      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Action: Display message",
        "GERMAN": "Aktion: Nachricht anzeigen",
        "RUSSIAN": "Действие: Вывести сообщение на экран",
        "FRENCH": "Action : Afficher le message",
        "SPANISH": "Acción: Mostrar mensaje",
        "ITALIAN": "Azione: Visualizza il messaggio",
        "CHINESE": "操作：显示信息"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Действие: Вывести сообщение на экран",
        "FRENCH": "Action : Afficher le message",
        "SPANISH": "Acción: Mostrar mensaje",
        "ITALIAN": "Azione: Visualizza il messaggio",
        "CHINESE": "操作：显示信息"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
