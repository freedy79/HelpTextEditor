    "NETWORK_WEBSERVICE_INSTRUCTION_1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The remote operation of the underlying functions of the MCA balance can also be done via a REST web service.",
        "GERMAN": "Die Remote Bedienung (Fernbedienung) der grundlegenden Funktionen der MCA Waage kann auch über einen REST Webservice erfolgen.",
        "RUSSIAN": "Удаленное управление базовыми функциями весов MCA также может осуществляться через веб-сервис REST.",
        "FRENCH": "L'exploitation à distance des fonctions sous-jacentes de la balance MCA peut également se faire via un service web REST.",
        "SPANISH": "La operación remota de las funciones subyacentes de la balanza MCA también puede realizarse a través de un servicio web REST.",
        "ITALIAN": "Il funzionamento remoto delle funzioni sottostanti della bilancia MCA può anche essere fatto tramite un servizio web REST.",
        "CHINESE": "MCA 天平底层功能的远程操作也可通过 REST 网络服务完成。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Удаленное управление базовыми функциями весов MCA также может осуществляться через веб-сервис REST.",
        "FRENCH": "L'exploitation à distance des fonctions sous-jacentes de la balance MCA peut également se faire via un service web REST.",
        "SPANISH": "La operación remota de las funciones subyacentes de la balanza MCA también puede realizarse a través de un servicio web REST.",
        "ITALIAN": "Il funzionamento remoto delle funzioni sottostanti della bilancia MCA può anche essere fatto tramite un servizio web REST.",
        "CHINESE": "MCA 天平底层功能的远程操作也可通过 REST 网络服务完成。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "NETWORK_WEBSERVICE_INSTRUCTION_2": {
