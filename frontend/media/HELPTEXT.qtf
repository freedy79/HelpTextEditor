    "SERIAL_VIA_NETWORK_INSTRUCTION_3": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "Do not replace the control characters <BR>.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Attention: The TCP is automatically disconnected after approx. 15 minutes of inactivity. The connection must then be re-established.",
        "GERMAN": "Achtung: Die TCP wird automatisch nach ca. 15 Minuten Inaktivität abgebaut. Die Verbindung muss dann neu hergestellt werden.",
        "FRENCH": "Attention : le TCP est automatiquement désactivé après environ 15 minutes d'inactivité. La connexion doit alors être rétablie.",
        "RUSSIAN": "Внимание: TCP автоматически отключается примерно через 15 минут бездействия. Затем соединение должно быть восстановлено.",
        "SPANISH": "Atención: El TCP se desconecta automáticamente tras unos 15 minutos de inactividad. A continuación, hay que restablecer la conexión.",
        "ITALIAN": "Attenzione: Il TCP si disconnette automaticamente dopo circa 15 minuti di inattività. La connessione deve poi essere ristabilita.",
        "CHINESE": "注意： TCP 在静止约 15 分钟后会自动取消。此时必须重新建立连接。",
        "JAPANESE": "注意TCPは約15分間使用されないと自動的に切断されます。その後、接続を再確立する必要があります。",
        "KOREAN": "주의: 약 15분 동안 활동이 없으면 TCP 연결이 자동으로 끊어집니다. 그런 다음 연결을 다시 설정해야 합니다."
      },
      "AUTOTRANSLATIONS": {
        "CHINESE": "注意： TCP 在静止约 15 分钟后会自动取消。此时必须重新建立连接。",
        "JAPANESE": "注意TCPは約15分間使用されないと自動的に切断されます。その後、接続を再確立する必要があります。",
        "KOREAN": "주의: 약 15분 동안 활동이 없으면 TCP 연결이 자동으로 끊어집니다. 그런 다음 연결을 다시 설정해야 합니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
        "RUSSIAN": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "SBI_PROTOCOL_TITLE": {
      "group": "HELP_TITLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
