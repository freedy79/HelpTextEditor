        "RUSSIAN": "Подтвердите диалог содержания данных нажатием [Создать].",
        "FRENCH": "Confirmez la boîte de dialogue du contenu des données en cliquant sur [Create].",
        "SPANISH": "Confirme el diálogo de contenido de datos con [Crear].",
        "ITALIAN": "Confermate la finestra di dialogo del contenuto dei dati con [Create].",
        "CHINESE": "用 [创建] 确认数据内容对话框。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Подтвердите диалог содержания данных нажатием [Создать].",
        "FRENCH": "Confirmez la boîte de dialogue du contenu des données en cliquant sur [Create].",
        "SPANISH": "Confirme el diálogo de contenido de datos con [Crear].",
        "ITALIAN": "Confermate la finestra di dialogo del contenuto dei dati con [Create].",
        "CHINESE": "用 [创建] 确认数据内容对话框。"
      },
