    "NETWORK_CERTIFICATES_RESET_STEP_5": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "GERMAN": "Wählen Sie das Symbol „Papierkorb“, um Zertifikate zu erneuern und bestätigen Sie die Meldung „Zertifikate zurücksetzen“ mit „Ja“.",
        "ENGLISH": "Select “Trash” icon to renew certificates and confirm the message “Reset certificates” with “Yes”",
        "FRENCH": "Sélectionnez l'icône \"Corbeille\" pour renouveler les certificats et confirmez le message \"Réinitialiser les certificats\" par \"Oui\".",
        "CHINESE": "选择 \"回收站 \"图标更新证书，并用 \"是 \"确认 \"重置证书 \"信息。",
        "ITALIAN": "Selezionare l'icona \"Cestino\" per rinnovare i certificati e confermare il messaggio \"Reimposta certificati\" con \"Sì\".",
        "SPANISH": "Seleccione el icono \"Papelera\" para renovar los certificados y confirme el mensaje \"Restablecer certificados\" con \"Sí\".",
        "RUSSIAN": "Выберите значок \"Корзина\", чтобы обновить сертификаты, и подтвердите сообщение \"Сбросить сертификаты\" нажатием кнопки \"Да\"."
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Sélectionnez l'icône \"Corbeille\" pour renouveler les certificats et confirmez le message \"Réinitialiser les certificats\" par \"Oui\".",
        "CHINESE": "选择 \"回收站 \"图标更新证书，并用 \"是 \"确认 \"重置证书 \"信息。",
        "ITALIAN": "Selezionare l'icona \"Cestino\" per rinnovare i certificati e confermare il messaggio \"Reimposta certificati\" con \"Sì\".",
        "SPANISH": "Seleccione el icono \"Papelera\" para renovar los certificados y confirme el mensaje \"Restablecer certificados\" con \"Sí\".",
        "RUSSIAN": "Выберите значок \"Корзина\", чтобы обновить сертификаты, и подтвердите сообщение \"Сбросить сертификаты\" нажатием кнопки \"Да\"."
      },
      "VERIFIED": {
        "GERMAN": false,
        "ENGLISH": false,
        "FRENCH": false,
        "CHINESE": false,
        "ITALIAN": false,
        "SPANISH": false,
        "RUSSIAN": false
      }
    },
    "NETWORK_CERTIFICATES_RESET_STEP_6": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "GERMAN": "Prüfen Sie, ob das neue Zertifikat „Sartorius Factory Authority“ verfügbar ist. Dieses Zertifikat wird im Jahr 2043 ablaufen.",
        "ENGLISH": "Check that new certificate “Sartorius Factory Authority” is available. This certificate will expire in 2043.",
        "FRENCH": "Vérifiez que le nouveau certificat \"Sartorius Factory Authority\" est disponible. Ce certificat expirera en 2043.",
        "CHINESE": "检查新的 \"赛多利斯工厂授权 \"证书是否可用。该证书将于 2043 年到期。",
        "SPANISH": "Compruebe que el nuevo certificado \"Sartorius Factory Authority\" está disponible. Este certificado caducará en 2043.",
        "RUSSIAN": "Убедитесь, что доступен новый сертификат \"Sartorius Factory Authority\". Срок действия этого сертификата истекает в 2043 году.",
        "ITALIAN": "Verificare che sia disponibile il nuovo certificato \"Sartorius Factory Authority\". Questo certificato scadrà nel 2043."
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Vérifiez que le nouveau certificat \"Sartorius Factory Authority\" est disponible. Ce certificat expirera en 2043.",
        "CHINESE": "检查新的 \"赛多利斯工厂授权 \"证书是否可用。该证书将于 2043 年到期。",
        "SPANISH": "Compruebe que el nuevo certificado \"Sartorius Factory Authority\" está disponible. Este certificado caducará en 2043.",
        "RUSSIAN": "Убедитесь, что доступен новый сертификат \"Sartorius Factory Authority\". Срок действия этого сертификата истекает в 2043 году.",
        "ITALIAN": "Verificare che sia disponibile il nuovo certificato \"Sartorius Factory Authority\". Questo certificato scadrà nel 2043."
      },
      "VERIFIED": {
        "GERMAN": false,
        "ENGLISH": false,
        "FRENCH": false,
        "CHINESE": false,
        "SPANISH": false,
        "RUSSIAN": false,
        "ITALIAN": false
      }
    },
    "NETWORK_CERTIFICATES_RESET_STEP_7": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "GERMAN": "Wenn „Sartorius Factory Authority“ in der Liste sichtbar ist, war die Aktualisierung erfolgreich, und es wird ein Audit Trail-Eintrag erstellt.",
        "ENGLISH": "If “Sartorius Factory Authority” is visible on the list, the update was successful, and an Audit Trail entry is generated.",
        "FRENCH": "Si \"Sartorius Factory Authority\" est visible dans la liste, la mise à jour a été effectuée avec succès et une entrée dans la piste d'audit est générée.",
        "CHINESE": "如果列表中显示 \"Sartorius Factory Authority\"（赛多利斯工厂授权），则表示更新成功并创建了审计跟踪条目。",
        "SPANISH": "Si \"Sartorius Factory Authority\" aparece en la lista, la actualización se ha realizado correctamente y se genera una entrada en el registro de auditoría.",
        "RUSSIAN": "Если в списке отображается \"Sartorius Factory Authority\", обновление прошло успешно, и создается запись в журнале аудита.",
        "ITALIAN": "Se \"Sartorius Factory Authority\" è visibile nell'elenco, l'aggiornamento è riuscito e viene generata una voce dell'Audit Trail."
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Si \"Sartorius Factory Authority\" est visible dans la liste, la mise à jour a été effectuée avec succès et une entrée dans la piste d'audit est générée.",
        "CHINESE": "如果列表中显示 \"Sartorius Factory Authority\"（赛多利斯工厂授权），则表示更新成功并创建了审计跟踪条目。",
        "SPANISH": "Si \"Sartorius Factory Authority\" aparece en la lista, la actualización se ha realizado correctamente y se genera una entrada en el registro de auditoría.",
        "RUSSIAN": "Если в списке отображается \"Sartorius Factory Authority\", обновление прошло успешно, и создается запись в журнале аудита.",
        "ITALIAN": "Se \"Sartorius Factory Authority\" è visibile nell'elenco, l'aggiornamento è riuscito e viene generata una voce dell'Audit Trail."
      },
      "VERIFIED": {
        "GERMAN": false,
        "ENGLISH": false,
        "FRENCH": false,
        "CHINESE": false,
        "SPANISH": false,
        "RUSSIAN": false,
        "ITALIAN": false
      }
    },
