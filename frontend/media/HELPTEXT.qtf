        "SPANISH": "Ajustes en los perfiles de pesaje",
        "ITALIAN": "Impostazioni nei profili di pesatura",
        "CHINESE": "称重配置文件中的设置"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Настройки в профилях взвешивания",
        "FRENCH": "Paramètres dans les profils de pesée",
        "SPANISH": "Ajustes en los perfiles de pesaje",
        "ITALIAN": "Impostazioni nei profili di pesatura",
