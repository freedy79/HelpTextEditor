      "TRANSLATIONS": {
        "ENGLISH": "<b>General device information</b><br>Displays general device information, e.g. model name, serial number, QAPP Center version.",
        "GERMAN": "<b>Allgemeine Geräteinformationen</b><br>Zeigt allgemeine Geräteinformationen, z. B. Modellname, Seriennummer, QAPP Center Version.",
        "CHINESE": "<b>一般设备信息</b><br>显示一般设备信息，如型号名称、序列号、QAPP 中心版本。",
        "FRENCH": "Informations générales sur l’appareil<br>Affiche des informations générales sur l'appareil, par exemple le nom du modèle, le numéro de série, la version du QAPP Center.",
        "ITALIAN": "Informazioni generali sull’apparecchio",
        "JAPANESE": "一般機器情報",
        "KOREAN": "일반 기기 정보",
        "RUSSIAN": "Общая информация об устройстве",
        "SPANISH": "Información general del aparato",
        "PORTUGUESE": "Informações gerais do dispositivo",
        "HUNGARIAN": "Általános készülékadatok",
        "POLISH": "Ogólne informacje o urządzeniu",
        "TURKISH": "Genel cihaz bilgileri",
        "DUTCH": "Algemene apparaatinformatie",
        "CZECH": "Všeobecné informace o zařízení"
      },
      "AUTOTRANSLATIONS": {
        "ENGLISH": "<b>General device information</b><br>Displays general device information, e.g. model name, serial number, QAPP Center version.",
        "CHINESE": "<b>一般设备信息</b><br>显示一般设备信息，如型号名称、序列号、QAPP 中心版本。"
