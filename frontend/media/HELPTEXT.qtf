      "TRANSLATIONS": {
        "ENGLISH": "Click [Cleaning criteria] and press the [+] to add the criterion [On login]",
        "GERMAN": "Klicken Sie auf [Reinigungskriterien] und drücken Sie auf das [+], um [Bei Anmeldung] hinzuzufügen.",
        "CHINESE": "点击[清洁标准]并按[+]添加标准[登录时］",
        "FRENCH": "Cliquez sur [Critères de nettoyage] et appuyez sur le [+] pour ajouter [À la connexion].",
        "SPANISH": "Haga clic en [Criterios de limpieza] y pulse el botón [+] para añadir el criterio [Al iniciar sesión].",
        "RUSSIAN": "Нажмите [Критерии очистки] и нажмите [+], чтобы добавить критерий [При входе в систему].",
        "ITALIAN": "Fare clic su [Criteri di pulizia] e premere il tasto [+] per aggiungere il criterio [All'accesso]."
      },
      "AUTOTRANSLATIONS": {
        "CHINESE": "点击[清洁标准]并按[+]添加标准[登录时］",
        "FRENCH": "Cliquez sur [Critères de nettoyage] et appuyez sur le [+] pour ajouter [À la connexion].",
        "SPANISH": "Haga clic en [Criterios de limpieza] y pulse el botón [+] para añadir el criterio [Al iniciar sesión].",
        "RUSSIAN": "Нажмите [Критерии очистки] и нажмите [+], чтобы добавить критерий [При входе в систему].",
        "ITALIAN": "Fare clic su [Criteri di pulizia] e premere il tasto [+] per aggiungere il criterio [All'accesso]."
      },
      "VERIFIED": {
