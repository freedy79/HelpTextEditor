    "DEVICE_CLEANING_APPLICATION_EXAMPLE_3_STEP_3": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Activate [Cleaning support] to <b>Basic and advanced</b>, the appropriate settings get visible",
        "GERMAN": "Selektieren Sie in der [Reinigungsunterstützung] <b>Normal und erweitert</b>, die weiteren Einstellungen werden sichtbar",
        "CHINESE": "激活[清洁支持]到<b>基本和高级</b>，相应的设置就会显示出来",
        "FRENCH": "Sélectionnez <b>Normal et étendu</b> dans le [Support de nettoyage], les autres réglages seront visibles.",
        "SPANISH": "Activar [Soporte de limpieza] en <b>Básico y avanzado</b>, los ajustes apropiados se hacen visibles.",
        "RUSSIAN": "Активируйте [Поддержка очистки] на <b>Основной и расширенный</b>, соответствующие настройки станут видимыми",
        "ITALIAN": "Attivare [Supporto pulizia] su <b>Basico e avanzato</b>, le impostazioni appropriate diventano visibili."
      },
      "AUTOTRANSLATIONS": {
        "CHINESE": "激活[清洁支持]到<b>基本和高级</b>，相应的设置就会显示出来",
        "FRENCH": "Sélectionnez <b>Normal et étendu</b> dans le [Support de nettoyage], les autres réglages seront visibles.",
        "SPANISH": "Activar [Soporte de limpieza] en <b>Básico y avanzado</b>, los ajustes apropiados se hacen visibles.",
        "RUSSIAN": "Активируйте [Поддержка очистки] на <b>Основной и расширенный</b>, соответствующие настройки станут видимыми",
        "ITALIAN": "Attivare [Supporto pulizia] su <b>Basico e avanzato</b>, le impostazioni appropriate diventano visibili."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "CHINESE": false,
        "FRENCH": false,
        "SPANISH": false,
        "RUSSIAN": false,
        "ITALIAN": false
      }
    },
    "DEVICE_CLEANING_APPLICATION_EXAMPLE_3_STEP_4": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Click [Cleaning criteria (Basic)] and press the [+] to add the criterion [On task start]",
        "GERMAN": "Klicken Sie auf [Reinigungskriterien (Normal)] und drücken Sie auf das [+], um [Bei Task-Ausführung] hinzuzufügen.",
        "CHINESE": "单击 [清洁标准（基本）]，然后按 [+] 键添加标准 [任务开始时]。",
        "FRENCH": "Cliquez sur [Critères de nettoyage (Normal)] et appuyez sur le [+] pour ajouter [Lors de l'exécution de la tâche].",
        "SPANISH": "Haga clic en [Criterios de limpieza (Básico)] y pulse el botón [+] para añadir el criterio [Al iniciar la tarea].",
        "RUSSIAN": "Нажмите [Критерии очистки (основные)] и нажмите [+], чтобы добавить критерий [При запуске задания].",
        "ITALIAN": "Cliccare su [Criteri di pulizia (base)] e premere il tasto [+] per aggiungere il criterio [All'inizio dell'attività]."
      },
      "AUTOTRANSLATIONS": {
        "CHINESE": "单击 [清洁标准（基本）]，然后按 [+] 键添加标准 [任务开始时]。",
        "FRENCH": "Cliquez sur [Critères de nettoyage (Normal)] et appuyez sur le [+] pour ajouter [Lors de l'exécution de la tâche].",
        "SPANISH": "Haga clic en [Criterios de limpieza (Básico)] y pulse el botón [+] para añadir el criterio [Al iniciar la tarea].",
        "RUSSIAN": "Нажмите [Критерии очистки (основные)] и нажмите [+], чтобы добавить критерий [При запуске задания].",
        "ITALIAN": "Cliccare su [Criteri di pulizia (base)] e premere il tasto [+] per aggiungere il criterio [All'inizio dell'attività]."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "CHINESE": false,
        "FRENCH": false,
        "SPANISH": false,
        "RUSSIAN": false,
        "ITALIAN": false
      }
    },
    "DEVICE_CLEANING_APPLICATION_EXAMPLE_3_STEP_5": {
      "group": "HELP_EXAMPLE",
