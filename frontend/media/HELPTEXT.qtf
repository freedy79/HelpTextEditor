    "DEVICE_CONCEPT_ELEMENTS_WEIGHING_UNIT_DESC": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "GERMAN": "−Zeigt die gewählte Einheit, z. B. Milligramm, [mg].<br>− Ermöglicht die Auswahl der Einheit und Auflösung.",
        "ENGLISH": "-Shows the selected unit, e.g. milligram, [mg].<br>- Allows you to select the unit and resolution.",
        "FRENCH": "-Affiche l'unité sélectionnée, par exemple le milligramme, [mg].<br>- Permet de sélectionner l'unité et la résolution.",
        "RUSSIAN": "-Показывает выбранную единицу измерения, например, миллиграмм, [mg].<br>- Позволяет выбрать единицу измерения и разрешение.",
        "CHINESE": "<br>- 可以选择单位和分辨率。",
        "SPANISH": "-Muestra la unidad seleccionada, por ejemplo, miligramo, [mg].<br>- Permite seleccionar la unidad y la resolución.",
        "ITALIAN": "-Mostra l'unità selezionata, ad esempio milligrammo, [mg].<br>- Permette di selezionare l'unità e la risoluzione."
      },
      "AUTOTRANSLATIONS": {
        "ENGLISH": "-Shows the selected unit, e.g. milligram, [mg].<br>- Allows you to select the unit and resolution.",
        "FRENCH": "-Affiche l'unité sélectionnée, par exemple le milligramme, [mg].<br>- Permet de sélectionner l'unité et la résolution.",
        "RUSSIAN": "-Показывает выбранную единицу измерения, например, миллиграмм, [mg].<br>- Позволяет выбрать единицу измерения и разрешение.",
        "CHINESE": "<br>- 可以选择单位和分辨率。",
        "SPANISH": "-Muestra la unidad seleccionada, por ejemplo, miligramo, [mg].<br>- Permite seleccionar la unidad y la resolución.",
        "ITALIAN": "-Mostra l'unità selezionata, ad esempio milligrammo, [mg].<br>- Permette di selezionare l'unità e la risoluzione."
      },
      "VERIFIED": {
        "GERMAN": false,
        "ENGLISH": false,
        "FRENCH": false,
        "RUSSIAN": false,
        "CHINESE": false,
        "SPANISH": false,
        "ITALIAN": false
      }
    },
