      "TRANSLATIONS": {
        "ENGLISH": "Navigate to [Device settings] -> [Date and time] -> [Set date and time].",
        "GERMAN": "Zu [Geräteeinstellungen] -> [Datum und Zeit] -> [Datum und Zeit einstellen] navigieren.",
        "RUSSIAN": "Перейдите к [Настройки устройства] -> [Дата и время] -> [Установить дату и время].",
        "FRENCH": "Naviguez jusqu'à [Paramètres du périphérique] -> [Date et heure] -> [Définir la date et l'heure].",
        "SPANISH": "Acceda a [Ajustes del dispositivo] -> [Fecha y hora] -> [Ajustar fecha y hora].",
        "ITALIAN": "Passare a [Impostazioni dispositivo] -> [Data e ora] -> [Imposta data e ora].",
        "CHINESE": "导航至 [ 设备设置 ] -> [ 日期和时间 ] -> [ 设置日期和时间 ]。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Перейдите к [Настройки устройства] -> [Дата и время] -> [Установить дату и время].",
        "FRENCH": "Naviguez jusqu'à [Paramètres du périphérique] -> [Date et heure] -> [Définir la date et l'heure].",
        "SPANISH": "Acceda a [Ajustes del dispositivo] -> [Fecha y hora] -> [Ajustar fecha y hora].",
        "ITALIAN": "Passare a [Impostazioni dispositivo] -> [Data e ora] -> [Imposta data e ora].",
        "CHINESE": "导航至 [ 设备设置 ] -> [ 日期和时间 ] -> [ 设置日期和时间 ]。"
      },
