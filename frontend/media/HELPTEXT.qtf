    "NETWORK_CONNECTION_INSTRUCTION_4": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "For a wireless connection, Cubis® MCA supports the most common Wi-Fi USB adapters (WLAN sticks) which are offered in the market.",
        "GERMAN": "Für eine kabellose Verbindung unterstützt die Cubis® MCA die gängigsten Wi-Fi USB Adapter (WLAN-Sticks) die auf dem Markt angeboten werden.",
        "RUSSIAN": "Для беспроводного подключения Cubis® MCA поддерживает наиболее распространенные USB-адаптеры Wi-Fi (WLAN-флешки), которые предлагаются на рынке.",
        "FRENCH": "Pour une connexion sans fil, Cubis® MCA supporte les adaptateurs USB Wi-Fi les plus courants (clés WLAN) proposés sur le marché.",
        "SPANISH": "Para una conexión inalámbrica, Cubis® MCA es compatible con los adaptadores USB Wi-Fi más comunes (memorias WLAN) que se ofrecen en el mercado.",
        "ITALIAN": "Per una connessione senza fili, Cubis® MCA supporta i più comuni adattatori USB Wi-Fi (WLAN sticks) che si trovano sul mercato.",
        "CHINESE": "在无线连接方面，Cubis® MCA 支持市场上最常见的 Wi-Fi USB 适配器（WLAN 棒）。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Для беспроводного подключения Cubis® MCA поддерживает наиболее распространенные USB-адаптеры Wi-Fi (WLAN-флешки), которые предлагаются на рынке.",
        "FRENCH": "Pour une connexion sans fil, Cubis® MCA supporte les adaptateurs USB Wi-Fi les plus courants (clés WLAN) proposés sur le marché.",
        "SPANISH": "Para una conexión inalámbrica, Cubis® MCA es compatible con los adaptadores USB Wi-Fi más comunes (memorias WLAN) que se ofrecen en el mercado.",
        "ITALIAN": "Per una connessione senza fili, Cubis® MCA supporta i più comuni adattatori USB Wi-Fi (WLAN sticks) che si trovano sul mercato.",
        "CHINESE": "在无线连接方面，Cubis® MCA 支持市场上最常见的 Wi-Fi USB 适配器（WLAN 棒）。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
