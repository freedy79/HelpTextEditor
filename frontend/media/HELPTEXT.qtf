      "TRANSLATIONS": {
        "ENGLISH": "Cleaning tile in status center",
        "GERMAN": "Kachel im Status-Center",
        "CHINESE": "清洁状态中心的瓷砖",
        "FRENCH": "Tuile dans le centre d'état",
        "SPANISH": "Limpieza de baldosas en el centro de estado",
        "RUSSIAN": "Очистка плитки в статусном центре",
        "ITALIAN": "Pulizia delle piastrelle nel centro di stato"
      },
      "AUTOTRANSLATIONS": {
        "CHINESE": "清洁状态中心的瓷砖",
        "FRENCH": "Tuile dans le centre d'état",
        "SPANISH": "Limpieza de baldosas en el centro de estado",
        "RUSSIAN": "Очистка плитки в статусном центре",
        "ITALIAN": "Pulizia delle piastrelle nel centro di stato"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "CHINESE": false,
        "FRENCH": false,
        "SPANISH": false,
        "RUSSIAN": false,
