    "EXAMPLE_WITH_DEFAULT_PROFILE_CONF_STEP_1": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Assign the [Weighing in safety cabinet] weighing profile to your task e.g., [My weighing in safety cabinet].",
        "GERMAN": "Ordnen Sie das Wägeprofil [Wägen in Sicherheitswerkbank] Ihrer Task zu, z. B. [Mein Wägen in Sicherheitswerkbank].",
        "RUSSIAN": "Установите профиль взвешивания [Взвешивание в шкафу безопасности] для вашей задачи, например, [Мое взвешивание в шкафу безопасности].",
        "FRENCH": "Attribuez le profil de pesée [Pesée dans une enceinte de sécurité] à votre tâche, par exemple, [Ma pesée dans une enceinte de sécurité].",
        "SPANISH": "Asigne el perfil de pesaje [Pesaje en cabina de seguridad] a su tarea, por ejemplo, [Mi pesaje en cabina de seguridad].",
        "ITALIAN": "Assegnate il profilo di pesatura [Pesatura nell'armadio di sicurezza] al vostro compito, ad esempio, [La mia pesatura nell'armadio di sicurezza].",
        "CHINESE": "将[安全柜称重]称重配置文件分配给您的任务，例如[我的安全柜称重]。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Установите профиль взвешивания [Взвешивание в шкафу безопасности] для вашей задачи, например, [Мое взвешивание в шкафу безопасности].",
        "FRENCH": "Attribuez le profil de pesée [Pesée dans une enceinte de sécurité] à votre tâche, par exemple, [Ma pesée dans une enceinte de sécurité].",
        "SPANISH": "Asigne el perfil de pesaje [Pesaje en cabina de seguridad] a su tarea, por ejemplo, [Mi pesaje en cabina de seguridad].",
        "ITALIAN": "Assegnate il profilo di pesatura [Pesatura nell'armadio di sicurezza] al vostro compito, ad esempio, [La mia pesatura nell'armadio di sicurezza].",
        "CHINESE": "将[安全柜称重]称重配置文件分配给您的任务，例如[我的安全柜称重]。"
