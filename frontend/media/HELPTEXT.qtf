    "MENU_SETTINGS_REPORT_SMB_ERROR_STEP_1": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Make sure that all the configuration steps mentioned above have been followed.",
        "GERMAN": "Stellen Sie sicher, dass alle oben genannten Konfigurationsschritte befolgt wurden.",
        "RUSSIAN": "Убедитесь, что все шаги по настройке, упомянутые выше, были выполнены.",
        "FRENCH": "Assurez-vous que toutes les étapes de configuration mentionnées ci-dessus ont été suivies.",
        "SPANISH": "Asegúrese de que se han seguido todos los pasos de configuración mencionados anteriormente.",
        "ITALIAN": "Assicuratevi che tutti i passi di configurazione menzionati sopra siano stati seguiti.",
        "CHINESE": "确保已遵循上述所有配置步骤。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Убедитесь, что все шаги по настройке, упомянутые выше, были выполнены.",
        "FRENCH": "Assurez-vous que toutes les étapes de configuration mentionnées ci-dessus ont été suivies.",
        "SPANISH": "Asegúrese de que se han seguido todos los pasos de configuración mencionados anteriormente.",
        "ITALIAN": "Assicuratevi che tutti i passi di configurazione menzionati sopra siano stati seguiti.",
        "CHINESE": "确保已遵循上述所有配置步骤。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "MENU_SETTINGS_REPORT_SMB_ERROR_STEP_2": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Check that the balance is connected to the network e.g., via an Ethernet cable. The IP address of the balance in the network must be displayed in the [Status center] under [Device information].",
        "GERMAN": "Überprüfen Sie, ob die Waage z. B. per Ethernet-Kabel mit dem Netzwerk verbunden ist. Im [Status Center] muss unter [Geräteinformationen] die IP-Adresse der Waage im Netzwerk angezeigt werden.",
        "RUSSIAN": "Убедитесь, что весы подключены к сети, например, через кабель Ethernet. IP-адрес весов в сети должен отображаться в [Status center] в разделе [Device information].",
        "FRENCH": "Vérifiez que la balance est connectée au réseau, par exemple via un câble Ethernet. L'adresse IP de la balance dans le réseau doit être affichée dans le [Centre d'état] sous [Informations sur l'appareil].",
        "SPANISH": "Compruebe que la balanza está conectada a la red, por ejemplo, mediante un cable Ethernet. La dirección IP de la balanza en la red debe aparecer en el [Centro de estado] en [Información del dispositivo].",
        "ITALIAN": "Controllare che la bilancia sia collegata alla rete, ad esempio tramite un cavo Ethernet. L'indirizzo IP della bilancia nella rete deve essere visualizzato nel [Status center] sotto [Device information].",
        "CHINESE": "检查天平是否通过以太网电缆等连接到网络。网络中天平的 IP 地址必须显示在 [Device information] （设备信息）下的 [Status center] （状态中心）中。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Убедитесь, что весы подключены к сети, например, через кабель Ethernet. IP-адрес весов в сети должен отображаться в [Status center] в разделе [Device information].",
        "FRENCH": "Vérifiez que la balance est connectée au réseau, par exemple via un câble Ethernet. L'adresse IP de la balance dans le réseau doit être affichée dans le [Centre d'état] sous [Informations sur l'appareil].",
        "SPANISH": "Compruebe que la balanza está conectada a la red, por ejemplo, mediante un cable Ethernet. La dirección IP de la balanza en la red debe aparecer en el [Centro de estado] en [Información del dispositivo].",
        "ITALIAN": "Controllare che la bilancia sia collegata alla rete, ad esempio tramite un cavo Ethernet. L'indirizzo IP della bilancia nella rete deve essere visualizzato nel [Status center] sotto [Device information].",
        "CHINESE": "检查天平是否通过以太网电缆等连接到网络。网络中天平的 IP 地址必须显示在 [Device information] （设备信息）下的 [Status center] （状态中心）中。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "MENU_SETTINGS_REPORT_SMB_ERROR_STEP_3": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Check the network path in the connector and the correct spelling of Host and Share, as well as the username and password for access rights to the SMB file server.",
        "GERMAN": "Kontrollieren Sie im Konnektor den Netzwerkpfad und die richtige Schreibweise von Host und Share sowie Benutzername und Passwort für die Zugriffsrechte auf den SMB File Server.",
        "RUSSIAN": "Проверьте сетевой путь в коннекторе и правильность написания Host и Share, а также имя пользователя и пароль для прав доступа к файловому серверу SMB.",
        "FRENCH": "Vérifiez le chemin d'accès au réseau dans le connecteur et l'orthographe correcte de Host et Share, ainsi que le nom d'utilisateur et le mot de passe pour les droits d'accès au serveur de fichiers SMB.",
        "SPANISH": "Compruebe la ruta de red en el conector y la ortografía correcta de Host y Share, así como el nombre de usuario y la contraseña para los derechos de acceso al servidor de archivos SMB.",
        "ITALIAN": "Controlla il percorso di rete nel connettore e l'ortografia corretta di Host e Share, così come il nome utente e la password per i diritti di accesso al file server SMB.",
        "CHINESE": "检查连接器中的网络路径、Host 和 Share 的正确拼写，以及 SMB 文件服务器访问权限的用户名和密码。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Проверьте сетевой путь в коннекторе и правильность написания Host и Share, а также имя пользователя и пароль для прав доступа к файловому серверу SMB.",
        "FRENCH": "Vérifiez le chemin d'accès au réseau dans le connecteur et l'orthographe correcte de Host et Share, ainsi que le nom d'utilisateur et le mot de passe pour les droits d'accès au serveur de fichiers SMB.",
        "SPANISH": "Compruebe la ruta de red en el conector y la ortografía correcta de Host y Share, así como el nombre de usuario y la contraseña para los derechos de acceso al servidor de archivos SMB.",
        "ITALIAN": "Controlla il percorso di rete nel connettore e l'ortografia corretta di Host e Share, così come il nome utente e la password per i diritti di accesso al file server SMB.",
        "CHINESE": "检查连接器中的网络路径、Host 和 Share 的正确拼写，以及 SMB 文件服务器访问权限的用户名和密码。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "MENU_SETTINGS_REPORT_SMB_ERROR_STEP_4": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Test the connection of the connectors with the SMB file server by activating the [Info] button in the overview of the set values. If all the settings are correct and the SMB file server is accessible, you will receive a message stating that the connector is available.",
        "GERMAN": "Testen Sie die Verbindung des Konnektors mit dem SMB File Server, in dem Sie in der Übersicht der eingestellten Werte die Schaltfläche [Info] betätigen. Wenn alle Einstellungen richtig sind und der SMB File Server erreichbar, dann erhalten Sie die Meldung, dass der Konnektor verfügbar ist.",
        "RUSSIAN": "Проверьте соединение коннекторов с файловым сервером SMB, активировав кнопку [Info] в обзоре установленных значений. Если все настройки верны и файловый сервер SMB доступен, вы получите сообщение о том, что коннектор доступен.",
        "FRENCH": "Testez la connexion des connecteurs avec le serveur de fichiers SMB en activant le bouton [Info] dans l'aperçu des valeurs définies. Si tous les paramètres sont corrects et que le serveur de fichiers SMB est accessible, vous recevrez un message indiquant que le connecteur est disponible.",
        "SPANISH": "Pruebe la conexión de los conectores con el servidor de archivos SMB activando el botón [Info] en el resumen de los valores establecidos. Si todos los ajustes son correctos y el servidor de archivos SMB es accesible, recibirá un mensaje indicando que el conector está disponible.",
        "ITALIAN": "Testate la connessione dei connettori con il file server SMB attivando il pulsante [Info] nella panoramica dei valori impostati. Se tutte le impostazioni sono corrette e il file server SMB è accessibile, riceverai un messaggio che indica che il connettore è disponibile.",
        "CHINESE": "通过激活设置值概览中的 [Info] 按钮，测试连接器与 SMB 文件服务器的连接。如果所有设置正确且 SMB 文件服务器可访问，则会收到一条连接器可用的消息。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Проверьте соединение коннекторов с файловым сервером SMB, активировав кнопку [Info] в обзоре установленных значений. Если все настройки верны и файловый сервер SMB доступен, вы получите сообщение о том, что коннектор доступен.",
        "FRENCH": "Testez la connexion des connecteurs avec le serveur de fichiers SMB en activant le bouton [Info] dans l'aperçu des valeurs définies. Si tous les paramètres sont corrects et que le serveur de fichiers SMB est accessible, vous recevrez un message indiquant que le connecteur est disponible.",
        "SPANISH": "Pruebe la conexión de los conectores con el servidor de archivos SMB activando el botón [Info] en el resumen de los valores establecidos. Si todos los ajustes son correctos y el servidor de archivos SMB es accesible, recibirá un mensaje indicando que el conector está disponible.",
        "ITALIAN": "Testate la connessione dei connettori con il file server SMB attivando il pulsante [Info] nella panoramica dei valori impostati. Se tutte le impostazioni sono corrette e il file server SMB è accessibile, riceverai un messaggio che indica che il connettore è disponibile.",
        "CHINESE": "通过激活设置值概览中的 [Info] 按钮，测试连接器与 SMB 文件服务器的连接。如果所有设置正确且 SMB 文件服务器可访问，则会收到一条连接器可用的消息。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "MENU_SETTINGS_REPORT_SMB_ERROR_STEP_5": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "If not, then check that the SMB file server is present in the network and that a file can be saved there from your PC.",
        "GERMAN": "Wenn nicht, dann überprüfen Sie, ob sich der SMB File Server im Netzwerk befindet und von Ihrem PC aus eine Datei dort abgelegt werden kann.",
        "RUSSIAN": "Если нет, то проверьте, что файловый сервер SMB присутствует в сети и что файл может быть сохранен там с вашего ПК.",
        "FRENCH": "Si ce n'est pas le cas, vérifiez que le serveur de fichiers SMB est présent sur le réseau et qu'un fichier peut y être enregistré à partir de votre PC.",
        "SPANISH": "Si no es así, compruebe que el servidor de archivos SMB está presente en la red y que se puede guardar un archivo allí desde su PC.",
        "ITALIAN": "In caso contrario, controllate che il file server SMB sia presente nella rete e che un file possa essere salvato lì dal vostro PC.",
        "CHINESE": "如果没有，请检查网络中是否存在 SMB 文件服务器，以及是否可以从电脑在那里保存文件。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Если нет, то проверьте, что файловый сервер SMB присутствует в сети и что файл может быть сохранен там с вашего ПК.",
        "FRENCH": "Si ce n'est pas le cas, vérifiez que le serveur de fichiers SMB est présent sur le réseau et qu'un fichier peut y être enregistré à partir de votre PC.",
        "SPANISH": "Si no es así, compruebe que el servidor de archivos SMB está presente en la red y que se puede guardar un archivo allí desde su PC.",
        "ITALIAN": "In caso contrario, controllate che il file server SMB sia presente nella rete e che un file possa essere salvato lì dal vostro PC.",
        "CHINESE": "如果没有，请检查网络中是否存在 SMB 文件服务器，以及是否可以从电脑在那里保存文件。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "MENU_SETTINGS_REPORT_SMB_ERROR_STEP_6": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "If there is an [Transfer failure] error message, then you can do the following with the export:",
        "GERMAN": "Falls es zu Fehlermeldung [Übertragungsfehler] kommt, dann können Sie den Export:",
        "RUSSIAN": "Если появляется сообщение об ошибке [Transfer failure], то с экспортом можно поступить следующим образом:",
        "FRENCH": "Si le message d'erreur [Échec du transfert] s'affiche, vous pouvez procéder comme suit pour l'exportation :",
        "SPANISH": "Si aparece un mensaje de error [Fallo de transferencia], puede hacer lo siguiente con la exportación:",
        "ITALIAN": "Se c'è un messaggio di errore [Transfer failure], allora potete fare quanto segue con l'esportazione:",
        "CHINESE": "如果出现 [Transfer failure] （传输失败）错误信息，则可以执行以下导出操作："
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Если появляется сообщение об ошибке [Transfer failure], то с экспортом можно поступить следующим образом:",
        "FRENCH": "Si le message d'erreur [Échec du transfert] s'affiche, vous pouvez procéder comme suit pour l'exportation :",
        "SPANISH": "Si aparece un mensaje de error [Fallo de transferencia], puede hacer lo siguiente con la exportación:",
        "ITALIAN": "Se c'è un messaggio di errore [Transfer failure], allora potete fare quanto segue con l'esportazione:",
        "CHINESE": "如果出现 [Transfer failure] （传输失败）错误信息，则可以执行以下导出操作："
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "MENU_SETTINGS_REPORT_SMB_ERROR_STEP_6_A": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Retry: Retry exporting the report file to the network server.",
        "GERMAN": "Wiederholen: Die Ausgabe der Report-Datei zum Netzwerk-Server erfolgt erneut.",
        "RUSSIAN": "Повторить: Повторная попытка экспорта файла отчета на сетевой сервер.",
        "FRENCH": "Retenter : Réessayer d'exporter le fichier de rapport vers le serveur réseau.",
        "SPANISH": "Reintentar: Reintentar la exportación del archivo de informe al servidor de red.",
        "ITALIAN": "Riprova: Riprova l'esportazione del file di report al server di rete.",
        "CHINESE": "重试：重试将报告文件导出到网络服务器。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Повторить: Повторная попытка экспорта файла отчета на сетевой сервер.",
        "FRENCH": "Retenter : Réessayer d'exporter le fichier de rapport vers le serveur réseau.",
        "SPANISH": "Reintentar: Reintentar la exportación del archivo de informe al servidor de red.",
        "ITALIAN": "Riprova: Riprova l'esportazione del file di report al server di rete.",
        "CHINESE": "重试：重试将报告文件导出到网络服务器。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "MENU_SETTINGS_REPORT_SMB_ERROR_STEP_6_B": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Retry later: The export of the report file is repeated automatically. Outstanding transfers are displayed in the [Status center] under [Messages].",
        "GERMAN": "Später wiederholen: Die Ausgabe der Report-Datei wird automatisch wiederholt. Im [Status Center] unter [Nachrichten] werden ausstehenden Übertragungen angezeigt.",
        "RUSSIAN": "Повторить позже: Экспорт файла отчета повторяется автоматически. Незавершенные передачи отображаются в [Центре состояния] в разделе [Сообщения].",
        "FRENCH": "Réessayer plus tard : L'exportation du fichier de rapport est répétée automatiquement. Les transferts en suspens sont affichés dans le [Centre d'état] sous [Messages].",
        "SPANISH": "Vuelva a intentarlo más tarde: La exportación del archivo de informe se repite automáticamente. Las transferencias pendientes se muestran en el [Centro de estado] en [Mensajes].",
        "ITALIAN": "Riprova più tardi: L'esportazione del file di report viene ripetuta automaticamente. I trasferimenti in sospeso vengono visualizzati nel [Centro di stato] sotto [Messaggi].",
        "CHINESE": "稍后重试：自动重复导出报告文件。未完成的传输会显示在 [信息] 下的 [状态中心]。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Повторить позже: Экспорт файла отчета повторяется автоматически. Незавершенные передачи отображаются в [Центре состояния] в разделе [Сообщения].",
        "FRENCH": "Réessayer plus tard : L'exportation du fichier de rapport est répétée automatiquement. Les transferts en suspens sont affichés dans le [Centre d'état] sous [Messages].",
        "SPANISH": "Vuelva a intentarlo más tarde: La exportación del archivo de informe se repite automáticamente. Las transferencias pendientes se muestran en el [Centro de estado] en [Mensajes].",
        "ITALIAN": "Riprova più tardi: L'esportazione del file di report viene ripetuta automaticamente. I trasferimenti in sospeso vengono visualizzati nel [Centro di stato] sotto [Messaggi].",
        "CHINESE": "稍后重试：自动重复导出报告文件。未完成的传输会显示在 [信息] 下的 [状态中心]。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
