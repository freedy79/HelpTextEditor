    "DEVICE_CLEANING_APPLICATION_EXAMPLE_3_STEP_6": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Click [Cleaning criteria (Advanced)] and press the [+] to add the criterion [Usage time]",
        "GERMAN": "Klicken Sie auf [Reinigungskriterien (Erweitert)] und drücken Sie auf das [+], um [Verwendungszeit] hinzuzufügen.",
        "CHINESE": "单击 [清洁标准（高级）]，然后按 [+] 添加标准 [使用时间］",
        "FRENCH": "Cliquez sur [Critères de nettoyage (avancés)] et appuyez sur le [+] pour ajouter [Temps d'utilisation].",
        "SPANISH": "Haga clic en [Criterios de limpieza (Avanzado)] y pulse el botón [+] para añadir el criterio [Tiempo de uso].",
        "RUSSIAN": "Нажмите [Критерии очистки (Дополнительно)] и нажмите [+], чтобы добавить критерий [Время использования].",
        "ITALIAN": "Cliccare su [Criteri di pulizia (avanzati)] e premere il tasto [+] per aggiungere il criterio [Tempo di utilizzo]."
      },
      "AUTOTRANSLATIONS": {
        "CHINESE": "单击 [清洁标准（高级）]，然后按 [+] 添加标准 [使用时间］",
        "FRENCH": "Cliquez sur [Critères de nettoyage (avancés)] et appuyez sur le [+] pour ajouter [Temps d'utilisation].",
        "SPANISH": "Haga clic en [Criterios de limpieza (Avanzado)] y pulse el botón [+] para añadir el criterio [Tiempo de uso].",
        "RUSSIAN": "Нажмите [Критерии очистки (Дополнительно)] и нажмите [+], чтобы добавить критерий [Время использования].",
        "ITALIAN": "Cliccare su [Criteri di pulizia (avanzati)] e premere il tasto [+] per aggiungere il criterio [Tempo di utilizzo]."
      },
