      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Действия: Экспорт устройства хранения данных",
        "FRENCH": "Action : Exporter le dispositif de stockage des données",
        "SPANISH": "Acción: Exportar el dispositivo de almacenamiento de datos",
        "ITALIAN": "Azione: Esportazione del dispositivo di memorizzazione dei dati",
        "CHINESE": "行动导出数据存储设备"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
