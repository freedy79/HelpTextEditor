    "EXAMPLE_AUTOM_CREATE_NETWORK_USER_CONF_STEP_2": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the control characters <BR>",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "In the login display, activate the field with the last used username. <BR>The list of users created in the balance is displayed.",
        "GERMAN": "Aus der Anmeldeanzeige heraus betätigen Sie das Feld mit dem zuletzt genutzten Benutzernamen. <BR>Es wird die Liste der angelegten Benutzer auf der Waage angezeigt.",
        "RUSSIAN": "В окне входа в систему активируйте поле с последним использованным именем пользователя. <BR>Отобразится список пользователей, созданных в весах.",
        "FRENCH": "Dans l'affichage de connexion, activez le champ avec le dernier nom d'utilisateur utilisé. <BR>La liste des utilisateurs créés dans la balance s'affiche.",
        "SPANISH": "En la pantalla de inicio de sesión, active el campo con el último nombre de usuario utilizado. <BR>Se muestra la lista de usuarios creados en la balanza.",
        "ITALIAN": "Nel display di login, attiva il campo con l'ultimo nome utente utilizzato. <BR>Viene visualizzato l'elenco degli utenti creati nel saldo.",
        "CHINESE": "在登录显示中，激活最后使用的用户名字段。<BR>显示在余额中创建的用户列表。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "В окне входа в систему активируйте поле с последним использованным именем пользователя. <BR>Отобразится список пользователей, созданных в весах.",
        "FRENCH": "Dans l'affichage de connexion, activez le champ avec le dernier nom d'utilisateur utilisé. <BR>La liste des utilisateurs créés dans la balance s'affiche.",
        "SPANISH": "En la pantalla de inicio de sesión, active el campo con el último nombre de usuario utilizado. <BR>Se muestra la lista de usuarios creados en la balanza.",
        "ITALIAN": "Nel display di login, attiva il campo con l'ultimo nome utente utilizzato. <BR>Viene visualizzato l'elenco degli utenti creati nel saldo.",
        "CHINESE": "在登录显示中，激活最后使用的用户名字段。<BR>显示在余额中创建的用户列表。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "EXAMPLE_AUTOM_CREATE_NETWORK_USER_CONF_STEP_3": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "For automatically creating a new network user, press the [+] button and confirm the message displayed with [Continue].",
        "GERMAN": "Zum automatischen Anlegen eines neuen Netzwerk-Benutzers betätigen Sie die Schaltfläche [+] und bestätigen Sie die angezeigte Meldung mit [Weiter].",
        "RUSSIAN": "Для автоматического создания нового пользователя сети нажмите кнопку [+] и подтвердите сообщение, выданное кнопкой [Продолжить].",
        "FRENCH": "Pour créer automatiquement un nouvel utilisateur du réseau, appuyez sur le bouton [+] et confirmez le message en cliquant sur [Continuer].",
        "SPANISH": "Para crear automáticamente un nuevo usuario de la red, pulse el botón [+] y confirme el mensaje emitido con [Continuar].",
        "ITALIAN": "Per creare automaticamente un nuovo utente di rete, premere il pulsante [+] e confermare il messaggio inviato con [Continua].",
        "CHINESE": "要自动创建新网络用户，请按 [+] 按钮并用 [Continue] 确认显示的信息。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Для автоматического создания нового пользователя сети нажмите кнопку [+] и подтвердите сообщение, выданное кнопкой [Продолжить].",
        "FRENCH": "Pour créer automatiquement un nouvel utilisateur du réseau, appuyez sur le bouton [+] et confirmez le message en cliquant sur [Continuer].",
        "SPANISH": "Para crear automáticamente un nuevo usuario de la red, pulse el botón [+] y confirme el mensaje emitido con [Continuar].",
        "ITALIAN": "Per creare automaticamente un nuovo utente di rete, premere il pulsante [+] e confermare il messaggio inviato con [Continua].",
        "CHINESE": "要自动创建新网络用户，请按 [+] 按钮并用 [Continue] 确认显示的信息。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "EXAMPLE_AUTOM_CREATE_NETWORK_USER_CONF_STEP_4": {
