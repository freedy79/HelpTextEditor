      }
    },
    "PRINT_PROFILE_PC_DIRECT_TITLE": {
      "group": "HELP_TITLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "PC Direct Print Profile",
        "GERMAN": "Druckprofil PC-Direkt",
        "FRENCH": "Profil d'impression directe PC",
        "RUSSIAN": "Профиль прямой печати ПК",
