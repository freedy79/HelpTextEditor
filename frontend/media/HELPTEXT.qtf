    },
    "TASK_CONCEPT_ACTIVATE_STEP5": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "TRANSLATIONS": {
        "GERMAN": "Eine Liste der im QAPP-Paket enthaltenen Anwendungen wird angezeigt.",
        "ENGLISH": "",
        "FRENCH": "",
        "CHINESE": "",
        "RUSSIAN": "",
        "SPANISH": "",
        "ITALIAN": "",
        "JAPANESE": "",
        "KOREAN": ""
      },
      "AUTOTRANSLATIONS": {},
      "VERIFIED": {}
    },
    "TASK_CONCEPT_ACTIVATE_STEP6": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "TRANSLATIONS": {
        "GERMAN": "Wenn das ausgewählte QAPP-Paket mit allen enthaltenen Anwendungen freigeschaltet werden soll:",
        "ENGLISH": "",
        "FRENCH": "",
        "CHINESE": "",
        "RUSSIAN": "",
        "SPANISH": "",
        "ITALIAN": "",
        "JAPANESE": "",
        "KOREAN": ""
      },
      "AUTOTRANSLATIONS": {},
      "VERIFIED": {}
    },
    "TASK_CONCEPT_PARAMETER_TITLE1_BULLET_ENUMERATION_vsaqghws01": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "TRANSLATIONS": {
        "GERMAN": "TASK_CONCEPT_PARAMETER_TITLE1_BULLET_ENUMERATION_vsaqghws01",
        "ENGLISH": "",
        "FRENCH": "",
        "CHINESE": "",
        "RUSSIAN": "",
        "SPANISH": "",
        "ITALIAN": "",
        "JAPANESE": "",
