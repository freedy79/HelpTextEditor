    "EXAMPLE_CREATE_NETWORK_USER_TITLE": {
      "group": "HELP_TITLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Example for creating network user",
        "GERMAN": "Beispiel für Netzwerk-Benutzer anlegen",
        "RUSSIAN": "Пример создания сетевого пользователя",
        "FRENCH": "Exemple de création d'un utilisateur réseau",
        "SPANISH": "Ejemplo de creación de un usuario de red",
        "ITALIAN": "Esempio di creazione di un utente di rete",
        "CHINESE": "创建网络用户示例"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Пример создания сетевого пользователя",
        "FRENCH": "Exemple de création d'un utilisateur réseau",
        "SPANISH": "Ejemplo de creación de un usuario de red",
        "ITALIAN": "Esempio di creazione di un utente di rete",
        "CHINESE": "创建网络用户示例"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "EXAMPLE_CREATE_NETWORK_USER_INSTRUCTION": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "In this example, a new user is to be created, whose login data username and password are fetched from an LDAP server in the network. The user is given a role available in the balance.",
        "GERMAN": "In diesem Beispiel soll ein neuer Benutzer angelegt werden, dessen Anmeldungsdaten Benutzername und Passwort von einem LDAP Server im Netzwerk geholt werden. Der Benutzer bekommt eine auf der Waage vorhandene Rolle.",
        "RUSSIAN": "В данном примере необходимо создать нового пользователя, имя пользователя и пароль которого получены с LDAP-сервера в сети. Пользователю присваивается роль, доступная в весах.",
        "FRENCH": "Dans cet exemple, il s'agit de créer un nouvel utilisateur, dont les données de connexion (nom d'utilisateur et mot de passe) sont récupérées sur un serveur LDAP du réseau. L'utilisateur se voit attribuer un rôle disponible dans la balance.",
        "SPANISH": "En este ejemplo, se va a crear un nuevo usuario, cuyos datos de acceso, nombre de usuario y contraseña, se obtienen de un servidor LDAP de la red. Al usuario se le asigna un rol disponible en la balanza.",
        "ITALIAN": "In questo esempio, un nuovo utente deve essere creato, i cui dati di login, nome utente e password, sono recuperati da un server LDAP nella rete. All'utente viene dato un ruolo disponibile nel bilancio.",
        "CHINESE": "在本例中，要创建一个新用户，其登录数据用户名和密码是从网络中的 LDAP 服务器获取的。该用户被赋予余额中的一个可用角色。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "В данном примере необходимо создать нового пользователя, имя пользователя и пароль которого получены с LDAP-сервера в сети. Пользователю присваивается роль, доступная в весах.",
        "FRENCH": "Dans cet exemple, il s'agit de créer un nouvel utilisateur, dont les données de connexion (nom d'utilisateur et mot de passe) sont récupérées sur un serveur LDAP du réseau. L'utilisateur se voit attribuer un rôle disponible dans la balance.",
        "SPANISH": "En este ejemplo, se va a crear un nuevo usuario, cuyos datos de acceso, nombre de usuario y contraseña, se obtienen de un servidor LDAP de la red. Al usuario se le asigna un rol disponible en la balanza.",
        "ITALIAN": "In questo esempio, un nuovo utente deve essere creato, i cui dati di login, nome utente e password, sono recuperati da un server LDAP nella rete. All'utente viene dato un ruolo disponibile nel bilancio.",
        "CHINESE": "在本例中，要创建一个新用户，其登录数据用户名和密码是从网络中的 LDAP 服务器获取的。该用户被赋予余额中的一个可用角色。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
