      "TRANSLATIONS": {
        "ENGLISH": "Cleaning task",
        "GERMAN": "Reinigungs-Task",
        "CHINESE": "清洁任务",
        "FRENCH": "Tâche de nettoyage",
        "SPANISH": "Tarea de limpieza",
        "RUSSIAN": "Задание по уборке",
        "ITALIAN": "Attività di pulizia"
      },
      "AUTOTRANSLATIONS": {
        "CHINESE": "清洁任务",
        "FRENCH": "Tâche de nettoyage",
        "SPANISH": "Tarea de limpieza",
        "RUSSIAN": "Задание по уборке",
        "ITALIAN": "Attività di pulizia"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
