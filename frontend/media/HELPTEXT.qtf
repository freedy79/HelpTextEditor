    "DEVICE_CONCEPT_USAGE_ENUM_1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "<b>Short tap:</b> A short tap on a control element is used to make a selection or trigger an action. This action is used for buttons, icons or menu items.",
        "GERMAN": "<b>Kurzes Antippen:</b> \nTippen Sie kurz auf ein Bedienelement, um eine Auswahl zu treffen oder eine Aktion auszulösen. Diese Aktion gilt für Schaltflächen, Symbole und Menüpunkte. \n\n",
        "FRENCH": "<b>Touche courte:</b> Une touche courte sur un élément de commande est utilisée pour faire une sélection ou déclencher une action. Cette action est souvent utilisée pour les boutons, les icônes ou les éléments de menu.",
        "RUSSIAN": "<b>Короткое нажатие:</b> Короткое нажатие на элемент управления используется для выбора или запуска действия. Это действие используется для кнопок, значков или пунктов меню.\n\n",
        "SPANISH": "<b>Toque corto:</b> Un toque corto en un elemento de control se utiliza para realizar una selección o desencadenar una acción. Esta acción se utiliza para botones, iconos o elementos de menú.\n\n",
        "ITALIAN": "<b>Breve tocco:</b> Un breve tocco su un elemento di controllo viene utilizzato per effettuare una selezione o attivare un'azione. Questa azione viene utilizzata per pulsanti, icone o voci di menu.\n\n",
        "CHINESE": "<b>短按：</b>短按控制元素可用于进行选择或触发操作。该操作用于按钮、图标或菜单项。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "<b>Короткое нажатие:</b> Короткое нажатие на элемент управления используется для выбора или запуска действия. Это действие используется для кнопок, значков или пунктов меню.\n\n",
        "SPANISH": "<b>Toque corto:</b> Un toque corto en un elemento de control se utiliza para realizar una selección o desencadenar una acción. Esta acción se utiliza para botones, iconos o elementos de menú.\n\n",
        "ITALIAN": "<b>Breve tocco:</b> Un breve tocco su un elemento di controllo viene utilizzato per effettuare una selezione o attivare un'azione. Questa azione viene utilizzata per pulsanti, icone o voci di menu.\n\n",
        "CHINESE": "<b>短按：</b>短按控制元素可用于进行选择或触发操作。该操作用于按钮、图标或菜单项。"
      },
      "VERIFIED": {
        "ENGLISH": true,
        "GERMAN": false,
        "FRENCH": false,
        "RUSSIAN": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "DEVICE_CONCEPT_USAGE_ENUM_2": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "<b>Long tap:</b> A long tap can open additional options or a context menu.\nThis interaction is often used for controls that offer advanced functions or settings.",
        "GERMAN": "<b>Langes Antippen:</b> \nTippen Sie lange auf ein Bedienelement, um zusätzliche Optionen oder ein Kontextmenü zu öffnen. Dies ist nur bei Bedienelementen mit erweiterten Funktionen oder Einstellungen möglich.",
        "FRENCH": "<b>Touche longue:</b> Une touche longue peut ouvrir des options supplémentaires ou un menu contextuel.\nCette interaction est souvent utilisée pour les éléments de commande qui offrent des fonctions ou des réglages avancés.",
        "RUSSIAN": "<b>Длинное нажатие: </b> Длинное нажатие может открыть дополнительные параметры или контекстное меню.\nЭтот способ часто используется для элементов управления, предлагающих расширенные функции или настройки.",
        "SPANISH": "<b>Toque prolongado:</b> Un toque prolongado puede abrir opciones adicionales o un menú contextual.\nEsta interacción suele utilizarse para controles que ofrecen funciones o ajustes avanzados.",
        "ITALIAN": "<b>Toccare a lungo:</b> Un tocco prolungato può aprire opzioni aggiuntive o un menu contestuale.\nQuesta interazione è spesso utilizzata per gli elementi di controllo che offrono funzioni o impostazioni avanzate.",
        "CHINESE": "<b>长点：</b>长点可打开其他选项或上下文菜单。\n这种交互方式通常用于提供高级功能或设置的控件。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "<b>Длинное нажатие: </b> Длинное нажатие может открыть дополнительные параметры или контекстное меню.\nЭтот способ часто используется для элементов управления, предлагающих расширенные функции или настройки.",
        "SPANISH": "<b>Toque prolongado:</b> Un toque prolongado puede abrir opciones adicionales o un menú contextual.\nEsta interacción suele utilizarse para controles que ofrecen funciones o ajustes avanzados.",
        "ITALIAN": "<b>Toccare a lungo:</b> Un tocco prolungato può aprire opzioni aggiuntive o un menu contestuale.\nQuesta interazione è spesso utilizzata per gli elementi di controllo che offrono funzioni o impostazioni avanzate.",
        "CHINESE": "<b>长点：</b>长点可打开其他选项或上下文菜单。\n这种交互方式通常用于提供高级功能或设置的控件。"
      },
      "VERIFIED": {
        "ENGLISH": true,
        "GERMAN": false,
        "FRENCH": false,
        "RUSSIAN": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "DEVICE_CONCEPT_USAGE_ENUM_3": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "<b>Swipe:</b> By swiping with your finger, you can scroll through lists, change pages or move elements. This action is useful for scroll bars, galleries or for switching between screens.",
        "GERMAN": "<b>Wischen:</b> Wischen Sie mit dem Finger, um durch Listen zu scrollen, Seiten zu wechseln oder Elemente zu verschieben. ",
        "FRENCH": "<b>Swipe:</b> En balayant avec le doigt, vous pouvez faire défiler des listes, changer de page ou déplacer des éléments. Cette action est utile pour les barres de défilement, les galeries ou pour passer d'un écran à l'autre.",
        "RUSSIAN": "<b>Свип:</b> Вы можете прокручивать списки, менять страницы или перемещать элементы, проводя пальцем. Это действие удобно для полос прокрутки, галерей или для переключения между экранами.",
        "SPANISH": "<b>Deslizar:</b> Puedes desplazarte por listas, cambiar de página o mover elementos deslizando el dedo. Esta acción es útil para barras de desplazamiento, galerías o para pasar de una pantalla a otra.",
        "ITALIAN": "<b>Swipe:</b> È possibile scorrere gli elenchi, cambiare pagina o spostare elementi passando il dito. Questa azione è utile per le barre di scorrimento, le gallerie o per passare da una schermata all'altra.",
        "CHINESE": "<b>轻扫：</b>用手指轻扫，可以滚动列表、更改页面或移动元素。该操作适用于滚动条、图库或在屏幕间切换。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "<b>Свип:</b> Вы можете прокручивать списки, менять страницы или перемещать элементы, проводя пальцем. Это действие удобно для полос прокрутки, галерей или для переключения между экранами.",
        "SPANISH": "<b>Deslizar:</b> Puedes desplazarte por listas, cambiar de página o mover elementos deslizando el dedo. Esta acción es útil para barras de desplazamiento, galerías o para pasar de una pantalla a otra.",
        "ITALIAN": "<b>Swipe:</b> È possibile scorrere gli elenchi, cambiare pagina o spostare elementi passando il dito. Questa azione è utile per le barre di scorrimento, le gallerie o per passare da una schermata all'altra.",
        "CHINESE": "<b>轻扫：</b>用手指轻扫，可以滚动列表、更改页面或移动元素。该操作适用于滚动条、图库或在屏幕间切换。"
      },
      "VERIFIED": {
        "ENGLISH": true,
        "GERMAN": false,
        "FRENCH": false,
        "RUSSIAN": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
