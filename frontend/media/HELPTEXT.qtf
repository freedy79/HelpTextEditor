    "TCA_EXAMPLE_EXPORT_AUDIT_TRAIL_CONF_STEP_3_G": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Give a unique name to the timer-controlled action, such as [My 3 months export audit trail].",
        "GERMAN": "Geben Sie der zeitgesteuerten Aktion einen eindeutigen Namen, z. B. [Mein 3 monatlicher Export Audit Trail].",
        "RUSSIAN": "Дайте уникальное имя действию, управляемому таймером, например, [Мой 3-месячный экспорт аудиторского следа].",
        "FRENCH": "Donnez un nom unique à l'action commandée par minuterie, par exemple [Ma piste d'audit d'exportation de 3 mois].",
        "SPANISH": "Dé un nombre único a la acción controlada por el temporizador, como [Mi pista de auditoría de exportación de 3 meses].",
        "ITALIAN": "Date un nome unico all'azione controllata dal timer, come ad esempio [My 3 months export audit trail].",
        "CHINESE": "为计时器控制的操作命名，如 [我的 3 个月导出审计跟踪]。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Дайте уникальное имя действию, управляемому таймером, например, [Мой 3-месячный экспорт аудиторского следа].",
        "FRENCH": "Donnez un nom unique à l'action commandée par minuterie, par exemple [Ma piste d'audit d'exportation de 3 mois].",
        "SPANISH": "Dé un nombre único a la acción controlada por el temporizador, como [Mi pista de auditoría de exportación de 3 meses].",
        "ITALIAN": "Date un nome unico all'azione controllata dal timer, come ad esempio [My 3 months export audit trail].",
        "CHINESE": "为计时器控制的操作命名，如 [我的 3 个月导出审计跟踪]。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "TCA_EXAMPLE_EXPORT_AUDIT_TRAIL_CONF_STEP_3_H": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Define whether one should be able to cancel the [Action execution] or not.",
        "GERMAN": "Legen Sie fest, dass die [Ausführung der Aktion] nicht abbrechbar sein soll.",
        "RUSSIAN": "Определите, должен ли человек иметь возможность отменить [Выполнение действия] или нет.",
        "FRENCH": "Définir si l'on doit pouvoir annuler l'[exécution de l'action] ou non.",
        "SPANISH": "Definir si se debe poder cancelar la [Ejecución de la acción] o no.",
        "ITALIAN": "Definire se si deve essere in grado di annullare l'[esecuzione dell'azione] o no.",
        "CHINESE": "定义是否可以取消 [动作执行]。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Определите, должен ли человек иметь возможность отменить [Выполнение действия] или нет.",
        "FRENCH": "Définir si l'on doit pouvoir annuler l'[exécution de l'action] ou non.",
        "SPANISH": "Definir si se debe poder cancelar la [Ejecución de la acción] o no.",
        "ITALIAN": "Definire se si deve essere in grado di annullare l'[esecuzione dell'azione] o no.",
        "CHINESE": "定义是否可以取消 [动作执行]。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "TCA_EXAMPLE_EXPORT_AUDIT_TRAIL_CONF_STEP_3_I": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Via [Export to connector], select the connector you have created e.g., [My FTP server for export].",
        "GERMAN": "Wählen Sie über [Export auf Konnektor] Ihren angelegten Konnektor z. B. [Mein FTP Server für Export].",
        "RUSSIAN": "Через [Export to connector] выберите созданный вами коннектор, например, [My FTP server for export].",
        "FRENCH": "Via [Exporter vers le connecteur], sélectionnez le connecteur que vous avez créé, par exemple, [Mon serveur FTP pour l'exportation].",
        "SPANISH": "A través de [Exportar a conector], seleccione el conector que ha creado, por ejemplo, [Mi servidor FTP para exportar].",
        "ITALIAN": "Tramite [Export to connector], seleziona il connettore che hai creato, ad esempio, [My FTP server for export].",
        "CHINESE": "通过 [导出到连接器]，选择您创建的连接器，例如 [用于导出的我的 FTP 服务器]。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Через [Export to connector] выберите созданный вами коннектор, например, [My FTP server for export].",
        "FRENCH": "Via [Exporter vers le connecteur], sélectionnez le connecteur que vous avez créé, par exemple, [Mon serveur FTP pour l'exportation].",
        "SPANISH": "A través de [Exportar a conector], seleccione el conector que ha creado, por ejemplo, [Mi servidor FTP para exportar].",
        "ITALIAN": "Tramite [Export to connector], seleziona il connettore che hai creato, ad esempio, [My FTP server for export].",
        "CHINESE": "通过 [导出到连接器]，选择您创建的连接器，例如 [用于导出的我的 FTP 服务器]。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "TCA_EXAMPLE_EXPORT_AUDIT_TRAIL_CONF_STEP_3_J": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Via [Modules for export], select all or only specific modules, which generate entries in the audit trail and which you want to export.",
        "GERMAN": "Wählen Sie über [Module für Export] alle oder nur bestimme Module aus, die Einträge im Audit Trail erzeugen und die Sie exportiert haben möchten.",
        "RUSSIAN": "Через [Модули для экспорта] выберите все или только определенные модули, которые генерируют записи в журнале аудита и которые вы хотите экспортировать.",
        "FRENCH": "Via [Modules à exporter], sélectionnez tous les modules ou seulement certains d'entre eux, qui génèrent des entrées dans l'audit trail et que vous souhaitez exporter.",
        "SPANISH": "A través de [Módulos para exportar], seleccione todos los módulos, o sólo algunos, que generan entradas en el registro de auditoría y que desea exportar.",
        "ITALIAN": "Tramite [Moduli da esportare], seleziona tutti o solo determinati moduli che generano voci nella traccia di controllo e che vuoi esportare.",
        "CHINESE": "通过[导出模块]，选择在审计跟踪中生成条目并希望导出的所有或特定模块。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Через [Модули для экспорта] выберите все или только определенные модули, которые генерируют записи в журнале аудита и которые вы хотите экспортировать.",
        "FRENCH": "Via [Modules à exporter], sélectionnez tous les modules ou seulement certains d'entre eux, qui génèrent des entrées dans l'audit trail et que vous souhaitez exporter.",
        "SPANISH": "A través de [Módulos para exportar], seleccione todos los módulos, o sólo algunos, que generan entradas en el registro de auditoría y que desea exportar.",
        "ITALIAN": "Tramite [Moduli da esportare], seleziona tutti o solo determinati moduli che generano voci nella traccia di controllo e che vuoi esportare.",
        "CHINESE": "通过[导出模块]，选择在审计跟踪中生成条目并希望导出的所有或特定模块。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "TCA_EXAMPLE_EXPORT_AUDIT_TRAIL_CONF_STEP_3_K": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Confirm your inputs; the timer-controlled action is now created and the time till execution of the action is displayed.",
        "GERMAN": "Bestätigen Sie Ihre Eingaben, die zeitgesteuerte Aktion ist jetzt angelegt und die Zeit bis zur Ausführung der Aktion wird angezeigt.",
        "RUSSIAN": "Подтвердите введенные данные; теперь создано действие, управляемое таймером, и отображается время до выполнения действия.",
        "FRENCH": "Confirmez vos entrées ; l'action commandée par minuterie est maintenant créée et le temps jusqu'à l'exécution de l'action est affiché.",
        "SPANISH": "Confirme sus entradas; ahora se crea la acción controlada por el temporizador y se muestra el tiempo hasta la ejecución de la acción.",
        "ITALIAN": "Confermate i vostri input; l'azione controllata dal timer è ora creata e viene visualizzato il tempo fino all'esecuzione dell'azione.",
        "CHINESE": "确认您的输入；定时器控制的操作现在已创建，并显示了操作执行前的时间。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Подтвердите введенные данные; теперь создано действие, управляемое таймером, и отображается время до выполнения действия.",
        "FRENCH": "Confirmez vos entrées ; l'action commandée par minuterie est maintenant créée et le temps jusqu'à l'exécution de l'action est affiché.",
        "SPANISH": "Confirme sus entradas; ahora se crea la acción controlada por el temporizador y se muestra el tiempo hasta la ejecución de la acción.",
        "ITALIAN": "Confermate i vostri input; l'azione controllata dal timer è ora creata e viene visualizzato il tempo fino all'esecuzione dell'azione.",
        "CHINESE": "确认您的输入；定时器控制的操作现在已创建，并显示了操作执行前的时间。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "TCA_EXAMPLE_EXPORT_AUDIT_TRAIL_CONF_STEP_3_L": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Upon selecting the action, the overview of settings is displayed. You can edit, delete or disable the action.",
        "GERMAN": "Durch das Anwählen der Aktion wird die Übersicht der Einstellungen angezeigt. Sie können die Aktion ändern, löschen oder deaktivieren.",
        "RUSSIAN": "При выборе действия отображается обзор настроек. Вы можете отредактировать, удалить или отключить действие.",
        "FRENCH": "Après avoir sélectionné l'action, la vue d'ensemble des paramètres s'affiche. Vous pouvez modifier, supprimer ou désactiver l'action.",
        "SPANISH": "Al seleccionar la acción, se muestra el resumen de los ajustes. Puede editar, eliminar o desactivar la acción.",
        "ITALIAN": "Selezionando l'azione, viene visualizzata la panoramica delle impostazioni. È possibile modificare, cancellare o disattivare l'azione.",
        "CHINESE": "选择操作后，将显示设置概览。您可以编辑、删除或禁用该操作。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "При выборе действия отображается обзор настроек. Вы можете отредактировать, удалить или отключить действие.",
        "FRENCH": "Après avoir sélectionné l'action, la vue d'ensemble des paramètres s'affiche. Vous pouvez modifier, supprimer ou désactiver l'action.",
        "SPANISH": "Al seleccionar la acción, se muestra el resumen de los ajustes. Puede editar, eliminar o desactivar la acción.",
        "ITALIAN": "Selezionando l'azione, viene visualizzata la panoramica delle impostazioni. È possibile modificare, cancellare o disattivare l'azione.",
        "CHINESE": "选择操作后，将显示设置概览。您可以编辑、删除或禁用该操作。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "TCA_EXAMPLE_EXPORT_AUDIT_TRAIL_CONF_NOTE": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Note: For the time of execution, keep in mind that the balance must be switched on; no execution of this action can be done in the standby mode.",
        "GERMAN": "Anmerkung: Berücksichtigen Sie für den Zeitpunkt der Ausführung, dass die Waage eingeschaltet sein muss, im Standby Modus erfolgt keine Ausführung dieser Aktion.",
        "RUSSIAN": "Примечание: На время выполнения следует помнить, что весы должен быть включены; в режиме ожидания выполнение этого действия невозможно.",
        "FRENCH": "Note : Pour le moment de l'exécution, gardez à l'esprit que la balance doit être allumée ; aucune exécution de cette action ne peut se faire en mode veille.",
        "SPANISH": "Nota: Para el momento de la ejecución, tenga en cuenta que la balanza debe estar encendida; no se puede ejecutar esta acción en el modo de espera.",
        "ITALIAN": "Nota: Per il momento dell'esecuzione, tenete presente che la bilancia deve essere accesa; non è possibile eseguire questa azione in modalità standby.",
        "CHINESE": "注意：在执行时，请记住必须打开天平；在待机模式下无法执行此操作。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Примечание: На время выполнения следует помнить, что весы должен быть включены; в режиме ожидания выполнение этого действия невозможно.",
        "FRENCH": "Note : Pour le moment de l'exécution, gardez à l'esprit que la balance doit être allumée ; aucune exécution de cette action ne peut se faire en mode veille.",
        "SPANISH": "Nota: Para el momento de la ejecución, tenga en cuenta que la balanza debe estar encendida; no se puede ejecutar esta acción en el modo de espera.",
        "ITALIAN": "Nota: Per il momento dell'esecuzione, tenete presente che la bilancia deve essere accesa; non è possibile eseguire questa azione in modalità standby.",
        "CHINESE": "注意：在执行时，请记住必须打开天平；在待机模式下无法执行此操作。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
