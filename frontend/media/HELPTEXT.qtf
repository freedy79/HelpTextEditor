      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Ensure that you have the right to add new hardware to the operating system. (No special driver is required.)",
        "GERMAN": "Vergewissern Sie sich, dass Sie das Recht haben, neue Hardware im Betriebssystem hinzuzufügen. (Es ist kein spezieller Treiber erforderlich).",
        "RUSSIAN": "Убедитесь, что у вас есть право добавлять новое оборудование в операционную систему. (Специальный драйвер не требуется.)",
        "FRENCH": "Assurez-vous que vous avez le droit d'ajouter un nouveau matériel au système d'exploitation. (Aucun pilote spécial n'est requis).",
        "SPANISH": "Asegúrese de que tiene derecho a añadir nuevo hardware al sistema operativo. (No se requiere ningún controlador especial).",
        "ITALIAN": "Assicuratevi di avere il diritto di aggiungere nuovo hardware al sistema operativo. (Non è richiesto alcun driver speciale).",
        "CHINESE": "确保您有权在操作系统中添加新硬件。(无需特殊驱动程序）。",
        "JAPANESE": "新しいハードウェアをオペレーティングシステムに追加する権利があることを確認してください。(特別なドライバは必要ありません）。",
        "KOREAN": "운영 체제에 새 하드웨어를 추가할 수 있는 권한이 있는지 확인합니다. (특별한 드라이버는 필요하지 않습니다.)"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Убедитесь, что у вас есть право добавлять новое оборудование в операционную систему. (Специальный драйвер не требуется.)",
        "FRENCH": "Assurez-vous que vous avez le droit d'ajouter un nouveau matériel au système d'exploitation. (Aucun pilote spécial n'est requis).",
        "SPANISH": "Asegúrese de que tiene derecho a añadir nuevo hardware al sistema operativo. (No se requiere ningún controlador especial).",
        "ITALIAN": "Assicuratevi di avere il diritto di aggiungere nuovo hardware al sistema operativo. (Non è richiesto alcun driver speciale).",
        "CHINESE": "确保您有权在操作系统中添加新硬件。(无需特殊驱动程序）。",
        "JAPANESE": "新しいハードウェアをオペレーティングシステムに追加する権利があることを確認してください。(特別なドライバは必要ありません）。",
        "KOREAN": "운영 체제에 새 하드웨어를 추가할 수 있는 권한이 있는지 확인합니다. (특별한 드라이버는 필요하지 않습니다.)"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
