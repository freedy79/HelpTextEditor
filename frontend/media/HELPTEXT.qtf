    },
    "NETWORK_CERTIFICATES_UPDATE_CA_STEP_4": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "GERMAN": "Navigieren Sie in das entsprechende Menü, für das ein Zertifikat installiert werden soll. Die Unterscheidung und Erläuterung der Zertifikate finden Sie im Kapitel <a href=\"#NETWORK_CERTIFICATES_TYPES\">Zertifikatstypen</a>",
        "ENGLISH": "Navigate to the corresponding menu for which a certificate is to be installed. The differentiation and explanation of the certificates can be found in the chapter <a href=\"#NETWORK_CERTIFICATES_TYPES\">Certificate types</a>",
        "FRENCH": "Naviguez vers le menu correspondant pour lequel un certificat doit être installé. La différenciation et l'explication des certificats se trouvent dans le chapitre <a href=\"#NETWORK_CERTIFICATES_TYPES\">Types de certificats</a>.",
        "SPANISH": "Navegue hasta el menú correspondiente para el que se desea instalar un certificado. La diferenciación y explicación de los certificados se encuentra en el capítulo <a href=\"#NETWORK_CERTIFICATES_TYPES\">Tipos de certificados</a>.",
        "RUSSIAN": "Перейдите в соответствующее меню, для которого необходимо установить сертификат. Различение и объяснение сертификатов можно найти в главе <a href=\"#NETWORK_CERTIFICATES_TYPES\">Типы сертификатов</a>.",
        "ITALIAN": "Navigare nel menu corrispondente per il quale si vuole installare un certificato. La differenziazione e la spiegazione dei certificati si trovano nel capitolo <a href=\"#NETWORK_CERTIFICATES_TYPES\">Tipi di certificati</a>.",
        "CHINESE": "导航至要安装证书的相应菜单。关于证书的区别和解释，请参阅<a href=\"#NETWORK_CERTIFICATES_TYPES\">证书类型</a>一章。"
      },
      "AUTOTRANSLATIONS": {
        "ENGLISH": "Navigate to the corresponding menu for which a certificate is to be installed. The differentiation and explanation of the certificates can be found in the chapter <a href=\"#NETWORK_CERTIFICATES_TYPES\">Certificate types</a>",
        "FRENCH": "Naviguez vers le menu correspondant pour lequel un certificat doit être installé. La différenciation et l'explication des certificats se trouvent dans le chapitre <a href=\"#NETWORK_CERTIFICATES_TYPES\">Types de certificats</a>.",
        "SPANISH": "Navegue hasta el menú correspondiente para el que se desea instalar un certificado. La diferenciación y explicación de los certificados se encuentra en el capítulo <a href=\"#NETWORK_CERTIFICATES_TYPES\">Tipos de certificados</a>.",
        "RUSSIAN": "Перейдите в соответствующее меню, для которого необходимо установить сертификат. Различение и объяснение сертификатов можно найти в главе <a href=\"#NETWORK_CERTIFICATES_TYPES\">Типы сертификатов</a>.",
        "ITALIAN": "Navigare nel menu corrispondente per il quale si vuole installare un certificato. La differenziazione e la spiegazione dei certificati si trovano nel capitolo <a href=\"#NETWORK_CERTIFICATES_TYPES\">Tipi di certificati</a>.",
        "CHINESE": "导航至要安装证书的相应菜单。关于证书的区别和解释，请参阅<a href=\"#NETWORK_CERTIFICATES_TYPES\">证书类型</a>一章。"
      },
      "VERIFIED": {
        "GERMAN": false,
        "ENGLISH": false,
        "FRENCH": false,
        "SPANISH": false,
        "RUSSIAN": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "NETWORK_CERTIFICATES_UPDATE_CA_STEP_5": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "GERMAN": "Betätigen Sie die Schaltfläche [IMPORT] und wählen den entsprechenden Konnektor, über den die zu installierenden Zertifikatsdateien erreichbar sind.",
        "ENGLISH": "Press the [IMPORT] button and select the corresponding connector via which the certificate files to be installed can be accessed.",
        "FRENCH": "Appuyez sur la touche [IMPORT] et sélectionnez le connecteur correspondant permettant d'accéder aux fichiers de certificat à installer.",
        "SPANISH": "Pulse el botón [IMPORTAR] y seleccione el conector correspondiente a través del cual se puede acceder a los archivos de certificado que se van a instalar.",
        "RUSSIAN": "Нажмите кнопку [IMPORT] и выберите соответствующий разъем, через который можно получить доступ к устанавливаемым файлам сертификатов.",
        "ITALIAN": "Premere il pulsante [IMPORT] e selezionare il connettore corrispondente tramite il quale è possibile accedere ai file di certificato da installare.",
        "CHINESE": "按下 [IMPORT] 按钮并选择相应的连接器，通过该连接器可以访问要安装的证书文件。"
      },
      "AUTOTRANSLATIONS": {
        "ENGLISH": "Press the [IMPORT] button and select the corresponding connector via which the certificate files to be installed can be accessed.",
        "FRENCH": "Appuyez sur la touche [IMPORT] et sélectionnez le connecteur correspondant permettant d'accéder aux fichiers de certificat à installer.",
        "SPANISH": "Pulse el botón [IMPORTAR] y seleccione el conector correspondiente a través del cual se puede acceder a los archivos de certificado que se van a instalar.",
        "RUSSIAN": "Нажмите кнопку [IMPORT] и выберите соответствующий разъем, через который можно получить доступ к устанавливаемым файлам сертификатов.",
        "ITALIAN": "Premere il pulsante [IMPORT] e selezionare il connettore corrispondente tramite il quale è possibile accedere ai file di certificato da installare.",
        "CHINESE": "按下 [IMPORT] 按钮并选择相应的连接器，通过该连接器可以访问要安装的证书文件。"
      },
      "VERIFIED": {
        "GERMAN": false,
        "ENGLISH": false,
        "FRENCH": false,
        "SPANISH": false,
        "RUSSIAN": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "NETWORK_CERTIFICATES_UPDATE_CA_STEP_6": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "GERMAN": "Selektieren Sie die Zertifikatsdatei aus der Liste der über den Konnektor verfügbaren Dateien. Folgende Formate werden unterstützt: <b>.pem</b> und <b>.crt</b>",
        "ENGLISH": "Select the certificate file from the list of files available via the connector. The following formats are supported: <b>.pem</b> and <b>.crt</b>",
        "FRENCH": "Sélectionnez le fichier de certificat dans la liste des fichiers disponibles via le connecteur. Les formats suivants sont pris en charge : <b>.pem</b> et <b>.crt</b>",
        "SPANISH": "Seleccione el archivo de certificado de la lista de archivos disponibles a través del conector. Se admiten los siguientes formatos: <b>.pem</b> y <b>.crt</b>.",
        "RUSSIAN": "Выберите файл сертификата из списка файлов, доступных через коннектор. Поддерживаются следующие форматы: <b>.pem</b> и <b>.crt</b>.",
        "ITALIAN": "Selezionare il file del certificato dall'elenco dei file disponibili tramite il connettore. Sono supportati i seguenti formati: <b>.pem</b> e <b>.crt</b>.",
        "CHINESE": "从可通过连接器获取的文件列表中选择证书文件。支持以下格式：<b>.pem</b>和<b>.crt</b"
      },
      "AUTOTRANSLATIONS": {
        "ENGLISH": "Select the certificate file from the list of files available via the connector. The following formats are supported: <b>.pem</b> and <b>.crt</b>",
        "FRENCH": "Sélectionnez le fichier de certificat dans la liste des fichiers disponibles via le connecteur. Les formats suivants sont pris en charge : <b>.pem</b> et <b>.crt</b>",
        "SPANISH": "Seleccione el archivo de certificado de la lista de archivos disponibles a través del conector. Se admiten los siguientes formatos: <b>.pem</b> y <b>.crt</b>.",
        "RUSSIAN": "Выберите файл сертификата из списка файлов, доступных через коннектор. Поддерживаются следующие форматы: <b>.pem</b> и <b>.crt</b>.",
        "ITALIAN": "Selezionare il file del certificato dall'elenco dei file disponibili tramite il connettore. Sono supportati i seguenti formati: <b>.pem</b> e <b>.crt</b>.",
        "CHINESE": "从可通过连接器获取的文件列表中选择证书文件。支持以下格式：<b>.pem</b>和<b>.crt</b"
      },
      "VERIFIED": {
        "GERMAN": false,
        "ENGLISH": false,
        "FRENCH": false,
        "SPANISH": false,
        "RUSSIAN": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
