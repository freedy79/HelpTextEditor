      "TRANSLATIONS": {
        "ENGLISH": "Configuration item",
        "GERMAN": "Konfigurationselement",
        "RUSSIAN": "Элемент конфигурации",
        "FRENCH": "Élément de configuration",
        "SPANISH": "Elemento de configuración",
