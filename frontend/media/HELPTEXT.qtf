    "DEVICE_MAINTENANCE_IMPORTEXPORT_EXCEPTIONS": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
