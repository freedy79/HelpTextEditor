      "TRANSLATIONS": {
        "ENGLISH": "Role management",
        "GERMAN": "Rollenverwaltung",
        "RUSSIAN": "Управление ролями",
        "FRENCH": "Gestion des rôles",
        "SPANISH": "Gestión de funciones",
        "ITALIAN": "Gestione dei ruoli",
        "CHINESE": "角色管理"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Управление ролями",
        "FRENCH": "Gestion des rôles",
        "SPANISH": "Gestión de funciones",
        "ITALIAN": "Gestione dei ruoli",
        "CHINESE": "角色管理"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
