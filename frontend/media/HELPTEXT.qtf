    "VIEW_AUDIT_TRAIL_VIA_BROWSER_APPL_STEP_7": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "You can now sort the list of entries according to ID, timestamp and user.",
        "GERMAN": "Sie können jetzt die Liste der Einträge sortieren nach ID, Zeitstempel und Benutzer.",
        "RUSSIAN": "Теперь вы можете сортировать список записей по ID, метке времени и пользователю.",
        "FRENCH": "Vous pouvez maintenant trier la liste des entrées selon l'ID, l'horodatage et l'utilisateur.",
        "SPANISH": "Ahora puede ordenar la lista de entradas según el ID, la marca de tiempo y el usuario.",
        "ITALIAN": "Ora è possibile ordinare l'elenco delle voci in base a ID, timestamp e utente.",
        "CHINESE": "现在，您可以根据 ID、时间戳和用户对条目列表进行排序。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Теперь вы можете сортировать список записей по ID, метке времени и пользователю.",
        "FRENCH": "Vous pouvez maintenant trier la liste des entrées selon l'ID, l'horodatage et l'utilisateur.",
        "SPANISH": "Ahora puede ordenar la lista de entradas según el ID, la marca de tiempo y el usuario.",
        "ITALIAN": "Ora è possibile ordinare l'elenco delle voci in base a ID, timestamp e utente.",
        "CHINESE": "现在，您可以根据 ID、时间戳和用户对条目列表进行排序。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "VIEW_AUDIT_TRAIL_VIA_BROWSER_APPL_STEP_8": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The list of entries can be displayed in ascending or descending order.",
        "GERMAN": "Die Liste der Einträge kann auf- oder absteigend angezeigt werden.",
        "RUSSIAN": "Список записей можно отобразить в порядке возрастания или убывания.",
        "FRENCH": "La liste des entrées peut être affichée par ordre croissant ou décroissant.",
        "SPANISH": "La lista de entradas puede mostrarse en orden ascendente o descendente.",
        "ITALIAN": "L'elenco delle voci può essere visualizzato in ordine crescente o decrescente.",
        "CHINESE": "条目列表可以升序或降序显示。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Список записей можно отобразить в порядке возрастания или убывания.",
        "FRENCH": "La liste des entrées peut être affichée par ordre croissant ou décroissant.",
        "SPANISH": "La lista de entradas puede mostrarse en orden ascendente o descendente.",
        "ITALIAN": "L'elenco delle voci può essere visualizzato in ordine crescente o decrescente.",
        "CHINESE": "条目列表可以升序或降序显示。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
