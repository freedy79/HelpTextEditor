      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Ensure that the [Num] key on your PC keyboard has been activated.",
        "GERMAN": "Stellen Sie sicher, dass die [Num]-Taste auf Ihrer PC-Tastatur aktiviert ist.",
        "RUSSIAN": "Убедитесь, что клавиша [Num] на клавиатуре компьютера активирована.",
        "FRENCH": "Assurez-vous que la touche [Num] du clavier de votre PC est activée.",
        "SPANISH": "Asegúrese de que la tecla [Num] del teclado de su PC esté activada.",
        "ITALIAN": "Assicuratevi che il tasto [Num] sulla tastiera del PC sia stato attivato.",
        "CHINESE": "确保电脑键盘上的 [Num] 键已激活。",
        "JAPANESE": "PCキーボードの[Num]キーが有効になっていることを確認してください。",
        "KOREAN": "PC 키보드의 [숫자] 키가 활성화되어 있는지 확인합니다."
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Убедитесь, что клавиша [Num] на клавиатуре компьютера активирована.",
        "FRENCH": "Assurez-vous que la touche [Num] du clavier de votre PC est activée.",
        "SPANISH": "Asegúrese de que la tecla [Num] del teclado de su PC esté activada.",
        "ITALIAN": "Assicuratevi che il tasto [Num] sulla tastiera del PC sia stato attivato.",
        "CHINESE": "确保电脑键盘上的 [Num] 键已激活。",
        "JAPANESE": "PCキーボードの[Num]キーが有効になっていることを確認してください。",
        "KOREAN": "PC 키보드의 [숫자] 키가 활성화되어 있는지 확인합니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_PC_DIRECT_APPL_STEP_3": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
