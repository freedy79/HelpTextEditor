    "PRINT_GLP_CVS_SMB_ERROR_STEP_6": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "If this results in a [Transfer failure] message, you can retry the print job now, retry it later, redirect it, or delete it.",
        "GERMAN": "Falls es zu Fehlermeldung [Übertragungsfehler] kommt, dann können Sie den Druckauftrag, wiederholen, später wiederholen, umleiten oder löschen.",
        "FRENCH": "Si le message [Échec du transfert] apparaît, vous pouvez relancer la tâche d'impression maintenant, la relancer plus tard, la rediriger ou la supprimer.",
        "RUSSIAN": "Если в результате появится сообщение [Transfer failure], вы можете повторить задание печати сейчас, повторить его позже, перенаправить его или удалить.",
        "SPANISH": "Si esto resulta en un mensaje de [Fallo de transferencia], puede reintentar el trabajo de impresión ahora, reintentarlo más tarde, redirigirlo o eliminarlo.",
        "ITALIAN": "Se questo risulta in un messaggio [Transfer failure], potete riprovare il lavoro di stampa ora, riprovare più tardi, reindirizzarlo o cancellarlo.",
        "CHINESE": "如果出现 [ 传输失败 ] 消息，您可以现在重试打印任务、稍后重试、重定向或删除。",
        "JAPANESE": "この結果[転送失敗]メッセージが表示された場合、印刷ジョブを今すぐ再試行するか、後で再試行するか、リダイレクトするか、削除することができます。",
        "KOREAN": "전송 실패] 메시지가 표시되면 지금 인쇄 작업을 다시 시도하거나, 나중에 다시 시도하거나, 리디렉션하거나, 삭제할 수 있습니다."
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Si le message [Échec du transfert] apparaît, vous pouvez relancer la tâche d'impression maintenant, la relancer plus tard, la rediriger ou la supprimer.",
        "RUSSIAN": "Если в результате появится сообщение [Transfer failure], вы можете повторить задание печати сейчас, повторить его позже, перенаправить его или удалить.",
        "SPANISH": "Si esto resulta en un mensaje de [Fallo de transferencia], puede reintentar el trabajo de impresión ahora, reintentarlo más tarde, redirigirlo o eliminarlo.",
        "ITALIAN": "Se questo risulta in un messaggio [Transfer failure], potete riprovare il lavoro di stampa ora, riprovare più tardi, reindirizzarlo o cancellarlo.",
        "CHINESE": "如果出现 [ 传输失败 ] 消息，您可以现在重试打印任务、稍后重试、重定向或删除。",
        "JAPANESE": "この結果[転送失敗]メッセージが表示された場合、印刷ジョブを今すぐ再試行するか、後で再試行するか、リダイレクトするか、削除することができます。",
        "KOREAN": "전송 실패] 메시지가 표시되면 지금 인쇄 작업을 다시 시도하거나, 나중에 다시 시도하거나, 리디렉션하거나, 삭제할 수 있습니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
        "RUSSIAN": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_GLP_CVS_SMB_ERROR_STEP_6_A": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Retry: The print job will again be sent to the SMB file server.",
        "GERMAN": "Wiederholen: Die Ausgabe vom Druckauftrag zum SMB File Server erfolgt erneut.",
        "FRENCH": "Retenter : La tâche d'impression sera à nouveau envoyée au serveur de fichiers SMB.",
        "RUSSIAN": "Повторная попытка: Задание печати будет снова отправлено на файловый сервер SMB.",
        "SPANISH": "Reintentar: El trabajo de impresión se enviará de nuevo al servidor de archivos SMB.",
        "ITALIAN": "Riprova: Il lavoro di stampa sarà nuovamente inviato al file server SMB.",
        "CHINESE": "重试：打印任务将再次发送到 SMB 文件服务器。",
        "JAPANESE": "再試行：印刷ジョブは再びSMBファイルサーバーに送信されます。",
        "KOREAN": "다시 시도합니다: 인쇄 작업이 다시 SMB 파일 서버로 전송됩니다."
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Retenter : La tâche d'impression sera à nouveau envoyée au serveur de fichiers SMB.",
        "RUSSIAN": "Повторная попытка: Задание печати будет снова отправлено на файловый сервер SMB.",
        "SPANISH": "Reintentar: El trabajo de impresión se enviará de nuevo al servidor de archivos SMB.",
        "ITALIAN": "Riprova: Il lavoro di stampa sarà nuovamente inviato al file server SMB.",
        "CHINESE": "重试：打印任务将再次发送到 SMB 文件服务器。",
        "JAPANESE": "再試行：印刷ジョブは再びSMBファイルサーバーに送信されます。",
        "KOREAN": "다시 시도합니다: 인쇄 작업이 다시 SMB 파일 서버로 전송됩니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
        "RUSSIAN": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_GLP_CVS_SMB_ERROR_STEP_6_B": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Retry later: The print job will be automatically repeated. Outstanding transfers are displayed in the [Status center] under [Duplicate messages].",
        "GERMAN": "Später wiederholen: Die Ausgabe vom Druckauftrag wird automatisch wiederholt. Im [Status-Center] unter [Nachrichten] werden die ausstehenden Übertragungen angezeigt.",
        "FRENCH": "Réessayer plus tard : Le travail d'impression sera automatiquement répété. Les transferts en attente sont affichés dans le [Centre d'état] sous [Messages en double].",
        "RUSSIAN": "Повторить позже: Задание печати будет автоматически повторено. Незавершенные передачи отображаются в [Центре состояния] в разделе [Дублированные сообщения].",
        "SPANISH": "Reintentar más tarde: El trabajo de impresión se repetirá automáticamente. Las transferencias pendientes se muestran en el [Centro de estado] en [Mensajes duplicados].",
        "ITALIAN": "Riprovare più tardi: Il lavoro di stampa viene ripetuto automaticamente. I trasferimenti in sospeso vengono visualizzati nel [Centro di stato] sotto [Messaggi duplicati].",
        "CHINESE": "稍后重试：打印任务将自动重复。未完成的传输会显示在 [状态中心] 的 [重复信息] 下。",
        "JAPANESE": "後で再試行する：印刷ジョブは自動的に繰り返されます。未処理の転送は、[ステータスセンター]の[重複メッセージ]に表示されます。",
        "KOREAN": "나중에 다시 시도합니다: 인쇄 작업이 자동으로 반복됩니다. 미처리 전송은 [상태 센터]의 [중복 메시지] 아래에 표시됩니다."
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Réessayer plus tard : Le travail d'impression sera automatiquement répété. Les transferts en attente sont affichés dans le [Centre d'état] sous [Messages en double].",
        "RUSSIAN": "Повторить позже: Задание печати будет автоматически повторено. Незавершенные передачи отображаются в [Центре состояния] в разделе [Дублированные сообщения].",
        "SPANISH": "Reintentar más tarde: El trabajo de impresión se repetirá automáticamente. Las transferencias pendientes se muestran en el [Centro de estado] en [Mensajes duplicados].",
        "ITALIAN": "Riprovare più tardi: Il lavoro di stampa viene ripetuto automaticamente. I trasferimenti in sospeso vengono visualizzati nel [Centro di stato] sotto [Messaggi duplicati].",
        "CHINESE": "稍后重试：打印任务将自动重复。未完成的传输会显示在 [状态中心] 的 [重复信息] 下。",
        "JAPANESE": "後で再試行する：印刷ジョブは自動的に繰り返されます。未処理の転送は、[ステータスセンター]の[重複メッセージ]に表示されます。",
        "KOREAN": "나중에 다시 시도합니다: 인쇄 작업이 자동으로 반복됩니다. 미처리 전송은 [상태 센터]의 [중복 메시지] 아래에 표시됩니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
        "RUSSIAN": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_GLP_CVS_SMB_ERROR_STEP_6_C": {
      "group": "HELP_EXAMPLE",
