      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Default user",
        "GERMAN": "Vorgegebene Benutzer",
        "RUSSIAN": "Пользователь по умолчанию",
        "FRENCH": "Utilisateur par défaut",
        "SPANISH": "Usuario por defecto",
        "ITALIAN": "Utente predefinito",
        "CHINESE": "默认用户",
        "JAPANESE": "デフォルトユーザー",
        "KOREAN": "기본 사용자"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Пользователь по умолчанию",
        "FRENCH": "Utilisateur par défaut",
        "SPANISH": "Usuario por defecto",
        "ITALIAN": "Utente predefinito",
        "CHINESE": "默认用户",
        "JAPANESE": "デフォルトユーザー",
        "KOREAN": "기본 사용자"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
