    "ISOCAL_EXEC_MODE_INSTRUCTION_3_STEP_1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The balance is loaded with less than 2 % of the maximum load (Max).",
        "GERMAN": "Die Waage ist mit weniger als 2 % der Höchstlast (Max) belastet.",
        "RUSSIAN": "весы нагружены менее чем на 2 % от максимальной нагрузки (Max).",
        "FRENCH": "La balance est chargée avec moins de 2 % de la charge maximale (Max).",
        "SPANISH": "La balanza está cargada con menos del 2 % de la carga máxima (Max).",
        "ITALIAN": "La bilancia è caricata con meno del 2 % del carico massimo (Max).",
        "CHINESE": "天平的负载小于最大负载 (Max) 的 2%。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "весы нагружены менее чем на 2 % от максимальной нагрузки (Max).",
        "FRENCH": "La balance est chargée avec moins de 2 % de la charge maximale (Max).",
        "SPANISH": "La balanza está cargada con menos del 2 % de la carga máxima (Max).",
        "ITALIAN": "La bilancia è caricata con meno del 2 % del carico massimo (Max).",
        "CHINESE": "天平的负载小于最大负载 (Max) 的 2%。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "ISOCAL_EXEC_MODE_INSTRUCTION_3_STEP_2": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The balance has not been used for more than 2 minutes, i.e., there has been no load change and no operation of the balance.",
        "GERMAN": "Die Waage ist länger als 2 Minuten nicht benutzt worden, d. h. es ist keine Lastwechsel und keine Bedienung der Waage erfolgt.",
        "RUSSIAN": "весы не использовались дольше 2 минут, т.е. не было изменения нагрузки и эксплуатации весов.",
        "FRENCH": "La balance n'a pas été utilisée pendant plus de 2 minutes, c'est-à-dire qu'il n'y a pas eu de changement de charge ni de fonctionnement de la balance.",
        "SPANISH": "La balanza no se ha utilizado durante más de 2 minutos, es decir, no se ha producido ningún cambio de carga ni se ha hecho funcionar la balanza.",
        "ITALIAN": "La bilancia non è stata usata per più di 2 minuti, cioè non c'è stato nessun cambio di carico e nessun funzionamento della bilancia.",
        "CHINESE": "天平使用时间不超过 2 分钟，即没有负载变化，也没有操作天平。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "весы не использовались дольше 2 минут, т.е. не было изменения нагрузки и эксплуатации весов.",
        "FRENCH": "La balance n'a pas été utilisée pendant plus de 2 minutes, c'est-à-dire qu'il n'y a pas eu de changement de charge ni de fonctionnement de la balance.",
        "SPANISH": "La balanza no se ha utilizado durante más de 2 minutos, es decir, no se ha producido ningún cambio de carga ni se ha hecho funcionar la balanza.",
        "ITALIAN": "La bilancia non è stata usata per più di 2 minuti, cioè non c'è stato nessun cambio di carico e nessun funzionamento della bilancia.",
        "CHINESE": "天平使用时间不超过 2 分钟，即没有负载变化，也没有操作天平。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "ISOCAL_EXEC_MODE_INSTRUCTION_4": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The automatic execution is announced with a message. If the balance is used during this time, then there is no execution and the prerequisites are checked again.",
        "GERMAN": "Die automatische Ausführung wird mit einer Meldung vorangekündigt. Wird die Waage während dieser Zeit bedient, dann kommt es nicht zu einer Ausführung und die Prüfung der Voraussetzungen erfolgt erneut.",
        "RUSSIAN": "Начало автоматического выполнения предупреждается сообщением. Если в течение этого времени весы находятся в эксплуатации (работа с кнопками на дисплее), то исполнение не происходит, а предпосылки проверяются снова.",
        "FRENCH": "L'exécution automatique est annoncée par un message. Si le solde est utilisé pendant cette période, il n'y a pas d'exécution et les conditions préalables sont à nouveau vérifiées.",
        "SPANISH": "La ejecución automática se anuncia con un mensaje. Si se utiliza el saldo durante este tiempo, entonces no hay ejecución y se vuelven a comprobar los requisitos previos.",
        "ITALIAN": "L'esecuzione automatica viene annunciata con un messaggio. Se il saldo viene usato durante questo tempo, allora non c'è esecuzione e i prerequisiti vengono controllati di nuovo.",
        "CHINESE": "自动执行时会有提示信息。如果在此期间使用了余额，则不执行，并再次检查先决条件。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Начало автоматического выполнения предупреждается сообщением. Если в течение этого времени весы находятся в эксплуатации (работа с кнопками на дисплее), то исполнение не происходит, а предпосылки проверяются снова.",
        "FRENCH": "L'exécution automatique est annoncée par un message. Si le solde est utilisé pendant cette période, il n'y a pas d'exécution et les conditions préalables sont à nouveau vérifiées.",
        "SPANISH": "La ejecución automática se anuncia con un mensaje. Si se utiliza el saldo durante este tiempo, entonces no hay ejecución y se vuelven a comprobar los requisitos previos.",
        "ITALIAN": "L'esecuzione automatica viene annunciata con un messaggio. Se il saldo viene usato durante questo tempo, allora non c'è esecuzione e i prerequisiti vengono controllati di nuovo.",
        "CHINESE": "自动执行时会有提示信息。如果在此期间使用了余额，则不执行，并再次检查先决条件。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "ISOCAL_EXEC_MODE_INSTRUCTION_5": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ]. Do not translate isoCAL.",
      "locked": false,
