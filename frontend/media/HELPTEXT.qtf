        "RUSSIAN": "См. также главу: <a href=\"#EXAMPLE_CREATE_NEW_ROLE\">Пример создания новой роли</a>.",
        "FRENCH": "Voir également le chapitre : <a href=\"#EXAMPLE_CREATE_NEW_ROLE\">Exemple de création d'un nouveau rôle</a>.",
        "SPANISH": "Ver también el capítulo: <a href=\"#EXAMPLE_CREATE_NEW_ROLE\">Ejemplo de creación de un nuevo rol</a>.",
        "ITALIAN": "Vedere anche il capitolo: <a href=\"#EXAMPLE_CREATE_NEW_ROLE\">Esempio per creare un nuovo ruolo</a>.",
        "CHINESE": "另请参阅本章：<a href=\"#EXAMPLE_CREATE_NEW_ROLE\">创建新角色的示例</a>。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "См. также главу: <a href=\"#EXAMPLE_CREATE_NEW_ROLE\">Пример создания новой роли</a>.",
        "FRENCH": "Voir également le chapitre : <a href=\"#EXAMPLE_CREATE_NEW_ROLE\">Exemple de création d'un nouveau rôle</a>.",
        "SPANISH": "Ver también el capítulo: <a href=\"#EXAMPLE_CREATE_NEW_ROLE\">Ejemplo de creación de un nuevo rol</a>.",
        "ITALIAN": "Vedere anche il capitolo: <a href=\"#EXAMPLE_CREATE_NEW_ROLE\">Esempio per creare un nuovo ruolo</a>.",
        "CHINESE": "另请参阅本章：<a href=\"#EXAMPLE_CREATE_NEW_ROLE\">创建新角色的示例</a>。"
      },
      "VERIFIED": {
