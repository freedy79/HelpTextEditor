    "ASCII_LONG": {
      "group": "HELP_ABBR_LONG",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The American standard code for information exchange is a 7-bit character encoding system.",
        "GERMAN": "Der Amerikanischer Standard-Code für den Informationsaustausch ist eine 7-Bit-Zeichenkodierung.",
        "RUSSIAN": "Американский стандартный код для обмена информацией представляет собой 7-битную систему кодирования символов.",
        "FRENCH": "Le code standard américain pour l'échange d'informations est un système de codage des caractères sur 7 bits.",
        "SPANISH": "El código estándar americano para el intercambio de información es un sistema de codificación de caracteres de 7 bits.",
        "ITALIAN": "Il codice standard americano per lo scambio di informazioni è un sistema di codifica dei caratteri a 7 bit.",
        "CHINESE": "用于信息交换的美国标准代码是一种 7 位字符编码系统。",
        "JAPANESE": "情報交換のためのアメリカの標準コードは、7ビットの文字符号化システムである。",
        "KOREAN": "정보 교환을 위한 미국 표준 코드는 7비트 문자 인코딩 시스템입니다."
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Американский стандартный код для обмена информацией представляет собой 7-битную систему кодирования символов.",
        "FRENCH": "Le code standard américain pour l'échange d'informations est un système de codage des caractères sur 7 bits.",
        "SPANISH": "El código estándar americano para el intercambio de información es un sistema de codificación de caracteres de 7 bits.",
        "ITALIAN": "Il codice standard americano per lo scambio di informazioni è un sistema di codifica dei caratteri a 7 bit.",
        "CHINESE": "用于信息交换的美国标准代码是一种 7 位字符编码系统。",
        "JAPANESE": "情報交換のためのアメリカの標準コードは、7ビットの文字符号化システムである。",
        "KOREAN": "정보 교환을 위한 미국 표준 코드는 7비트 문자 인코딩 시스템입니다."
      },
      "VERIFIED": {
