    "EXAMPLE_CHANGE_USER_SETTINGS_CONF_STEP_1": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Edit the settings of the specified user e.g., [Administrator].",
        "GERMAN": "Ändern Sie die Einstellungen vom vorgegebenen Benutzer z. B. [Administrator].",
        "RUSSIAN": "Редактирование настроек указанного пользователя, например, [Администратор].",
        "FRENCH": "Modifiez les paramètres de l'utilisateur spécifié, par exemple, [Administrateur].",
        "SPANISH": "Editar la configuración del usuario especificado, por ejemplo, [Administrador].",
        "ITALIAN": "Modifica le impostazioni dell'utente specificato, ad esempio, [Administrator].",
        "CHINESE": "编辑指定用户的设置，例如 [管理员]。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Редактирование настроек указанного пользователя, например, [Администратор].",
        "FRENCH": "Modifiez les paramètres de l'utilisateur spécifié, par exemple, [Administrateur].",
        "SPANISH": "Editar la configuración del usuario especificado, por ejemplo, [Administrador].",
        "ITALIAN": "Modifica le impostazioni dell'utente specificato, ad esempio, [Administrator].",
        "CHINESE": "编辑指定用户的设置，例如 [管理员]。"
      },
      "VERIFIED": {
