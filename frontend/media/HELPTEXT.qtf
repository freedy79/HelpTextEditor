    "TASK_CONCEPT_QAPP_CENTER_INSTRUCTION_1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "TRANSLATIONS": {
        "GERMAN": "Die Anwendungen der Waage (QAPPs) sind im QAPP-Center in verschiedenen Paketen zusammengefasst. Innerhalb der einzelnen Bereiche werden die verfügbaren Anwendungen übersichtlich aufgeführt, beschrieben und anhand von Bildschirmfotos (Screenshots) erläutert.",
        "ENGLISH": "",
        "FRENCH": "",
        "CHINESE": "",
        "RUSSIAN": "",
        "SPANISH": "",
        "ITALIAN": "",
        "JAPANESE": "",
        "KOREAN": ""
      },
      "AUTOTRANSLATIONS": {},
      "VERIFIED": {}
    },
    "TASK_CONCEPT_QAPP_CENTER_INSTRUCTION_2": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "TRANSLATIONS": {
        "GERMAN": "Ist eine für den Anwendungsfall geeignete und bereits lizenzierte Anwendung vorhanden, kann direkt aus dem QAPP-Center heraus eine Task auf Basis dieser Anwendung erstellt werden. Dadurch entfällt eine separate Auswahl der Anwendung in der Task-Verwaltung und der Konfigurationsprozess wird vereinfacht.",
        "ENGLISH": "",
        "FRENCH": "",
        "CHINESE": "",
        "RUSSIAN": "",
        "SPANISH": "",
        "ITALIAN": "",
        "JAPANESE": "",
        "KOREAN": ""
      },
      "AUTOTRANSLATIONS": {},
      "VERIFIED": {}
    },
