    "WEIGHING_STABILITY_DELAY_TITLE": {
      "group": "HELP_TITLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Stability delay",
        "GERMAN": "Stillstands-Verzögerung",
        "RUSSIAN": "Задержка покоя",
        "FRENCH": "Retard de stabilité",
        "SPANISH": "Retraso en la estabilidad",
        "ITALIAN": "Ritardo di stabilità",
        "CHINESE": "稳定性延迟"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Задержка покоя",
        "FRENCH": "Retard de stabilité",
        "SPANISH": "Retraso en la estabilidad",
        "ITALIAN": "Ritardo di stabilità",
        "CHINESE": "稳定性延迟"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "WEIGHING_STABILITY_DELAY_INSTRUCTION_1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "In addition to the standstill criterion, the display of standstill can also be customized by a delay. This setting, for instance, lets you compensate for slowly abating disturbances.",
        "GERMAN": "Zusätzlich zum Stillstand-Kriterium kann für die Anzeige vom Stillstand noch durch eine Verzögerung angepasst werden. Damit lassen sich z. B. langsam abklingende Störungen ausgleichen.",
        "RUSSIAN": "Помимо критерия остояния покоя, отображение покоя можно также настроить с помощью задержки. Эта настройка, например, позволяет компенсировать медленно ослабевающие помехи.",
        "FRENCH": "Outre le critère d'immobilisation, l'affichage de l'immobilisation peut également être personnalisé par un délai. Ce réglage vous permet, par exemple, de compenser les perturbations qui diminuent lentement.",
        "SPANISH": "Además del criterio de parada, la visualización de la parada también puede personalizarse mediante un retardo. Este ajuste permite, por ejemplo, compensar las perturbaciones que disminuyen lentamente.",
        "ITALIAN": "Oltre al criterio di arresto, la visualizzazione dell'arresto può anche essere personalizzata da un ritardo. Questa impostazione, per esempio, permette di compensare i disturbi che diminuiscono lentamente.",
        "CHINESE": "除了停机标准外，还可以通过延迟来定制停机显示。例如，通过这一设置可以对缓慢减弱的干扰进行补偿。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Помимо критерия остояния покоя, отображение покоя можно также настроить с помощью задержки. Эта настройка, например, позволяет компенсировать медленно ослабевающие помехи.",
        "FRENCH": "Outre le critère d'immobilisation, l'affichage de l'immobilisation peut également être personnalisé par un délai. Ce réglage vous permet, par exemple, de compenser les perturbations qui diminuent lentement.",
        "SPANISH": "Además del criterio de parada, la visualización de la parada también puede personalizarse mediante un retardo. Este ajuste permite, por ejemplo, compensar las perturbaciones que disminuyen lentamente.",
        "ITALIAN": "Oltre al criterio di arresto, la visualizzazione dell'arresto può anche essere personalizzata da un ritardo. Questa impostazione, per esempio, permette di compensare i disturbi che diminuiscono lentamente.",
        "CHINESE": "除了停机标准外，还可以通过延迟来定制停机显示。例如，通过这一设置可以对缓慢减弱的干扰进行补偿。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "WEIGHING_STABILITY_DELAY_INSTRUCTION_1_STEP_1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "Do not translate HTML command <b> and </b>",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "<b>Very short:</b> Very short delay, standstill is also displayed very soon after reaching the standstill criterion.",
        "GERMAN": "<b>Sehr kurz:</b> Sehr kurze Verzögerung, sehr schnell nach dem Erreichen des Stillstand-Kriteriums wird auch Stillstand angezeigt.",
        "RUSSIAN": "<b>Очень короткая:</b> Очень короткая задержка, покой также отображается очень скоро после достижения критерия состояния покоя.",
        "FRENCH": "<b>Très court :</b> Délai très court, l'arrêt est également affiché très rapidement après avoir atteint le critère d'arrêt.",
        "SPANISH": "<b>Muy corto:</b> Retraso muy corto, la parada también se muestra muy pronto después de alcanzar el criterio de parada.",
        "ITALIAN": "<b>Molto breve:</b> Ritardo molto breve, lo standstill viene anche visualizzato molto presto dopo aver raggiunto il criterio di standstill.",
        "CHINESE": "<b>极短：</b>极短延迟，达到静止标准后也会很快显示静止。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "<b>Очень короткая:</b> Очень короткая задержка, покой также отображается очень скоро после достижения критерия состояния покоя.",
        "FRENCH": "<b>Très court :</b> Délai très court, l'arrêt est également affiché très rapidement après avoir atteint le critère d'arrêt.",
        "SPANISH": "<b>Muy corto:</b> Retraso muy corto, la parada también se muestra muy pronto después de alcanzar el criterio de parada.",
        "ITALIAN": "<b>Molto breve:</b> Ritardo molto breve, lo standstill viene anche visualizzato molto presto dopo aver raggiunto il criterio di standstill.",
        "CHINESE": "<b>极短：</b>极短延迟，达到静止标准后也会很快显示静止。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
