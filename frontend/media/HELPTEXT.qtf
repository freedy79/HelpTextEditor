        "ITALIAN": "Connettore Windows File Server",
        "CHINESE": "连接 Windows 文件服务器",
        "JAPANESE": "Windowsファイルサーバーコネクター",
        "KOREAN": "Windows 파일 서버 커넥터"
      },
      "AUTOTRANSLATIONS": {
