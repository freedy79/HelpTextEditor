    "21CFRPART11_LONG": {
      "group": "HELP_ABBR_LONG",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Part 11 of Title 21 of the FDA regulation, regulates, among other things, electronic records and signatures.",
        "GERMAN": "Teil 11 vom Titel 21 der FDA-Vorschrift, regelt u.a. elektronische Aufzeichnungen und Unterschriften.",
        "RUSSIAN": "Часть 11 раздела 21 Положения о FDA на заглавные и строчные буквы регулирует, среди прочего, электронные записи и подписи.",
        "FRENCH": "La partie 11 du titre 21 du règlement de la FDA, régit, entre autres, les enregistrements et les signatures électroniques.",
        "SPANISH": "La parte 11 del Título 21 de la normativa de la FDA regula, entre otras cosas, los registros y las firmas electrónicas.",
        "ITALIAN": "La parte 11 del titolo 21 del regolamento della FDA regola, tra l'altro, le registrazioni e le firme elettroniche.",
        "CHINESE": "FDA 法规第 21 篇第 11 部分对电子记录和签名等事项进行了规范。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Часть 11 раздела 21 Положения о FDA на заглавные и строчные буквы регулирует, среди прочего, электронные записи и подписи.",
        "FRENCH": "La partie 11 du titre 21 du règlement de la FDA, régit, entre autres, les enregistrements et les signatures électroniques.",
        "SPANISH": "La parte 11 del Título 21 de la normativa de la FDA regula, entre otras cosas, los registros y las firmas electrónicas.",
        "ITALIAN": "La parte 11 del titolo 21 del regolamento della FDA regola, tra l'altro, le registrazioni e le firme elettroniche.",
        "CHINESE": "FDA 法规第 21 篇第 11 部分对电子记录和签名等事项进行了规范。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
