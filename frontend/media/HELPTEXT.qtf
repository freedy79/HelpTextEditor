    "NETWORK_CERTIFICATES_UPDATE_CA_STEP_1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "GERMAN": "Stellen Sie die Zertifikatsdateien so bereit, dass sie über einen Konnektor des Geräts erreicht werden können, beispielsweise auf einem USB-Speicher und dem USB-Konnektor",
        "ENGLISH": "Make the certificate files available so that they can be accessed via a connector on the device, for example on a USB memory device and the USB connector",
        "FRENCH": "Rendez les fichiers de certificat accessibles via un connecteur de l'appareil, par exemple sur une clé USB et le connecteur USB.",
        "SPANISH": "Hacer que los archivos de certificado estén disponibles para que se pueda acceder a ellos a través de un conector del dispositivo, por ejemplo, en un dispositivo de memoria USB y el conector USB.",
        "RUSSIAN": "Сделайте файлы сертификатов доступными, чтобы к ним можно было получить доступ через разъем на устройстве, например, на USB-накопителе и через разъем USB.",
        "ITALIAN": "Rendere disponibili i file di certificato in modo che sia possibile accedervi tramite un connettore sul dispositivo, ad esempio su un dispositivo di memoria USB e sul connettore USB.",
        "CHINESE": "提供证书文件，以便通过设备上的连接器（如 USB 存储设备和 USB 连接器）访问这些文件"
      },
      "AUTOTRANSLATIONS": {
        "SPANISH": "Hacer que los archivos de certificado estén disponibles para que se pueda acceder a ellos a través de un conector del dispositivo, por ejemplo, en un dispositivo de memoria USB y el conector USB.",
        "RUSSIAN": "Сделайте файлы сертификатов доступными, чтобы к ним можно было получить доступ через разъем на устройстве, например, на USB-накопителе и через разъем USB.",
        "ITALIAN": "Rendere disponibili i file di certificato in modo che sia possibile accedervi tramite un connettore sul dispositivo, ad esempio su un dispositivo di memoria USB e sul connettore USB.",
        "CHINESE": "提供证书文件，以便通过设备上的连接器（如 USB 存储设备和 USB 连接器）访问这些文件"
      },
      "VERIFIED": {
        "GERMAN": false,
        "ENGLISH": false,
        "FRENCH": false,
        "SPANISH": false,
        "RUSSIAN": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
