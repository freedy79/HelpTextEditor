      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Connecteur FTP/FTPS",
        "RUSSIAN": "FTP/FTPS коннектор",
        "SPANISH": "Conector FTP/FTPS",
        "ITALIAN": "Connettore FTP/FTPS",
        "CHINESE": "FTP/FTPS 连接器",
        "JAPANESE": "FTP/FTPSコネクタ",
        "KOREAN": "FTP/FTPS 커넥터"
      },
      "VERIFIED": {
        "ENGLISH": false,
