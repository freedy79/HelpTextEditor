      "TRANSLATIONS": {
        "ENGLISH": "Daily cleaning",
        "GERMAN": "Tägliche Reinigung",
        "CHINESE": "日常清洁",
        "FRENCH": "Nettoyage quotidien",
        "SPANISH": "Limpieza diaria",
        "RUSSIAN": "Ежедневная уборка",
        "ITALIAN": "Pulizia giornaliera"
      },
      "AUTOTRANSLATIONS": {
        "CHINESE": "日常清洁",
        "FRENCH": "Nettoyage quotidien",
        "SPANISH": "Limpieza diaria",
        "RUSSIAN": "Ежедневная уборка",
        "ITALIAN": "Pulizia giornaliera"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "CHINESE": false,
        "FRENCH": false,
        "SPANISH": false,
        "RUSSIAN": false,
        "ITALIAN": false
      }
    },
    "DEVICE_CLEANING_APPLICATION_EXAMPLE_1_INSTRUCTION_1": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The daily cleaning can be set up without the support of the device cleaning. The scheduled actions are available for this purpose. To set up, follow these steps:",
        "GERMAN": "Die tägliche Reinigung kann ohne die Unterstützung der Gerätereinigung eingerichtet werden. Dafür stehen die zeitgesteuerten Aktionen zur Verfügung. Zur Einrichtung befolgen Sie diese Schritte:",
        "CHINESE": "可以在不支持设备清洁的情况下设置日常清洁。为此可使用计划行动。设置步骤如下：",
        "FRENCH": "Le nettoyage quotidien peut être mis en place sans l'aide du nettoyage des appareils. Les actions programmées sont disponibles à cet effet. Pour la mise en place, suivez ces étapes :",
        "SPANISH": "La limpieza diaria se puede configurar sin el apoyo de la limpieza del dispositivo. Para ello están disponibles las acciones programadas. Para configurarlo, siga estos pasos:",
        "RUSSIAN": "Ежедневную уборку можно настроить без поддержки очистки устройства. Для этого предусмотрены действия по расписанию. Для настройки выполните следующие действия:",
        "ITALIAN": "La pulizia giornaliera può essere impostata senza il supporto della pulizia del dispositivo. A questo scopo sono disponibili le azioni programmate. Per l'impostazione, procedere come segue:"
      },
      "AUTOTRANSLATIONS": {
        "CHINESE": "可以在不支持设备清洁的情况下设置日常清洁。为此可使用计划行动。设置步骤如下：",
        "FRENCH": "Le nettoyage quotidien peut être mis en place sans l'aide du nettoyage des appareils. Les actions programmées sont disponibles à cet effet. Pour la mise en place, suivez ces étapes :",
        "SPANISH": "La limpieza diaria se puede configurar sin el apoyo de la limpieza del dispositivo. Para ello están disponibles las acciones programadas. Para configurarlo, siga estos pasos:",
        "RUSSIAN": "Ежедневную уборку можно настроить без поддержки очистки устройства. Для этого предусмотрены действия по расписанию. Для настройки выполните следующие действия:",
        "ITALIAN": "La pulizia giornaliera può essere impostata senza il supporto della pulizia del dispositivo. A questo scopo sono disponibili le azioni programmate. Per l'impostazione, procedere come segue:"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "CHINESE": false,
        "FRENCH": false,
        "SPANISH": false,
        "RUSSIAN": false,
        "ITALIAN": false
      }
    },
    "DEVICE_CLEANING_APPLICATION_EXAMPLE_1_STEP_1": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Create a cleaning task as described in <a href=#DEVICE_CLEANING_CREATE_TASK>chapter 4</a>",
        "GERMAN": "Erstellen Sie eine Reinigungs-Task wie in <a href=#DEVICE_CLEANING_CREATE_TASK>Kapitel 4</a> beschrieben",
        "CHINESE": "按照<a href=#DEVICE_CLEANING_CREATE_TASK>第 4 章</a>中的描述创建一个清洁任务",
        "FRENCH": "Créez une tâche de nettoyage comme décrit dans <a href=#DEVICE_CLEANING_CREATE_TASK>Chapitre 4</a",
        "SPANISH": "Cree una tarea de limpieza como se describe en <a href=#DEVICE_CLEANING_CREATE_TASK>capítulo 4</a>.",
        "RUSSIAN": "Создайте задачу очистки, как описано в <a href=#DEVICE_CLEANING_CREATE_TASK>главе 4</a>.",
        "ITALIAN": "Creare un'attività di pulizia come descritto in <a href=#DEVICE_CLEANING_CREATE_TASK>capitolo 4</a>."
      },
      "AUTOTRANSLATIONS": {
        "CHINESE": "按照<a href=#DEVICE_CLEANING_CREATE_TASK>第 4 章</a>中的描述创建一个清洁任务",
        "FRENCH": "Créez une tâche de nettoyage comme décrit dans <a href=#DEVICE_CLEANING_CREATE_TASK>Chapitre 4</a",
        "SPANISH": "Cree una tarea de limpieza como se describe en <a href=#DEVICE_CLEANING_CREATE_TASK>capítulo 4</a>.",
        "RUSSIAN": "Создайте задачу очистки, как описано в <a href=#DEVICE_CLEANING_CREATE_TASK>главе 4</a>.",
        "ITALIAN": "Creare un'attività di pulizia come descritto in <a href=#DEVICE_CLEANING_CREATE_TASK>capitolo 4</a>."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "CHINESE": false,
        "FRENCH": false,
        "SPANISH": false,
        "RUSSIAN": false,
        "ITALIAN": false
      }
    },
    "DEVICE_CLEANING_APPLICATION_EXAMPLE_1_STEP_2": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
