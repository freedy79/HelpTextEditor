    "VIEW_AUDIT_TRAIL_VIA_BROWSER_APPL_STEP_1": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
