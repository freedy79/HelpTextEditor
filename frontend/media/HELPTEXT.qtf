      "TRANSLATIONS": {
        "ENGLISH": "Specified weighing profiles",
        "GERMAN": "Vorgegeben Wägeprofile",
        "RUSSIAN": "Заданные профили взвешивания",
        "FRENCH": "Profils de pesage spécifiés",
        "SPANISH": "Perfiles de pesaje especificados",
        "ITALIAN": "Profili di pesatura specificati",
        "CHINESE": "指定的称重曲线"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Заданные профили взвешивания",
        "FRENCH": "Profils de pesage spécifiés",
        "SPANISH": "Perfiles de pesaje especificados",
        "ITALIAN": "Profili di pesatura specificati",
        "CHINESE": "指定的称重曲线"
      },
      "VERIFIED": {
