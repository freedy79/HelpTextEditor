    "WEIGHING_PROFILES_DEFAULT_INSTRUCTION_2": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The [Default weighing] weighing profile is used for the factory-set [Weighing] and [Internal adjustment] tasks.",
        "GERMAN": "Für die ab Werk vorgegebenen Tasks [Wägen] und [Internes Justieren] wird das Wägeprofil [Standard Wägen] verwendet.",
        "RUSSIAN": "Профиль взвешивания [Стандартное взвешивание] используется для задач по умолчанию [Взвешивание] и [Внутренняя юстировка].",
        "FRENCH": "Le profil de pesage [Pesage par défaut] est utilisé pour les tâches de [Pesage] et [Ajustement interne] réglées en usine.",
        "SPANISH": "El perfil de pesaje [Pesaje por defecto] se utiliza para las tareas de [Pesaje] y [Ajuste interno] ajustadas en fábrica.",
        "ITALIAN": "Il profilo di pesatura [Default weighing] viene utilizzato per le operazioni [Weighing] e [Internal adjustment] impostate in fabbrica.",
        "CHINESE": "默认称量]称量曲线用于出厂设置的[称量]和[内部调整]任务。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Профиль взвешивания [Стандартное взвешивание] используется для задач по умолчанию [Взвешивание] и [Внутренняя юстировка].",
        "FRENCH": "Le profil de pesage [Pesage par défaut] est utilisé pour les tâches de [Pesage] et [Ajustement interne] réglées en usine.",
        "SPANISH": "El perfil de pesaje [Pesaje por defecto] se utiliza para las tareas de [Pesaje] y [Ajuste interno] ajustadas en fábrica.",
        "ITALIAN": "Il profilo di pesatura [Default weighing] viene utilizzato per le operazioni [Weighing] e [Internal adjustment] impostate in fabbrica.",
        "CHINESE": "默认称量]称量曲线用于出厂设置的[称量]和[内部调整]任务。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "WEIGHING_PROFILES_DEFAULT_NSTRUCTION_3": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "For the newly created tasks, these specified weighing profiles can be selected directly, or else new weighing profiles must be created beforehand in accordance with the requirement.",
        "GERMAN": "Für Tasks, die neu angelegt werden, können diese vorgegebenen Wägeprofile direkt gewählt werden oder es müssen vorher neue Wägeprofile gemäß der Anforderung erstellt werden.",
        "RUSSIAN": "Для вновь созданных задач можно выбрать непосредственно эти заданные профили взвешивания, либо предварительно создать новые профили взвешивания в соответствии с требованиями.",
        "FRENCH": "Pour les tâches nouvellement créées, ces profils de pesée spécifiés peuvent être sélectionnés directement, ou bien de nouveaux profils de pesée doivent être créés au préalable en fonction des besoins.",
        "SPANISH": "Para las tareas recién creadas, estos perfiles de pesaje especificados pueden seleccionarse directamente, o bien deben crearse previamente nuevos perfiles de pesaje de acuerdo con los requisitos.",
        "ITALIAN": "Per i nuovi compiti creati, questi profili di pesatura specificati possono essere selezionati direttamente, oppure nuovi profili di pesatura devono essere creati in anticipo in base alle esigenze.",
        "CHINESE": "对于新创建的任务，可以直接选择这些指定的称重曲线，否则必须根据要求事先创建新的称重曲线。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Для вновь созданных задач можно выбрать непосредственно эти заданные профили взвешивания, либо предварительно создать новые профили взвешивания в соответствии с требованиями.",
        "FRENCH": "Pour les tâches nouvellement créées, ces profils de pesée spécifiés peuvent être sélectionnés directement, ou bien de nouveaux profils de pesée doivent être créés au préalable en fonction des besoins.",
        "SPANISH": "Para las tareas recién creadas, estos perfiles de pesaje especificados pueden seleccionarse directamente, o bien deben crearse previamente nuevos perfiles de pesaje de acuerdo con los requisitos.",
        "ITALIAN": "Per i nuovi compiti creati, questi profili di pesatura specificati possono essere selezionati direttamente, oppure nuovi profili di pesatura devono essere creati in anticipo in base alle esigenze.",
        "CHINESE": "对于新创建的任务，可以直接选择这些指定的称重曲线，否则必须根据要求事先创建新的称重曲线。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
