    "EXAMPLE_WITH_DEFAULT_PROFILE_INSTRUCTION": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
