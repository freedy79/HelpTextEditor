    "EXAMPLE_AUTOM_CREATE_NETWORK_USER_ERROR_1_STEP_1": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the control characters <BR>",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Check the connection of your balance with the network. <BR>Check whether an IP address of the balance is displayed in [Status center].",
        "GERMAN": "Überprüfen Sie die Verbindung Ihrer Waage mit dem Netzwerk. <BR>Stellen Sie fest, ob im [Status Center] eine IP-Adresse der Waage angezeigt wird.",
        "RUSSIAN": "Проверьте подключение весов к сети. <BR>Проверьте, отображается ли IP-адрес весов в [Status center].",
        "FRENCH": "Vérifiez la connexion de votre balance avec le réseau. <BR>Vérifiez si une adresse IP de la balance est affichée dans [Centre d'état].",
        "SPANISH": "Compruebe la conexión de su balanza con la red. <BR>Compruebe si se muestra una dirección IP de la balanza en [Centro de estado].",
        "ITALIAN": "Controllare la connessione della bilancia alla rete. <BR>Controllare se un indirizzo IP della bilancia viene visualizzato in [Status center].",
        "CHINESE": "检查天平与网络的连接。<BR>检查 [Status center] 中是否显示了天平的 IP 地址。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Проверьте подключение весов к сети. <BR>Проверьте, отображается ли IP-адрес весов в [Status center].",
        "FRENCH": "Vérifiez la connexion de votre balance avec le réseau. <BR>Vérifiez si une adresse IP de la balance est affichée dans [Centre d'état].",
        "SPANISH": "Compruebe la conexión de su balanza con la red. <BR>Compruebe si se muestra una dirección IP de la balanza en [Centro de estado].",
        "ITALIAN": "Controllare la connessione della bilancia alla rete. <BR>Controllare se un indirizzo IP della bilancia viene visualizzato in [Status center].",
        "CHINESE": "检查天平与网络的连接。<BR>检查 [Status center] 中是否显示了天平的 IP 地址。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "EXAMPLE_AUTOM_CREATE_NETWORK_USER_ERROR_1_STEP_2": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the control characters <BR>",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Check whether you can log on to your PC with the same username and password. <BR>Let your administrator check the settings for the LDAP server on the balance.",
        "GERMAN": "Überprüfen Sie, ob Sie sich mit dem gleichen Benutzernamen und Passwort auf ihrem PC anmelden können. <BR>Lassen Sie ggf. von Ihrem Administrator die Einstellungen für den LDAP Server auf der Waage überprüfen.",
        "RUSSIAN": "Проверьте, можете ли вы войти на свой ПК с тем же именем пользователя и паролем. <BR>Позвольте вашему администратору проверить настройки сервера LDAP на весах.",
        "FRENCH": "Vérifiez si vous pouvez vous connecter à votre PC avec le même nom d'utilisateur et le même mot de passe. <BR>Laissez votre administrateur vérifier les paramètres du serveur LDAP sur la balance.",
        "SPANISH": "Compruebe si puede iniciar sesión en su PC con el mismo nombre de usuario y contraseña. <BR>Haga que su administrador compruebe la configuración del servidor LDAP en la balanza.",
        "ITALIAN": "Controlla se puoi accedere al tuo PC con lo stesso nome utente e password. <BR>Fai controllare al tuo amministratore le impostazioni del server LDAP sulla bilancia.",
        "CHINESE": "检查是否可以使用相同的用户名和密码登录个人计算机。<BR>让管理员检查天平上 LDAP 服务器的设置。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Проверьте, можете ли вы войти на свой ПК с тем же именем пользователя и паролем. <BR>Позвольте вашему администратору проверить настройки сервера LDAP на весах.",
        "FRENCH": "Vérifiez si vous pouvez vous connecter à votre PC avec le même nom d'utilisateur et le même mot de passe. <BR>Laissez votre administrateur vérifier les paramètres du serveur LDAP sur la balance.",
        "SPANISH": "Compruebe si puede iniciar sesión en su PC con el mismo nombre de usuario y contraseña. <BR>Haga que su administrador compruebe la configuración del servidor LDAP en la balanza.",
        "ITALIAN": "Controlla se puoi accedere al tuo PC con lo stesso nome utente e password. <BR>Fai controllare al tuo amministratore le impostazioni del server LDAP sulla bilancia.",
        "CHINESE": "检查是否可以使用相同的用户名和密码登录个人计算机。<BR>让管理员检查天平上 LDAP 服务器的设置。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
