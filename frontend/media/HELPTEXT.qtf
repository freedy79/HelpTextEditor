      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Delete preload",
        "GERMAN": "Lösche Vorlast",
        "RUSSIAN": "Удалить предварительную нагрузку",
        "FRENCH": "Supprimer la précharge",
        "SPANISH": "Borrar la precarga",
        "ITALIAN": "Cancellare il precarico",
        "CHINESE": "删除预加载"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Удалить предварительную нагрузку",
        "FRENCH": "Supprimer la précharge",
        "SPANISH": "Borrar la precarga",
        "ITALIAN": "Cancellare il precarico",
        "CHINESE": "删除预加载"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
