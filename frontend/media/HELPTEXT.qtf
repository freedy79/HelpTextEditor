    "UPDATE_QAPP_CENTER_FTP_CONF_STEP_2_F": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "A port number is required for the connection: the number 21 has been assigned. If required, you can enter a different port number.",
        "GERMAN": "Für die Verbindung ist eine Port-Nummer erforderlich, vorgegeben ist die Nummer 21. Falls erforderlich, können Sie eine andere Port-Nummer eingeben.",
        "RUSSIAN": "Для подключения требуется номер порта: по умолчанию номер 21. При необходимости можно ввести другой номер порта.",
        "FRENCH": "Un numéro de port est nécessaire pour la connexion : le numéro 21 a été attribué. Si nécessaire, vous pouvez saisir un autre numéro de port.",
        "SPANISH": "Se requiere un número de puerto para la conexión: se ha asignado el número 21. Si es necesario, puede introducir un número de puerto diferente.",
        "ITALIAN": "Un numero di porta è richiesto per la connessione: il numero 21 è stato assegnato. Se necessario, è possibile inserire un numero di porta diverso.",
        "CHINESE": "连接需要端口号：已指定端口号为 21。如果需要，可以输入不同的端口号。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Для подключения требуется номер порта: по умолчанию номер 21. При необходимости можно ввести другой номер порта.",
        "FRENCH": "Un numéro de port est nécessaire pour la connexion : le numéro 21 a été attribué. Si nécessaire, vous pouvez saisir un autre numéro de port.",
        "SPANISH": "Se requiere un número de puerto para la conexión: se ha asignado el número 21. Si es necesario, puede introducir un número de puerto diferente.",
        "ITALIAN": "Un numero di porta è richiesto per la connessione: il numero 21 è stato assegnato. Se necessario, è possibile inserire un numero di porta diverso.",
        "CHINESE": "连接需要端口号：已指定端口号为 21。如果需要，可以输入不同的端口号。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "UPDATE_QAPP_CENTER_FTP_CONF_STEP_2_G": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not translate QAPP and QAPP Center.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "For updating the QAPP Center, you can also specify a sub-directory for the files stored in the server.",
        "GERMAN": "Sie können für die auf dem Server abgelegten Dateien zur Aktualisierung des QAPP Centers auch ein Unterverzeichnis angeben.",
        "RUSSIAN": "Для обновления QAPP Center можно также указать подкаталог для файлов, хранящихся на сервере.",
        "FRENCH": "Pour la mise à jour du QAPP Center, vous pouvez également spécifier un sous-répertoire pour les fichiers stockés sur le serveur.",
        "SPANISH": "Para actualizar el Centro QAPP, también puede especificar un subdirectorio para los archivos almacenados en el servidor.",
        "ITALIAN": "Per aggiornare il QAPP Center, puoi anche specificare una sotto-directory per i file memorizzati nel server.",
        "CHINESE": "为更新 QAPP 中心，您还可以为存储在服务器中的文件指定一个子目录。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Для обновления QAPP Center можно также указать подкаталог для файлов, хранящихся на сервере.",
        "FRENCH": "Pour la mise à jour du QAPP Center, vous pouvez également spécifier un sous-répertoire pour les fichiers stockés sur le serveur.",
        "SPANISH": "Para actualizar el Centro QAPP, también puede especificar un subdirectorio para los archivos almacenados en el servidor.",
        "ITALIAN": "Per aggiornare il QAPP Center, puoi anche specificare una sotto-directory per i file memorizzati nel server.",
        "CHINESE": "为更新 QAPP 中心，您还可以为存储在服务器中的文件指定一个子目录。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "UPDATE_QAPP_CENTER_FTP_CONF_STEP_2_H": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Enter the username and password for accessing the FTP server. Pay attention to the correct notation here too, particularly, upper/lower case letters.",
        "GERMAN": "Geben Sie den Benutzernamen und das Passwort für den Zugriff auf den FTP Server ein. Achten sie hier ebenfalls auf die richtige Schreibweise, insbesondere auf Groß- und Kleinschreibung.",
        "RUSSIAN": "Введите имя пользователя и пароль для доступа к FTP-серверу. Обратите внимание на правильность обозначений, в частности, на верхний/нижний регистр букв.",
        "FRENCH": "Entrez le nom d'utilisateur et le mot de passe pour accéder au serveur FTP. Faites attention à la notation correcte ici aussi, en particulier, les lettres majuscules/minuscules.",
        "SPANISH": "Introduzca el nombre de usuario y la contraseña para acceder al servidor FTP. Preste atención a la notación correcta aquí también, en particular, las letras mayúsculas / minúsculas.",
        "ITALIAN": "Inserisci il nome utente e la password per accedere al server FTP. Fate attenzione alla notazione corretta anche qui, in particolare alle lettere maiuscole/minuscole.",
        "CHINESE": "输入访问 FTP 服务器的用户名和密码。这里也要注意正确的符号，尤其是大/小写字母。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Введите имя пользователя и пароль для доступа к FTP-серверу. Обратите внимание на правильность обозначений, в частности, на верхний/нижний регистр букв.",
        "FRENCH": "Entrez le nom d'utilisateur et le mot de passe pour accéder au serveur FTP. Faites attention à la notation correcte ici aussi, en particulier, les lettres majuscules/minuscules.",
        "SPANISH": "Introduzca el nombre de usuario y la contraseña para acceder al servidor FTP. Preste atención a la notación correcta aquí también, en particular, las letras mayúsculas / minúsculas.",
        "ITALIAN": "Inserisci il nome utente e la password per accedere al server FTP. Fate attenzione alla notazione corretta anche qui, in particolare alle lettere maiuscole/minuscole.",
        "CHINESE": "输入访问 FTP 服务器的用户名和密码。这里也要注意正确的符号，尤其是大/小写字母。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
