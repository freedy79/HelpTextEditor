    "PRINT_GLP_YDP30_APPL_STEP_1": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Connect the USB-A connection on the balance with the USB-B connection on the YDP30 printer using a standard USB cable (USB-A to USB-B). The YDP30 printer is automatically recognized and no further interface settings are required.",
        "GERMAN": "Verbinden Sie den USB-A Anschluss der Waage mit dem USB-B Anschluss am Drucker YDP30 mit einem USB-Standardkabel (USB-A auf USB-B). Der Drucker YDP30 wird automatisch erkannt, es sind keine weiteren Schnittstelleneinstellungen erforderlich.",
        "FRENCH": "Reliez la connexion USB-A de la balance à la connexion USB-B de l'imprimante YDP30 à l'aide d'un câble USB standard (USB-A vers USB-B). L'imprimante YDP30 est automatiquement reconnue et aucun autre réglage d'interface n'est nécessaire.",
        "RUSSIAN": "Соедините разъем USB-A на весах с разъемом USB-B на принтере YDP30 с помощью стандартного USB-кабеля (USB-A - USB-B). Принтер YDP30 распознается автоматически, и никаких дополнительных настроек интерфейса не требуется.",
        "SPANISH": "Conecte la conexión USB-A de la balanza con la conexión USB-B de la impresora YDP30 mediante un cable USB estándar (USB-A a USB-B). La impresora YDP30 se reconoce automáticamente y no es necesario realizar más ajustes de interfaz.",
        "ITALIAN": "Collegare la connessione USB-A della bilancia con la connessione USB-B della stampante YDP30 utilizzando un cavo USB standard (da USB-A a USB-B). La stampante YDP30 viene riconosciuta automaticamente e non sono necessarie ulteriori impostazioni di interfaccia.",
        "CHINESE": "使用标准 USB 电缆（USB-A 至 USB-B）将衡器上的 USB-A 端口连接到 YDP30 打印机上的 USB-B 端口。YDP30 打印机会自动识别，无需进一步的接口设置。",
        "JAPANESE": "天びんの USB-A コネクタと YDP30 プリンタの USB-B コネクタを標準 USB ケーブル（USB-A to USB-B）で接続します。YDP30プリンタは自動的に認識され、それ以上のインターフェース設定は必要ありません。",
        "KOREAN": "표준 USB 케이블(USB-A to USB-B)을 사용하여 저울의 USB-A 연결부를 YDP30 프린터의 USB-B 연결부에 연결합니다. YDP30 프린터가 자동으로 인식되므로 추가 인터페이스 설정이 필요하지 않습니다."
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Reliez la connexion USB-A de la balance à la connexion USB-B de l'imprimante YDP30 à l'aide d'un câble USB standard (USB-A vers USB-B). L'imprimante YDP30 est automatiquement reconnue et aucun autre réglage d'interface n'est nécessaire.",
        "RUSSIAN": "Соедините разъем USB-A на весах с разъемом USB-B на принтере YDP30 с помощью стандартного USB-кабеля (USB-A - USB-B). Принтер YDP30 распознается автоматически, и никаких дополнительных настроек интерфейса не требуется.",
        "SPANISH": "Conecte la conexión USB-A de la balanza con la conexión USB-B de la impresora YDP30 mediante un cable USB estándar (USB-A a USB-B). La impresora YDP30 se reconoce automáticamente y no es necesario realizar más ajustes de interfaz.",
        "ITALIAN": "Collegare la connessione USB-A della bilancia con la connessione USB-B della stampante YDP30 utilizzando un cavo USB standard (da USB-A a USB-B). La stampante YDP30 viene riconosciuta automaticamente e non sono necessarie ulteriori impostazioni di interfaccia.",
        "CHINESE": "使用标准 USB 电缆（USB-A 至 USB-B）将衡器上的 USB-A 端口连接到 YDP30 打印机上的 USB-B 端口。YDP30 打印机会自动识别，无需进一步的接口设置。",
        "JAPANESE": "天びんの USB-A コネクタと YDP30 プリンタの USB-B コネクタを標準 USB ケーブル（USB-A to USB-B）で接続します。YDP30プリンタは自動的に認識され、それ以上のインターフェース設定は必要ありません。",
        "KOREAN": "표준 USB 케이블(USB-A to USB-B)을 사용하여 저울의 USB-A 연결부를 YDP30 프린터의 USB-B 연결부에 연결합니다. YDP30 프린터가 자동으로 인식되므로 추가 인터페이스 설정이 필요하지 않습니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
        "RUSSIAN": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_GLP_YDP30_APPL_STEP_2": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Start the task, e.g. [My weighing with GLP print], which includes the allocated print profile [My GLP print to YDP30].",
        "GERMAN": "Starten Sie die Task z. B. [Mein Wägen mit GLP-Druck] mit dem darin zugewiesenen Druckprofil [Mein GLP Druck auf YDP30].",
        "FRENCH": "Lancez la tâche, par exemple [Ma pesée avec impression BPL], qui inclut le profil d'impression attribué [Mon impression BPL sur YDP30].",
        "RUSSIAN": "Запустите задачу, например, [Мое взвешивание с печатью GLP], которая включает выделенный профиль печати [Моя печать GLP на YDP30].",
        "SPANISH": "Inicie la tarea, por ejemplo, [Mi pesaje con impresión GLP], que incluye el perfil de impresión asignado [Mi impresión GLP a YDP30].",
        "ITALIAN": "Avviare l'attività, ad esempio [La mia pesatura con stampa BPL], che include il profilo di stampa assegnato [La mia stampa BPL su YDP30].",
        "CHINESE": "启动任务，例如 [我的称重与 GLP 打印]，其中包括分配的打印配置文件 [我的 GLP 打印到 YDP30]。",
        "JAPANESE": "割り当てられた印刷プロファイル[My GLP print to YDP30]を含むタスク、例えば[My weighing with GLP print]を開始します。",
        "KOREAN": "예를 들어 할당된 인쇄 프로필 [YDP30에 대한 내 GLP 인쇄]가 포함된 [GLP 인쇄로 내 계량]과 같은 작업을 시작합니다."
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Lancez la tâche, par exemple [Ma pesée avec impression BPL], qui inclut le profil d'impression attribué [Mon impression BPL sur YDP30].",
        "RUSSIAN": "Запустите задачу, например, [Мое взвешивание с печатью GLP], которая включает выделенный профиль печати [Моя печать GLP на YDP30].",
        "SPANISH": "Inicie la tarea, por ejemplo, [Mi pesaje con impresión GLP], que incluye el perfil de impresión asignado [Mi impresión GLP a YDP30].",
        "ITALIAN": "Avviare l'attività, ad esempio [La mia pesatura con stampa BPL], che include il profilo di stampa assegnato [La mia stampa BPL su YDP30].",
        "CHINESE": "启动任务，例如 [我的称重与 GLP 打印]，其中包括分配的打印配置文件 [我的 GLP 打印到 YDP30]。",
        "JAPANESE": "割り当てられた印刷プロファイル[My GLP print to YDP30]を含むタスク、例えば[My weighing with GLP print]を開始します。",
        "KOREAN": "예를 들어 할당된 인쇄 프로필 [YDP30에 대한 내 GLP 인쇄]가 포함된 [GLP 인쇄로 내 계량]과 같은 작업을 시작합니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
        "RUSSIAN": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_GLP_YDP30_APPL_STEP_3": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "If you selected descriptors for the batch, they must now be entered or scanned. The [Weighing] application then starts.",
        "GERMAN": "Falls Sie Bezeichner für die Charge gewählt haben, müssen diese jetzt eingegeben oder eingescannt werden. Anschließend startet die Anwendung [Wägen].",
        "FRENCH": "Si vous avez sélectionné des descripteurs pour le lot, ils doivent maintenant être saisis ou scannés. L'application [Pesée] démarre alors.",
        "RUSSIAN": "Если вы выбрали дескрипторы для партии, их необходимо ввести или отсканировать. После этого запускается приложение [Взвешивание].",
        "SPANISH": "Si ha seleccionado descriptores para el lote, ahora deben introducirse o escanearse. A continuación, se inicia la aplicación [Pesaje].",
        "ITALIAN": "Se sono stati selezionati dei descrittori per il lotto, questi devono ora essere inseriti o scansionati. Si avvia quindi l'applicazione [Pesatura].",
        "CHINESE": "如果为批次选择了描述符，则现在必须输入或扫描描述符。然后启动 [称重] 应用程序。",
        "JAPANESE": "バッチに記述子を選択した場合は、その記述子を入力またはスキャンする必要があります。その後、[Weighing]アプリケーションが起動します。",
        "KOREAN": "배치에 대한 설명자를 선택한 경우 이제 해당 설명자를 입력하거나 스캔해야 합니다. 그러면 [계량] 애플리케이션이 시작됩니다."
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Si vous avez sélectionné des descripteurs pour le lot, ils doivent maintenant être saisis ou scannés. L'application [Pesée] démarre alors.",
        "RUSSIAN": "Если вы выбрали дескрипторы для партии, их необходимо ввести или отсканировать. После этого запускается приложение [Взвешивание].",
        "SPANISH": "Si ha seleccionado descriptores para el lote, ahora deben introducirse o escanearse. A continuación, se inicia la aplicación [Pesaje].",
        "ITALIAN": "Se sono stati selezionati dei descrittori per il lotto, questi devono ora essere inseriti o scansionati. Si avvia quindi l'applicazione [Pesatura].",
        "CHINESE": "如果为批次选择了描述符，则现在必须输入或扫描描述符。然后启动 [称重] 应用程序。",
        "JAPANESE": "バッチに記述子を選択した場合は、その記述子を入力またはスキャンする必要があります。その後、[Weighing]アプリケーションが起動します。",
        "KOREAN": "배치에 대한 설명자를 선택한 경우 이제 해당 설명자를 입력하거나 스캔해야 합니다. 그러면 [계량] 애플리케이션이 시작됩니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
        "RUSSIAN": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_GLP_YDP30_APPL_STEP_4": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The current weighing result is accepted by pressing the [Save] button. If you have selected descriptors for the samples, they must now be entered or scanned. The values specified by the print profile for each accepted value are written into the printer memory together with the descriptors, and can be viewed at any time using the [Printer memory] button. It is possible to mark the accepted value as invalid, where required.",
        "GERMAN": "Mit der Schaltfläche [Speichern] wird der aktuelle Wägewert übernommen. Falls Sie Bezeichner für die Proben gewählt haben müssen diese jetzt ebenfalls eingegeben oder eingescannt werden. Die durch das Druckprofil festgelegten Werte für jeden übernommenen Wert werden zusammen mit den Bezeichnern in den Druckerspeicher geschrieben und können mit der Schaltfläche [Druckspeicher] jederzeit eingesehen werden. Außerdem besteht die Möglichkeit den übernommenen Wert ggf. als ungültig zu kennzeichnen.",
        "FRENCH": "Le résultat actuel de la pesée est accepté en appuyant sur le bouton [Save]. Si vous avez sélectionné des descripteurs pour les échantillons, ils doivent maintenant être saisis ou scannés. Les valeurs spécifiées par le profil d'impression pour chaque valeur acceptée sont écrites dans la mémoire de l'imprimante avec les descripteurs et peuvent être consultées à tout moment à l'aide du bouton [Mémoire imprimante]. Il est possible de marquer la valeur acceptée comme non valide, si nécessaire.",
        "RUSSIAN": "Текущий результат взвешивания принимается нажатием кнопки [Сохранить]. Если вы выбрали дескрипторы для образцов, их теперь необходимо ввести или отсканировать. Значения, заданные профилем печати для каждого принятого значения, записываются в память принтера вместе с дескрипторами и могут быть просмотрены в любое время с помощью кнопки [Память принтера]. При необходимости можно пометить принятое значение как недействительное.",
        "SPANISH": "El resultado del pesaje actual se acepta pulsando el botón [Guardar]. Si se han seleccionado descriptores para las muestras, ahora hay que introducirlos o escanearlos. Los valores especificados por el perfil de impresión para cada valor aceptado se escriben en la memoria de la impresora junto con los descriptores, y pueden consultarse en cualquier momento mediante el botón [Memoria de la impresora]. Es posible marcar el valor aceptado como no válido, en caso necesario.",
        "ITALIAN": "Il risultato attuale della pesatura viene accettato premendo il tasto [Save]. Se sono stati selezionati dei descrittori per i campioni, questi devono ora essere inseriti o scansionati. I valori specificati dal profilo di stampa per ogni valore accettato vengono scritti nella memoria della stampante insieme ai descrittori e possono essere visualizzati in qualsiasi momento con il tasto [Printer memory]. È possibile contrassegnare il valore accettato come non valido, se necessario.",
        "CHINESE": "按[保存]按钮接受当前的称量结果。如果您为样品选择了描述符，现在必须输入或扫描这些描述符。打印配置文件为每个接受值指定的值与描述符一起写入打印机内存，并可随时使用 [打印机内存] 按钮查看。根据需要，可以将接受的值标记为无效。",
        "JAPANESE": "現在の計量結果は、[Save]ボタンを押すことで受理されます。サンプルの記述子を選択した場合は、その記述子を入力するかスキャンする必要があります。受理された各値に対して印刷プロファイルで指定された値は、記述子とともにプリンタメモリに書き込まれ、[Printer memory]ボタンを使用していつでも見ることができます。必要であれば、受理された値を無効としてマークすることも可能です。",
        "KOREAN": "저장] 버튼을 누르면 현재 계량 결과가 승인됩니다. 시료에 대한 설명자를 선택한 경우 이제 해당 설명자를 입력하거나 스캔해야 합니다. 허용된 각 값에 대해 인쇄 프로필에 지정된 값은 설명자와 함께 프린터 메모리에 기록되며, [프린터 메모리] 버튼을 사용하여 언제든지 확인할 수 있습니다. 필요한 경우 수락된 값을 유효하지 않은 값으로 표시할 수 있습니다."
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Le résultat actuel de la pesée est accepté en appuyant sur le bouton [Save]. Si vous avez sélectionné des descripteurs pour les échantillons, ils doivent maintenant être saisis ou scannés. Les valeurs spécifiées par le profil d'impression pour chaque valeur acceptée sont écrites dans la mémoire de l'imprimante avec les descripteurs et peuvent être consultées à tout moment à l'aide du bouton [Mémoire imprimante]. Il est possible de marquer la valeur acceptée comme non valide, si nécessaire.",
        "RUSSIAN": "Текущий результат взвешивания принимается нажатием кнопки [Сохранить]. Если вы выбрали дескрипторы для образцов, их теперь необходимо ввести или отсканировать. Значения, заданные профилем печати для каждого принятого значения, записываются в память принтера вместе с дескрипторами и могут быть просмотрены в любое время с помощью кнопки [Память принтера]. При необходимости можно пометить принятое значение как недействительное.",
        "SPANISH": "El resultado del pesaje actual se acepta pulsando el botón [Guardar]. Si se han seleccionado descriptores para las muestras, ahora hay que introducirlos o escanearlos. Los valores especificados por el perfil de impresión para cada valor aceptado se escriben en la memoria de la impresora junto con los descriptores, y pueden consultarse en cualquier momento mediante el botón [Memoria de la impresora]. Es posible marcar el valor aceptado como no válido, en caso necesario.",
        "ITALIAN": "Il risultato attuale della pesatura viene accettato premendo il tasto [Save]. Se sono stati selezionati dei descrittori per i campioni, questi devono ora essere inseriti o scansionati. I valori specificati dal profilo di stampa per ogni valore accettato vengono scritti nella memoria della stampante insieme ai descrittori e possono essere visualizzati in qualsiasi momento con il tasto [Printer memory]. È possibile contrassegnare il valore accettato come non valido, se necessario.",
        "CHINESE": "按[保存]按钮接受当前的称量结果。如果您为样品选择了描述符，现在必须输入或扫描这些描述符。打印配置文件为每个接受值指定的值与描述符一起写入打印机内存，并可随时使用 [打印机内存] 按钮查看。根据需要，可以将接受的值标记为无效。",
        "JAPANESE": "現在の計量結果は、[Save]ボタンを押すことで受理されます。サンプルの記述子を選択した場合は、その記述子を入力するかスキャンする必要があります。受理された各値に対して印刷プロファイルで指定された値は、記述子とともにプリンタメモリに書き込まれ、[Printer memory]ボタンを使用していつでも見ることができます。必要であれば、受理された値を無効としてマークすることも可能です。",
        "KOREAN": "저장] 버튼을 누르면 현재 계량 결과가 승인됩니다. 시료에 대한 설명자를 선택한 경우 이제 해당 설명자를 입력하거나 스캔해야 합니다. 허용된 각 값에 대해 인쇄 프로필에 지정된 값은 설명자와 함께 프린터 메모리에 기록되며, [프린터 메모리] 버튼을 사용하여 언제든지 확인할 수 있습니다. 필요한 경우 수락된 값을 유효하지 않은 값으로 표시할 수 있습니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
        "RUSSIAN": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_GLP_YDP30_APPL_STEP_5": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The printer memory is automatically displayed after pressing the [Quit] button.",
        "GERMAN": "Durch die Schaltfläche [Beenden] wird automatisch der Druckerspeicher angezeigt.",
        "FRENCH": "La mémoire de l'imprimante s'affiche automatiquement après avoir appuyé sur le bouton [Quit].",
        "RUSSIAN": "Память принтера автоматически отображается после нажатия кнопки [Quit].",
        "SPANISH": "La memoria de la impresora se muestra automáticamente después de pulsar el botón [Salir].",
        "ITALIAN": "La memoria della stampante viene visualizzata automaticamente dopo aver premuto il pulsante [Quit].",
        "CHINESE": "按下 [Quit] 按钮后，打印机内存将自动显示。",
        "JAPANESE": "Quit]ボタンを押すと、プリンタメモリが自動的に表示されます。",
        "KOREAN": "종료] 버튼을 누르면 프린터 메모리가 자동으로 표시됩니다."
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "La mémoire de l'imprimante s'affiche automatiquement après avoir appuyé sur le bouton [Quit].",
        "RUSSIAN": "Память принтера автоматически отображается после нажатия кнопки [Quit].",
        "SPANISH": "La memoria de la impresora se muestra automáticamente después de pulsar el botón [Salir].",
        "ITALIAN": "La memoria della stampante viene visualizzata automaticamente dopo aver premuto il pulsante [Quit].",
        "CHINESE": "按下 [Quit] 按钮后，打印机内存将自动显示。",
        "JAPANESE": "Quit]ボタンを押すと、プリンタメモリが自動的に表示されます。",
        "KOREAN": "종료] 버튼을 누르면 프린터 메모리가 자동으로 표시됩니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
        "RUSSIAN": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_GLP_YDP30_APPL_STEP_6": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ]. Do not replace the control character <BR>. Do not translate HTML link commands, e.g. <a href=\"#OUTPUT_EXAMPLES_YDP30_STRIP\"> and </a>.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The [Print] button generates the print job and sends it to the connected YDP30 printer. <BR>An output example can be found here: <a href=\"#OUTPUT_EXAMPLES_YDP30_STRIP\">YDP30 printer with paper strip</a>.",
        "GERMAN": "Mit der Schaltfläche [Drucken] wird der Druckauftrag erstellt und an den angeschlossenen Drucker YDP30 gesendet. <BR>Ein Ausgabebeispiel dazu finden Sie hier: <a href=\"#OUTPUT_EXAMPLES_YDP30_STRIP\">Drucker YDP30 mit Streifenpapier</a>.",
        "FRENCH": "Le bouton [Print] génère le travail d'impression et l'envoie à l'imprimante YDP30 connectée. <BR>Un exemple de sortie peut être trouvé ici : <a href=\"#OUTPUT_EXAMPLES_YDP30_STRIP\">Imprimante YDP30 avec bande de papier</a>.",
        "RUSSIAN": "Кнопка [Печать] формирует задание на печать и отправляет его на подключенный принтер YDP30. <BR>Пример вывода можно найти здесь: <a href=\"#OUTPUT_EXAMPLES_YDP30_STRIP\">принтер YDP30 с бумажной полосой</a>.",
        "SPANISH": "El botón [Imprimir] genera el trabajo de impresión y lo envía a la impresora YDP30 conectada. <BR>Un ejemplo de salida se puede encontrar aquí: <a href=\"#OUTPUT_EXAMPLES_YDP30_STRIP\">Impresora YDP30 con tira de papel</a>.",
        "ITALIAN": "Il pulsante [Print] genera il lavoro di stampa e lo invia alla stampante YDP30 collegata. <BR>Un esempio di output può essere trovato qui: <a href=\"#OUTPUT_EXAMPLES_YDP30_STRIP\">Stampante YDP30 con striscia di carta</a>.",
        "CHINESE": "打印]按钮生成打印作业并将其发送到连接的 YDP30 打印机。<BR>输出示例可在此处找到：<a href=\"#OUTPUT_EXAMPLES_YDP30_STRIP\">带纸条的 YDP30 打印机</a>。",
        "JAPANESE": "Print]ボタンは印刷ジョブを生成し、接続されたYDP30プリンタに送信します。<BR>出力例はこちらをご覧ください：<a href=\"#OUTPUT_EXAMPLES_YDP30_STRIP\">YDP30 printer with paper strip</a>.",
        "KOREAN": "인쇄] 버튼을 누르면 인쇄 작업이 생성되어 연결된 YDP30 프린터로 전송됩니다. <BR>출력 예제는 여기에서 확인할 수 있습니다: <a href=\"#OUTPUT_EXAMPLES_YDP30_STRIP\">용지 스트립이 있는 YDP30 프린터</a>."
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Le bouton [Print] génère le travail d'impression et l'envoie à l'imprimante YDP30 connectée. <BR>Un exemple de sortie peut être trouvé ici : <a href=\"#OUTPUT_EXAMPLES_YDP30_STRIP\">Imprimante YDP30 avec bande de papier</a>.",
        "RUSSIAN": "Кнопка [Печать] формирует задание на печать и отправляет его на подключенный принтер YDP30. <BR>Пример вывода можно найти здесь: <a href=\"#OUTPUT_EXAMPLES_YDP30_STRIP\">принтер YDP30 с бумажной полосой</a>.",
        "SPANISH": "El botón [Imprimir] genera el trabajo de impresión y lo envía a la impresora YDP30 conectada. <BR>Un ejemplo de salida se puede encontrar aquí: <a href=\"#OUTPUT_EXAMPLES_YDP30_STRIP\">Impresora YDP30 con tira de papel</a>.",
        "ITALIAN": "Il pulsante [Print] genera il lavoro di stampa e lo invia alla stampante YDP30 collegata. <BR>Un esempio di output può essere trovato qui: <a href=\"#OUTPUT_EXAMPLES_YDP30_STRIP\">Stampante YDP30 con striscia di carta</a>.",
        "CHINESE": "打印]按钮生成打印作业并将其发送到连接的 YDP30 打印机。<BR>输出示例可在此处找到：<a href=\"#OUTPUT_EXAMPLES_YDP30_STRIP\">带纸条的 YDP30 打印机</a>。",
        "JAPANESE": "Print]ボタンは印刷ジョブを生成し、接続されたYDP30プリンタに送信します。<BR>出力例はこちらをご覧ください：<a href=\"#OUTPUT_EXAMPLES_YDP30_STRIP\">YDP30 printer with paper strip</a>.",
        "KOREAN": "인쇄] 버튼을 누르면 인쇄 작업이 생성되어 연결된 YDP30 프린터로 전송됩니다. <BR>출력 예제는 여기에서 확인할 수 있습니다: <a href=\"#OUTPUT_EXAMPLES_YDP30_STRIP\">용지 스트립이 있는 YDP30 프린터</a>."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
        "RUSSIAN": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_GLP_YDP30_APPL_NOTE": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Note: If the print job cannot be completed, it will not be lost; see Troubleshooting.",
        "GERMAN": "Anmerkung: Falls der Druckauftrag nicht abgesetzt werden kann, geht dieser nicht verloren; siehe Fehlerbehandlung.",
        "FRENCH": "Remarque : si le travail d'impression ne peut être achevé, il ne sera pas perdu ; voir la section Dépannage.",
        "RUSSIAN": "Примечание: Если задание печати не может быть выполнено, оно не будет потеряно; см. раздел Устранение неполадок.",
        "SPANISH": "Nota: Si el trabajo de impresión no puede completarse, no se perderá; consulte la sección de resolución de problemas.",
        "ITALIAN": "Nota: Se il lavoro di stampa non può essere completato, non verrà perso; vedere Risoluzione dei problemi.",
        "CHINESE": "注意：如果打印任务无法完成，也不会丢失；请参阅故障排除。",
        "JAPANESE": "注：印刷ジョブを完了できなかった場合でも、ジョブは失われません。",
        "KOREAN": "참고: 인쇄 작업을 완료할 수 없는 경우에도 인쇄 작업은 손실되지 않습니다(문제 해결을 참조하세요)."
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Remarque : si le travail d'impression ne peut être achevé, il ne sera pas perdu ; voir la section Dépannage.",
        "RUSSIAN": "Примечание: Если задание печати не может быть выполнено, оно не будет потеряно; см. раздел Устранение неполадок.",
        "SPANISH": "Nota: Si el trabajo de impresión no puede completarse, no se perderá; consulte la sección de resolución de problemas.",
        "ITALIAN": "Nota: Se il lavoro di stampa non può essere completato, non verrà perso; vedere Risoluzione dei problemi.",
        "CHINESE": "注意：如果打印任务无法完成，也不会丢失；请参阅故障排除。",
        "JAPANESE": "注：印刷ジョブを完了できなかった場合でも、ジョブは失われません。",
        "KOREAN": "참고: 인쇄 작업을 완료할 수 없는 경우에도 인쇄 작업은 손실되지 않습니다(문제 해결을 참조하세요)."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
        "RUSSIAN": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
