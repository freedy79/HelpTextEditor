      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Navigate to [User management] and activate the creation of a new user with the [+] button.",
        "GERMAN": "Zu [Benutzerverwaltung] navigieren und mit der Schaltfläche [+] das Anlegen eines neuen Benutzers aktivieren.",
        "RUSSIAN": "Перейдите в раздел [Управление пользователями] и активируйте создание нового пользователя кнопкой [+].",
        "FRENCH": "Naviguez vers [Gestion des utilisateurs] et activez la création d'un nouvel utilisateur avec le bouton [+].",
        "SPANISH": "Vaya a [Gestión de usuarios] y active la creación de un nuevo usuario con el botón [+].",
        "ITALIAN": "Naviga su [Gestione utenti] e attiva la creazione di un nuovo utente con il pulsante [+].",
        "CHINESE": "导航至 [用户管理]，使用 [+] 按钮激活创建新用户。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Перейдите в раздел [Управление пользователями] и активируйте создание нового пользователя кнопкой [+].",
        "FRENCH": "Naviguez vers [Gestion des utilisateurs] et activez la création d'un nouvel utilisateur avec le bouton [+].",
        "SPANISH": "Vaya a [Gestión de usuarios] y active la creación de un nuevo usuario con el botón [+].",
        "ITALIAN": "Naviga su [Gestione utenti] e attiva la creazione di un nuovo utente con il pulsante [+].",
        "CHINESE": "导航至 [用户管理]，使用 [+] 按钮激活创建新用户。"
      },
      "VERIFIED": {
        "ENGLISH": false,
