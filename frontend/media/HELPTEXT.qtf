    "PRINT_PROFILE_WEBSERVICE_INSTRUCTION_2": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "GERMAN": "Das Druckprofil speichert unabhängig von den konfigurierten Druckelementen alle bereitgestellten Daten.",
        "ENGLISH": "The print profile saves all the data provided, regardless of the configured print elements.",
        "FRENCH": "Le profil d'impression enregistre toutes les données fournies, quels que soient les éléments d'impression configurés.",
        "CHINESE": "打印配置文件保存提供的所有数据，与配置的打印元素无关。",
        "SPANISH": "El perfil de impresión guarda todos los datos proporcionados, independientemente de los elementos de impresión configurados.",
        "RUSSIAN": "Профиль печати сохраняет все предоставленные данные, независимо от настроенных элементов печати.",
        "ITALIAN": "Il profilo di stampa salva tutti i dati forniti, indipendentemente dagli elementi di stampa configurati."
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Le profil d'impression enregistre toutes les données fournies, quels que soient les éléments d'impression configurés.",
        "CHINESE": "打印配置文件保存提供的所有数据，与配置的打印元素无关。",
        "SPANISH": "El perfil de impresión guarda todos los datos proporcionados, independientemente de los elementos de impresión configurados.",
        "RUSSIAN": "Профиль печати сохраняет все предоставленные данные, независимо от настроенных элементов печати.",
        "ITALIAN": "Il profilo di stampa salva tutti i dati forniti, indipendentemente dagli elementi di stampa configurati."
      },
      "VERIFIED": {
        "GERMAN": false,
        "ENGLISH": false,
        "FRENCH": false,
        "CHINESE": false,
        "SPANISH": false,
        "RUSSIAN": false,
        "ITALIAN": false
      }
    },
    "DEVICE_CONCEPT_APPLICATIONS_INSTRUCTION_3": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "GERMAN": "Bestehende Tasks bleiben bei einer Aktualisierung des QAPP-Centers in der urspünglich angelegten QAPP-Version erhalten. Zum Aktualisieren muss eine neue Task angelegt werden.",
        "ENGLISH": "Existing tasks are retained in the originally created QAPP version when the QAPP Center is updated. A new task must be created for updating.",
        "FRENCH": "Lors de la mise à jour du centre QAPP, les tâches existantes sont conservées dans la version QAPP créée à l'origine. Pour la mise à jour, une nouvelle tâche doit être créée.",
        "CHINESE": "更新 QAPP 中心时，现有任务将保留在最初创建的 QAPP 版本中。更新时必须创建新任务。",
        "SPANISH": "Las tareas existentes se conservan en la versión del QAPP creada originalmente cuando se actualiza el Centro del QAPP. Para la actualización debe crearse una nueva tarea.",
        "RUSSIAN": "При обновлении центра QAPP существующие задачи сохраняются в первоначально созданной версии QAPP. Для обновления необходимо создать новую задачу.",
        "ITALIAN": "I compiti esistenti vengono mantenuti nella versione del QAPP originariamente creata quando il Centro QAPP viene aggiornato. Per l'aggiornamento è necessario creare un nuovo compito."
      },
      "AUTOTRANSLATIONS": {
        "CHINESE": "更新 QAPP 中心时，现有任务将保留在最初创建的 QAPP 版本中。更新时必须创建新任务。",
        "SPANISH": "Las tareas existentes se conservan en la versión del QAPP creada originalmente cuando se actualiza el Centro del QAPP. Para la actualización debe crearse una nueva tarea.",
        "RUSSIAN": "При обновлении центра QAPP существующие задачи сохраняются в первоначально созданной версии QAPP. Для обновления необходимо создать новую задачу.",
        "ITALIAN": "I compiti esistenti vengono mantenuti nella versione del QAPP originariamente creata quando il Centro QAPP viene aggiornato. Per l'aggiornamento è necessario creare un nuovo compito."
      },
      "VERIFIED": {
        "GERMAN": false,
        "ENGLISH": false,
        "FRENCH": false,
        "CHINESE": false,
        "SPANISH": false,
        "RUSSIAN": false,
        "ITALIAN": false
      }
    },
