    "EXAMPLE_CREATE_NETWORK_USER_ERROR_2_STEP_1": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the control characters <BR>",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Enter your network password in the correct form. <BR>Pay attention to upper and lower case letters.",
        "GERMAN": "Geben Sie Ihr Netzwerk Passwort in der richtigen Form ein. <BR>Achten Sie auf Groß- und Kleinschreibung.",
        "RUSSIAN": "Введите свой сетевой пароль в правильной форме. <BR>Обратите внимание на заглавные и строчные буквы.",
        "FRENCH": "Saisissez votre mot de passe réseau sous la forme correcte. <BR>Faites attention aux lettres majuscules et minuscules.",
        "SPANISH": "Introduzca su contraseña de red en la forma correcta. <BR>Presta atención a las letras mayúsculas y minúsculas.",
        "ITALIAN": "Inserisci la tua password di rete nella forma corretta. <BR>Fate attenzione alle lettere maiuscole e minuscole.",
        "CHINESE": "以正确的形式输入网络密码。<BR>注意大小写字母。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Введите свой сетевой пароль в правильной форме. <BR>Обратите внимание на заглавные и строчные буквы.",
        "FRENCH": "Saisissez votre mot de passe réseau sous la forme correcte. <BR>Faites attention aux lettres majuscules et minuscules.",
        "SPANISH": "Introduzca su contraseña de red en la forma correcta. <BR>Presta atención a las letras mayúsculas y minúsculas.",
        "ITALIAN": "Inserisci la tua password di rete nella forma corretta. <BR>Fate attenzione alle lettere maiuscole e minuscole.",
        "CHINESE": "以正确的形式输入网络密码。<BR>注意大小写字母。"
      },
