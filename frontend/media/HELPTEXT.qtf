      "TRANSLATIONS": {
        "ENGLISH": "Access management",
        "GERMAN": "Zugriffsverwaltung",
        "FRENCH": "Gestion de l'accès",
        "SPANISH": "Gestión de accesos",
        "RUSSIAN": "Управление доступом",
        "ITALIAN": "Gestione degli accessi",
        "CHINESE": "访问管理"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Управление пользователями",
        "ITALIAN": "Gestione degli utenti",
        "CHINESE": "访问管理"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
