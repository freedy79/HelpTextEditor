    "EXAMPLE_CHANGE_USER_SETTINGS_INSTRUCTION": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "In this example, the Administrator user should get a specific color in the user field and the login should be done with a local password.",
        "GERMAN": "In diesem Beispiel soll der Benutzer Administrator eine bestimmte Farbe im Benutzerfeld erhalten und die Anmeldung soll mit einem lokalen Passwort erfolgen.",
        "RUSSIAN": "В данном примере пользователь Administrator должен получить определенный цвет в поле пользователя, а вход в систему должен осуществляться с помощью локального пароля.",
        "FRENCH": "Dans cet exemple, l'utilisateur Administrateur doit obtenir une couleur spécifique dans le champ utilisateur et la connexion doit se faire avec un mot de passe local.",
        "SPANISH": "En este ejemplo, el usuario Administrador debe obtener un color específico en el campo de usuario y el inicio de sesión debe hacerse con una contraseña local.",
        "ITALIAN": "In questo esempio, l'utente Amministratore dovrebbe avere un colore specifico nel campo utente e il login dovrebbe essere fatto con una password locale.",
        "CHINESE": "在本例中，管理员用户应在用户字段中使用特定颜色，并使用本地密码登录。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "В данном примере пользователь Administrator должен получить определенный цвет в поле пользователя, а вход в систему должен осуществляться с помощью локального пароля.",
        "FRENCH": "Dans cet exemple, l'utilisateur Administrateur doit obtenir une couleur spécifique dans le champ utilisateur et la connexion doit se faire avec un mot de passe local.",
        "SPANISH": "En este ejemplo, el usuario Administrador debe obtener un color específico en el campo de usuario y el inicio de sesión debe hacerse con una contraseña local.",
        "ITALIAN": "In questo esempio, l'utente Amministratore dovrebbe avere un colore specifico nel campo utente e il login dovrebbe essere fatto con una password locale.",
        "CHINESE": "在本例中，管理员用户应在用户字段中使用特定颜色，并使用本地密码登录。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
