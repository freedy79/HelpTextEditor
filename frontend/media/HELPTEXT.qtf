    "PRINT_A4_NETWORK_APPL_STEP_1": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Start the task, e.g. [My backweighing with GLP print on DIN A4] with the assigned print profile: [My GLP print to A4 network printer].",
        "GERMAN": "Starten Sie die Task z. B. [Mein Rückwägen mit GLP Druck auf DIN A4] mit dem darin zugewiesenen Druckprofil [Mein GLP Druck auf A4 Netzwerk-Drucker].",
        "RUSSIAN": "Запустите задание, например, [Мое взвешивание с GLP печать на DIN A4] с назначенным профилем печати: [Моя печать GLP на сетевом принтере A4].",
        "FRENCH": "Lancez la tâche, par exemple [Ma pesée de contrôle avec impression GLP sur DIN A4] avec le profil d'impression attribué : [Mon impression GLP sur une imprimante réseau A4].",
        "SPANISH": "Inicie la tarea, por ejemplo, [Mi pesaje posterior con impresión GLP en DIN A4] con el perfil de impresión asignado: [Mi impresión GLP en impresora de red A4].",
        "ITALIAN": "Avviare l'attività, ad es. [La mia pesa posteriore con stampa BPL su DIN A4] con il profilo di stampa assegnato: [La mia stampa BPL su stampante di rete A4].",
        "CHINESE": "使用指定的打印配置文件启动任务，例如[我的背重与 GLP 打印到 DIN A4]：[我的 GLP 打印到 A4 网络打印机]。",
        "JAPANESE": "タスクを開始します。例えば、[My back weighing with GLP print on DIN A4]を割り当てられた印刷プロファイルで実行します：[A4ネットワークプリンターへのGLP印刷]。",
        "KOREAN": "할당된 인쇄 프로필을 사용하여 [DIN A4에 GLP 인쇄로 내 백중량] 작업을 시작합니다(예: [내 백중량을 DIN A4로 인쇄]): [A4 네트워크 프린터로 내 GLP 인쇄]."
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Запустите задание, например, [Мое взвешивание с GLP печать на DIN A4] с назначенным профилем печати: [Моя печать GLP на сетевом принтере A4].",
        "FRENCH": "Lancez la tâche, par exemple [Ma pesée de contrôle avec impression GLP sur DIN A4] avec le profil d'impression attribué : [Mon impression GLP sur une imprimante réseau A4].",
        "SPANISH": "Inicie la tarea, por ejemplo, [Mi pesaje posterior con impresión GLP en DIN A4] con el perfil de impresión asignado: [Mi impresión GLP en impresora de red A4].",
        "ITALIAN": "Avviare l'attività, ad es. [La mia pesa posteriore con stampa BPL su DIN A4] con il profilo di stampa assegnato: [La mia stampa BPL su stampante di rete A4].",
        "CHINESE": "使用指定的打印配置文件启动任务，例如[我的背重与 GLP 打印到 DIN A4]：[我的 GLP 打印到 A4 网络打印机]。",
        "JAPANESE": "タスクを開始します。例えば、[My back weighing with GLP print on DIN A4]を割り当てられた印刷プロファイルで実行します：[A4ネットワークプリンターへのGLP印刷]。",
        "KOREAN": "할당된 인쇄 프로필을 사용하여 [DIN A4에 GLP 인쇄로 내 백중량] 작업을 시작합니다(예: [내 백중량을 DIN A4로 인쇄]): [A4 네트워크 프린터로 내 GLP 인쇄]."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_A4_NETWORK_APPL_STEP_2": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The specified values for the backweighing application are displayed in an overview.",
        "GERMAN": "Die vorgegebenen Werte für die Anwendung Rückwägen werden in einer Übersicht angezeigt.",
        "RUSSIAN": "Заданные значения для приложения обратного взвешивания отображаются в виде обзора.",
        "FRENCH": "Les valeurs spécifiées pour l'application de la pesée finale sont affichées dans une vue d'ensemble.",
        "SPANISH": "Los valores especificados para la aplicación de pesaje por retroceso se muestran en un resumen.",
        "ITALIAN": "I valori specificati per l'applicazione di pesatura posteriore sono visualizzati in una panoramica.",
        "CHINESE": "背重称量应用的指定值显示在概览中。",
        "JAPANESE": "後方計量アプリケーションに指定された値は、概要に表示されます。",
        "KOREAN": "백계량 애플리케이션에 대해 지정된 값이 개요에 표시됩니다."
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Заданные значения для приложения обратного взвешивания отображаются в виде обзора.",
        "FRENCH": "Les valeurs spécifiées pour l'application de la pesée finale sont affichées dans une vue d'ensemble.",
        "SPANISH": "Los valores especificados para la aplicación de pesaje por retroceso se muestran en un resumen.",
        "ITALIAN": "I valori specificati per l'applicazione di pesatura posteriore sono visualizzati in una panoramica.",
        "CHINESE": "背重称量应用的指定值显示在概览中。",
        "JAPANESE": "後方計量アプリケーションに指定された値は、概要に表示されます。",
        "KOREAN": "백계량 애플리케이션에 대해 지정된 값이 개요에 표시됩니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
