    "MENU_SETTINGS_REPORT_SMB_CONF_STEP_2_F": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Also enter the name of a sub-directory on the server, in which to save the files.",
        "GERMAN": "Für die Ablage der Dateien können Sie auch ein Unterverzeichnis auf dem Server mit angeben.",
        "RUSSIAN": "Также введите имя подкаталога на сервере, в котором будут сохранены файлы.",
        "FRENCH": "Saisissez également le nom d'un sous-répertoire sur le serveur, dans lequel enregistrer les fichiers.",
        "SPANISH": "Introduzca también el nombre de un subdirectorio en el servidor, en el que guardar los archivos.",
        "ITALIAN": "Inserisci anche il nome di una sotto-directory sul server, in cui salvare i file.",
        "CHINESE": "同时输入服务器上保存文件的子目录名称。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Также введите имя подкаталога на сервере, в котором будут сохранены файлы.",
        "FRENCH": "Saisissez également le nom d'un sous-répertoire sur le serveur, dans lequel enregistrer les fichiers.",
        "SPANISH": "Introduzca también el nombre de un subdirectorio en el servidor, en el que guardar los archivos.",
        "ITALIAN": "Inserisci anche il nome di una sotto-directory sul server, in cui salvare i file.",
        "CHINESE": "同时输入服务器上保存文件的子目录名称。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "MENU_SETTINGS_REPORT_SMB_CONF_STEP_2_G": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Enter the username and password for access to the authorized drive in your network. Pay attention to the correct notation here too, particularly, upper/lower case letters.",
        "GERMAN": "Geben Sie den Benutzernamen und das Passwort für den Zugriff auf das freigegebene Laufwerk in Ihrem Netzwerk ein. Achten sie hier ebenfalls auf die richtige Schreibweise, insbesondere auf Groß- und Kleinschreibung.",
        "RUSSIAN": "Введите имя пользователя и пароль для доступа к авторизованному диску в вашей сети. Обратите внимание на правильность обозначений и здесь, в частности, на заглавные/прописные буквы.",
        "FRENCH": "Entrez le nom d'utilisateur et le mot de passe pour l'accès au lecteur autorisé dans votre réseau. Faites attention à la notation correcte ici aussi, en particulier, les lettres majuscules/minuscules.",
        "SPANISH": "Introduzca el nombre de usuario y la contraseña para acceder a la unidad autorizada en su red. Preste atención a la notación correcta aquí también, en particular, las letras mayúsculas / minúsculas.",
        "ITALIAN": "Inserisci il nome utente e la password per l'accesso all'unità autorizzata nella tua rete. Fate attenzione alla notazione corretta anche qui, in particolare alle lettere maiuscole/minuscole.",
        "CHINESE": "输入用户名和密码，以便访问网络中的授权硬盘。这里也要注意正确的符号，尤其是大/小写字母。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Введите имя пользователя и пароль для доступа к авторизованному диску в вашей сети. Обратите внимание на правильность обозначений и здесь, в частности, на заглавные/прописные буквы.",
        "FRENCH": "Entrez le nom d'utilisateur et le mot de passe pour l'accès au lecteur autorisé dans votre réseau. Faites attention à la notation correcte ici aussi, en particulier, les lettres majuscules/minuscules.",
        "SPANISH": "Introduzca el nombre de usuario y la contraseña para acceder a la unidad autorizada en su red. Preste atención a la notación correcta aquí también, en particular, las letras mayúsculas / minúsculas.",
        "ITALIAN": "Inserisci il nome utente e la password per l'accesso all'unità autorizzata nella tua rete. Fate attenzione alla notazione corretta anche qui, in particolare alle lettere maiuscole/minuscole.",
        "CHINESE": "输入用户名和密码，以便访问网络中的授权硬盘。这里也要注意正确的符号，尤其是大/小写字母。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
