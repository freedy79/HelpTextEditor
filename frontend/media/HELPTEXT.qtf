    "PRINT_A4_NETWORK_INSTRUCTION_1": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "This example describes the setup and application of a [Backweighing] task with output of the accepted values for weighing and backweighing in GLP-compliant form in PDF format using a network printer with DIN A4 paper.",
        "GERMAN": "Dieses Beispiel beschreibt das Einrichten und Anwenden einer Task [Rückwägen] mit Ausgabe der übernommenen Werte für Einwaage und Rückwaage in GLP gerechter Form im PDF-Format über einen Netzwerk-Drucker auf DIN A4-Papier.",
        "FRENCH": "Cet exemple décrit la configuration et l'application d'une tâche [Pesée finale] avec la sortie des valeurs acceptées pour la pesée et la pesée finale sous forme conforme aux BPL en format PDF à l'aide d'une imprimante réseau avec du papier DIN A4.",
        "RUSSIAN": "Этот пример описывает настройку и применение задачи [Backweighing] с выводом принятых значений для взвешивания и обратного взвешивания в GLP-совместимой форме в формате PDF с использованием сетевого принтера с бумагой DIN A4.",
        "SPANISH": "Este ejemplo describe la configuración y aplicación de una tarea [Backweighing] con la salida de los valores aceptados para el pesaje y el contrapeso en forma de conformidad con las BPL en formato PDF utilizando una impresora de red con papel DIN A4.",
        "ITALIAN": "Questo esempio descrive l'impostazione e l'applicazione di un compito [Backweighing] con l'output dei valori accettati per la pesatura e il contrappeso in forma conforme a GLP in formato PDF utilizzando una stampante di rete con carta DIN A4.",
        "CHINESE": "本示例介绍了[背秤量]任务的设置和应用，使用 DIN A4 纸张的网络打印机以 PDF 格式输出符合 GLP 标准的秤量和背秤量认可值。",
        "JAPANESE": "この例では、DIN A4用紙を使用したネットワークプリンタを使用して、GLPに準拠した形式で計量およびバックウェイトの許容値をPDF形式で出力する[Backweighing]タスクのセットアップと適用について説明します。",
        "KOREAN": "이 예에서는 DIN A4 용지의 네트워크 프린터를 사용하여 GLP 준수 형식의 PDF 형식으로 계량 및 역계량에 허용되는 값을 출력하는 [역계량] 작업의 설정 및 적용에 대해 설명합니다."
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Cet exemple décrit la configuration et l'application d'une tâche [Pesée finale] avec la sortie des valeurs acceptées pour la pesée et la pesée finale sous forme conforme aux BPL en format PDF à l'aide d'une imprimante réseau avec du papier DIN A4.",
        "RUSSIAN": "Этот пример описывает настройку и применение задачи [Backweighing] с выводом принятых значений для взвешивания и обратного взвешивания в GLP-совместимой форме в формате PDF с использованием сетевого принтера с бумагой DIN A4.",
        "SPANISH": "Este ejemplo describe la configuración y aplicación de una tarea [Backweighing] con la salida de los valores aceptados para el pesaje y el contrapeso en forma de conformidad con las BPL en formato PDF utilizando una impresora de red con papel DIN A4.",
        "ITALIAN": "Questo esempio descrive l'impostazione e l'applicazione di un compito [Backweighing] con l'output dei valori accettati per la pesatura e il contrappeso in forma conforme a GLP in formato PDF utilizzando una stampante di rete con carta DIN A4.",
        "CHINESE": "本示例介绍了[背秤量]任务的设置和应用，使用 DIN A4 纸张的网络打印机以 PDF 格式输出符合 GLP 标准的秤量和背秤量认可值。",
        "JAPANESE": "この例では、DIN A4用紙を使用したネットワークプリンタを使用して、GLPに準拠した形式で計量およびバックウェイトの許容値をPDF形式で出力する[Backweighing]タスクのセットアップと適用について説明します。",
        "KOREAN": "이 예에서는 DIN A4 용지의 네트워크 프린터를 사용하여 GLP 준수 형식의 PDF 형식으로 계량 및 역계량에 허용되는 값을 출력하는 [역계량] 작업의 설정 및 적용에 대해 설명합니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
        "RUSSIAN": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_A4_NETWORK_INSTRUCTION_2": {
      "group": "HELP_EXAMPLE",
