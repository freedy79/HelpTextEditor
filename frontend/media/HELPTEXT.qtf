    "TCA_EXAMPLE_EXPORT_DSD_CONF_STEP_1": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ]. Do not translate QAPP and QAPP Center.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Activate the [Connection to FTP/FTPS] QAPP extension, if this has not yet been done.",
        "GERMAN": "Aktivieren Sie die QAPP-Erweiterung [Verbindung zu FTP/FTPS], falls noch nicht erfolgt.",
        "RUSSIAN": "Активируйте расширение QAPP [Подключение к FTP/FTPS], если это еще не было сделано.",
        "FRENCH": "Activez l'extension QAPP [Connexion à FTP/FTPS], si cela n'a pas encore été fait.",
        "SPANISH": "Active la extensión QAPP [Conexión a FTP/FTPS], si aún no lo ha hecho.",
        "ITALIAN": "Attivare l'estensione QAPP [Connessione a FTP/FTPS], se questo non è stato ancora fatto.",
        "CHINESE": "如果尚未激活[连接到 FTP/FTPS] QAPP 扩展，则激活此扩展。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Активируйте расширение QAPP [Подключение к FTP/FTPS], если это еще не было сделано.",
        "FRENCH": "Activez l'extension QAPP [Connexion à FTP/FTPS], si cela n'a pas encore été fait.",
        "SPANISH": "Active la extensión QAPP [Conexión a FTP/FTPS], si aún no lo ha hecho.",
