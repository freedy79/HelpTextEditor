    "NETWORK_A4_PRINTER_TITLE": {
      "group": "HELP_TITLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Network printer",
        "GERMAN": "Netzwerk-Drucker",
        "RUSSIAN": "Сетевой принтер",
        "FRENCH": "Imprimante réseau",
        "SPANISH": "Impresora de red",
        "ITALIAN": "Stampante di rete",
        "CHINESE": "网络打印机"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Сетевой принтер",
        "FRENCH": "Imprimante réseau",
        "SPANISH": "Impresora de red",
        "ITALIAN": "Stampante di rete",
        "CHINESE": "网络打印机"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "NETWORK_A4_PRINTER_INSTRUCTION_1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The network printer connector allows, for example, connections to an A4 printer in an independent Wi-Fi network with standard Wi-Fi components, or in a corporate network per DHCP with standard authentication methods. The network printer must support IPP (Internet Printing Protocol).",
        "GERMAN": "Der Konnektor Netzwerk-Drucker ermöglicht die Verbindung zu in einem z. B. A4-Drucker in einem unabhängigen Wi-Fi-Netzwerk mit Standard-Wi-Fi-Komponenten oder in einem Firmennetzwerk per DHCP mit Standard-Authentifizierungsmethoden. Der Netzwerk-Drucker muss IPP (Internet Printing Protocol) unterstützen.",
        "RUSSIAN": "Коннектор для сетевого принтера позволяет, например, подключаться к принтеру формата A4 в независимой сети Wi-Fi со стандартными компонентами WiF-i или в корпоративной сети по DHCP со стандартными методами аутентификации. Сетевой принтер должен поддерживать протокол IPP (Internet Printing Protocol).",
        "FRENCH": "Le connecteur pour imprimante réseau permet, par exemple, de se connecter à une imprimante A4 dans un réseau Wi-Fi indépendant avec des composants WiF-i standard, ou dans un réseau d'entreprise par DHCP avec des méthodes d'authentification standard. L'imprimante réseau doit prendre en charge le protocole IPP (Internet Printing Protocol).",
        "SPANISH": "El conector de impresora de red permite, por ejemplo, la conexión a una impresora A4 en una red Wi-Fi independiente con componentes Wi-Fi estándar, o en una red corporativa por DHCP con métodos de autenticación estándar. La impresora de red debe ser compatible con IPP (Internet Printing Protocol).",
        "ITALIAN": "Il connettore della stampante di rete permette, per esempio, le connessioni a una stampante A4 in una rete Wi-Fi indipendente con componenti Wi-Fi standard, o in una rete aziendale per DHCP con metodi di autenticazione standard. La stampante di rete deve supportare IPP (Internet Printing Protocol).",
        "CHINESE": "例如，网络打印机连接器允许在独立的 Wi-Fi 网络中使用标准 Wi-Fi 组件连接 A4 打印机，或在企业网络中使用标准认证方法通过 DHCP 连接 A4 打印机。网络打印机必须支持 IPP（互联网打印协议）。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Коннектор для сетевого принтера позволяет, например, подключаться к принтеру формата A4 в независимой сети Wi-Fi со стандартными компонентами Wi-Fi или в корпоративной сети по DHCP со стандартными методами аутентификации. Сетевой принтер должен поддерживать протокол IPP (Internet Printing Protocol).",
        "FRENCH": "Le connecteur pour imprimante réseau permet, par exemple, de se connecter à une imprimante A4 dans un réseau Wi-Fi indépendant avec des composants Wi-Fi standard, ou dans un réseau d'entreprise par DHCP avec des méthodes d'authentification standard. L'imprimante réseau doit prendre en charge le protocole IPP (Internet Printing Protocol).",
        "SPANISH": "El conector de impresora de red permite, por ejemplo, la conexión a una impresora A4 en una red Wi-Fi independiente con componentes Wi-Fi estándar, o en una red corporativa por DHCP con métodos de autenticación estándar. La impresora de red debe ser compatible con IPP (Internet Printing Protocol).",
        "ITALIAN": "Il connettore della stampante di rete permette, per esempio, le connessioni a una stampante A4 in una rete Wi-Fi indipendente con componenti Wi-Fi standard, o in una rete aziendale per DHCP con metodi di autenticazione standard. La stampante di rete deve supportare IPP (Internet Printing Protocol).",
        "CHINESE": "例如，网络打印机连接器允许在独立的 Wi-Fi 网络中使用标准 Wi-Fi 组件连接 A4 打印机，或在企业网络中使用标准认证方法通过 DHCP 连接 A4 打印机。网络打印机必须支持 IPP（互联网打印协议）。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "NETWORK_A4_PRINTER_INSTRUCTION_2": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "A connector requires a connector name, an IP address, or a host name to be entered on the printer, as well as the transfer protocol.",
        "GERMAN": "Für den Konnektor muss ein Konnektor Name, eine IP-Adresse oder ein Host Name vom Drucker eingegeben sowie das Protokoll für die Übertragung eingestellt werden.",
        "RUSSIAN": "Для коннектора требуется ввести имя коннектора, IP-адрес или имя хоста на принтере, а также протокол передачи данных.",
        "FRENCH": "Un connecteur nécessite la saisie d'un nom de connecteur, d'une adresse IP ou d'un nom d'hôte sur l'imprimante, ainsi que du protocole de transfert.",
        "SPANISH": "Un conector requiere que se introduzca un nombre de conector, una dirección IP o un nombre de host en la impresora, así como el protocolo de transferencia.",
        "ITALIAN": "Un connettore richiede un nome di connettore, un indirizzo IP o un nome di host da inserire sulla stampante, così come il protocollo di trasferimento.",
        "CHINESE": "连接器要求在打印机上输入连接器名称、IP 地址或主机名以及传输协议。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Для коннектора требуется ввести имя коннектора, IP-адрес или имя хоста на принтере, а также протокол передачи данных.",
        "FRENCH": "Un connecteur nécessite la saisie d'un nom de connecteur, d'une adresse IP ou d'un nom d'hôte sur l'imprimante, ainsi que du protocole de transfert.",
        "SPANISH": "Un conector requiere que se introduzca un nombre de conector, una dirección IP o un nombre de host en la impresora, así como el protocolo de transferencia.",
        "ITALIAN": "Un connettore richiede un nome di connettore, un indirizzo IP o un nome di host da inserire sulla stampante, così come il protocollo di trasferimento.",
        "CHINESE": "连接器要求在打印机上输入连接器名称、IP 地址或主机名以及传输协议。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "NETWORK_A4_PRINTER_INSTRUCTION_3": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The separate description [Print concept] describes the setup and application of a network printer with an application example.",
        "GERMAN": "In der separaten Beschreibung [Druckkonzept] ist das Einrichten und Anwenden eines Netzwerk-Druckers in einem Anwendungsbeispiel beschrieben.",
        "RUSSIAN": "В отдельном описании [Концепция печати] описывается настройка и применение сетевого принтера с примером применения.",
        "FRENCH": "La description séparée [Concept d'impression] décrit la configuration et l'application d'une imprimante réseau avec un exemple d'application.",
        "SPANISH": "La descripción separada [Concepto de impresión] describe la configuración y aplicación de una impresora de red con un ejemplo de aplicación.",
        "ITALIAN": "La descrizione separata [Print concept] descrive la configurazione e l'applicazione di una stampante di rete con un esempio di applicazione.",
        "CHINESE": "单独的说明 [打印概念] 通过一个应用实例介绍了网络打印机的设置和应用。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "В отдельном описании [Концепция печати] описывается настройка и применение сетевого принтера с примером применения.",
        "FRENCH": "La description séparée [Concept d'impression] décrit la configuration et l'application d'une imprimante réseau avec un exemple d'application.",
        "SPANISH": "La descripción separada [Concepto de impresión] describe la configuración y aplicación de una impresora de red con un ejemplo de aplicación.",
        "ITALIAN": "La descrizione separata [Print concept] descrive la configurazione e l'applicazione di una stampante di rete con un esempio di applicazione.",
        "CHINESE": "单独的说明 [打印概念] 通过一个应用实例介绍了网络打印机的设置和应用。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
