      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Incompatible software downgrade detected",
        "GERMAN": "Nicht kompatibles Software-Downgrade",
        "RUSSIAN": "Обнаружено несовместимое обновление программного обеспечения",
        "FRENCH": "Mise à niveau logicielle incompatible détectée",
        "SPANISH": "Se ha detectado una bajada de software incompatible",
        "ITALIAN": "Rilevato un downgrade del software incompatibile",
        "CHINESE": "检测到不兼容软件降级"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Обнаружено несовместимое обновление программного обеспечения",
        "FRENCH": "Mise à niveau logicielle incompatible détectée",
        "SPANISH": "Se ha detectado una bajada de software incompatible",
        "ITALIAN": "Rilevato un downgrade del software incompatibile",
        "CHINESE": "检测到不兼容软件降级"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "DEVICE_MAINTENANCE_FIRMWARE_UPDATE_ERROR_HANDLING_4_INSTRUCTION": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "You have installed a software version that had a lower version and data level than the previously installed version. Since proper use cannot be ensured, all data will be deleted. The device must be set up again.",
        "GERMAN": "Sie haben eine Software-Version installiert, die einen niedrigeren Versions- und Datenstand hatte, als die zuvor installierte Version. Da eine ordnungsgemäße Benutzung nicht sichergestellt werden kann, werden alle Daten gelöscht. Das Gerät muss neu eingerichtet werden.",
        "RUSSIAN": "Вы установили версию программного обеспечения, которая имела более низкий уровень версии и данных, чем ранее установленная версия. Поскольку надлежащее использование не может быть обеспечено, все данные будут удалены. Устройство должно быть настроено заново.",
        "FRENCH": "Vous avez installé une version du logiciel dont le niveau de version et de données était inférieur à celui de la version précédemment installée. L'utilisation correcte ne pouvant être garantie, toutes les données seront effacées. L'appareil doit être configuré à nouveau.",
        "SPANISH": "Ha instalado una versión de software que tenía una versión y un nivel de datos inferiores a los de la versión instalada anteriormente. Como no se puede garantizar un uso correcto, se borrarán todos los datos. El dispositivo debe ser configurado de nuevo.",
        "ITALIAN": "Avete installato una versione del software che aveva una versione e un livello di dati inferiori alla versione precedentemente installata. Poiché non è possibile garantire un uso corretto, tutti i dati vengono cancellati. Il dispositivo deve essere impostato di nuovo.",
        "CHINESE": "您安装的软件版本的版本和数据级别低于之前安装的版本。由于无法确保正常使用，所有数据将被删除。必须重新设置设备。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Вы установили версию программного обеспечения, которая имела более низкий уровень версии и данных, чем ранее установленная версия. Поскольку надлежащее использование не может быть обеспечено, все данные будут удалены. Устройство должно быть настроено заново.",
        "FRENCH": "Vous avez installé une version du logiciel dont le niveau de version et de données était inférieur à celui de la version précédemment installée. L'utilisation correcte ne pouvant être garantie, toutes les données seront effacées. L'appareil doit être configuré à nouveau.",
        "SPANISH": "Ha instalado una versión de software que tenía una versión y un nivel de datos inferiores a los de la versión instalada anteriormente. Como no se puede garantizar un uso correcto, se borrarán todos los datos. El dispositivo debe ser configurado de nuevo.",
        "ITALIAN": "Avete installato una versione del software che aveva una versione e un livello di dati inferiori alla versione precedentemente installata. Poiché non è possibile garantire un uso corretto, tutti i dati vengono cancellati. Il dispositivo deve essere impostato di nuovo.",
        "CHINESE": "您安装的软件版本的版本和数据级别低于之前安装的版本。由于无法确保正常使用，所有数据将被删除。必须重新设置设备。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
