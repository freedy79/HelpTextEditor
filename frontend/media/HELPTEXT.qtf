      "TRANSLATIONS": {
        "ENGLISH": "-Allows you to navigate and search in menus and lists.<br/>-In the menu \"Settings\": Displays the name of the menu.",
        "GERMAN": "-Ermöglicht das Navigieren und Suchen in Menüs und Listen.<br/>-Im Menü \"Einstellungen\": Zeigt den Namen des Menüs an.",
        "RUSSIAN": "-Позволяет осуществлять навигацию и поиск в меню и списках.<br/>В меню \"Настройки\": Отображает название меню.",
        "FRENCH": "-Permet de naviguer et de rechercher dans les menus et les listes.<br/>-Dans le menu \"Réglages\" : Affiche le nom du menu.",
        "ITALIAN": "-Permette di navigare e cercare nei menu e negli elenchi.<br/>Nel menu \"Impostazioni\": Visualizza il nome del menu.",
        "CHINESE": "<br/>在菜单 \"设置 \"中：显示菜单名称。",
        "SPANISH": "-Permite navegar y buscar en menús y listas.<br/>En el menú \"Ajustes\": Muestra el nombre del menú."
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "-Позволяет осуществлять навигацию и поиск в меню и списках.<br/>В меню \"Настройки\": Отображает название меню.",
        "FRENCH": "-Permet de naviguer et de rechercher dans les menus et les listes.<br/>-Dans le menu \"Réglages\" : Affiche le nom du menu.",
        "ITALIAN": "-Permette di navigare e cercare nei menu e negli elenchi.<br/>Nel menu \"Impostazioni\": Visualizza il nome del menu.",
        "CHINESE": "<br/>在菜单 \"设置 \"中：显示菜单名称。",
        "SPANISH": "-Permite navegar y buscar en menús y listas.<br/>En el menú \"Ajustes\": Muestra el nombre del menú."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "ITALIAN": false,
        "CHINESE": false,
