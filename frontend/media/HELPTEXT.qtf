      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "To activate the cleaning support, select the mode that suits you in the [Cleaning support] setting:",
        "GERMAN": "Um die Reinigungsunterstützung zu aktivieren, wählen Sie in der Einstellung [Reinigungsunterstützung] den für Sie passenden Modus aus:",
        "CHINESE": "要激活清洁支持，请在 [清洁支持] 设置中选择适合您的模式：",
        "FRENCH": "Pour activer l'aide au nettoyage, sélectionnez le mode qui vous convient dans le réglage [Aide au nettoyage] :",
        "SPANISH": "Para activar el soporte de limpieza, seleccione el modo adecuado para usted en el ajuste [Soporte de limpieza]:",
        "ITALIAN": "Per attivare il supporto della pulizia, selezionare la modalità appropriata nell'impostazione [Supporto pulizia]:",
        "RUSSIAN": "Чтобы активировать поддержку очистки, выберите подходящий вам режим в настройках [Поддержка очистки]:"
      },
      "AUTOTRANSLATIONS": {
        "CHINESE": "要激活清洁支持，请在 [清洁支持] 设置中选择适合您的模式：",
        "FRENCH": "Pour activer l'aide au nettoyage, sélectionnez le mode qui vous convient dans le réglage [Aide au nettoyage] :",
        "SPANISH": "Para activar el soporte de limpieza, seleccione el modo adecuado para usted en el ajuste [Soporte de limpieza]:",
        "ITALIAN": "Per attivare il supporto della pulizia, selezionare la modalità appropriata nell'impostazione [Supporto pulizia]:",
        "RUSSIAN": "Чтобы активировать поддержку очистки, выберите подходящий вам режим в настройках [Поддержка очистки]:"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "CHINESE": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "RUSSIAN": false
      }
    },
