    "EXAMPLE_SET_LOCAL_PASSW_RULES_CONF_STEP_1_B": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ]. Do not translate QAPP and QAPP Center.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Select the software package [Pharma] and QAPP [User management] in it. The description and version of the QAPP will be displayed.",
        "GERMAN": "Wählen Sie das Software-Paket [Pharma] und darin die QAPP [Benutzerverwaltung]. Es wird die Beschreibung und Version der QAPP angezeigt.",
        "RUSSIAN": "Выберите пакет программного обеспечения [Pharma] и QAPP [User management] в нем. Появится описание и версия QAPP.",
        "FRENCH": "Sélectionnez le progiciel [Pharma] et le QAPP [User management] dans celui-ci. La description et la version du QAPP s'affichent.",
        "SPANISH": "Seleccione el paquete de software [Pharma] y el QAPP [User management] en él. Se mostrará la descripción y la versión del QAPP.",
