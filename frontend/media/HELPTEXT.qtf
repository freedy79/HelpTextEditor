      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Ensure that the [Num] key on your keyboard has been activated.",
        "GERMAN": "Vergewissern Sie sich, dass die [Num]-Taste auf der Tastatur aktiviert ist.",
        "RUSSIAN": "Убедитесь, что клавиша [Num] на вашей клавиатуре активирована.",
        "FRENCH": "Assurez-vous que la touche [Num] de votre clavier est activée.",
        "SPANISH": "Asegúrese de que la tecla [Num] de su teclado esté activada.",
        "ITALIAN": "Assicuratevi che il tasto [Num] della vostra tastiera sia stato attivato.",
        "CHINESE": "确保键盘上的 [Num] 键已激活。",
        "JAPANESE": "キーボードの[Num]キーが有効になっていることを確認してください。",
        "KOREAN": "키보드의 [숫자] 키가 활성화되어 있는지 확인합니다."
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Убедитесь, что клавиша [Num] на вашей клавиатуре активирована.",
        "FRENCH": "Assurez-vous que la touche [Num] de votre clavier est activée.",
        "SPANISH": "Asegúrese de que la tecla [Num] de su teclado esté activada.",
        "ITALIAN": "Assicuratevi che il tasto [Num] della vostra tastiera sia stato attivato.",
        "CHINESE": "确保键盘上的 [Num] 键已激活。",
        "JAPANESE": "キーボードの[Num]キーが有効になっていることを確認してください。",
        "KOREAN": "키보드의 [숫자] 키가 활성화되어 있는지 확인합니다."
      },
      "VERIFIED": {
