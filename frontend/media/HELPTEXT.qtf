        "CHINESE": false
      }
    },
    "WEIGHING_APPLICATION_FILTER_INSTRUCTION_1_STEP_4": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "Do not translate HTML command <b> and </b>",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "<b>Dynamic mode without filter:</b> Deactivates the active application filter. The filtering is reduced to a minimum. Filter option depends on balance dataset.",
        "GERMAN": "<b>Dynamischer Modus ohne Filter:</b> Deaktiviert den aktiven Anwendungsfilter. Die Filterung wird auf ein Minimum reduziert. Die Filteroption hängt vom Datensatz der Waage ab.",
        "RUSSIAN": "",
        "FRENCH": "",
        "SPANISH": "",
        "ITALIAN": "",
        "CHINESE": ""
      },
      "AUTOTRANSLATIONS": {
        "GERMAN": "<b>Dynamischer Modus ohne Filter:</b> Deaktiviert den aktiven Anwendungsfilter. Die Filterung wird auf ein Minimum reduziert. Die Filteroption hängt vom Datensatz der Waage ab."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
