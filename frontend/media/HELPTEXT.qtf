      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "<b>Display data memory</b><br>Displays the memory of the recorded weighing values",
        "GERMAN": "<b>Datenspeicher anzeigen</b><br>Zeigt den Speicher den aufgezeichneten Wägewerte",
        "CHINESE": "<b>显示数据存储器</b><br>显示已记录称重值的存储器",
        "FRENCH": "Afficher la mémoire de données",
        "ITALIAN": "Visualizzare la memoria dati",
        "JAPANESE": "データ保管機器の表示",
        "KOREAN": "데이터 저장 장치 표시",
        "RUSSIAN": "<b>Отображение памяти данных</b><br>Отображает память записанных значений взвешивания",
        "SPANISH": "Mostrar memoria",
        "PORTUGUESE": "Visualizar o dispos. de armazenam. dados",
        "HUNGARIAN": "Adattároló megjelenítése",
        "POLISH": "Wyświetl pamięć danych",
        "TURKISH": "Veri belleği göster",
        "DUTCH": "Datageheugen weergeven",
        "CZECH": "Zobrazit úložiště dat"
      },
      "AUTOTRANSLATIONS": {
        "ENGLISH": "<b>Display data memory</b><br>Displays the memory of the recorded weighing values",
        "CHINESE": "<b>显示数据存储器</b><br>显示已记录称重值的存储器",
        "RUSSIAN": "<b>Отображение памяти данных</b><br>Отображает память записанных значений взвешивания"
