    "PRINT_PC_DIRECT_CONF_STEP_2_D": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Select data fields: one data field corresponds to a cell or column allocation for each output value in the table processing software.",
        "GERMAN": "Datenfelder wählen, ein Datenfeld entspricht einer Zellen- bzw. Spaltenzuordnung, von jedem einzelnen Ausgabewert, in der Tabellenverarbeitungs-Software.",
        "RUSSIAN": "Выберите поля данных: одно поле данных соответствует выделению ячейки или столбца для каждого выходного значения в программе обработки таблиц.",
        "FRENCH": "Sélectionner les champs de données : un champ de données correspond à l'attribution d'une cellule ou d'une colonne pour chaque valeur de sortie dans le logiciel de traitement des tableaux.",
        "SPANISH": "Seleccionar campos de datos: un campo de datos corresponde a una asignación de celdas o columnas para cada valor de salida en el software de procesamiento de tablas.",
        "ITALIAN": "Selezionare i campi di dati: un campo di dati corrisponde all'assegnazione di una cella o di una colonna per ogni valore di uscita nel software di elaborazione delle tabelle.",
        "CHINESE": "选择数据字段：一个数据字段对应表格处理软件中每个输出值的单元格或列分配。",
        "JAPANESE": "データフィールドの選択：1つのデータフィールドは、表処理ソフトウェアの各出力値のセルまたは列の割り当てに対応します。",
        "KOREAN": "데이터 필드 선택: 하나의 데이터 필드는 테이블 처리 소프트웨어에서 각 출력 값에 대한 셀 또는 열 할당에 해당합니다."
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Выберите поля данных: одно поле данных соответствует выделению ячейки или столбца для каждого выходного значения в программе обработки таблиц.",
        "FRENCH": "Sélectionner les champs de données : un champ de données correspond à l'attribution d'une cellule ou d'une colonne pour chaque valeur de sortie dans le logiciel de traitement des tableaux.",
        "SPANISH": "Seleccionar campos de datos: un campo de datos corresponde a una asignación de celdas o columnas para cada valor de salida en el software de procesamiento de tablas.",
        "ITALIAN": "Selezionare i campi di dati: un campo di dati corrisponde all'assegnazione di una cella o di una colonna per ogni valore di uscita nel software di elaborazione delle tabelle.",
        "CHINESE": "选择数据字段：一个数据字段对应表格处理软件中每个输出值的单元格或列分配。",
        "JAPANESE": "データフィールドの選択：1つのデータフィールドは、表処理ソフトウェアの各出力値のセルまたは列の割り当てに対応します。",
        "KOREAN": "데이터 필드 선택: 하나의 데이터 필드는 테이블 처리 소프트웨어에서 각 출력 값에 대한 셀 또는 열 할당에 해당합니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_PC_DIRECT_CONF_STEP_2_E": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Select the decimal points according to the regional settings for the operating system or the table processing software.",
        "GERMAN": "Dezimalzeichen wählen, gemäß der regionalen Einstellungen des Betriebssystems bzw. der Tabellenverarbeitungs-Software.",
        "RUSSIAN": "Выберите десятичные точки в соответствии с региональными настройками операционной системы или программного обеспечения для обработки таблиц.",
        "FRENCH": "Sélectionnez les points décimaux en fonction des paramètres régionaux du système d'exploitation ou du logiciel de traitement des tableaux.",
        "SPANISH": "Seleccione los puntos decimales según la configuración regional del sistema operativo o del software de procesamiento de tablas.",
        "ITALIAN": "Selezionare i punti decimali secondo le impostazioni regionali del sistema operativo o del software di elaborazione delle tabelle.",
        "CHINESE": "根据操作系统或表格处理软件的区域设置选择小数点。",
        "JAPANESE": "オペレーティング・システムまたは表処理ソフトウェアの地域設定に従って、小数点を選択する。",
        "KOREAN": "운영 체제 또는 테이블 처리 소프트웨어의 지역 설정에 따라 소수점 이하 자릿수를 선택합니다."
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Выберите десятичные точки в соответствии с региональными настройками операционной системы или программного обеспечения для обработки таблиц.",
        "FRENCH": "Sélectionnez les points décimaux en fonction des paramètres régionaux du système d'exploitation ou du logiciel de traitement des tableaux.",
        "SPANISH": "Seleccione los puntos decimales según la configuración regional del sistema operativo o del software de procesamiento de tablas.",
        "ITALIAN": "Selezionare i punti decimali secondo le impostazioni regionali del sistema operativo o del software di elaborazione delle tabelle.",
        "CHINESE": "根据操作系统或表格处理软件的区域设置选择小数点。",
        "JAPANESE": "オペレーティング・システムまたは表処理ソフトウェアの地域設定に従って、小数点を選択する。",
        "KOREAN": "운영 체제 또는 테이블 처리 소프트웨어의 지역 설정에 따라 소수점 이하 자릿수를 선택합니다."
      },
      "VERIFIED": {
