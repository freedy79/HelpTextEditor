      "TRANSLATIONS": {
        "ENGLISH": "Print profile Data file",
        "GERMAN": "Druckprofil Datendatei",
        "FRENCH": "Profil d'impression Fichier de données",
        "CHINESE": "打印配置文件 数据文件",
        "SPANISH": "Imprimir perfil Fichero de datos",
        "RUSSIAN": "Профиль печати Файл данных",
