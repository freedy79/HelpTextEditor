      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Подготовка",
        "FRENCH": "Préparation",
        "SPANISH": "Preparación",
        "ITALIAN": "Preparazione",
        "CHINESE": "准备工作"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
