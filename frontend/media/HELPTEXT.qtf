    "EXAMPLE_AUTOM_CREATE_NETWORK_USER_CONF_STEP_1": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The following items are the prerequisite for automatic configuration of a network user in the balance.",
        "GERMAN": "Voraussetzungen für das automatische Einrichten eines Netzwerk-Benutzers auf der Waage sind diese Punkte.",
        "RUSSIAN": "Следующие элементы являются необходимым условием для автоматической настройки сетевого пользователя в весах.",
        "FRENCH": "Les éléments suivants sont la condition préalable à la configuration automatique d'un utilisateur réseau dans la balance.",
        "SPANISH": "Los siguientes elementos son el requisito previo para la configuración automática de un usuario de red en la balanza.",
        "ITALIAN": "I seguenti elementi sono il prerequisito per la configurazione automatica di un utente di rete nella bilancia.",
        "CHINESE": "以下项目是在天平中自动配置网络用户的前提条件。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Следующие элементы являются необходимым условием для автоматической настройки сетевого пользователя в весах.",
        "FRENCH": "Les éléments suivants sont la condition préalable à la configuration automatique d'un utilisateur réseau dans la balance.",
        "SPANISH": "Los siguientes elementos son el requisito previo para la configuración automática de un usuario de red en la balanza.",
        "ITALIAN": "I seguenti elementi sono il prerequisito per la configurazione automatica di un utente di rete nella bilancia.",
        "CHINESE": "以下项目是在天平中自动配置网络用户的前提条件。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "EXAMPLE_AUTOM_CREATE_NETWORK_USER_CONF_STEP_1_A": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ]. Do not translate QAPP and QAPP Center.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The [User management] QAPP extension is activated on the balance.",
        "GERMAN": "Die QAPP-Erweiterung [Benutzerverwaltung] ist auf der Waage aktiviert.",
        "RUSSIAN": "Расширение QAPP [Управление пользователями] активировано на весах.",
        "FRENCH": "L'extension QAPP [Gestion des utilisateurs] est activée sur la balance.",
        "SPANISH": "La extensión [Gestión de usuarios] QAPP se activa en la balanza.",
        "ITALIAN": "L'estensione QAPP [Gestione utenti] è attivata sulla bilancia.",
        "CHINESE": "用户管理] QAPP 扩展已在天平上激活。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Расширение QAPP [Управление пользователями] активировано на весах.",
        "FRENCH": "L'extension QAPP [Gestion des utilisateurs] est activée sur la balance.",
        "SPANISH": "La extensión [Gestión de usuarios] QAPP se activa en la balanza.",
        "ITALIAN": "L'estensione QAPP [Gestione utenti] è attivata sulla bilancia.",
        "CHINESE": "用户管理] QAPP 扩展已在天平上激活。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "EXAMPLE_AUTOM_CREATE_NETWORK_USER_CONF_STEP_1_B": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The balance is connected to the network and an LDAP server is present there.",
        "GERMAN": "Die Waage ist am Netzwerk angeschlossen und dort befindet sich ein LDAP Server.",
        "RUSSIAN": "весы подключены к сети, и в ней присутствует LDAP-сервер.",
        "FRENCH": "La balance est connectée au réseau et un serveur LDAP y est présent.",
        "SPANISH": "La balanza está conectada a la red y en ella hay un servidor LDAP.",
        "ITALIAN": "La bilancia è collegata alla rete ed è presente un server LDAP.",
        "CHINESE": "余额已连接到网络，并且那里有一个 LDAP 服务器。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "весы подключены к сети, и в ней присутствует LDAP-сервер.",
        "FRENCH": "La balance est connectée au réseau et un serveur LDAP y est présent.",
        "SPANISH": "La balanza está conectada a la red y en ella hay un servidor LDAP.",
        "ITALIAN": "La bilancia è collegata alla rete ed è presente un server LDAP.",
        "CHINESE": "余额已连接到网络，并且那里有一个 LDAP 服务器。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "EXAMPLE_AUTOM_CREATE_NETWORK_USER_CONF_STEP_1_C": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The settings for this LDAP server have been configured in the balance, particularly, the [Auto create user] menu item is set to [On] and the predefined settings for language and role are selected.",
        "GERMAN": "Die Einstellungen für diesen LDAP Server sind auf der Waage erfolgt, insbesondere der Punkt [Automatisch Nutzer erstellen] ist auf [Ein] gesetzt und die Voreinstellungen für Sprache und Rolle gewählt.",
        "RUSSIAN": "Настройки для этого LDAP-сервера были настроены в весах, в частности, для пункта меню [Auto create user] установлено значение [On] и выбраны предопределенные настройки для языка и роли.",
        "FRENCH": "Les paramètres de ce serveur LDAP ont été configurés dans le bilan, en particulier, l'élément de menu [Auto create user] est réglé sur [On] et les paramètres prédéfinis pour la langue et le rôle sont sélectionnés.",
        "SPANISH": "Los ajustes para este servidor LDAP han sido configurados en la balanza, en particular, el elemento de menú [Creación automática de usuarios] está ajustado a [Activado] y los ajustes predefinidos para el idioma y el rol están seleccionados.",
        "ITALIAN": "Le impostazioni per questo server LDAP sono state configurate nel bilancio, in particolare, la voce di menu [Auto create user] è impostata su [On] e le impostazioni predefinite per la lingua e il ruolo sono selezionate.",
        "CHINESE": "该 LDAP 服务器的设置已在余额中配置，特别是 [自动创建用户] 菜单项已设置为 [开]，并且选择了语言和角色的预定义设置。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Настройки для этого LDAP-сервера были настроены в весах, в частности, для пункта меню [Auto create user] установлено значение [On] и выбраны предопределенные настройки для языка и роли.",
        "FRENCH": "Les paramètres de ce serveur LDAP ont été configurés dans le bilan, en particulier, l'élément de menu [Auto create user] est réglé sur [On] et les paramètres prédéfinis pour la langue et le rôle sont sélectionnés.",
        "SPANISH": "Los ajustes para este servidor LDAP han sido configurados en la balanza, en particular, el elemento de menú [Creación automática de usuarios] está ajustado a [Activado] y los ajustes predefinidos para el idioma y el rol están seleccionados.",
        "ITALIAN": "Le impostazioni per questo server LDAP sono state configurate nel bilancio, in particolare, la voce di menu [Auto create user] è impostata su [On] e le impostazioni predefinite per la lingua e il ruolo sono selezionate.",
        "CHINESE": "该 LDAP 服务器的设置已在余额中配置，特别是 [自动创建用户] 菜单项已设置为 [开]，并且选择了语言和角色的预定义设置。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
