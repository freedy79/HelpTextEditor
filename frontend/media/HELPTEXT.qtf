      "TRANSLATIONS": {
        "GERMAN": "Hier finden Sie einen Überblick zu folgenden Themen:",
        "ENGLISH": "Here you will find an overview of the following topics:",
        "CHINESE": "在这里，您将看到以下主题的概述：",
        "FRENCH": "Vous trouverez ici un aperçu des thèmes suivants :",
        "ITALIAN": "Qui troverete una panoramica dei seguenti argomenti:",
        "SPANISH": "Aquí encontrará un resumen de los siguientes temas:",
        "RUSSIAN": "Здесь вы найдете обзор следующих тем:",
        "JAPANESE": "ここでは、以下のトピックの概要をご覧いただけます：",
        "KOREAN": "여기에서 다음 주제에 대한 개요를 확인할 수 있습니다:"
      },
      "AUTOTRANSLATIONS": {
        "ENGLISH": "Here you will find an overview of the following topics:",
        "CHINESE": "在这里，您将看到以下主题的概述：",
        "FRENCH": "Vous trouverez ici un aperçu des thèmes suivants :",
        "ITALIAN": "Qui troverete una panoramica dei seguenti argomenti:",
        "SPANISH": "Aquí encontrará un resumen de los siguientes temas:",
        "RUSSIAN": "Здесь вы найдете обзор следующих тем:",
        "JAPANESE": "ここでは、以下のトピックの概要をご覧いただけます：",
        "KOREAN": "여기에서 다음 주제에 대한 개요를 확인할 수 있습니다:"
      },
      "VERIFIED": {
        "GERMAN": false,
        "ENGLISH": false,
        "CHINESE": false,
        "FRENCH": false,
        "ITALIAN": false,
        "SPANISH": false,
        "RUSSIAN": false
      }
    },
    "DEVICE_CONCEPT_INSTRUCTION_2": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "GERMAN": "Bedienen Sie das Gerät mit einem Finger über den Bildschirm. Folgende Aktionen sind möglich:",
        "ENGLISH": "Operate the device with one finger over the screen. The following actions are possible:",
        "CHINESE": "用一根手指在屏幕上操作设备。可以执行以下操作：",
        "FRENCH": "Commandez l'appareil avec un doigt sur l'écran. Les actions suivantes sont possibles :",
        "ITALIAN": "Azionare il dispositivo con un dito sullo schermo. Sono possibili le seguenti azioni:",
        "SPANISH": "Maneje el dispositivo con un dedo sobre la pantalla. Son posibles las siguientes acciones:",
        "RUSSIAN": "Проведите одним пальцем по экрану устройства. Возможны следующие действия:",
        "JAPANESE": "画面の上に指を1本置いて操作する。以下の操作が可能です：",
        "KOREAN": "한 손가락으로 화면을 가리키며 기기를 조작합니다. 다음과 같은 동작이 가능합니다:"
      },
      "AUTOTRANSLATIONS": {
        "ENGLISH": "Operate the device with one finger over the screen. The following actions are possible:",
        "CHINESE": "用一根手指在屏幕上操作设备。可以执行以下操作：",
        "FRENCH": "Commandez l'appareil avec un doigt sur l'écran. Les actions suivantes sont possibles :",
        "ITALIAN": "Azionare il dispositivo con un dito sullo schermo. Sono possibili le seguenti azioni:",
        "SPANISH": "Maneje el dispositivo con un dedo sobre la pantalla. Son posibles las siguientes acciones:",
        "RUSSIAN": "Проведите одним пальцем по экрану устройства. Возможны следующие действия:",
        "JAPANESE": "画面の上に指を1本置いて操作する。以下の操作が可能です：",
        "KOREAN": "한 손가락으로 화면을 가리키며 기기를 조작합니다. 다음과 같은 동작이 가능합니다:"
      },
      "VERIFIED": {
        "GERMAN": false,
        "ENGLISH": false,
        "CHINESE": false,
        "FRENCH": false,
        "ITALIAN": false,
        "SPANISH": false,
