      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Preload",
        "GERMAN": "Vorlast",
        "FRENCH": "Précharge",
        "RUSSIAN": "Предварительная нагрузка",
        "SPANISH": "Precarga",
        "ITALIAN": "Precarico",
        "CHINESE": "预载"
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Précharge",
        "RUSSIAN": "Предварительная нагрузка",
        "SPANISH": "Precarga",
        "ITALIAN": "Precarico",
        "CHINESE": "预载"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
        "RUSSIAN": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "WEIGHING_PRELOAD_INSTRUCTION_1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Technical equipment that should be permanently on the balance, such as a density determination set, can thus be taken into account, enabling calibration and adjustment functions, such as isoCAL, despite the presence of a load.",
        "GERMAN": "Technische Einrichtungen, die sich ständig auf der Waage befinden sollen, wie z. B. ein Dichtebestimmungs-Set, können verwendet werden. Die Kalibrier- und Justierfunktion, wie z. B. isoCAL, können trotz vorhandener Last durchgeführt werden.",
        "RUSSIAN": "Техническое оборудование, которое должно постоянно находиться на весах, например, набор для определения плотности, может быть учтено, что позволяет выполнять функции калибровки и настройки, такие как isoCAL, несмотря на наличие груза.",
        "FRENCH": "Les équipements techniques qui devraient se trouver en permanence sur la balance, comme un ensemble de détermination de la densité, peuvent ainsi être pris en compte, ce qui permet des fonctions de calibrage et d'ajustement, comme isoCAL, malgré la présence d'une charge.",
        "SPANISH": "De este modo, se pueden tener en cuenta los equipos técnicos que deben estar permanentemente en la balanza, como un juego de determinación de la densidad, lo que permite realizar funciones de calibración y ajuste, como isoCAL, a pesar de la presencia de una carga.",
        "ITALIAN": "Le attrezzature tecniche che dovrebbero essere permanentemente sulla bilancia, come un set di determinazione della densità, possono così essere prese in considerazione, consentendo funzioni di calibrazione e regolazione, come l'isoCAL, nonostante la presenza di un carico.",
        "CHINESE": "这样就可以考虑到天平上的永久性技术设备，如密度测定装置，从而实现校准和调整功能，如isoCAL，尽管存在负载。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Техническое оборудование, которое должно постоянно находиться на весах, например, набор для определения плотности, может быть учтено, что позволяет выполнять функции калибровки и настройки, такие как isoCAL, несмотря на наличие груза.",
        "FRENCH": "Les équipements techniques qui devraient se trouver en permanence sur la balance, comme un ensemble de détermination de la densité, peuvent ainsi être pris en compte, ce qui permet des fonctions de calibrage et d'ajustement, comme isoCAL, malgré la présence d'une charge.",
        "SPANISH": "De este modo, se pueden tener en cuenta los equipos técnicos que deben estar permanentemente en la balanza, como un juego de determinación de la densidad, lo que permite realizar funciones de calibración y ajuste, como isoCAL, a pesar de la presencia de una carga.",
        "ITALIAN": "Le attrezzature tecniche che dovrebbero essere permanentemente sulla bilancia, come un set di determinazione della densità, possono così essere prese in considerazione, consentendo funzioni di calibrazione e regolazione, come l'isoCAL, nonostante la presenza di un carico.",
        "CHINESE": "这样就可以考虑到天平上的永久性技术设备，如密度测定装置，从而实现校准和调整功能，如isoCAL，尽管存在负载。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "WEIGHING_PRELOAD_INSTRUCTION_2": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "This function is blocked in conformity-rated (calibrated) balances.",
        "GERMAN": "Bei konformitätsbewerteten (geeichten) Waagen ist diese Funktion gesperrt.",
        "RUSSIAN": "Эта функция заблокирована в весах с сертификатом соответствия (калиброванных).",
        "FRENCH": "Cette fonction est bloquée dans les balances conformes (calibrées).",
        "SPANISH": "Esta función está bloqueada en las balanzas de conformidad (calibradas).",
        "ITALIAN": "Questa funzione è bloccata nelle bilance classificate a norma (calibrate).",
        "CHINESE": "该功能在合格评定（校准）天平中被禁止使用。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Эта функция заблокирована в весах с сертификатом соответствия (калиброванных).",
        "FRENCH": "Cette fonction est bloquée dans les balances conformes (calibrées).",
        "SPANISH": "Esta función está bloqueada en las balanzas de conformidad (calibradas).",
        "ITALIAN": "Questa funzione è bloccata nelle bilance classificate a norma (calibrate).",
        "CHINESE": "该功能在合格评定（校准）天平中被禁止使用。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "WEIGHING_SET_PRELOAD_TITLE": {
      "group": "HELP_TITLE",
