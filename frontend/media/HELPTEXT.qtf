    "PRINT_A4_NETWORK_APPL_STEP_3": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Use the [+] button to activate the creation of a new batch and enter a unique designation for your batch (measurement, test).",
        "GERMAN": "Aktivieren Sie mit der Schaltfläche [+] das Anlegen einer neuen Charge und geben Sie eine eindeutige Bezeichnung für Ihre Charge (Messung, Versuch) ein.",
        "RUSSIAN": "Используйте кнопку [+] для активации создания новой партии и введите уникальное обозначение для вашей партии (измерение, тест).",
        "FRENCH": "Utilisez le bouton [+] pour activer la création d'un nouveau lot et entrez une désignation unique pour votre lot (mesure, test).",
        "SPANISH": "Utilice el botón [+] para activar la creación de un nuevo lote e introduzca una designación única para su lote (medición, prueba).",
        "ITALIAN": "Usa il pulsante [+] per attivare la creazione di un nuovo lotto e inserisci una denominazione unica per il tuo lotto (misurazione, test).",
        "CHINESE": "使用 [+] 按钮激活创建新批次，并输入批次的唯一名称（测量、测试）。",
        "JAPANESE": "新規バッチの作成を有効にするには、[+]ボタンを使用し、バッチに固有の名称（測定、テスト）を入力します。",
        "KOREAN": "+] 버튼을 사용하여 새 배치 생성을 활성화하고 배치에 대한 고유한 지정(측정, 테스트)을 입력합니다."
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Используйте кнопку [+] для активации создания новой партии и введите уникальное обозначение для вашей партии (измерение, тест).",
        "FRENCH": "Utilisez le bouton [+] pour activer la création d'un nouveau lot et entrez une désignation unique pour votre lot (mesure, test).",
        "SPANISH": "Utilice el botón [+] para activar la creación de un nuevo lote e introduzca una designación única para su lote (medición, prueba).",
        "ITALIAN": "Usa il pulsante [+] per attivare la creazione di un nuovo lotto e inserisci una denominazione unica per il tuo lotto (misurazione, test).",
        "CHINESE": "使用 [+] 按钮激活创建新批次，并输入批次的唯一名称（测量、测试）。",
        "JAPANESE": "新規バッチの作成を有効にするには、[+]ボタンを使用し、バッチに固有の名称（測定、テスト）を入力します。",
        "KOREAN": "+] 버튼을 사용하여 새 배치 생성을 활성화하고 배치에 대한 고유한 지정(측정, 테스트)을 입력합니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_A4_NETWORK_APPL_STEP_4": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Start your batch by weighing your sample, and enter a designation for sample 1.",
        "GERMAN": "Starten Sie ihre Charge mit der Einwaage ihrer Proben und geben Sie für die 1. Probe eine Bezeichnung ein.",
        "RUSSIAN": "Начните замес со взвешивания образца и введите обозначение для образца 1.",
        "FRENCH": "Commencez votre lot en pesant votre échantillon, et entrez une désignation pour l'échantillon 1.",
        "SPANISH": "Comience su lote pesando su muestra, e introduzca una designación para la muestra 1.",
        "ITALIAN": "Inizia il tuo lotto pesando il tuo campione e inserisci una designazione per il campione 1.",
        "CHINESE": "称量样品重量，开始批处理，并输入样品 1 的名称。",
        "JAPANESE": "試料を計量してバッチを開始し、試料1の指定を入力します。",
        "KOREAN": "시료의 무게를 측정하여 배치를 시작하고 시료 1에 대한 명칭을 입력합니다."
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Начните замес со взвешивания образца и введите обозначение для образца 1.",
        "FRENCH": "Commencez votre lot en pesant votre échantillon, et entrez une désignation pour l'échantillon 1.",
        "SPANISH": "Comience su lote pesando su muestra, e introduzca una designación para la muestra 1.",
        "ITALIAN": "Inizia il tuo lotto pesando il tuo campione e inserisci una designazione per il campione 1.",
        "CHINESE": "称量样品重量，开始批处理，并输入样品 1 的名称。",
        "JAPANESE": "試料を計量してバッチを開始し、試料1の指定を入力します。",
        "KOREAN": "시료의 무게를 측정하여 배치를 시작하고 시료 1에 대한 명칭을 입력합니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_A4_NETWORK_APPL_STEP_5": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Follow the instructions and symbols to guide you through the sample weighing process. Repeat these steps until all samples have been weighed.",
        "GERMAN": "Mit Anweisungstexten und Symbolen werden Sie durch die Einwaage der Probe geführt. Wiederholen Sie diese Schritte für die Einwaage aller Proben.",
        "RUSSIAN": "Следуйте инструкциям и символам, которые будут сопровождать вас в процессе взвешивания образца. Повторяйте эти шаги до тех пор, пока все образцы не будут взвешены.",
        "FRENCH": "Suivez les instructions et les symboles qui vous guideront dans le processus de pesée des échantillons. Répétez ces étapes jusqu'à ce que tous les échantillons aient été pesés.",
        "SPANISH": "Siga las instrucciones y los símbolos que le guían en el proceso de pesaje de las muestras. Repita estos pasos hasta que se hayan pesado todas las muestras.",
        "ITALIAN": "Seguire le istruzioni e i simboli per guidarvi nel processo di pesatura dei campioni. Ripetere questi passaggi fino a quando tutti i campioni sono stati pesati.",
        "CHINESE": "按照说明和符号指导完成样品称量过程。重复这些步骤，直到称量完所有样品。",
        "JAPANESE": "指示と記号に従って、試料の計量プロセスを進めます。すべての試料の計量が終わるまで、この手順を繰り返します。",
        "KOREAN": "지침과 기호에 따라 시료 계량 과정을 안내합니다. 모든 샘플의 무게가 측정될 때까지 이 단계를 반복합니다."
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Следуйте инструкциям и символам, которые будут сопровождать вас в процессе взвешивания образца. Повторяйте эти шаги до тех пор, пока все образцы не будут взвешены.",
        "FRENCH": "Suivez les instructions et les symboles qui vous guideront dans le processus de pesée des échantillons. Répétez ces étapes jusqu'à ce que tous les échantillons aient été pesés.",
        "SPANISH": "Siga las instrucciones y los símbolos que le guían en el proceso de pesaje de las muestras. Repita estos pasos hasta que se hayan pesado todas las muestras.",
        "ITALIAN": "Seguire le istruzioni e i simboli per guidarvi nel processo di pesatura dei campioni. Ripetere questi passaggi fino a quando tutti i campioni sono stati pesati.",
        "CHINESE": "按照说明和符号指导完成样品称量过程。重复这些步骤，直到称量完所有样品。",
        "JAPANESE": "指示と記号に従って、試料の計量プロセスを進めます。すべての試料の計量が終わるまで、この手順を繰り返します。",
        "KOREAN": "지침과 기호에 따라 시료 계량 과정을 안내합니다. 모든 샘플의 무게가 측정될 때까지 이 단계를 반복합니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_A4_NETWORK_APPL_STEP_6": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Treat your samples in accordance with your requirements. In the meantime, the balance can be used for other batches or applications.",
        "GERMAN": "Behandeln Sie ihre Proben entsprechend Ihrer Anforderung. In der Zwischenzeit kann die Waage für andere Chargen oder andere Anwendungen genutzt werden.",
        "RUSSIAN": "Обрабатывайте образцы в соответствии с вашими требованиями. В то же время весы можно использовать для других партий или приложений.",
        "FRENCH": "Traitez vos échantillons en fonction de vos besoins. Entre-temps, la balance peut être utilisée pour d'autres lots ou applications.",
        "SPANISH": "Trate sus muestras de acuerdo con sus necesidades. Mientras tanto, la balanza puede utilizarse para otros lotes o aplicaciones.",
        "ITALIAN": "Trattate i vostri campioni secondo le vostre esigenze. Nel frattempo, la bilancia può essere utilizzata per altri lotti o applicazioni.",
        "CHINESE": "根据您的要求处理样品。同时，天平还可用于其他批次或应用。",
        "JAPANESE": "お客様の要求に従って試料を処理してください。その間、天秤は他のバッチやアプリケーションに使用することができます。",
        "KOREAN": "요구 사항에 따라 샘플을 처리하세요. 그 동안 저울은 다른 배치 또는 애플리케이션에 사용할 수 있습니다."
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Обрабатывайте образцы в соответствии с вашими требованиями. В то же время весы можно использовать для других партий или приложений.",
        "FRENCH": "Traitez vos échantillons en fonction de vos besoins. Entre-temps, la balance peut être utilisée pour d'autres lots ou applications.",
        "SPANISH": "Trate sus muestras de acuerdo con sus necesidades. Mientras tanto, la balanza puede utilizarse para otros lotes o aplicaciones.",
        "ITALIAN": "Trattate i vostri campioni secondo le vostre esigenze. Nel frattempo, la bilancia può essere utilizzata per altri lotti o applicazioni.",
        "CHINESE": "根据您的要求处理样品。同时，天平还可用于其他批次或应用。",
        "JAPANESE": "お客様の要求に従って試料を処理してください。その間、天秤は他のバッチやアプリケーションに使用することができます。",
        "KOREAN": "요구 사항에 따라 샘플을 처리하세요. 그 동안 저울은 다른 배치 또는 애플리케이션에 사용할 수 있습니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_A4_NETWORK_APPL_STEP_7": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Start your batch by backweighing your samples and select the sample for backweighing.",
        "GERMAN": "Starten Sie ihre Charge mit der Rückwaage ihrer Proben, wählen Sie die Probe für die Rückwaage.",
        "RUSSIAN": "Начните партию с обратного взвешивания образцов и выберите образец для обратного взвешивания.",
        "FRENCH": "Commencez votre lot par la pesée finale de vos échantillons et sélectionnez l'échantillon pour la pesée finale.",
        "SPANISH": "Inicie su lote pesando las muestras por detrás y seleccione la muestra para el pesaje por detrás.",
        "ITALIAN": "Iniziate il vostro lotto pesando i vostri campioni e selezionate il campione da pesare.",
        "CHINESE": "开始批量称量样品，并选择要称量的样品。",
        "JAPANESE": "試料をバックウェイト（後方計量）してバッチを開始し、バックウェイト用の試料を選択します。",
        "KOREAN": "샘플을 역계량하여 배치를 시작하고 역계량할 샘플을 선택합니다."
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Начните партию с обратного взвешивания образцов и выберите образец для обратного взвешивания.",
        "FRENCH": "Commencez votre lot par la pesée finale de vos échantillons et sélectionnez l'échantillon pour la pesée finale.",
        "SPANISH": "Inicie su lote pesando las muestras por detrás y seleccione la muestra para el pesaje por detrás.",
        "ITALIAN": "Iniziate il vostro lotto pesando i vostri campioni e selezionate il campione da pesare.",
        "CHINESE": "开始批量称量样品，并选择要称量的样品。",
        "JAPANESE": "試料をバックウェイト（後方計量）してバッチを開始し、バックウェイト用の試料を選択します。",
        "KOREAN": "샘플을 역계량하여 배치를 시작하고 역계량할 샘플을 선택합니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_A4_NETWORK_APPL_STEP_8": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Follow the instructions and symbols to guide you through the backweighing process. Once accepted, the backweighing results will be displayed. Repeat these steps until all the samples have been backweighed.",
        "GERMAN": "Mit Anweisungstexten und Symbolen werden Sie durch die Rückwägung geführt. Nach der Übernahme wird das Ergebnis der Rückwägung gezeigt. Wiederholen Sie diese Schritte für die Rückwägung aller Proben.",
        "RUSSIAN": "Следуйте инструкциям и символам, которые будут сопровождать вас в процессе обратного взвешивания. После принятия результатов взвешивания на экране появятся результаты обратного взвешивания. Повторяйте эти шаги до тех пор, пока все образцы не будут взвешены.",
        "FRENCH": "Suivez les instructions et les symboles qui vous guideront tout au long du processus de pesée finale. Une fois acceptés, les résultats de la pesée finale s'affichent. Répétez ces étapes jusqu'à ce que tous les échantillons aient été pesés.",
        "SPANISH": "Siga las instrucciones y los símbolos que le guiarán en el proceso de pesaje. Una vez aceptado, se mostrarán los resultados de la pesada final. Repita estos pasos hasta que todas las muestras hayan sido pesadas.",
        "ITALIAN": "Seguite le istruzioni e i simboli che vi guideranno nel processo di pesatura a ritroso. Una volta accettati, verranno visualizzati i risultati della pesata indietro. Ripetere questi passaggi fino a quando tutti i campioni sono stati pesati.",
        "CHINESE": "请按照提示和符号完成称重过程。一旦接受，就会显示反称结果。重复上述步骤，直到所有样品都称完重量。",
        "JAPANESE": "バックウェイトの計量は、指示と記号に従って行ってください。受理されると、逆計量の結果が表示されます。すべての試料の計量が終了するまで、この手順を繰り返します。",
        "KOREAN": "지침과 기호에 따라 계량 과정을 안내합니다. 수락되면 재계량 결과가 표시됩니다. 모든 샘플의 무게가 다시 측정될 때까지 이 단계를 반복합니다."
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Следуйте инструкциям и символам, которые будут сопровождать вас в процессе обратного взвешивания. После принятия результатов взвешивания на экране появятся результаты обратного взвешивания. Повторяйте эти шаги до тех пор, пока все образцы не будут взвешены.",
        "FRENCH": "Suivez les instructions et les symboles qui vous guideront tout au long du processus de pesée finale. Une fois acceptés, les résultats de la pesée finale s'affichent. Répétez ces étapes jusqu'à ce que tous les échantillons aient été pesés.",
        "SPANISH": "Siga las instrucciones y los símbolos que le guiarán en el proceso de pesaje. Una vez aceptado, se mostrarán los resultados de la pesada final. Repita estos pasos hasta que todas las muestras hayan sido pesadas.",
        "ITALIAN": "Seguite le istruzioni e i simboli che vi guideranno nel processo di pesatura a ritroso. Una volta accettati, verranno visualizzati i risultati della pesata indietro. Ripetere questi passaggi fino a quando tutti i campioni sono stati pesati.",
        "CHINESE": "请按照提示和符号完成称重过程。一旦接受，就会显示反称结果。重复上述步骤，直到所有样品都称完重量。",
        "JAPANESE": "バックウェイトの計量は、指示と記号に従って行ってください。受理されると、逆計量の結果が表示されます。すべての試料の計量が終了するまで、この手順を繰り返します。",
        "KOREAN": "지침과 기호에 따라 계량 과정을 안내합니다. 수락되면 재계량 결과가 표시됩니다. 모든 샘플의 무게가 다시 측정될 때까지 이 단계를 반복합니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_A4_NETWORK_APPL_STEP_9": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the control character <BR>. Do not translate HTML link commands, e.g. <a href=\"#OUTPUT_EXAMPLES_NETWORK_PRINTER_A4\"> and </a>.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "You have the option to change to the print preview of the accepted values and their results. You can generate the print output on the network printer from here. <BR>You can find an output example here: <a href=\"#OUTPUT_EXAMPLES_NETWORK_PRINTER_A4\">Network Printer with A4 Paper</a>.",
        "GERMAN": "Sie haben die Möglichkeit in die Druckvorschau der übernommenen Werte und deren Ergebnisse zu wechseln. Von hier aus können Sie die Druckausgabe auf dem Netzwerkdrucker auslösen. <BR>Ein Ausgabebeispiel finden Sie hier: <a href=\"#OUTPUT_EXAMPLES_NETWORK_PRINTER_A4\">Netzwerk-Drucker mit A4-Papier</a>.",
        "RUSSIAN": "У вас есть возможность перейти к предварительному просмотру печати принятых значений и их результатов. Вы можете отсюда сгенерировать вывод на печать на сетевой принтер. <BR>Пример вывода вы можете найти здесь: <a href=\"#OUTPUT_EXAMPLES_NETWORK_PRINTER_A4\">Сетевой принтер с бумагой A4</a>.",
        "FRENCH": "Vous avez la possibilité de passer à l'aperçu avant impression des valeurs acceptées et de leurs résultats. Vous pouvez générer la sortie d'impression sur l'imprimante réseau à partir d'ici. <BR>Vous pouvez trouver un exemple de sortie ici : <a href=\"#OUTPUT_EXAMPLES_NETWORK_PRINTER_A4\">Imprimante réseau avec papier A4</a>.",
        "SPANISH": "Tiene la opción de cambiar a la vista previa de impresión de los valores aceptados y sus resultados. Desde aquí puede generar la salida de impresión en la impresora de red. <BR>Puede encontrar un ejemplo de salida aquí: <a href=\"#OUTPUT_EXAMPLES_NETWORK_PRINTER_A4\">Impresora de red con papel A4</a>.",
        "ITALIAN": "Avete la possibilità di passare all'anteprima di stampa dei valori accettati e dei loro risultati. Puoi generare l'output di stampa sulla stampante di rete da qui. <BR>Puoi trovare un esempio di output qui: <a href=\"#OUTPUT_EXAMPLES_NETWORK_PRINTER_A4\">Stampante di rete con carta A4</a>.",
        "CHINESE": "您可以选择更改为打印预览已接受的值及其结果。您可以在网络打印机上生成打印输出。<BR>您可以在这里找到输出示例：<a href=\"#OUTPUT_EXAMPLES_NETWORK_PRINTER_A4\">使用 A4 纸的网络打印机</a>。",
        "JAPANESE": "オプションで、承認された値とその結果の印刷プレビューに変更することができます。ここからネットワークプリンタに印刷出力を生成することができます。<BR>ここに出力例があります：<a href=\"#OUTPUT_EXAMPLES_NETWORK_PRINTER_A4\">Network Printer with A4 Paper</a>.",
        "KOREAN": "허용된 값과 그 결과의 인쇄 미리 보기로 변경할 수 있는 옵션이 있습니다. 여기에서 네트워크 프린터에서 인쇄 출력을 생성할 수 있습니다. <BR>출력 예제는 여기에서 확인할 수 있습니다: <a href=\"#OUTPUT_EXAMPLES_NETWORK_PRINTER_A4\">A4 용지가 있는 네트워크 프린터</a>."
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "У вас есть возможность перейти к предварительному просмотру печати принятых значений и их результатов. Вы можете отсюда сгенерировать вывод на печать на сетевой принтер. <BR>Пример вывода вы можете найти здесь: <a href=\"#OUTPUT_EXAMPLES_NETWORK_PRINTER_A4\">Сетевой принтер с бумагой A4</a>.",
        "FRENCH": "Vous avez la possibilité de passer à l'aperçu avant impression des valeurs acceptées et de leurs résultats. Vous pouvez générer la sortie d'impression sur l'imprimante réseau à partir d'ici. <BR>Vous pouvez trouver un exemple de sortie ici : <a href=\"#OUTPUT_EXAMPLES_NETWORK_PRINTER_A4\">Imprimante réseau avec papier A4</a>.",
        "SPANISH": "Tiene la opción de cambiar a la vista previa de impresión de los valores aceptados y sus resultados. Desde aquí puede generar la salida de impresión en la impresora de red. <BR>Puede encontrar un ejemplo de salida aquí: <a href=\"#OUTPUT_EXAMPLES_NETWORK_PRINTER_A4\">Impresora de red con papel A4</a>.",
        "ITALIAN": "Avete la possibilità di passare all'anteprima di stampa dei valori accettati e dei loro risultati. Puoi generare l'output di stampa sulla stampante di rete da qui. <BR>Puoi trovare un esempio di output qui: <a href=\"#OUTPUT_EXAMPLES_NETWORK_PRINTER_A4\">Stampante di rete con carta A4</a>.",
        "CHINESE": "您可以选择更改为打印预览已接受的值及其结果。您可以在网络打印机上生成打印输出。<BR>您可以在这里找到输出示例：<a href=\"#OUTPUT_EXAMPLES_NETWORK_PRINTER_A4\">使用 A4 纸的网络打印机</a>。",
        "JAPANESE": "オプションで、承認された値とその結果の印刷プレビューに変更することができます。ここからネットワークプリンタに印刷出力を生成することができます。<BR>ここに出力例があります：<a href=\"#OUTPUT_EXAMPLES_NETWORK_PRINTER_A4\">Network Printer with A4 Paper</a>.",
        "KOREAN": "허용된 값과 그 결과의 인쇄 미리 보기로 변경할 수 있는 옵션이 있습니다. 여기에서 네트워크 프린터에서 인쇄 출력을 생성할 수 있습니다. <BR>출력 예제는 여기에서 확인할 수 있습니다: <a href=\"#OUTPUT_EXAMPLES_NETWORK_PRINTER_A4\">A4 용지가 있는 네트워크 프린터</a>."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_A4_NETWORK_APPL_NOTE": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Note: If the print job cannot be completed, it will not be lost; see Troubleshooting.",
        "GERMAN": "Anmerkung: Falls der Druckauftrag nicht abgesetzt werden kann, geht dieser nicht verloren; siehe Fehlerbehandlung.",
        "RUSSIAN": "Примечание: Если задание печати не может быть выполнено, оно не будет потеряно; см. раздел Устранение неполадок.",
        "FRENCH": "Remarque : si le travail d'impression ne peut être achevé, il ne sera pas perdu ; voir la section Dépannage.",
        "SPANISH": "Nota: Si el trabajo de impresión no puede completarse, no se perderá; consulte la sección de resolución de problemas.",
        "ITALIAN": "Nota: Se il lavoro di stampa non può essere completato, non verrà perso; vedere Risoluzione dei problemi.",
        "CHINESE": "注意：如果打印任务无法完成，也不会丢失；请参阅故障排除。",
        "JAPANESE": "注：印刷ジョブを完了できなかった場合でも、ジョブは失われません。",
        "KOREAN": "참고: 인쇄 작업을 완료할 수 없는 경우에도 인쇄 작업은 손실되지 않습니다(문제 해결을 참조하세요)."
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Примечание: Если задание печати не может быть выполнено, оно не будет потеряно; см. раздел Устранение неполадок.",
        "FRENCH": "Remarque : si le travail d'impression ne peut être achevé, il ne sera pas perdu ; voir la section Dépannage.",
        "SPANISH": "Nota: Si el trabajo de impresión no puede completarse, no se perderá; consulte la sección de resolución de problemas.",
        "ITALIAN": "Nota: Se il lavoro di stampa non può essere completato, non verrà perso; vedere Risoluzione dei problemi.",
        "CHINESE": "注意：如果打印任务无法完成，也不会丢失；请参阅故障排除。",
        "JAPANESE": "注：印刷ジョブを完了できなかった場合でも、ジョブは失われません。",
        "KOREAN": "참고: 인쇄 작업을 완료할 수 없는 경우에도 인쇄 작업은 손실되지 않습니다(문제 해결을 참조하세요)."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
