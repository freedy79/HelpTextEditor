    "ROLE_RIGHT_USERMANAGEMENT": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "GERMAN": "<b>Benutzerverwaltung:</b> Zugriff auf die Verwaltung zum Erstellen, Ändern oder Löschen von Gerätenutzern. Benötigt auch das Recht, auf das Einstellungsmenü zuzugreifen.",
        "ENGLISH": "<b>User management:</b> Access to the management for creating, modifying or deleting device users. Needs also right to access settings menu.",
        "CHINESE": "<b>用户管理：</b>创建、更改或删除设备用户的管理访问权限。还需要访问设置菜单的权限。",
        "FRENCH": "<b>Gestion des utilisateurs:</b> Accès à la gestion pour créer, modifier ou supprimer des utilisateurs de l'appareil. Nécessite également le droit d'accéder au menu des paramètres.",
        "SPANISH": "<b>Gestión de usuarios:</b> Acceso a la gestión para crear, modificar o eliminar usuarios del dispositivo. Necesita también derecho para acceder al menú de configuración.",
        "RUSSIAN": "<b>Управление пользователями:</b> Доступ к управлению для создания, изменения или удаления пользователей устройства. Также необходимо право доступа к меню настроек.",
        "ITALIAN": "<b>Gestione degli utenti:</b> Accesso alla gestione per creare, modificare o eliminare gli utenti del dispositivo. Richiede anche il diritto di accedere al menu delle impostazioni."
      },
      "AUTOTRANSLATIONS": {
        "CHINESE": "<b>用户管理：</b>创建、更改或删除设备用户的管理访问权限。还需要访问设置菜单的权限。",
        "FRENCH": "<b>Gestion des utilisateurs:</b> Accès à la gestion pour créer, modifier ou supprimer des utilisateurs de l'appareil. Nécessite également le droit d'accéder au menu des paramètres.",
        "SPANISH": "<b>Gestión de usuarios:</b> Acceso a la gestión para crear, modificar o eliminar usuarios del dispositivo. Necesita también derecho para acceder al menú de configuración.",
        "RUSSIAN": "<b>Управление пользователями:</b> Доступ к управлению для создания, изменения или удаления пользователей устройства. Также необходимо право доступа к меню настроек.",
        "ITALIAN": "<b>Gestione degli utenti:</b> Accesso alla gestione per creare, modificare o eliminare gli utenti del dispositivo. Richiede anche il diritto di accedere al menu delle impostazioni."
      },
      "VERIFIED": {
        "GERMAN": false,
        "ENGLISH": false,
        "CHINESE": false,
        "FRENCH": false,
        "SPANISH": false,
        "RUSSIAN": false,
        "ITALIAN": false
      }
    },
    "ROLE_RIGHT_TASKMANAGEMENT": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "GERMAN": "<b>Taskverwaltung:</b> Zugriff auf die Verwaltung zum Erstellen, Ändern oder Löschen von Tasks. Der Zugriff erfolgt aus dem Hauptmenü und Einstellungsmenü.",
        "ENGLISH": "<b>Task management:</b> Access to the management for creating, changing or deleting tasks. Access is from the main menu and settings menu.",
        "CHINESE": "<b>任务管理：</b>创建、更改或删除任务的管理入口。可从主菜单和设置菜单进入。",
        "FRENCH": "<b>Gestion des tâches:</b> Accès à la gestion de la création, de la modification ou de la suppression des tâches. L'accès se fait à partir du menu principal et du menu des paramètres.",
        "SPANISH": "<b>Gestión de tareas:</b> Acceso a la gestión para crear, modificar o eliminar tareas. Se accede desde el menú principal y el de ajustes.",
        "RUSSIAN": "<b>Управление задачами:</b> Доступ к управлению созданием, изменением или удалением задач. Доступ осуществляется из главного меню и меню настроек.",
        "ITALIAN": "<b>Gestione attività:</b> Accesso alla gestione per la creazione, la modifica o l'eliminazione delle attività. L'accesso avviene dal menu principale e dal menu delle impostazioni."
      },
      "AUTOTRANSLATIONS": {
        "CHINESE": "<b>任务管理：</b>创建、更改或删除任务的管理入口。可从主菜单和设置菜单进入。",
        "FRENCH": "<b>Gestion des tâches:</b> Accès à la gestion de la création, de la modification ou de la suppression des tâches. L'accès se fait à partir du menu principal et du menu des paramètres.",
        "SPANISH": "<b>Gestión de tareas:</b> Acceso a la gestión para crear, modificar o eliminar tareas. Se accede desde el menú principal y el de ajustes.",
        "RUSSIAN": "<b>Управление задачами:</b> Доступ к управлению созданием, изменением или удалением задач. Доступ осуществляется из главного меню и меню настроек.",
        "ITALIAN": "<b>Gestione attività:</b> Accesso alla gestione per la creazione, la modifica o l'eliminazione delle attività. L'accesso avviene dal menu principale e dal menu delle impostazioni."
      },
      "VERIFIED": {
        "GERMAN": false,
        "ENGLISH": false,
        "CHINESE": false,
        "FRENCH": false,
        "SPANISH": false,
        "RUSSIAN": false,
        "ITALIAN": false
      }
    },
    "ROLE_RIGHT_ACCESS_SETTINGS": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "GERMAN": "<b>Zugriff Geräteeinstellungen:</b> Allgemeiner Zugriff auf das Einstellungsmenü. Ist teilweise Voraussetzung, um Zugriff auf unterliegende Menüstrukturen zu erhalten.",
        "ENGLISH": "<b>Access device settings:</b> General access to the settings menu. Partly required to gain access to underlying menu structures.",
        "CHINESE": "<b>访问设备设置：</b>一般访问设置菜单。部分需要访问底层菜单结构。",
        "FRENCH": "<b>Accéder aux paramètres de l'appareil :</b> Accès général au menu des paramètres. Partiellement nécessaire pour accéder aux structures de menu sous-jacentes.",
        "SPANISH": "<b>Acceso a la configuración del dispositivo:</b> Acceso general al menú de configuración. Parcialmente necesario para acceder a las estructuras de menú subyacentes.",
        "RUSSIAN": "<b>Доступ к настройкам устройства:</b> Общий доступ к меню настроек. Частично требуется для получения доступа к базовым структурам меню.",
        "ITALIAN": "<b>Accesso alle impostazioni del dispositivo:</b> Accesso generale al menu delle impostazioni. Richiesto in parte per accedere alle strutture di menu sottostanti."
      },
      "AUTOTRANSLATIONS": {
        "CHINESE": "<b>访问设备设置：</b>一般访问设置菜单。部分需要访问底层菜单结构。",
        "FRENCH": "<b>Accéder aux paramètres de l'appareil :</b> Accès général au menu des paramètres. Partiellement nécessaire pour accéder aux structures de menu sous-jacentes.",
        "SPANISH": "<b>Acceso a la configuración del dispositivo:</b> Acceso general al menú de configuración. Parcialmente necesario para acceder a las estructuras de menú subyacentes.",
        "RUSSIAN": "<b>Доступ к настройкам устройства:</b> Общий доступ к меню настроек. Частично требуется для получения доступа к базовым структурам меню.",
        "ITALIAN": "<b>Accesso alle impostazioni del dispositivo:</b> Accesso generale al menu delle impostazioni. Richiesto in parte per accedere alle strutture di menu sottostanti."
      },
      "VERIFIED": {
        "GERMAN": false,
        "ENGLISH": false,
        "CHINESE": false,
        "FRENCH": false,
        "SPANISH": false,
        "RUSSIAN": false,
        "ITALIAN": false
      }
    },
    "ROLE_RIGHT_QAPP_CENTER": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "GERMAN": "<b>Zugriff QAPP-Center:</b> Zugriff auf das QAPP-Center. Von dort das QAPP-Center aktualisiert werden, QAPP-Beschreibungen eingesehen und QAPPs lizensiert werden. Der Zugriff erfolgt über die Taskverwaltung.",
        "ENGLISH": "<b>Access QAPP Center:</b> Access to the QAPP Center. From there, the QAPP Center can be updated, QAPP descriptions can be viewed and QAPPs can be licensed. Access is via the task management.",
        "CHINESE": "<b>访问 QAPP 中心：</b>访问 QAPP 中心。可从该中心更新 QAPP 中心，查看 QAPP 说明，并为 QAPP 发放许可证。可通过任务管理进行访问。",
        "FRENCH": "<b>Accéder au centre QAPP:</b> Accès au centre QAPP. A partir de là, le QAPP Center peut être mis à jour, les descriptions des QAPP peuvent être visualisées et les QAPP peuvent être licenciés. L'accès se fait par le biais de la gestion des tâches.",
        "SPANISH": "<b>Acceso al Centro QAPP:</b> Acceso al Centro QAPP. Desde allí se puede actualizar el Centro QAPP, ver las descripciones de los QAPP y obtener licencias para los QAPP. El acceso se realiza a través de la gestión de tareas.",
        "RUSSIAN": "<b>Доступ к QAPP-центру:</b> Доступ к QAPP-центру. Отсюда можно обновлять Центр QAPP, просматривать описания QAPP и лицензировать QAPP. Доступ осуществляется через управление задачами.",
        "ITALIAN": "<b>Accesso al Centro QAPP:</b> Accesso al Centro QAPP. Da qui è possibile aggiornare il QAPP Center, visualizzare le descrizioni dei QAPP e concedere le licenze per i QAPP. L'accesso avviene tramite la gestione delle attività."
      },
      "AUTOTRANSLATIONS": {
        "CHINESE": "<b>访问 QAPP 中心：</b>访问 QAPP 中心。可从该中心更新 QAPP 中心，查看 QAPP 说明，并为 QAPP 发放许可证。可通过任务管理进行访问。",
        "FRENCH": "<b>Accéder au centre QAPP:</b> Accès au centre QAPP. A partir de là, le QAPP Center peut être mis à jour, les descriptions des QAPP peuvent être visualisées et les QAPP peuvent être licenciés. L'accès se fait par le biais de la gestion des tâches.",
        "SPANISH": "<b>Acceso al Centro QAPP:</b> Acceso al Centro QAPP. Desde allí se puede actualizar el Centro QAPP, ver las descripciones de los QAPP y obtener licencias para los QAPP. El acceso se realiza a través de la gestión de tareas.",
        "RUSSIAN": "<b>Доступ к QAPP-центру:</b> Доступ к QAPP-центру. Отсюда можно обновлять Центр QAPP, просматривать описания QAPP и лицензировать QAPP. Доступ осуществляется через управление задачами.",
        "ITALIAN": "<b>Accesso al Centro QAPP:</b> Accesso al Centro QAPP. Da qui è possibile aggiornare il QAPP Center, visualizzare le descrizioni dei QAPP e concedere le licenze per i QAPP. L'accesso avviene tramite la gestione delle attività."
      },
      "VERIFIED": {
        "GERMAN": false,
        "ENGLISH": false,
        "CHINESE": false,
        "FRENCH": false,
        "SPANISH": false,
        "RUSSIAN": false,
        "ITALIAN": false
      }
    },
    "ROLE_RIGHT_ACCESS_AUDIT_TRAIL": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "GERMAN": "<b>Zugriff Audit Trail:</b> Lesender Zugriff auf den Audit Trail und Exportieren der Daten. Dieser muss durch die entsprechende Erweiterung lizensiert sein.",
        "ENGLISH": "<b>Access audit trail:</b> Read access to the audit trail and export of the data. This must be licensed by the corresponding extension.",
        "CHINESE": "<b>访问审计跟踪：</b>读取审计跟踪和导出数据。必须获得相应扩展的许可。",
        "FRENCH": "<b>Accéder à la piste d'audit:</b> Accès en lecture à la piste d'audit et exportation des données. Cette fonction doit être autorisée par l'extension correspondante.",
        "SPANISH": "<b>Acceso a la pista de auditoría:</b> Acceso de lectura a la pista de auditoría y exportación de los datos. Para ello es necesario disponer de la licencia de la extensión correspondiente.",
        "RUSSIAN": "<b>Доступ к журналу аудита:</b> Доступ на чтение к журналу аудита и экспорт данных. Это должно быть лицензировано соответствующим расширением.",
        "ITALIAN": "<b>Accesso audit trail:</b> Accesso in lettura all'audit trail ed esportazione dei dati. La licenza deve essere concessa dall'estensione corrispondente."
      },
      "AUTOTRANSLATIONS": {
        "CHINESE": "<b>访问审计跟踪：</b>读取审计跟踪和导出数据。必须获得相应扩展的许可。",
        "FRENCH": "<b>Accéder à la piste d'audit:</b> Accès en lecture à la piste d'audit et exportation des données. Cette fonction doit être autorisée par l'extension correspondante.",
        "SPANISH": "<b>Acceso a la pista de auditoría:</b> Acceso de lectura a la pista de auditoría y exportación de los datos. Para ello es necesario disponer de la licencia de la extensión correspondiente.",
        "RUSSIAN": "<b>Доступ к журналу аудита:</b> Доступ на чтение к журналу аудита и экспорт данных. Это должно быть лицензировано соответствующим расширением.",
        "ITALIAN": "<b>Accesso audit trail:</b> Accesso in lettura all'audit trail ed esportazione dei dati. La licenza deve essere concessa dall'estensione corrispondente."
      },
      "VERIFIED": {
        "GERMAN": false,
        "ENGLISH": false,
        "CHINESE": false,
        "FRENCH": false,
        "SPANISH": false,
        "RUSSIAN": false,
        "ITALIAN": false
      }
    },
