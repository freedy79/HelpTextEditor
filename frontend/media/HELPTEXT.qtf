    "EXAMPLE_CREATE_NETWORK_USER_CONF_STEP_2": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Configure a network user, for instance, [My network user].",
        "GERMAN": "Konfigurieren Sie einen Netzwerk-Benutzer z. B. [Mein Netzwerk Anwender].",
        "RUSSIAN": "Настройте сетевого пользователя, например, [Мой сетевой пользователь].",
        "FRENCH": "Configurez un utilisateur réseau, par exemple, [Mon utilisateur réseau].",
        "SPANISH": "Configure un usuario de red, por ejemplo, [Mi usuario de red].",
        "ITALIAN": "Configura un utente di rete, per esempio, [Il mio utente di rete].",
        "CHINESE": "配置网络用户，例如 [我的网络用户]。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Настройте сетевого пользователя, например, [Мой сетевой пользователь].",
        "FRENCH": "Configurez un utilisateur réseau, par exemple, [Mon utilisateur réseau].",
        "SPANISH": "Configure un usuario de red, por ejemplo, [Mi usuario de red].",
        "ITALIAN": "Configura un utente di rete, per esempio, [Il mio utente di rete].",
        "CHINESE": "配置网络用户，例如 [我的网络用户]。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
