    "DEVICE_CONCEPT_ELEMENTS_MAINMENU_FUNCTIONBAR_DESC": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Shows available submenus and operating functions for the current display and the current user.",
        "GERMAN": "Zeigt verfügbare Untermenüs und Bedienfunktionen für die aktuelle Anzeige und den aktuellen Benutzer an.",
        "CHINESE": "显示当前显示屏和当前用户的可用子菜单和操作功能。",
        "FRENCH": "Affiche les sous-menus et les fonctions d'exploitation disponibles pour l'affichage et l'utilisateur actuels.",
        "ITALIAN": "Mostra i sottomenu e le funzioni operative disponibili per il display e l'utente corrente.",
        "RUSSIAN": "Показывает доступные подменю и функции управления для текущего дисплея и текущего пользователя.",
        "SPANISH": "Muestra los submenús y las funciones operativas disponibles para la pantalla y el usuario actuales.",
        "JAPANESE": "現在のディスプレイと現在のユーザーに対して利用可能なサブメニューと操作機能を表示します。",
        "KOREAN": "현재 디스플레이와 현재 사용자에게 사용 가능한 하위 메뉴와 조작 기능을 표시합니다."
      },
      "AUTOTRANSLATIONS": {
        "ENGLISH": "Shows available submenus and operating functions for the current display and the current user.",
        "CHINESE": "显示当前显示屏和当前用户的可用子菜单和操作功能。",
        "FRENCH": "Affiche les sous-menus et les fonctions d'exploitation disponibles pour l'affichage et l'utilisateur actuels.",
        "ITALIAN": "Mostra i sottomenu e le funzioni operative disponibili per il display e l'utente corrente.",
        "RUSSIAN": "Показывает доступные подменю и функции управления для текущего дисплея и текущего пользователя.",
        "SPANISH": "Muestra los submenús y las funciones operativas disponibles para la pantalla y el usuario actuales.",
        "JAPANESE": "現在のディスプレイと現在のユーザーに対して利用可能なサブメニューと操作機能を表示します。",
        "KOREAN": "현재 디스플레이와 현재 사용자에게 사용 가능한 하위 메뉴와 조작 기능을 표시합니다."
      },
