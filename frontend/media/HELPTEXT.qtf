      }
    },
    "PRINT_A4_NETWORK_CONF_STEP_1_B": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ]. Do not translate QAPP and QAPP Center.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Select the [Advanced] QAPP package and then the [Backweighing] QAPP. The description and version of the QAPP will be displayed.",
        "GERMAN": "Wählen Sie das QAPP-Paket [Advanced] und darin die QAPP [Rückwägen]. Es wird die Beschreibung und Version der QAPP angezeigt.",
        "RUSSIAN": "Выберите пакет QAPP [Advanced], а затем QAPP [Backweighing]. Отобразится описание и версия QAPP.",
        "FRENCH": "Sélectionnez le paquet QAPP [Advanced] et ensuite le QAPP [Backweighing]. La description et la version du QAPP s'affichent.",
        "SPANISH": "Seleccione el paquete QAPP [Avanzado] y luego el QAPP [Contrapeso]. Se mostrará la descripción y la versión del QAPP.",
        "ITALIAN": "Seleziona il pacchetto QAPP [Advanced] e poi il QAPP [Backweighing]. Verranno visualizzate la descrizione e la versione del QAPP.",
        "CHINESE": "选择 [高级] QAPP 包，然后选择 [背重] QAPP。将显示 QAPP 的说明和版本。",
        "JAPANESE": "Advanced] QAPPパッケージを選択し、次に[Backweighing] QAPPを選択します。QAPPの説明とバージョンが表示されます。",
        "KOREAN": "고급] QAPP 패키지를 선택한 다음 [백웨이트] QAPP을 선택합니다. QAPP에 대한 설명과 버전이 표시됩니다."
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Выберите пакет QAPP [Advanced], а затем QAPP [Backweighing]. Отобразится описание и версия QAPP.",
        "FRENCH": "Sélectionnez le paquet QAPP [Advanced] et ensuite le QAPP [Backweighing]. La description et la version du QAPP s'affichent.",
        "SPANISH": "Seleccione el paquete QAPP [Avanzado] y luego el QAPP [Contrapeso]. Se mostrará la descripción y la versión del QAPP.",
        "ITALIAN": "Seleziona il pacchetto QAPP [Advanced] e poi il QAPP [Backweighing]. Verranno visualizzate la descrizione e la versione del QAPP.",
        "CHINESE": "选择 [高级] QAPP 包，然后选择 [背重] QAPP。将显示 QAPP 的说明和版本。",
        "JAPANESE": "Advanced] QAPPパッケージを選択し、次に[Backweighing] QAPPを選択します。QAPPの説明とバージョンが表示されます。",
        "KOREAN": "고급] QAPP 패키지를 선택한 다음 [백웨이트] QAPP을 선택합니다. QAPP에 대한 설명과 버전이 표시됩니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
