    "PRINT_SBI_DIRECT_ERROR_1_STEP_2": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Check that the balance is recognized in the device manager of the operating system. If the balance is not recognized by the operating system:",
        "GERMAN": "Überprüfen Sie, ob die Waage im Gerätemanager des Betriebssystems erkannt wird.. Falls die Waage im Betriebssystem nicht als Tastatur erkannt wird:",
        "RUSSIAN": "Убедитесь, что баланс распознан в диспетчере устройств операционной системы. Если весы не распознаются операционной системой как клавиатура:",
        "FRENCH": "Vérifiez que la balance est reconnue dans le gestionnaire de périphériques du système d'exploitation. Si la balance n'est pas reconnue comme un clavier par le système d'exploitation :",
        "SPANISH": "Compruebe que la balanza es reconocida en el administrador de dispositivos del sistema operativo. Si la balanza no es reconocida como teclado por el sistema operativo:",
        "ITALIAN": "ConControllate che la bilancia sia riconosciuta nella gestione dei dispositivi del sistema operativo. Se la bilancia non viene riconosciuta come tastiera dal sistema operativo:",
        "CHINESE": "检查操作系统的设备管理器是否识别天平。如果操作系统未识别天平：",
        "JAPANESE": "天びんが OS のデバイスマネージャで認識されていることを確認します。天びんがOSに認識されていない場合",
        "KOREAN": "운영 체제의 장치 관리자에서 잔액이 인식되는지 확인합니다. 운영 체제에서 잔액이 인식되지 않는 경우:"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Убедитесь, что баланс распознан в диспетчере устройств операционной системы. Если весы не распознаются операционной системой как клавиатура:",
        "FRENCH": "Vérifiez que la balance est reconnue dans le gestionnaire de périphériques du système d'exploitation. Si la balance n'est pas reconnue comme un clavier par le système d'exploitation :",
        "SPANISH": "Compruebe que la balanza es reconocida en el administrador de dispositivos del sistema operativo. Si la balanza no es reconocida como teclado por el sistema operativo:",
        "ITALIAN": "ConControllate che la bilancia sia riconosciuta nella gestione dei dispositivi del sistema operativo. Se la bilancia non viene riconosciuta come tastiera dal sistema operativo:",
        "CHINESE": "检查操作系统的设备管理器是否识别天平。如果操作系统未识别天平：",
        "JAPANESE": "天びんが OS のデバイスマネージャで認識されていることを確認します。天びんがOSに認識されていない場合",
        "KOREAN": "운영 체제의 장치 관리자에서 잔액이 인식되는지 확인합니다. 운영 체제에서 잔액이 인식되지 않는 경우:"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_SBI_DIRECT_ERROR_1_STEP_2_A": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Ensure that the Cubis® MSA USB-B interface is set to [SBI].",
        "GERMAN": "Vergewissern Sie sich, dass die Cubis® MSA USB-B-Schnittstelle auf [SBI] eingestellt ist.",
        "RUSSIAN": "Убедитесь, что интерфейс USB-B Cubis® MSA установлен в положение [SBI].",
        "FRENCH": "Assurez-vous que l'interface USB-B de Cubis® MSA est réglée sur [SBI].",
        "SPANISH": "Asegúrese de que la interfaz USB-B del Cubis® MSA está ajustada a [SBI].",
        "ITALIAN": "Assicurarsi che l'interfaccia Cubis® MSA USB-B sia impostata su [SBI].",
        "CHINESE": "确保 Cubis® MSA USB-B 接口设置为 [SBI]。",
        "JAPANESE": "Cubis® MSA USB-B インターフェースが [SBI] に設定されていることを確認します。",
        "KOREAN": "Cubis® MSA USB-B 인터페이스가 [SBI]로 설정되어 있는지 확인합니다."
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Убедитесь, что интерфейс USB-B Cubis® MSA установлен в положение [SBI].",
        "FRENCH": "Assurez-vous que l'interface USB-B de Cubis® MSA est réglée sur [SBI].",
        "SPANISH": "Asegúrese de que la interfaz USB-B del Cubis® MSA está ajustada a [SBI].",
        "ITALIAN": "Assicurarsi che l'interfaccia Cubis® MSA USB-B sia impostata su [SBI].",
        "CHINESE": "确保 Cubis® MSA USB-B 接口设置为 [SBI]。",
        "JAPANESE": "Cubis® MSA USB-B インターフェースが [SBI] に設定されていることを確認します。",
        "KOREAN": "Cubis® MSA USB-B 인터페이스가 [SBI]로 설정되어 있는지 확인합니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_SBI_DIRECT_ERROR_1_STEP_2_B": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Ensure that you have the right to add new hardware to the operating system. (No special driver is required.)",
        "GERMAN": "Vergewissern Sie sich, dass Sie das Recht haben, neue Hardware im Betriebssystem hinzuzufügen. (Es ist kein spezieller Treiber erforderlich).",
        "RUSSIAN": "Убедитесь, что у вас есть право добавлять новое оборудование в операционную систему. (Специальный драйвер не требуется.)",
        "FRENCH": "Assurez-vous que vous avez le droit d'ajouter un nouveau matériel au système d'exploitation. (Aucun pilote spécial n'est requis).",
        "SPANISH": "Asegúrese de que tiene derecho a añadir nuevo hardware al sistema operativo. (No se requiere ningún controlador especial).",
        "ITALIAN": "Assicuratevi di avere il diritto di aggiungere nuovo hardware al sistema operativo. (Non è richiesto alcun driver speciale).",
        "CHINESE": "确保您有权在操作系统中添加新硬件。(无需特殊驱动程序）。",
        "JAPANESE": "新しいハードウェアをオペレーティングシステムに追加する権利があることを確認してください。(特別なドライバは必要ありません）。",
        "KOREAN": "운영 체제에 새 하드웨어를 추가할 수 있는 권한이 있는지 확인합니다. (특별한 드라이버는 필요하지 않습니다.)"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Убедитесь, что у вас есть право добавлять новое оборудование в операционную систему. (Специальный драйвер не требуется.)",
        "FRENCH": "Assurez-vous que vous avez le droit d'ajouter un nouveau matériel au système d'exploitation. (Aucun pilote spécial n'est requis).",
        "SPANISH": "Asegúrese de que tiene derecho a añadir nuevo hardware al sistema operativo. (No se requiere ningún controlador especial).",
        "ITALIAN": "Assicuratevi di avere il diritto di aggiungere nuovo hardware al sistema operativo. (Non è richiesto alcun driver speciale).",
        "CHINESE": "确保您有权在操作系统中添加新硬件。(无需特殊驱动程序）。",
        "JAPANESE": "新しいハードウェアをオペレーティングシステムに追加する権利があることを確認してください。(特別なドライバは必要ありません）。",
        "KOREAN": "운영 체제에 새 하드웨어를 추가할 수 있는 권한이 있는지 확인합니다. (특별한 드라이버는 필요하지 않습니다.)"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
