      "TRANSLATIONS": {
        "ENGLISH": "Set the first execution date and time, e.g. 2023/03/01, 8:00",
        "GERMAN": "Setzen Sie das erste Ausführungsdatum und -uhrzeit, z. B. 01.03.2023, 8:00",
        "CHINESE": "设置首次执行日期和时间，例如 2023/03/01, 8:00",
        "FRENCH": "Définissez la première date et heure d'exécution, par exemple 01.03.2023, 8:00",
        "SPANISH": "Establezca la fecha y hora de la primera ejecución, por ejemplo 2023/03/01, 8:00",
        "RUSSIAN": "Установите дату и время первого выполнения, например, 2023/03/01, 8:00",
        "ITALIAN": "Impostare la data e l'ora della prima esecuzione, ad esempio 2023/03/01, 8:00."
      },
      "AUTOTRANSLATIONS": {
        "CHINESE": "设置首次执行日期和时间，例如 2023/03/01, 8:00",
        "FRENCH": "Définissez la première date et heure d'exécution, par exemple 01.03.2023, 8:00",
        "SPANISH": "Establezca la fecha y hora de la primera ejecución, por ejemplo 2023/03/01, 8:00",
        "RUSSIAN": "Установите дату и время первого выполнения, например, 2023/03/01, 8:00",
        "ITALIAN": "Impostare la data e l'ora della prima esecuzione, ad esempio 2023/03/01, 8:00."
      },
      "VERIFIED": {
        "ENGLISH": false,
