        "GERMAN": "Die SBI Befehle und Ausgabeformate sind in einer separaten Schnittstellenbeschreibung zu finden.",
        "RUSSIAN": "Команды SBI и форматы вывода приведены в отдельном описании интерфейса.",
        "FRENCH": "Les commandes SBI et les formats de sortie sont donnés dans une description séparée de l'interface.",
        "SPANISH": "Los comandos SBI y los formatos de salida se dan en una descripción de la interfaz por separado.",
        "ITALIAN": "I comandi SBI e i formati di output sono dati in una descrizione separata dell'interfaccia.",
        "CHINESE": "SBI 命令和输出格式在单独的界面说明中给出。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Команды SBI и форматы вывода приведены в отдельном описании интерфейса.",
        "FRENCH": "Les commandes SBI et les formats de sortie sont donnés dans une description séparée de l'interface.",
        "SPANISH": "Los comandos SBI y los formatos de salida se dan en una descripción de la interfaz por separado.",
        "ITALIAN": "I comandi SBI e i formati di output sono dati in una descrizione separata dell'interfaccia.",
        "CHINESE": "SBI 命令和输出格式在单独的界面说明中给出。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
