      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Available resolutions",
        "GERMAN": "Verfügbare Auflösungen",
        "FRENCH": "Résolutions disponibles",
        "RUSSIAN": "Доступные разрешения",
        "SPANISH": "Resoluciones disponibles",
        "ITALIAN": "Risoluzioni disponibili",
        "CHINESE": "可用分辨率"
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Résolutions disponibles",
        "RUSSIAN": "Доступные разрешения",
        "SPANISH": "Resoluciones disponibles",
        "ITALIAN": "Risoluzioni disponibili",
        "CHINESE": "可用分辨率"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
