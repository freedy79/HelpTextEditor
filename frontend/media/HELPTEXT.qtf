    "TCA_STANDBY_INSTRUCTION_1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "This action allows the balance to be regularly switched to [Standby mode] at a specified time. For the [Action execution], you can determine whether the execution can be aborted or not.",
        "GERMAN": "Mit dieser Aktion kann die Waage regelmäßig zu einem bestimmten Zeitpunkt in den [Standby-Modus] geschaltet werden. Für die [Ausführung der Aktion] kann festgelegt werden ob die Ausführung abbrechbar ist oder nicht.",
        "RUSSIAN": "Это действие позволяет регулярно переводить весы в [Режим ожидания] в заданное время. Для параметра [Выполнение действия] можно определить, можно ли прервать выполнение или нет.",
        "FRENCH": "Cette action permet à la balance de passer régulièrement en [mode veille] à une heure donnée. Pour l'[Exécution de l'action], vous pouvez déterminer si l'exécution peut être interrompue ou non.",
        "SPANISH": "Esta acción permite que la balanza pase regularmente al [Modo de espera] a una hora determinada. Para la [Ejecución de la acción], se puede determinar si la ejecución se puede abortar o no.",
        "ITALIAN": "Questa azione permette alla bilancia di passare regolarmente alla [Standby mode] ad un'ora specificata. Per l'[Esecuzione dell'azione], è possibile determinare se l'esecuzione può essere interrotta o meno.",
        "CHINESE": "该操作允许天平在指定时间定期切换到 [待机模式]。对于 [动作执行]，您可以确定是否可以中止执行。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Это действие позволяет регулярно переводить весы в [Режим ожидания] в заданное время. Для параметра [Выполнение действия] можно определить, можно ли прервать выполнение или нет.",
        "FRENCH": "Cette action permet à la balance de passer régulièrement en [mode veille] à une heure donnée. Pour l'[Exécution de l'action], vous pouvez déterminer si l'exécution peut être interrompue ou non.",
        "SPANISH": "Esta acción permite que la balanza pase regularmente al [Modo de espera] a una hora determinada. Para la [Ejecución de la acción], se puede determinar si la ejecución se puede abortar o no.",
        "ITALIAN": "Questa azione permette alla bilancia di passare regolarmente alla [Standby mode] ad un'ora specificata. Per l'[Esecuzione dell'azione], è possibile determinare se l'esecuzione può essere interrotta o meno.",
        "CHINESE": "该操作允许天平在指定时间定期切换到 [待机模式]。对于 [动作执行]，您可以确定是否可以中止执行。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "TCA_STANDBY_INSTRUCTION_2": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "You can switch on the balance from standby by pressing the Standby icon on the display.",
        "GERMAN": "Das Einschalten der Waage aus dem Standby heraus ist durch das Betätigen vom Symbol Standby auf der Anzeige möglich.",
        "RUSSIAN": "Вы можете включить весы из режима ожидания, нажав значок Standby на дисплее.",
        "FRENCH": "Vous pouvez mettre la balance en marche à partir du mode veille en appuyant sur l'icône de veille à l'écran.",
        "SPANISH": "Puedes encender la balanza desde el modo de espera pulsando el icono de Standby en la pantalla.",
        "ITALIAN": "È possibile accendere la bilancia dallo standby premendo l'icona Standby sul display.",
        "CHINESE": "按显示屏上的待机图标可以从待机状态打开天平。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Вы можете включить весы из режима ожидания, нажав значок Standby на дисплее.",
        "FRENCH": "Vous pouvez mettre la balance en marche à partir du mode veille en appuyant sur l'icône de veille à l'écran.",
        "SPANISH": "Puedes encender la balanza desde el modo de espera pulsando el icono de Standby en la pantalla.",
        "ITALIAN": "È possibile accendere la bilancia dallo standby premendo l'icona Standby sul display.",
        "CHINESE": "按显示屏上的待机图标可以从待机状态打开天平。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "TCA_WAKING_UP_TITLE": {
      "group": "HELP_TITLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
