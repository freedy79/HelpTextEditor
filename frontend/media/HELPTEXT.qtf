      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Assign the [Weighing with units g, ct, lb] weighing profile to your task e.g., [My weighing with the units g, ct, lb].",
        "GERMAN": "Ordnen Sie das Wägeprofil [Wägen mit Einheit g, ct, lb] Ihrer Task zu z. B. [Mein Wägen mit der Einheit g, ct, lb].",
        "RUSSIAN": "Назначьте профиль взвешивания [Взвешивание с единицами g, ct, lb] для вашей задачи, например, [Мое взвешивание с единицами g, ct, lb].",
        "FRENCH": "Attribuez le profil de pesée [Pesée avec les unités g, ct, lb] à votre tâche, par exemple, [Ma pesée avec les unités g, ct, lb].",
        "SPANISH": "Asigne el perfil de pesaje [Pesaje con unidades g, ct, lb] a su tarea, por ejemplo, [Mi pesaje con las unidades g, ct, lb].",
        "ITALIAN": "Assegnare il profilo di pesatura [Pesatura con unità g, ct, lb] al vostro compito, ad esempio, [La mia pesatura con le unità g, ct, lb].",
        "CHINESE": "为您的任务分配[用 g、ct、lb 单位称重]称重配置文件，例如[我用 g、ct、lb 单位称重]。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Назначьте профиль взвешивания [Взвешивание с единицами g, ct, lb] для вашей задачи, например, [Мое взвешивание с единицами g, ct, lb].",
        "FRENCH": "Attribuez le profil de pesée [Pesée avec les unités g, ct, lb] à votre tâche, par exemple, [Ma pesée avec les unités g, ct, lb].",
        "SPANISH": "Asigne el perfil de pesaje [Pesaje con unidades g, ct, lb] a su tarea, por ejemplo, [Mi pesaje con las unidades g, ct, lb].",
        "ITALIAN": "Assegnare il profilo di pesatura [Pesatura con unità g, ct, lb] al vostro compito, ad esempio, [La mia pesatura con le unità g, ct, lb].",
        "CHINESE": "为您的任务分配[用 g、ct、lb 单位称重]称重配置文件，例如[我用 g、ct、lb 单位称重]。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
