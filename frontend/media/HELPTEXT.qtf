      "TRANSLATIONS": {
        "GERMAN": "<a href=\"#NETWORK_CERTIFICATES_TYPES_CA\">CA-Zertifikate (Vertrauenswürdige Zertfizierungsstellen)</a>",
        "ENGLISH": "<a href=\"#NETWORK_CERTIFICATES_TYPES_CA\">CA certificates (trusted certification authorities)</a>",
        "FRENCH": "<a href=\"#NETWORK_CERTIFICATES_TYPES_CA\">Certificats CA (autorités de certification de confiance)</a>.",
        "SPANISH": "<a href=\"#NETWORK_CERTIFICATES_TYPES_CA\">Certificados CA (autoridades de certificación de confianza)</a>",
        "RUSSIAN": "<a href=\"#NETWORK_CERTIFICATES_TYPES_CA\">CA-сертификаты (доверенные центры сертификации)</a>",
        "ITALIAN": "<a href=\"#NETWORK_CERTIFICATES_TYPES_CA\">Certificati CA (autorità di certificazione fidate)</a>",
        "CHINESE": "<a href=\"#NETWORK_CERTIFICATES_TYPES_CA\">CA 证书（受信任的认证机构）</a>。"
      },
      "AUTOTRANSLATIONS": {
        "ENGLISH": "<a href=\"#NETWORK_CERTIFICATES_TYPES_CA\">CA certificates (trusted certification authorities)</a>",
        "FRENCH": "<a href=\"#NETWORK_CERTIFICATES_TYPES_CA\">Certificats CA (autorités de certification de confiance)</a>.",
