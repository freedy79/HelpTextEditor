    "EXAMPLE_CREATE_LOCAL_USER_CONF_STEP_2_D": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Enter a display name, a login name and optionally a user description, such as [My local user] as display name, [local.user] as login name and as description [Local user with password].",
        "GERMAN": "Geben Sie einen Anzeigenamen, einen Anmeldenamen und optional eine Benutzerbeschreibung ein, z. B. [Mein lokaler Anwender] als Anzeigenamen, [lokaler.Anwender] als Anmeldenamen und als Beschreibung [Lokaler Anwender mit Passwort].",
        "RUSSIAN": "Введите имя пользователя и, по желанию, описание пользователя, например [Мой локальный пользователь] и описание [Локальный пользователь с паролем].",
        "FRENCH": "Saisissez un nom d'utilisateur et éventuellement une description de l'utilisateur, par exemple [Mon utilisateur local] et comme description [Utilisateur local avec mot de passe].",
        "SPANISH": "Introduzca un nombre de usuario y, opcionalmente, una descripción de usuario, como [Mi usuario local] y como descripción [Usuario local con contraseña].",
        "ITALIAN": "Inserisci un nome utente e opzionalmente una descrizione dell'utente, come [Il mio utente locale] e come descrizione [Utente locale con password].",
        "CHINESE": "输入显示名、登录名和用户说明，如 [我的本地用户] 作为显示名，[local.user] 作为登录名，[本地用户带密码] 作为说明。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Введите имя пользователя и, по желанию, описание пользователя, например [Мой локальный пользователь] и описание [Локальный пользователь с паролем].",
        "FRENCH": "Saisissez un nom d'utilisateur et éventuellement une description de l'utilisateur, par exemple [Mon utilisateur local] et comme description [Utilisateur local avec mot de passe].",
        "SPANISH": "Introduzca un nombre de usuario y, opcionalmente, una descripción de usuario, como [Mi usuario local] y como descripción [Usuario local con contraseña].",
        "ITALIAN": "Inserisci un nome utente e opzionalmente una descrizione dell'utente, come [Il mio utente locale] e come descrizione [Utente locale con password].",
        "CHINESE": "输入显示名、登录名和用户说明，如 [我的本地用户] 作为显示名，[local.user] 作为登录名，[本地用户带密码] 作为说明。"
      },
      "VERIFIED": {
