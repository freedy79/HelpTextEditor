      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "<b>High accuracy:</b> High criterion for standstill.",
        "GERMAN": "<b>Hohe Genauigkeit:</b> Hohes Kriterium für den Stillstand.",
        "RUSSIAN": "<b>Высокая точность:</b> Высокий критерий состояния покоя.",
        "FRENCH": "<b>Haute précision:</b> Critère élevé d'immobilisation.",
        "SPANISH": "<b>Alta precisión:</b> Alto criterio de parada.",
        "ITALIAN": "<b>Alta precisione:</b> Alto criterio per l'arresto.",
        "CHINESE": "<b>高精确度：</b>静止时的高标准。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "<b>Высокая точность:</b> Высокий критерий остановки.",
        "FRENCH": "<b>Haute précision:</b> Critère élevé d'immobilisation.",
        "SPANISH": "<b>Alta precisión:</b> Alto criterio de parada.",
        "ITALIAN": "<b>Alta precisione:</b> Alto criterio per l'arresto.",
        "CHINESE": "<b>高精确度：</b>静止时的高标准。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
