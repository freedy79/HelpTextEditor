    "NETWORK_CERTIFICATES_TYPES_DEVICE_ENUM_1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "GERMAN": "Erstellen Sie eine eigene private CA mit Tools wie OpenSSL oder Microsoft CA.",
        "ENGLISH": "Create your own private CA with tools such as OpenSSL or Microsoft CA.",
        "FRENCH": "Créez votre propre CA privée avec des outils comme OpenSSL ou Microsoft CA.",
        "SPANISH": "Cree su propia CA privada con herramientas como OpenSSL o Microsoft CA.",
        "RUSSIAN": "Создайте собственный частный ЦС с помощью таких инструментов, как OpenSSL или Microsoft CA.",
        "ITALIAN": "Creare una CA privata con strumenti quali OpenSSL o Microsoft CA.",
        "CHINESE": "使用 OpenSSL 或 Microsoft CA 等工具创建自己的专用 CA。"
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Créez votre propre CA privée avec des outils comme OpenSSL ou Microsoft CA.",
        "SPANISH": "Cree su propia CA privada con herramientas como OpenSSL o Microsoft CA.",
        "RUSSIAN": "Создайте собственный частный ЦС с помощью таких инструментов, как OpenSSL или Microsoft CA.",
        "ITALIAN": "Creare una CA privata con strumenti quali OpenSSL o Microsoft CA.",
        "CHINESE": "使用 OpenSSL 或 Microsoft CA 等工具创建自己的专用 CA。"
      },
      "VERIFIED": {
        "GERMAN": false,
        "ENGLISH": false,
        "FRENCH": false,
        "SPANISH": false,
        "RUSSIAN": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "NETWORK_CERTIFICATES_TYPES_DEVICE_ENUM_2": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "GERMAN": "Beauftragen Sie einen Managed PKI (mPKI)-Anbieter, der Ihre Authentifizierungs- und Verschlüsselungsanforderungen übernimmt.",
        "ENGLISH": "Hire a managed PKI (mPKI) provider to handle your authentication and encryption needs.",
        "FRENCH": "Engagez un fournisseur de Managed PKI (mPKI) qui prendra en charge vos besoins d'authentification et de cryptage.",
        "SPANISH": "Contrate a un proveedor de PKI gestionada (mPKI) para que se encargue de sus necesidades de autenticación y cifrado.",
        "RUSSIAN": "Наймите поставщика управляемых PKI (mPKI) для решения задач аутентификации и шифрования.",
        "ITALIAN": "Assumete un fornitore di PKI gestite (mPKI) per gestire le vostre esigenze di autenticazione e crittografia.",
        "CHINESE": "聘请托管 PKI（mPKI）提供商来满足您的身份验证和加密需求。"
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Engagez un fournisseur de Managed PKI (mPKI) qui prendra en charge vos besoins d'authentification et de cryptage.",
        "SPANISH": "Contrate a un proveedor de PKI gestionada (mPKI) para que se encargue de sus necesidades de autenticación y cifrado.",
        "RUSSIAN": "Наймите поставщика управляемых PKI (mPKI) для решения задач аутентификации и шифрования.",
        "ITALIAN": "Assumete un fornitore di PKI gestite (mPKI) per gestire le vostre esigenze di autenticazione e crittografia.",
        "CHINESE": "聘请托管 PKI（mPKI）提供商来满足您的身份验证和加密需求。"
      },
      "VERIFIED": {
        "GERMAN": false,
        "ENGLISH": false,
        "FRENCH": false,
        "SPANISH": false,
        "RUSSIAN": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "NETWORK_CERTIFICATES_TYPES_DEVICE_INSTRUCTION_3": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "GERMAN": "In der Regel wird ein Gerätezertifikat von der internen Zertifizierungsstelle (CA) einer Organisation ausgestellt. Das Zertifikat wird mit dem privaten Schlüssel des Stammzertifikats (<a href=\"#NETWORK_CERTIFICATES_TYPES_CA\">CA-Zertifikat</a>) der Organisation signiert, das als Basis für die Signierung weiterer Zertifikate dient.",
        "ENGLISH": "In der Regel wird ein Gerätezertifikat von der internen Zertifizierungsstelle (CA) einer Organisation ausgestellt. Das Zertifikat wird mit dem privaten Schlüssel des Stammzertifikats (<a href=“#NETWORK_CERTIFICATES_TYPES_CA”>CA-Zertifikat</a>) der Organisation signiert, das als Basis für die Signierung weiterer Zertifikate dient.",
        "FRENCH": "En règle générale, un certificat de périphérique est délivré par l'autorité de certification (AC) interne d'une organisation. Le certificat est signé avec la clé privée du certificat racine (<a href=\"#NETWORK_CERTIFICATES_TYPES_CA\">certificat AC</a>) de l'organisation, qui sert de base pour la signature d'autres certificats.",
        "SPANISH": "En este Reglamento se establece un certificado de gestión del centro de certificación interno (CA) de una organización. El certificado se firmará con el sello privado del certificado de empresa (<a href=\"#NETWORK_CERTIFICATES_TYPES_CA\">CA-Zertifikat</a>) de la organización, que servirá de base para la firma de otros certificados.",
        "RUSSIAN": "В соответствии с этим правилом должен быть создан Gerätezertifikat из внутреннего Zertifizierungsstelle (CA) одной организации. Das Zertifikat wird mit dem privaten Schlüssel des Stammzertifikats (<a href=\"#NETWORK_CERTIFICATES_TYPES_CA\">CA-Zertifikat</a>) der Organisation signiert, das als Basis für die Signierung weiterer Zertifikate dient.",
        "ITALIAN": "In der Regel wird ein Gerätezertifikat von der internen Zertifizierungsstelle (CA) einer Organisation ausgestellt. Lo Zertifikat viene siglato con lo Schlüssel privato dello Stammzertifikat (<a href=\"#NETWORK_CERTIFICATES_TYPES_CA\">CA-Zertifikat</a>) dell'Organizzazione, che è la base per la firma di altri Zertifikat.",
        "CHINESE": "在此规定中，内部认证中心（CA）会为某一组织提供一个 Gerätezertifikat。该 Zertifikat 将在组织的 Stammzertifikats (<a href=\"#NETWORK_CERTIFICATES_TYPES_CA\">CA-Zertifikat</a>)私有标记上签名，作为签署其他 Zertifikat 的基础。"
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "En règle générale, un certificat de périphérique est délivré par l'autorité de certification (AC) interne d'une organisation. Le certificat est signé avec la clé privée du certificat racine (<a href=\"#NETWORK_CERTIFICATES_TYPES_CA\">certificat AC</a>) de l'organisation, qui sert de base pour la signature d'autres certificats.",
        "SPANISH": "En este Reglamento se establece un certificado de gestión del centro de certificación interno (CA) de una organización. El certificado se firmará con el sello privado del certificado de empresa (<a href=\"#NETWORK_CERTIFICATES_TYPES_CA\">CA-Zertifikat</a>) de la organización, que servirá de base para la firma de otros certificados.",
        "RUSSIAN": "В соответствии с этим правилом должен быть создан Gerätezertifikat из внутреннего Zertifizierungsstelle (CA) одной организации. Das Zertifikat wird mit dem privaten Schlüssel des Stammzertifikats (<a href=\"#NETWORK_CERTIFICATES_TYPES_CA\">CA-Zertifikat</a>) der Organisation signiert, das als Basis für die Signierung weiterer Zertifikate dient.",
        "ITALIAN": "In der Regel wird ein Gerätezertifikat von der internen Zertifizierungsstelle (CA) einer Organisation ausgestellt. Lo Zertifikat viene siglato con lo Schlüssel privato dello Stammzertifikat (<a href=\"#NETWORK_CERTIFICATES_TYPES_CA\">CA-Zertifikat</a>) dell'Organizzazione, che è la base per la firma di altri Zertifikat.",
        "CHINESE": "在此规定中，内部认证中心（CA）会为某一组织提供一个 Gerätezertifikat。该 Zertifikat 将在组织的 Stammzertifikats (<a href=\"#NETWORK_CERTIFICATES_TYPES_CA\">CA-Zertifikat</a>)私有标记上签名，作为签署其他 Zertifikat 的基础。"
      },
      "VERIFIED": {
        "GERMAN": false,
        "ENGLISH": false,
        "FRENCH": false,
        "SPANISH": false,
        "RUSSIAN": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "NETWORK_CERTIFICATES_TYPES_DEVICE_INSTRUCTION_4": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "GERMAN": "<b>Die Sicherung der Geräte obliegt dem Betreiber und ist keine Leistung des Herstellers Sartorius.</b> Daher ist es wichtig, das Gerät mit einem eigenen Zertifikat zu sichern, sobald es in Ihrer Organisation eintrifft. Ab Werk werden die Geräte mit einem Standard-Zertifikat von Sartorius ausgeliefert.",
        "ENGLISH": "<b>The security of the devices is the responsibility of the operator and is not a service provided by the manufacturer Sartorius.</b> It is therefore important to secure the device with your own certificate as soon as it arrives at your organization. The devices are delivered ex works with a standard certificate from Sartorius.",
        "FRENCH": "<b>La sécurisation des appareils incombe à l'exploitant et n'est pas une prestation du fabricant Sartorius.</b> Il est donc important de sécuriser l'appareil avec son propre certificat dès qu'il arrive dans votre organisation. Au départ de l'usine, les appareils sont livrés avec un certificat standard de Sartorius.",
        "SPANISH": "<b>La seguridad de los aparatos es responsabilidad del operador y no es un servicio proporcionado por el fabricante Sartorius.</b> Por lo tanto, es importante asegurar el aparato con su propio certificado tan pronto como llegue a su organización. Los aparatos se entregan de fábrica con un certificado estándar de Sartorius.",
        "RUSSIAN": "<Поэтому важно защитить устройство собственным сертификатом, как только оно поступит в вашу организацию. Устройства поставляются в разобранном виде со стандартным сертификатом от Sartorius.",
        "ITALIAN": "<b>La sicurezza dei dispositivi è responsabilità dell'operatore e non è un servizio fornito dal produttore Sartorius.</b> È quindi importante proteggere il dispositivo con il proprio certificato non appena arriva alla propria organizzazione. I dispositivi vengono consegnati franco fabbrica con un certificato standard di Sartorius.",
        "CHINESE": "<b>设备的安全性由操作人员负责，并非赛多利斯制造商提供的服务。</b>因此，设备到达贵机构后，必须立即使用自己的证书确保其安全性。设备出厂时带有赛多利斯的标准证书。"
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "<b>La sécurisation des appareils incombe à l'exploitant et n'est pas une prestation du fabricant Sartorius.</b> Il est donc important de sécuriser l'appareil avec son propre certificat dès qu'il arrive dans votre organisation. Au départ de l'usine, les appareils sont livrés avec un certificat standard de Sartorius.",
        "SPANISH": "<b>La seguridad de los aparatos es responsabilidad del operador y no es un servicio proporcionado por el fabricante Sartorius.</b> Por lo tanto, es importante asegurar el aparato con su propio certificado tan pronto como llegue a su organización. Los aparatos se entregan de fábrica con un certificado estándar de Sartorius.",
        "RUSSIAN": "<Поэтому важно защитить устройство собственным сертификатом, как только оно поступит в вашу организацию. Устройства поставляются в разобранном виде со стандартным сертификатом от Sartorius.",
        "ITALIAN": "<b>La sicurezza dei dispositivi è responsabilità dell'operatore e non è un servizio fornito dal produttore Sartorius.</b> È quindi importante proteggere il dispositivo con il proprio certificato non appena arriva alla propria organizzazione. I dispositivi vengono consegnati franco fabbrica con un certificato standard di Sartorius.",
        "CHINESE": "<b>设备的安全性由操作人员负责，并非赛多利斯制造商提供的服务。</b>因此，设备到达贵机构后，必须立即使用自己的证书确保其安全性。设备出厂时带有赛多利斯的标准证书。"
      },
      "VERIFIED": {
        "GERMAN": false,
        "ENGLISH": false,
        "FRENCH": false,
        "SPANISH": false,
        "RUSSIAN": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "NETWORK_CERTIFICATES_TYPES_DEVICE_INSTRUCTION_5": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "GERMAN": "Gerätezertifikate sollten intern in Ihrem System und Netzwerk erstellt werden, wofür eine private CA erforderlich ist. Es gibt zwei Ansätze:",
        "ENGLISH": "Device certificates should be created internally in your system and network, which requires a private CA. There are two approaches:",
        "FRENCH": "Les certificats de périphérique doivent être créés en interne dans votre système et votre réseau, ce qui nécessite une AC privée. Il existe deux approches :",
        "SPANISH": "Los certificados de dispositivo deben crearse internamente en su sistema y red, lo que requiere una CA privada. Existen dos enfoques:",
        "RUSSIAN": "Сертификаты устройств должны создаваться внутри вашей системы и сети, для чего необходим частный ЦС. Существует два подхода:",
        "ITALIAN": "I certificati dei dispositivi devono essere creati internamente al sistema e alla rete, il che richiede una CA privata. Esistono due approcci:",
        "CHINESE": "设备证书应在系统和网络内部创建，这需要一个私有 CA。有两种方法："
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Les certificats de périphérique doivent être créés en interne dans votre système et votre réseau, ce qui nécessite une AC privée. Il existe deux approches :",
        "SPANISH": "Los certificados de dispositivo deben crearse internamente en su sistema y red, lo que requiere una CA privada. Existen dos enfoques:",
        "RUSSIAN": "Сертификаты устройств должны создаваться внутри вашей системы и сети, для чего необходим частный ЦС. Существует два подхода:",
        "ITALIAN": "I certificati dei dispositivi devono essere creati internamente al sistema e alla rete, il che richiede una CA privata. Esistono due approcci:",
        "CHINESE": "设备证书应在系统和网络内部创建，这需要一个私有 CA。有两种方法："
      },
      "VERIFIED": {
        "GERMAN": false,
        "ENGLISH": false,
        "FRENCH": false,
        "SPANISH": false,
        "RUSSIAN": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
