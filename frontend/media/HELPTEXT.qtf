      "TRANSLATIONS": {
        "ENGLISH": "Establish a connector for a network printer, e.g. [My A4 network printer].",
        "GERMAN": "Richten Sie einen Konnektor für einen Netzwerk-Drucker ein, z. B. [Mein A4 Netzwerk-Drucker].",
        "RUSSIAN": "Установите коннектор для сетевого принтера, например, [Мой сетевой принтер A4].",
        "FRENCH": "Établissez un connecteur pour une imprimante réseau, par exemple [Mon imprimante réseau A4].",
        "SPANISH": "Establezca un conector para una impresora de red, por ejemplo, [Mi impresora de red A4].",
        "ITALIAN": "Stabilire un connettore per una stampante di rete, ad esempio [La mia stampante di rete A4].",
        "CHINESE": "建立网络打印机连接器，例如 [我的 A4 网络打印机]。",
        "JAPANESE": "My A4 network printer]など、ネットワークプリンターのコネクターを設定します。",
        "KOREAN": "네트워크 프린터용 커넥터를 설정합니다(예: [내 A4 네트워크 프린터])."
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Установите коннектор для сетевого принтера, например, [Мой сетевой принтер A4].",
        "FRENCH": "Établissez un connecteur pour une imprimante réseau, par exemple [Mon imprimante réseau A4].",
        "SPANISH": "Establezca un conector para una impresora de red, por ejemplo, [Mi impresora de red A4].",
        "ITALIAN": "Stabilire un connettore per una stampante di rete, ad esempio [La mia stampante di rete A4].",
        "CHINESE": "建立网络打印机连接器，例如 [我的 A4 网络打印机]。",
        "JAPANESE": "My A4 network printer]など、ネットワークプリンターのコネクターを設定します。",
