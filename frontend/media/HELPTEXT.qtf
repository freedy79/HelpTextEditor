    "EXAMPLE_CREATE_NEW_ROLE_CONF_STEP_1": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ]. Do not translate QAPP and QAPP Center.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Activate the [User management] QAPP extension, if not yet done.",
        "GERMAN": "Aktivieren Sie die QAPP-Erweiterung [Benutzerverwaltung], falls noch nicht erfolgt.",
        "RUSSIAN": "Активируйте расширение QAPP [Управление пользователями], если это еще не сделано.",
        "FRENCH": "Activez l'extension QAPP [Gestion des utilisateurs], si ce n'est pas encore fait.",
        "SPANISH": "Active la extensión QAPP [Gestión de usuarios], si aún no lo ha hecho.",
        "ITALIAN": "Attivare l'estensione QAPP [Gestione utenti], se non ancora fatto.",
        "CHINESE": "如果尚未激活[用户管理]QAPP 扩展，请激活。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Активируйте расширение QAPP [Управление пользователями], если это еще не сделано.",
        "FRENCH": "Activez l'extension QAPP [Gestion des utilisateurs], si ce n'est pas encore fait.",
        "SPANISH": "Active la extensión QAPP [Gestión de usuarios], si aún no lo ha hecho.",
        "ITALIAN": "Attivare l'estensione QAPP [Gestione utenti], se non ancora fatto.",
        "CHINESE": "如果尚未激活[用户管理]QAPP 扩展，请激活。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "EXAMPLE_CREATE_NEW_ROLE_CONF_STEP_1_A": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ]. Do not translate QAPP and QAPP Center.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Open the [Task management] menu, followed by the [QAPP Center].",
        "GERMAN": "Das Menü [Task-Verwaltung] und dann das [QAPP Center] öffnen.",
        "RUSSIAN": "Откройте меню [Управление задачами], а затем [QAPP Center].",
        "FRENCH": "Ouvrez le menu [Gestion des tâches], puis le [Centre QAPP].",
        "SPANISH": "Abra el menú [Gestión de tareas], seguido del [Centro QAPP].",
        "ITALIAN": "Apri il menu [Task management], seguito dal [QAPP Center].",
        "CHINESE": "打开 [任务管理] 菜单，然后打开 [QAPP 中心]。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Откройте меню [Управление задачами], а затем [QAPP Center].",
        "FRENCH": "Ouvrez le menu [Gestion des tâches], puis le [Centre QAPP].",
        "SPANISH": "Abra el menú [Gestión de tareas], seguido del [Centro QAPP].",
        "ITALIAN": "Apri il menu [Task management], seguito dal [QAPP Center].",
        "CHINESE": "打开 [任务管理] 菜单，然后打开 [QAPP 中心]。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "EXAMPLE_CREATE_NEW_ROLE_CONF_STEP_1_B": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ]. Do not translate QAPP and QAPP Center.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Select the software package [Pharma] and QAPP [User management] in it. The description and version of the QAPP will be displayed.",
        "GERMAN": "Wählen Sie das Software-Paket [Pharma] und darin die QAPP [Benutzerverwaltung]. Es wird die Beschreibung und Version der QAPP angezeigt.",
        "RUSSIAN": "Выберите пакет программного обеспечения [Pharma] и QAPP [User management] в нем. Появится описание и версия QAPP.",
        "FRENCH": "Sélectionnez le progiciel [Pharma] et le QAPP [User management] dans celui-ci. La description et la version du QAPP s'affichent.",
        "SPANISH": "Seleccione el paquete de software [Pharma] y el QAPP [User management] en él. Se mostrará la descripción y la versión del QAPP.",
        "ITALIAN": "Seleziona il pacchetto software [Pharma] e il QAPP [Gestione utenti] in esso. Verranno visualizzate la descrizione e la versione del QAPP.",
        "CHINESE": "选择软件包 [制药] 和其中的 QAPP [用户管理]。将显示 QAPP 的说明和版本。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Выберите пакет программного обеспечения [Pharma] и QAPP [User management] в нем. Появится описание и версия QAPP.",
        "FRENCH": "Sélectionnez le progiciel [Pharma] et le QAPP [User management] dans celui-ci. La description et la version du QAPP s'affichent.",
        "SPANISH": "Seleccione el paquete de software [Pharma] y el QAPP [User management] en él. Se mostrará la descripción y la versión del QAPP.",
        "ITALIAN": "Seleziona il pacchetto software [Pharma] e il QAPP [Gestione utenti] in esso. Verranno visualizzate la descrizione e la versione del QAPP.",
        "CHINESE": "选择软件包 [制药] 和其中的 QAPP [用户管理]。将显示 QAPP 的说明和版本。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "EXAMPLE_CREATE_NEW_ROLE_CONF_STEP_1_C": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ]. Do not translate QAPP and QAPP Center.",
      "locked": false,
      "obsolete": false,
