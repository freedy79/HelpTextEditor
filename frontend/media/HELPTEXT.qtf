      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Advanced cleaning states",
        "GERMAN": "Zustände bei erweiterter Reinigung",
        "CHINESE": "高级清洁状态",
        "FRENCH": "États en cas de nettoyage étendu",
        "RUSSIAN": "Государства с расширенной очисткой",
        "SPANISH": "Estados con limpieza prolongada",
        "ITALIAN": "Stati con pulizia estesa"
      },
      "AUTOTRANSLATIONS": {
        "CHINESE": "高级清洁状态",
        "FRENCH": "États en cas de nettoyage étendu",
        "RUSSIAN": "Государства с расширенной очисткой",
        "SPANISH": "Estados con limpieza prolongada",
        "ITALIAN": "Stati con pulizia estesa"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "CHINESE": false,
        "FRENCH": false,
