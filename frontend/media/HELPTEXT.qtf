    "TASK_CONCEPT_ACTIVATE_TITLE1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "TRANSLATIONS": {
