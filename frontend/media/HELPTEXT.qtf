      "TRANSLATIONS": {
        "ENGLISH": "Navigate to [Device settings] -> [Timer controlled actions]",
        "GERMAN": "Navigieren Sie zu [Geräteeinstellungen] -> [Zeitgesteuerte Aktionen]",
        "CHINESE": "导航至 [设备设置] -> [计时器控制的操作］",
        "FRENCH": "Naviguez vers [Réglages de l'appareil] -> [Actions programmées].",
        "SPANISH": "Navegue hasta [Device settings] -> [Timer controlled actions].",
        "RUSSIAN": "Перейдите в раздел [Настройки устройства] -> [Действия, управляемые таймером].",
        "ITALIAN": "Spostarsi su [Impostazioni dispositivo] -> [Azioni controllate dal timer]."
      },
      "AUTOTRANSLATIONS": {
        "CHINESE": "导航至 [设备设置] -> [计时器控制的操作］",
        "FRENCH": "Naviguez vers [Réglages de l'appareil] -> [Actions programmées].",
        "SPANISH": "Navegue hasta [Device settings] -> [Timer controlled actions].",
        "RUSSIAN": "Перейдите в раздел [Настройки устройства] -> [Действия, управляемые таймером].",
        "ITALIAN": "Spostarsi su [Impostazioni dispositivo] -> [Azioni controllate dal timer]."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "CHINESE": false,
        "FRENCH": false,
        "SPANISH": false,
