      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Enter the first date and time [Execution date] as e.g., 2020-05-18 and 08:00:00 i.e., Monday 18.05.2020 at 8:00 a.m.",
        "GERMAN": "Geben Sie das erstmalige [Ausführungsdatum] mit Datum und Uhrzeit ein, z. B. 2020-05-18 und 08:00:00, damit Montag 18.05.2020 um 8:00 Uhr.",
        "RUSSIAN": "Введите первую дату и время [Дата исполнения], например, 2020-05-18 и 08:00:00, т.е. в понедельник 18.05.2020 в 8:00 утра.",
        "FRENCH": "Saisissez la première date et heure [Date d'exécution], par exemple 2020-05-18 et 08:00:00, c'est-à-dire le lundi 18.05.2020 à 8h00.",
        "SPANISH": "Introduzca la primera fecha y hora [Fecha de ejecución] como, por ejemplo, 2020-05-18 y 08:00:00, es decir, el lunes 18.05.2020 a las 8:00 horas.",
        "ITALIAN": "Inserire la prima data e ora [Data di esecuzione] come ad esempio, 2020-05-18 e 08:00:00 cioè, lunedì 18.05.2020 alle 8:00.",
        "CHINESE": "输入第一个日期和时间 [执行日期]，例如 2020-05-18 和 08:00:00，即 2020 年 5 月 18 日星期一上午 8:00。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Введите первую дату и время [Дата исполнения], например, 2020-05-18 и 08:00:00, т.е. в понедельник 18.05.2020 в 8:00 утра.",
        "FRENCH": "Saisissez la première date et heure [Date d'exécution], par exemple 2020-05-18 et 08:00:00, c'est-à-dire le lundi 18.05.2020 à 8h00.",
        "SPANISH": "Introduzca la primera fecha y hora [Fecha de ejecución] como, por ejemplo, 2020-05-18 y 08:00:00, es decir, el lunes 18.05.2020 a las 8:00 horas.",
        "ITALIAN": "Inserire la prima data e ora [Data di esecuzione] come ad esempio, 2020-05-18 e 08:00:00 cioè, lunedì 18.05.2020 alle 8:00.",
        "CHINESE": "输入第一个日期和时间 [执行日期]，例如 2020-05-18 和 08:00:00，即 2020 年 5 月 18 日星期一上午 8:00。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
