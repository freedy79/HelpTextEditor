      "TRANSLATIONS": {
        "ENGLISH": "Set up a connector to a Windows file server e.g., [My SMB server for settings].",
        "GERMAN": "Richten Sie einen Konnektor zu einem Windows File Server ein, z. B. [Mein SMB Server für Einstellungen].",
        "RUSSIAN": "Настройте подключение к файловому серверу Windows, например, [Мой SMB-сервер для настроек].",
        "FRENCH": "Configurez un connecteur vers un serveur de fichiers Windows, par exemple, [Mon serveur SMB pour les paramètres].",
        "SPANISH": "Configure un conector a un servidor de archivos de Windows, por ejemplo, [Mi servidor SMB para la configuración].",
        "ITALIAN": "Impostare un connettore a un file server Windows, ad esempio, [Il mio server SMB per le impostazioni].",
        "CHINESE": "设置连接 Windows 文件服务器的连接器，例如[我的 SMB 服务器设置]。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Настройте подключение к файловому серверу Windows, например, [Мой SMB-сервер для настроек].",
        "FRENCH": "Configurez un connecteur vers un serveur de fichiers Windows, par exemple, [Mon serveur SMB pour les paramètres].",
        "SPANISH": "Configure un conector a un servidor de archivos de Windows, por ejemplo, [Mi servidor SMB para la configuración].",
        "ITALIAN": "Impostare un connettore a un file server Windows, ad esempio, [Il mio server SMB per le impostazioni].",
        "CHINESE": "设置连接 Windows 文件服务器的连接器，例如[我的 SMB 服务器设置]。"
      },
      "VERIFIED": {
