    "WEIGHING_UNITS_INSTRUCTION_1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "This defines which unit(s) should be available in the task and can be set at the beginning of the application.",
        "GERMAN": "Hiermit wird festgelegt, welche Einheit(en) in der Task verfügbar sein sollen und damit zu Beginn der Anwendung ggf. eingestellt werden kann.",
        "RUSSIAN": "Это определяет, какая единица (единицы) измерения должна быть доступна в задании, и может быть установлена в начале приложения.",
        "FRENCH": "Cela définit la ou les unités qui doivent être disponibles dans la tâche et peut être défini au début de l'application.",
        "SPANISH": "Define qué unidad(es) debe(n) estar disponible(s) en la tarea y puede(n) establecerse al principio de la aplicación.",
        "ITALIAN": "Questo definisce quale unità deve essere disponibile nel compito e può essere impostato all'inizio dell'applicazione.",
        "CHINESE": "这定义了任务中应使用的单元，可在应用程序开始时设置。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Это определяет, какая единица (единицы) измерения должна быть доступна в задании, и может быть установлена в начале приложения.",
        "FRENCH": "Cela définit la ou les unités qui doivent être disponibles dans la tâche et peut être défini au début de l'application.",
        "SPANISH": "Define qué unidad(es) debe(n) estar disponible(s) en la tarea y puede(n) establecerse al principio de la aplicación.",
        "ITALIAN": "Questo definisce quale unità deve essere disponibile nel compito e può essere impostato all'inizio dell'applicazione.",
        "CHINESE": "这定义了任务中应使用的单元，可在应用程序开始时设置。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "WEIGHING_UNITS_INSTRUCTION_2": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The units [Milligr.] and [Grams] or [Grams] and [Kilogr.] are set by default.",
        "GERMAN": "Voreingestellt sind die Einheiten [Milligramm] und [Gramm] bzw. [Gramm] und [Kilogramm].",
        "RUSSIAN": "По умолчанию установлены единицы измерения [Миллиграмм] и [Грамм] или [Грамм] и [Килограмм].",
        "FRENCH": "Les unités [Milligr.] et [Grams] ou [Grams] et [Kilogr.] sont définies par défaut.",
        "SPANISH": "Las unidades [Milligr.] y [Grams] o [Grams] y [Kilogr.] están establecidas por defecto.",
        "ITALIAN": "Le unità [Milligr.] e [Grams] o [Grams] e [Kilogr.] sono impostate di default.",
        "CHINESE": "默认设置单位为 [Milligr.] 和 [Grams] 或 [Grams] 和 [Kilogr.]。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "По умолчанию установлены единицы измерения [Миллиграмм] и [Грамм] или [Грамм] и [Килограмм].",
        "FRENCH": "Les unités [Milligr.] et [Grams] ou [Grams] et [Kilogr.] sont définies par défaut.",
        "SPANISH": "Las unidades [Milligr.] y [Grams] o [Grams] y [Kilogr.] están establecidas por defecto.",
        "ITALIAN": "Le unità [Milligr.] e [Grams] o [Grams] e [Kilogr.] sono impostate di default.",
        "CHINESE": "默认设置单位为 [Milligr.] 和 [Grams] 或 [Grams] 和 [Kilogr.]。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "WEIGHING_UNITS_INSTRUCTION_3": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Starting from the base unit [Grams], the conversion into the other unit is carried out via the factor; a decimal point shift and a scale interval ensure that the resolution in this unit is not greater than that in the base unit.",
        "GERMAN": "Von der Basiseinheit [Gramm] aus erfolgt über den Faktor die Umrechnung in die andere Einheit, dabei sorgen eine Dezimalpunktverschiebung und ein Teilungswert dafür, dass die Auflösung in dieser Einheit nicht größer ist als in der Basiseinheit.",
        "RUSSIAN": "Начиная с базовой единицы [Грамм], пересчет в другую единицу осуществляется через коэффициент; сдвиг десятичной точки и интервал масштаба гарантируют, что разрешение в этой единице не будет больше, чем в базовой.",
        "FRENCH": "En partant de l'unité de base [Grammes], la conversion dans l'autre unité s'effectue via le facteur ; un décalage de la virgule et un intervalle d'échelle garantissent que la résolution dans cette unité n'est pas supérieure à celle de l'unité de base.",
        "SPANISH": "Partiendo de la unidad base [Gramos], la conversión a la otra unidad se realiza a través del factor; un desplazamiento del punto decimal y un intervalo de escala garantizan que la resolución en esta unidad no sea mayor que la de la unidad base.",
        "ITALIAN": "Partendo dall'unità di base [Grammi], la conversione nell'altra unità viene effettuata tramite il fattore; uno spostamento del punto decimale e un intervallo di scala assicurano che la risoluzione in questa unità non sia maggiore di quella dell'unità di base.",
        "CHINESE": "从基本单位 [克] 开始，通过系数转换成其他单位；小数点移位和比例间隔确保该单位的分辨率不大于基本单位的分辨率。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Начиная с базовой единицы [Грамм], пересчет в другую единицу осуществляется через коэффициент; сдвиг десятичной точки и интервал масштаба гарантируют, что разрешение в этой единице не будет больше, чем в базовой.",
        "FRENCH": "En partant de l'unité de base [Grammes], la conversion dans l'autre unité s'effectue via le facteur ; un décalage de la virgule et un intervalle d'échelle garantissent que la résolution dans cette unité n'est pas supérieure à celle de l'unité de base.",
        "SPANISH": "Partiendo de la unidad base [Gramos], la conversión a la otra unidad se realiza a través del factor; un desplazamiento del punto decimal y un intervalo de escala garantizan que la resolución en esta unidad no sea mayor que la de la unidad base.",
        "ITALIAN": "Partendo dall'unità di base [Grammi], la conversione nell'altra unità viene effettuata tramite il fattore; uno spostamento del punto decimale e un intervallo di scala assicurano che la risoluzione in questa unità non sia maggiore di quella dell'unità di base.",
        "CHINESE": "从基本单位 [克] 开始，通过系数转换成其他单位；小数点移位和比例间隔确保该单位的分辨率不大于基本单位的分辨率。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
