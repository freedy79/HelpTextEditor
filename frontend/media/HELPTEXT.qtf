      }
    },
    "LOGIN_LOGOUT_RULES_INSTRUCTION_1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "An automatic logout of the logged-in user can be set after a specific period of non-use of the balance.",
        "GERMAN": "Es kann eine automatische Abmeldung (Logout) des angemeldeten Benutzers nach einer bestimmten Zeit der Nicht-Benutzung der Waage eingestellt werden.",
        "RUSSIAN": "Можно установить автоматический выход пользователя из системы после определенного периода неиспользования весов.",
        "FRENCH": "Une déconnexion automatique de l'utilisateur connecté peut être définie après une période spécifique de non-utilisation de la balance.",
        "SPANISH": "Se puede establecer un cierre de sesión automático del usuario conectado después de un período específico de no utilización de la balanza.",
        "ITALIAN": "Un logout automatico dell'utente loggato può essere impostato dopo un periodo specifico di non utilizzo della bilancia.",
        "CHINESE": "可以设置登录用户在特定时间内未使用余额后自动注销。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Можно установить автоматический выход пользователя из системы после определенного периода неиспользования весов.",
        "FRENCH": "Une déconnexion automatique de l'utilisateur connecté peut être définie après une période spécifique de non-utilisation de la balance.",
        "SPANISH": "Se puede establecer un cierre de sesión automático del usuario conectado después de un período específico de no utilización de la balanza.",
        "ITALIAN": "Un logout automatico dell'utente loggato può essere impostato dopo un periodo specifico di non utilizzo della bilancia.",
        "CHINESE": "可以设置登录用户在特定时间内未使用余额后自动注销。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "LOGIN_LOGOUT_RULES_INSTRUCTION_2": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "For login with password, a maximum number of failed attempts can be entered. The behavior after this number of failed attempts is either [no action], [login delay for re-login] or [deactivation of user account] can be set on the scale.",
        "GERMAN": "Für die Anmeldung (Login) mit Passwort kann eine maximale Anzahl der Fehlversuche eingegeben werden. Das Verhalten nach dieser Anzahl von Fehlversuchen ist entweder [keine Aktion], [Anmeldeverzögerung für die erneute Anmeldung] oder [Deaktivierung des Nutzerkontos] auf der Waage einstellbar.",
        "RUSSIAN": "Для входа в систему с паролем можно ввести максимальное количество неудачных попыток. Поведение после этого количества неудачных попыток - [бездействие], [задержка для повторного входа] или [деактивация учетной записи пользователя] может быть установлено на шкале.",
        "FRENCH": "Pour la connexion avec mot de passe, un nombre maximum de tentatives infructueuses peut être saisi. Le comportement après ce nombre d'échecs est soit [pas d'action], soit [délai de reconnexion], soit [désactivation du compte de l'utilisateur] peut être défini sur l'échelle.",
        "SPANISH": "Para el inicio de sesión con contraseña, se puede introducir un número máximo de intentos fallidos. El comportamiento después de este número de intentos fallidos es [ninguna acción], [retardo de inicio de sesión para volver a iniciar sesión] o [desactivación de la cuenta de usuario] se puede establecer en la escala.",
        "ITALIAN": "Per il login con password, può essere inserito un numero massimo di tentativi falliti. Il comportamento dopo questo numero di tentativi falliti è [nessuna azione], [ritardo di login per il re-login] o [disattivazione dell'account utente] può essere impostato sulla scala.",
        "CHINESE": "使用密码登录时，可输入最大尝试失败次数。尝试失败次数达到一定程度后的行为是[无操作]、[重新登录延迟]或[停用用户账户]。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Для входа в систему с паролем можно ввести максимальное количество неудачных попыток. Поведение после этого количества неудачных попыток - [бездействие], [задержка для повторного входа] или [деактивация учетной записи пользователя] может быть установлено на шкале.",
        "FRENCH": "Pour la connexion avec mot de passe, un nombre maximum de tentatives infructueuses peut être saisi. Le comportement après ce nombre d'échecs est soit [pas d'action], soit [délai de reconnexion], soit [désactivation du compte de l'utilisateur] peut être défini sur l'échelle.",
        "SPANISH": "Para el inicio de sesión con contraseña, se puede introducir un número máximo de intentos fallidos. El comportamiento después de este número de intentos fallidos es [ninguna acción], [retardo de inicio de sesión para volver a iniciar sesión] o [desactivación de la cuenta de usuario] se puede establecer en la escala.",
        "ITALIAN": "Per il login con password, può essere inserito un numero massimo di tentativi falliti. Il comportamento dopo questo numero di tentativi falliti è [nessuna azione], [ritardo di login per il re-login] o [disattivazione dell'account utente] può essere impostato sulla scala.",
        "CHINESE": "使用密码登录时，可输入最大尝试失败次数。尝试失败次数达到一定程度后的行为是[无操作]、[重新登录延迟]或[停用用户账户]。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "LOGIN_LOGOUT_RULES_INSTRUCTION_3": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "A deactivated user account must first be released again by a user with the user management right.",
        "GERMAN": "Ein deaktiviertes Benutzerkonto muss erst von einem Benutzer mit dem Recht der Benutzerverwaltung wieder freigegeben werden.",
        "RUSSIAN": "Деактивированная учетная запись пользователя должна быть сначала снова освобождена пользователем с правом управления пользователями.",
        "FRENCH": "Un compte utilisateur désactivé doit d'abord être libéré à nouveau par un utilisateur ayant le droit de gestion des utilisateurs.",
        "SPANISH": "Una cuenta de usuario desactivada debe ser liberada de nuevo por un usuario con derecho de gestión de usuarios.",
        "ITALIAN": "Un account utente disattivato deve prima essere rilasciato nuovamente da un utente con il diritto di gestione degli utenti.",
        "CHINESE": "停用的用户账户必须首先由具有用户管理权的用户重新释放。"
      },
      "AUTOTRANSLATIONS": {
        "GERMAN": "Ein deaktiviertes Benutzerkonto muss erst von einem Benutzer mit dem Recht der Benutzerverwaltung wieder freigegeben werden.",
        "RUSSIAN": "Деактивированная учетная запись пользователя должна быть сначала снова освобождена пользователем с правом управления пользователями.",
        "FRENCH": "Un compte utilisateur désactivé doit d'abord être libéré à nouveau par un utilisateur ayant le droit de gestion des utilisateurs.",
        "SPANISH": "Una cuenta de usuario desactivada debe ser liberada de nuevo por un usuario con derecho de gestión de usuarios.",
        "ITALIAN": "Un account utente disattivato deve prima essere rilasciato nuovamente da un utente con il diritto di gestione degli utenti.",
        "CHINESE": "停用的用户账户必须首先由具有用户管理权的用户重新释放。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "LOCAL_PASSWORD_RULES_TITLE": {
      "group": "HELP_TITLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Local password rules",
        "GERMAN": "Lokale Passwortregeln",
        "RUSSIAN": "Локальные правила паролей",
        "FRENCH": "Règles de mot de passe local",
        "SPANISH": "Reglas locales de contraseña",
        "ITALIAN": "Regole locali per le password",
        "CHINESE": "本地密码规则"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Локальные правила паролей",
        "FRENCH": "Règles de mot de passe local",
        "SPANISH": "Reglas locales de contraseña",
        "ITALIAN": "Regole locali per le password",
        "CHINESE": "本地密码规则"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "LOCAL_PASSWORD_RULES_INSTRUCTION_1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Rules can be specified for the local password of the user on this balance. In this way, the necessary use of characters (upper/lower case letters, numbers, special characters) in the password and the minimum length of the password can be defined. Moreover, the validity period of the password as well as the reuse of the password can also be configured.",
        "GERMAN": "Für das lokale Passwort des Benutzers auf dieser Waage können Regeln vorgegeben werden. So kann die erforderliche Verwendung von Zeichen (Groß-/Kleinbuchstaben, Zahlen, Sonderzeichen) im Passwort und die minimale Länge vom Passwort festgelegt werden. Außerdem kann die Gültigkeitsdauer für das Passwort sowie die Wiederverwendung von Passwörtern eingestellt werden.",
        "RUSSIAN": "Можно задать правила для локального пароля пользователя на данных весах. Таким образом, можно определить необходимое использование символов (прописные/строчные буквы, цифры, специальные символы) в пароле и минимальную длину пароля. Кроме того, можно настроить срок действия пароля, а также его повторное использование.",
        "FRENCH": "Des règles peuvent être spécifiées pour le mot de passe local de l'utilisateur sur cette balance. Ainsi, l'utilisation nécessaire de caractères (lettres majuscules/minuscules, chiffres, caractères spéciaux) dans le mot de passe et la longueur minimale du mot de passe peuvent être définies. En outre, la période de validité du mot de passe ainsi que la réutilisation du mot de passe peuvent également être configurées.",
        "SPANISH": "Se pueden especificar reglas para la contraseña local del usuario en esta balanza. De este modo, se puede definir el uso necesario de caracteres (letras mayúsculas/minúsculas, números, caracteres especiales) en la contraseña y la longitud mínima de la misma. Además, también se puede configurar el periodo de validez de la contraseña, así como la reutilización de la misma.",
        "ITALIAN": "Si possono specificare delle regole per la password locale dell'utente su questa bilancia. In questo modo, l'uso necessario di caratteri (lettere maiuscole/minuscole, numeri, caratteri speciali) nella password e la lunghezza minima della password possono essere definiti. Inoltre, il periodo di validità della password così come il riutilizzo della password possono essere configurati.",
        "CHINESE": "可以为本天平上用户的本地密码指定规则。通过这种方式，可以定义密码中必须使用的字符（大写/小写字母、数字、特殊字符）以及密码的最小长度。此外，还可以配置密码的有效期和密码的重复使用。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Можно задать правила для локального пароля пользователя на данных весах. Таким образом, можно определить необходимое использование символов (прописные/строчные буквы, цифры, специальные символы) в пароле и минимальную длину пароля. Кроме того, можно настроить срок действия пароля, а также его повторное использование.",
        "FRENCH": "Des règles peuvent être spécifiées pour le mot de passe local de l'utilisateur sur cette balance. Ainsi, l'utilisation nécessaire de caractères (lettres majuscules/minuscules, chiffres, caractères spéciaux) dans le mot de passe et la longueur minimale du mot de passe peuvent être définies. En outre, la période de validité du mot de passe ainsi que la réutilisation du mot de passe peuvent également être configurées.",
        "SPANISH": "Se pueden especificar reglas para la contraseña local del usuario en esta balanza. De este modo, se puede definir el uso necesario de caracteres (letras mayúsculas/minúsculas, números, caracteres especiales) en la contraseña y la longitud mínima de la misma. Además, también se puede configurar el periodo de validez de la contraseña, así como la reutilización de la misma.",
        "ITALIAN": "Si possono specificare delle regole per la password locale dell'utente su questa bilancia. In questo modo, l'uso necessario di caratteri (lettere maiuscole/minuscole, numeri, caratteri speciali) nella password e la lunghezza minima della password possono essere definiti. Inoltre, il periodo di validità della password così come il riutilizzo della password possono essere configurati.",
        "CHINESE": "可以为本天平上用户的本地密码指定规则。通过这种方式，可以定义密码中必须使用的字符（大写/小写字母、数字、特殊字符）以及密码的最小长度。此外，还可以配置密码的有效期和密码的重复使用。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "LOCAL_PASSWORD_RULES_INSTRUCTION_2": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "Do not translate HTML link commands, e.g. <a href=\"#EXAMPLE_SET_LOCAL_PASSW_RULES\"> and </a>.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "See also chapter: <a href=\"#EXAMPLE_SET_LOCAL_PASSW_RULES\">Example for setting local password rules</a>.",
        "GERMAN": "Siehe dazu auch Kapitel: <a href=\"#EXAMPLE_SET_LOCAL_PASSW_RULES\">Beispiel für lokale Passwortregeln einstellen</a>.",
        "RUSSIAN": "См. также главу: <a href=\"#EXAMPLE_SET_LOCAL_PASSW_RULES\">Пример установки правил локального пароля</a>.",
        "FRENCH": "Voir également le chapitre : <a href=\"#EXAMPLE_SET_LOCAL_PASSW_RULES\">Exemple de définition des règles de mot de passe local</a>.",
        "SPANISH": "Ver también el capítulo: <a href=\"#EXAMPLE_SET_LOCAL_PASSW_RULES\">Ejemplo de configuración de reglas locales de contraseña</a>.",
        "ITALIAN": "Vedi anche il capitolo: <a href=\"#EXAMPLE_SET_LOCAL_PASSW_RULES\">Esempio per impostare le regole locali per le password</a>.",
        "CHINESE": "另请参阅本章：<a href=\"#EXAMPLE_SET_LOCAL_PASSW_RULES\">设置本地密码规则的示例</a>。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "См. также главу: <a href=\"#EXAMPLE_SET_LOCAL_PASSW_RULES\">Пример установки правил локального пароля</a>.",
        "FRENCH": "Voir également le chapitre : <a href=\"#EXAMPLE_SET_LOCAL_PASSW_RULES\">Exemple de définition des règles de mot de passe local</a>.",
        "SPANISH": "Ver también el capítulo: <a href=\"#EXAMPLE_SET_LOCAL_PASSW_RULES\">Ejemplo de configuración de reglas locales de contraseña</a>.",
        "ITALIAN": "Vedi anche il capitolo: <a href=\"#EXAMPLE_SET_LOCAL_PASSW_RULES\">Esempio per impostare le regole locali per le password</a>.",
        "CHINESE": "另请参阅本章：<a href=\"#EXAMPLE_SET_LOCAL_PASSW_RULES\">设置本地密码规则的示例</a>。"
      },
      "VERIFIED": {
