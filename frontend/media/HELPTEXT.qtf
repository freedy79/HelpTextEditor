    "ROLE_RIGHT_ACCESS_RESET_TO_FACTORY": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "<b>Access reset to factory settings:</b> Allows to reset device to factory defaults",
        "GERMAN": "<b>Zurücksetzen auf Werkseinstellungen:</b> Ermöglicht das Zurücksetzen des Geräts auf die Werkseinstellungen",
        "FRENCH": "<b>Réinitialisation des paramètres d'usine :</b> Permet de réinitialiser l'appareil aux paramètres d'usine.",
        "ITALIAN": "<b>Ripristino delle impostazioni di fabbrica:</b> Consente di ripristinare il dispositivo alle impostazioni di fabbrica.",
        "RUSSIAN": "<b>Сброс к заводским настройкам:</b> Позволяет вернуть устройство к заводским настройкам по умолчанию",
        "SPANISH": "<b>Acceso a restablecer valores de fábrica:</b> Permite restablecer el dispositivo a los valores predeterminados de fábrica.",
        "CHINESE": "<b>访问重置为出厂设置：</b>允许将设备重置为出厂默认设置"
      },
      "AUTOTRANSLATIONS": {
