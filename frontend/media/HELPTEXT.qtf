      "TRANSLATIONS": {
        "ENGLISH": "Select the connector  through which the previously provided file is reached.",
        "GERMAN": "Wählen Sie den Konnektor, über den Sie die zuvor bereitgestellte Datei erreichen.",
        "RUSSIAN": "Выберите коннектор, через который осуществляется доступ к ранее предоставленному файлу.",
        "FRENCH": "Sélectionnez le connecteur par lequel le fichier fourni précédemment est atteint.",
        "SPANISH": "Seleccione el conector a través del cual se llega al archivo previamente proporcionado.",
        "ITALIAN": "Seleziona il connettore attraverso il quale si raggiunge il file fornito in precedenza.",
        "CHINESE": "选择可以访问先前提供的文件的连接器。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Выберите коннектор, через который осуществляется доступ к ранее предоставленному файлу.",
        "FRENCH": "Sélectionnez le connecteur par lequel le fichier fourni précédemment est atteint.",
        "SPANISH": "Seleccione el conector a través del cual se llega al archivo previamente proporcionado.",
        "ITALIAN": "Seleziona il connettore attraverso il quale si raggiunge il file fornito in precedenza.",
        "CHINESE": "选择可以访问先前提供的文件的连接器。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
