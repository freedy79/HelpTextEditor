      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Activate the settings for date and time using the [Edit] button.",
        "GERMAN": "Aktivieren Sie mit der Schaltfläche [Bearbeiten] die Einstellungen für Datum und Zeit.",
        "RUSSIAN": "Активируйте настройки даты и времени с помощью кнопки [Edit].",
        "FRENCH": "Activez les paramètres de date et d'heure à l'aide du bouton [Modifier].",
        "SPANISH": "Active la configuración de la fecha y la hora con el botón [Editar].",
        "ITALIAN": "Attivare le impostazioni di data e ora con il pulsante [Modifica].",
        "CHINESE": "使用 [Edit] 按钮激活日期和时间设置。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Активируйте настройки даты и времени с помощью кнопки [Edit].",
        "FRENCH": "Activez les paramètres de date et d'heure à l'aide du bouton [Modifier].",
        "SPANISH": "Active la configuración de la fecha y la hora con el botón [Editar].",
        "ITALIAN": "Attivare le impostazioni di data e ora con il pulsante [Modifica].",
        "CHINESE": "使用 [Edit] 按钮激活日期和时间设置。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "SYNC_DATE_TIME_WITH_NTP_CONF_STEP_2_D": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Set your location using the [Time zone] menu item, [UTC +/- time, place]. Thereafter, the time and date are displayed immediately matching with your local time.",
        "GERMAN": "Stellen Sie über den Punkt [Zeitzone] ihren Standort ein, [UTC +/- Zeit, Ort]. Die Anzeige von Datum und Uhrzeit erfolgt anschließend sofort passend in Ihrer lokalen Zeit.",
        "RUSSIAN": "Установите свое местоположение с помощью пункта меню [Часовой пояс], [UTC +/- время, место]. После этого время и дата будут отображаться в соответствии с местным временем.",
        "FRENCH": "Réglez votre emplacement en utilisant l'élément de menu [Fuseau horaire], [UTC +/- heure, lieu]. Ensuite, l'heure et la date s'affichent en fonction de votre heure locale.",
        "SPANISH": "Establezca su ubicación mediante la opción de menú [Zona horaria], [UTC +/- hora, lugar]. A partir de entonces, la hora y la fecha se muestran inmediatamente coincidiendo con su hora local.",
        "ITALIAN": "Impostare la propria posizione utilizzando la voce di menu [Time zone], [UTC +/- time, place]. In seguito, l'ora e la data vengono visualizzate immediatamente corrispondenti alla vostra ora locale.",
        "CHINESE": "使用[时区]菜单项[UTC +/- 时间、地点]设置您的位置。之后，时间和日期将立即显示为与您当地时间一致的时间。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Установите свое местоположение с помощью пункта меню [Часовой пояс], [UTC +/- время, место]. После этого время и дата будут отображаться в соответствии с местным временем.",
        "FRENCH": "Réglez votre emplacement en utilisant l'élément de menu [Fuseau horaire], [UTC +/- heure, lieu]. Ensuite, l'heure et la date s'affichent en fonction de votre heure locale.",
        "SPANISH": "Establezca su ubicación mediante la opción de menú [Zona horaria], [UTC +/- hora, lugar]. A partir de entonces, la hora y la fecha se muestran inmediatamente coincidiendo con su hora local.",
        "ITALIAN": "Impostare la propria posizione utilizzando la voce di menu [Time zone], [UTC +/- time, place]. In seguito, l'ora e la data vengono visualizzate immediatamente corrispondenti alla vostra ora locale.",
        "CHINESE": "使用[时区]菜单项[UTC +/- 时间、地点]设置您的位置。之后，时间和日期将立即显示为与您当地时间一致的时间。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "SYNC_DATE_TIME_WITH_NTP_CONF_NOTE": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Note: After setting the date, time and time zone, the MCA balance asks you to restart the system.",
        "GERMAN": "Anmerkung: Nach dem Stellen von Datum, Zeit und Zeitzone fordert die MCA Waage zum Neustart des Systems auf.",
        "RUSSIAN": "Примечание: После установки даты, времени и часового пояса весы MCA попросят вас перезагрузить систему.",
        "FRENCH": "Remarque : après avoir réglé la date, l'heure et le fuseau horaire, le MCA balance vous demande de redémarrer le système.",
        "SPANISH": "Nota: Después de ajustar la fecha, la hora y la zona horaria, la balanza MCA le pide que reinicie el sistema.",
        "ITALIAN": "Nota: Dopo aver impostato la data, l'ora e il fuso orario, la bilancia MCA chiede di riavviare il sistema.",
        "CHINESE": "注意： 设置日期、时间和时区后，MCA 天平会要求您重新启动系统。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Примечание: После установки даты, времени и часового пояса весы MCA попросят вас перезагрузить систему.",
        "FRENCH": "Remarque : après avoir réglé la date, l'heure et le fuseau horaire, le MCA balance vous demande de redémarrer le système.",
        "SPANISH": "Nota: Después de ajustar la fecha, la hora y la zona horaria, la balanza MCA le pide que reinicie el sistema.",
        "ITALIAN": "Nota: Dopo aver impostato la data, l'ora e il fuso orario, la bilancia MCA chiede di riavviare il sistema.",
        "CHINESE": "注意： 设置日期、时间和时区后，MCA 天平会要求您重新启动系统。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
