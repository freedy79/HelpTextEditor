    "LOGIN_LOGOUT_RULES_TITLE": {
      "group": "HELP_TITLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
