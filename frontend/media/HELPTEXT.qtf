    "NETWORK_PASSWORD_LDAP_TITLE": {
      "group": "HELP_TITLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Network password (via LDAP)",
        "GERMAN": "Netzwerk-Passwort (per LDAP)",
        "RUSSIAN": "Сетевой пароль (через LDAP)",
        "FRENCH": "Mot de passe réseau (via LDAP)",
        "SPANISH": "Contraseña de red (vía LDAP)",
        "ITALIAN": "Password di rete (via LDAP)",
        "CHINESE": "网络密码（通过 LDAP）"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Сетевой пароль (через LDAP)",
        "FRENCH": "Mot de passe réseau (via LDAP)",
        "SPANISH": "Contraseña de red (vía LDAP)",
        "ITALIAN": "Password di rete (via LDAP)",
        "CHINESE": "网络密码（通过 LDAP）"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
