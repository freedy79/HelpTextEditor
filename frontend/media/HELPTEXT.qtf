      "TRANSLATIONS": {
        "ENGLISH": "Set the [Connector] item to [My FTPS server].",
        "GERMAN": "Stellen Sie den Punkt [Konnektor] auf [Mein FTPS-Server] ein.",
        "FRENCH": "Réglez l'élément [Connecteur] sur [Mon serveur FTPS].",
        "RUSSIAN": "Установите для элемента [Connector] значение [My FTPS server].",
        "SPANISH": "Establezca el elemento [Conector] en [Mi servidor FTPS].",
        "ITALIAN": "Impostare la voce [Connector] su [My FTPS server].",
        "CHINESE": "将 [Connector] 项设置为 [My FTPS server]（我的 FTPS 服务器）。",
        "JAPANESE": "Connector]項目を[My FTPS server]に設定します。",
