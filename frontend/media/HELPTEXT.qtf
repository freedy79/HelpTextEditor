    "DEVICE_CONCEPT_ELEMENTS_TASKMGNT_FUNCTIONS_DESC": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "GERMAN": "-Ermöglicht das Navigieren und Suchen in Menüs und Listen<br>-Ermöglicht das Hinzufügen von Tasks<br>-Öffnet das QAPP-Center<br>-Zeigt den Namen des Menüs",
        "ENGLISH": "-Enables you to navigate and search in menus and lists<br>-Enables you to add tasks<br>-Opens the QAPP Center<br>-Shows the name of the menu",
        "FRENCH": "-Permet de naviguer et de rechercher dans les menus et les listes<br>-Permet d'ajouter des tâches<br>-Ouvre le centre QAPP<br>-Indique le nom du menu",
        "CHINESE": "-使您能够在菜单和列表中导航和搜索<br>-使您能够添加任务<br>-打开 QAPP 中心<br>-显示菜单名称",
        "SPANISH": "-Permite navegar y buscar en menús y listas<br>-Permite añadir tareas<br>-Abre el Centro QAPP<br>-Muestra el nombre del menú",
        "RUSSIAN": "-Позволяет осуществлять навигацию и поиск в меню и списках<br>-Позволяет добавлять задачи<br>-Открывает QAPP-центр<br>-Показывает название меню",
        "ITALIAN": "-Permette di navigare e cercare nei menu e negli elenchi<br>Permette di aggiungere attività<br>Apre il QAPP Center<br>Mostra il nome del menu"
      },
      "AUTOTRANSLATIONS": {
        "ENGLISH": "-Enables you to navigate and search in menus and lists<br>-Enables you to add tasks<br>-Opens the QAPP Center<br>-Shows the name of the menu",
        "FRENCH": "-Permet de naviguer et de rechercher dans les menus et les listes<br>-Permet d'ajouter des tâches<br>-Ouvre le centre QAPP<br>-Indique le nom du menu",
        "CHINESE": "-使您能够在菜单和列表中导航和搜索<br>-使您能够添加任务<br>-打开 QAPP 中心<br>-显示菜单名称",
        "SPANISH": "-Permite navegar y buscar en menús y listas<br>-Permite añadir tareas<br>-Abre el Centro QAPP<br>-Muestra el nombre del menú",
        "RUSSIAN": "-Позволяет осуществлять навигацию и поиск в меню и списках<br>-Позволяет добавлять задачи<br>-Открывает QAPP-центр<br>-Показывает название меню",
        "ITALIAN": "-Permette di navigare e cercare nei menu e negli elenchi<br>Permette di aggiungere attività<br>Apre il QAPP Center<br>Mostra il nome del menu"
      },
      "VERIFIED": {
        "GERMAN": false,
        "ENGLISH": false,
        "FRENCH": false,
        "CHINESE": false,
        "SPANISH": false,
        "RUSSIAN": false,
        "ITALIAN": false
      }
    },
    "ROLE_RIGHT_ACCESS_MANAGEMENT": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "<b>Access management:</b> Access to the “Access management” settings menu (prerequisite for role and user management, LDAP settings and password rules)",
        "GERMAN": "<b>Zugriffsverwaltung:</b> Zugriff auf das Einstellungsmenü \"Zugriffsverwaltung\" (Voraussetzung für Rollen- und Benutzerverwaltung, LDAP-Einstellungen und Passwortregeln)",
        "RUSSIAN": "<b>Управление доступом:</b> Доступ к меню настроек «Управление доступом»",
        "FRENCH": "<b>Gestion des accès:</b> Accès au menu de configuration \"Gestion des accès\" (condition préalable pour la gestion des rôles et des utilisateurs, les paramètres LDAP et les règles de mot de passe)",
        "CHINESE": "<b>访问管理：</b>访问 \"访问管理 \"设置菜单（角色和用户管理、LDAP 设置和密码规则的前提条件）",
        "SPANISH": "<b>Gestión de acceso:</b> Acceso al menú de configuración \"Gestión de acceso\" (requisito previo para la gestión de roles y usuarios, configuración LDAP y reglas de contraseña).",
        "ITALIAN": "<b>Gestione degli accessi:</b> Accesso al menu delle impostazioni \"Gestione degli accessi\" (prerequisito per la gestione dei ruoli e degli utenti, le impostazioni LDAP e le regole per le password)."
      },
      "AUTOTRANSLATIONS": {
        "GERMAN": "<b>Zugangsverwaltung</b>",
        "FRENCH": "<b>Gestion des accès:</b> Accès au menu de configuration \"Gestion des accès\" (condition préalable pour la gestion des rôles et des utilisateurs, les paramètres LDAP et les règles de mot de passe)",
        "CHINESE": "<b>访问管理：</b>访问 \"访问管理 \"设置菜单（角色和用户管理、LDAP 设置和密码规则的前提条件）",
        "SPANISH": "<b>Gestión de acceso:</b> Acceso al menú de configuración \"Gestión de acceso\" (requisito previo para la gestión de roles y usuarios, configuración LDAP y reglas de contraseña).",
        "ITALIAN": "<b>Gestione degli accessi:</b> Accesso al menu delle impostazioni \"Gestione degli accessi\" (prerequisito per la gestione dei ruoli e degli utenti, le impostazioni LDAP e le regole per le password)."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "CHINESE": false,
        "SPANISH": false,
        "ITALIAN": false
      }
    },
    "ROLE_RIGHT_LDAPSERVER_SETTINGS": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "<b>LDAP/S settings:</b> Access to the LDAP or LDAPS settings such as server configuration, assigned user roles and groups and the creation of new users",
        "GERMAN": "<b>LDAP/S-Einstellungen:</b> Zugriff auf die LDAP- bzw. LDAPS-Einstellungen wie Server-Konfiguration, zugewiesene Benutzerrollen und -gruppen sowie das Anlegen neuer Nutzer",
        "FRENCH": "<b>Paramètres LDAP/S:</b> Accès aux paramètres LDAP ou LDAPS tels que la configuration du serveur, les rôles et groupes d'utilisateurs attribués et la création de nouveaux utilisateurs",
        "CHINESE": "<b>LDAP/S 设置：</b> 访问 LDAP 或 LDAPS 设置，如服务器配置、分配的用户角色和组以及创建新用户。",
        "SPANISH": "<b>Configuración LDAP/S:</b> Acceso a la configuración LDAP o LDAPS, como la configuración del servidor, los roles y grupos de usuarios asignados y la creación de nuevos usuarios.",
        "RUSSIAN": "<b>Настройки LDAP/S:</b> Доступ к настройкам LDAP или LDAPS, таким как конфигурация сервера, назначенные роли и группы пользователей и создание новых пользователей.",
        "ITALIAN": "<b>ImpostazioniLDAP/S:</b> Accesso alle impostazioni LDAP o LDAPS, come la configurazione del server, i ruoli e i gruppi assegnati agli utenti e la creazione di nuovi utenti."
      },
      "AUTOTRANSLATIONS": {
        "GERMAN": "<b>LDAP/S-Einstellungen</b>",
        "FRENCH": "<b>Paramètres LDAP/S:</b> Accès aux paramètres LDAP ou LDAPS tels que la configuration du serveur, les rôles et groupes d'utilisateurs attribués et la création de nouveaux utilisateurs",
        "CHINESE": "<b>LDAP/S 设置：</b> 访问 LDAP 或 LDAPS 设置，如服务器配置、分配的用户角色和组以及创建新用户。",
        "SPANISH": "<b>Configuración LDAP/S:</b> Acceso a la configuración LDAP o LDAPS, como la configuración del servidor, los roles y grupos de usuarios asignados y la creación de nuevos usuarios.",
        "RUSSIAN": "<b>Настройки LDAP/S:</b> Доступ к настройкам LDAP или LDAPS, таким как конфигурация сервера, назначенные роли и группы пользователей и создание новых пользователей.",
        "ITALIAN": "<b>ImpostazioniLDAP/S:</b> Accesso alle impostazioni LDAP o LDAPS, come la configurazione del server, i ruoli e i gruppi assegnati agli utenti e la creazione di nuovi utenti."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
        "CHINESE": false,
        "SPANISH": false,
        "RUSSIAN": false,
        "ITALIAN": false
      }
    },
    "ROLE_RIGHT_TIMERCONTROLLED_ACTIONS": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "<b>Management of time-controlled actions:</b> Access to the administration for creating, changing or deleting time-controlled actions, such as automatic device backup, export of device data, etc.",
        "GERMAN": "<b>Verwaltung zeitgesteuerter Aktionen:</b> Zugriff auf die Verwaltung zum Erstellen, Ändern oder Löschen von zeitgesteuerten Aktionen, wie z. B. automatische Gerätesicherung, Export von Gerätedaten usw.",
        "FRENCH": "<b>Gestion des actions programmées :</b> Accès à la gestion pour créer, modifier ou supprimer des actions programmées, telles que la sauvegarde automatique des appareils, l'exportation des données des appareils, etc.",
        "CHINESE": "<b>时间控制操作的管理：</b>访问管理界面，创建、更改或删除时间控制操作，如自动设备备份、导出设备数据等。",
        "SPANISH": "<b>Gestión de acciones controladas por tiempo:</b> Acceso a la administración para crear, modificar o eliminar acciones controladas por tiempo, como la copia de seguridad automática del dispositivo, la exportación de datos del dispositivo, etc.",
        "RUSSIAN": "<b>Управление действиями, контролируемыми временем:</b> Доступ к администрированию для создания, изменения или удаления действий, контролируемых временем, таких как автоматическое резервное копирование устройства, экспорт данных устройства и т. д.",
        "ITALIAN": "<b>Gestione delle azioni temporizzate:</b> Accesso all'amministrazione per la creazione, la modifica o l'eliminazione di azioni temporizzate, come il backup automatico del dispositivo, l'esportazione dei dati del dispositivo, ecc."
      },
      "AUTOTRANSLATIONS": {
        "GERMAN": "<b>Verwaltung zeitgesteuerter Aktionen</b>",
        "FRENCH": "<b>Gestion des actions programmées :</b> Accès à la gestion pour créer, modifier ou supprimer des actions programmées, telles que la sauvegarde automatique des appareils, l'exportation des données des appareils, etc.",
        "CHINESE": "<b>时间控制操作的管理：</b>访问管理界面，创建、更改或删除时间控制操作，如自动设备备份、导出设备数据等。",
        "SPANISH": "<b>Gestión de acciones controladas por tiempo:</b> Acceso a la administración para crear, modificar o eliminar acciones controladas por tiempo, como la copia de seguridad automática del dispositivo, la exportación de datos del dispositivo, etc.",
        "RUSSIAN": "<b>Управление действиями, контролируемыми временем:</b> Доступ к администрированию для создания, изменения или удаления действий, контролируемых временем, таких как автоматическое резервное копирование устройства, экспорт данных устройства и т. д.",
        "ITALIAN": "<b>Gestione delle azioni temporizzate:</b> Accesso all'amministrazione per la creazione, la modifica o l'eliminazione di azioni temporizzate, come il backup automatico del dispositivo, l'esportazione dei dati del dispositivo, ecc."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
        "CHINESE": false,
        "SPANISH": false,
        "RUSSIAN": false,
        "ITALIAN": false
      }
    },
