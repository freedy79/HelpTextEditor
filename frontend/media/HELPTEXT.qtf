        "JAPANESE": "デモ：エディターの使い方",
        "RUSSIAN": "Демо: как пользоваться редактором",
        "CHINESE": "演示：如何使用编辑器",
        "PORTUGUESE": "Demonstração: como usar o editor",
        "KOREAN": "데모: 편집기 사용 방법"
      },
