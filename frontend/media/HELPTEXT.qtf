      "TRANSLATIONS": {
        "ENGLISH": "Enter the name of a sub-directory on the server, in which to save the files.",
        "GERMAN": "Für die Ablage der Dateien können Sie ein Unterverzeichnis auf dem Server angeben.",
        "RUSSIAN": "Введите имя подкаталога на сервере, в котором будут сохранены файлы.",
        "FRENCH": "Entrez le nom d'un sous-répertoire sur le serveur, dans lequel enregistrer les fichiers.",
        "SPANISH": "Introduzca el nombre de un subdirectorio en el servidor, en el que guardar los archivos.",
        "ITALIAN": "Inserisci il nome di una sotto-directory sul server, in cui salvare i file.",
        "CHINESE": "输入服务器上保存文件的子目录名称。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Введите имя подкаталога на сервере, в котором будут сохранены файлы.",
        "FRENCH": "Entrez le nom d'un sous-répertoire sur le serveur, dans lequel enregistrer les fichiers.",
        "SPANISH": "Introduzca el nombre de un subdirectorio en el servidor, en el que guardar los archivos.",
        "ITALIAN": "Inserisci il nome di una sotto-directory sul server, in cui salvare i file.",
        "CHINESE": "输入服务器上保存文件的子目录名称。"
      },
