      "TRANSLATIONS": {
        "ENGLISH": "Network connectors",
        "GERMAN": "Netzwerkkonnektoren",
        "RUSSIAN": "Сетевые разъемы",
        "FRENCH": "Connecteurs de réseau",
        "SPANISH": "Conectores de red",
