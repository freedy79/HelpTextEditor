    "TCA_BASIC_SETTINGS_TITLE": {
      "group": "HELP_TITLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Default settings for timer-controlled actions",
        "GERMAN": "Grundeinstellungen der zeitgesteuerten Aktionen",
        "RUSSIAN": "Настройки по умолчанию для действий, управляемых таймером",
        "FRENCH": "Paramètres par défaut pour les actions commandées par minuterie",
        "SPANISH": "Ajustes por defecto para las acciones controladas por el temporizador",
        "ITALIAN": "Impostazioni predefinite per le azioni controllate dal timer",
        "CHINESE": "计时器控制操作的默认设置"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Настройки по умолчанию для действий, управляемых таймером",
        "FRENCH": "Paramètres par défaut pour les actions commandées par minuterie",
        "SPANISH": "Ajustes por defecto para las acciones controladas por el temporizador",
        "ITALIAN": "Impostazioni predefinite per le azioni controllate dal timer",
        "CHINESE": "计时器控制操作的默认设置"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
