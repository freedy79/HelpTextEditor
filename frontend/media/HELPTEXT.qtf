    "TCA_EXAMPLE_EXPORT_DSD_ERROR_STEP_5_C": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Set the filter for all or only one specific day which you want to export.",
        "GERMAN": "Setzen Sie das Filter für alle oder nur auf einen bestimmten Tag, den Sie exportiert haben möchten.",
        "RUSSIAN": "Установите фильтр для всех или только для одного конкретного дня, который вы хотите экспортировать.",
        "FRENCH": "Définissez le filtre pour tous les jours ou seulement un jour spécifique que vous souhaitez exporter.",
        "SPANISH": "Establezca el filtro para todos o sólo para un día específico que desee exportar.",
        "ITALIAN": "Impostare il filtro per tutti o solo un giorno specifico che si desidera esportare.",
        "CHINESE": "设置要导出的全部或仅一个特定日期的筛选器。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Установите фильтр для всех или только для одного конкретного дня, который вы хотите экспортировать.",
        "FRENCH": "Définissez le filtre pour tous les jours ou seulement un jour spécifique que vous souhaitez exporter.",
        "SPANISH": "Establezca el filtro para todos o sólo para un día específico que desee exportar.",
        "ITALIAN": "Impostare il filtro per tutti o solo un giorno specifico che si desidera esportare.",
        "CHINESE": "设置要导出的全部或仅一个特定日期的筛选器。"
      },
