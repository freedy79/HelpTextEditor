      "TRANSLATIONS": {
        "ENGLISH": "Default language",
        "GERMAN": "Voreinstellung Sprache",
        "RUSSIAN": "Язык по умолчанию",
        "FRENCH": "Langue par défaut",
        "SPANISH": "Idioma por defecto",
        "ITALIAN": "Lingua predefinita",
        "CHINESE": "默认语言"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Язык по умолчанию",
        "FRENCH": "Langue par défaut",
        "SPANISH": "Idioma por defecto",
        "ITALIAN": "Lingua predefinita",
        "CHINESE": "默认语言"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "LDAP_SERVER_SETTINGS_INSTRUCTION_9_1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The language can be set as default for this point for the case that the automatic creation of users on the balance is enabled.",
        "GERMAN": "Für den Fall, dass die automatische Erstellung von Nutzern auf der Waage eingeschaltet ist, kann über diesen Punkt die Sprache voreingestellt werden.",
        "RUSSIAN": "Язык может быть установлен по умолчанию для этого пункта в случае, если включено автоматическое создание пользователей на весах.",
        "FRENCH": "La langue peut être définie par défaut pour ce point dans le cas où la création automatique d'utilisateurs sur la balance est activée.",
        "SPANISH": "El idioma puede establecerse por defecto en este punto para el caso de que se habilite la creación automática de usuarios en la balanza.",
        "ITALIAN": "La lingua può essere impostata come predefinita per questo punto nel caso in cui la creazione automatica di utenti sulla bilancia sia abilitata.",
        "CHINESE": "在启用余额自动创建用户的情况下，可将语言设置为默认语言。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Язык может быть установлен по умолчанию для этого пункта в случае, если включено автоматическое создание пользователей на весах.",
        "FRENCH": "La langue peut être définie par défaut pour ce point dans le cas où la création automatique d'utilisateurs sur la balance est activée.",
        "SPANISH": "El idioma puede establecerse por defecto en este punto para el caso de que se habilite la creación automática de usuarios en la balanza.",
        "ITALIAN": "La lingua può essere impostata come predefinita per questo punto nel caso in cui la creazione automatica di utenti sulla bilancia sia abilitata.",
        "CHINESE": "在启用余额自动创建用户的情况下，可将语言设置为默认语言。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "LDAP_SERVER_SETTINGS_HEADLINE_10": {
