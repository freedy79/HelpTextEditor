    "MENU_SETTINGS_REPORT_SMB_APPL_STEP_1": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "From the main menu, use the [Setup] button to open the menu for the settings of the balance.",
        "GERMAN": "Vom Hauptmenü aus öffnen Sie mit der Schaltfläche [Einstellungen] das Menü für die Einstellungen der Waage.",
        "RUSSIAN": "В главном меню с помощью кнопки [Setup] откройте меню настроек весов.",
        "FRENCH": "Dans le menu principal, utilisez le bouton [Setup] pour ouvrir le menu des réglages de la balance.",
        "SPANISH": "Desde el menú principal, utilice el botón [Setup] para abrir el menú para los ajustes de la balanza.",
        "ITALIAN": "Dal menu principale, utilizzare il pulsante [Setup] per aprire il menu per le impostazioni del bilanciamento.",
        "CHINESE": "在主菜单中，使用 [设置] 按钮打开天平设置菜单。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "В главном меню с помощью кнопки [Setup] откройте меню настроек весов.",
        "FRENCH": "Dans le menu principal, utilisez le bouton [Setup] pour ouvrir le menu des réglages de la balance.",
        "SPANISH": "Desde el menú principal, utilice el botón [Setup] para abrir el menú para los ajustes de la balanza.",
        "ITALIAN": "Dal menu principale, utilizzare il pulsante [Setup] per aprire il menu per le impostazioni del bilanciamento.",
        "CHINESE": "在主菜单中，使用 [设置] 按钮打开天平设置菜单。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "MENU_SETTINGS_REPORT_SMB_APPL_STEP_2": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Press the [Export] button in the navigation and toolbar.",
        "GERMAN": "Betätigen Sie die Schaltfläche [Export] in der Navigations- und Funktionsleiste.",
        "RUSSIAN": "Нажмите кнопку [Экспорт] на панели навигации и инструментов.",
        "FRENCH": "Appuyez sur le bouton [Export] dans la barre de navigation et d'outils.",
        "SPANISH": "Pulse el botón [Exportar] en la barra de navegación y de herramientas.",
        "ITALIAN": "Premete il tasto [Export] nella barra di navigazione e degli strumenti.",
        "CHINESE": "按导航栏和工具栏上的 [Export] 按钮。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Нажмите кнопку [Экспорт] на панели навигации и инструментов.",
        "FRENCH": "Appuyez sur le bouton [Export] dans la barre de navigation et d'outils.",
        "SPANISH": "Pulse el botón [Exportar] en la barra de navegación y de herramientas.",
        "ITALIAN": "Premete il tasto [Export] nella barra di navigazione e degli strumenti.",
        "CHINESE": "按导航栏和工具栏上的 [Export] 按钮。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "MENU_SETTINGS_REPORT_SMB_APPL_STEP_3": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "A list of the connectors is displayed, via which the report file can be exported.",
        "GERMAN": "Es wird eine Liste der Konnektoren angezeigt, über die der Export der Report-Datei erfolgen kann.",
        "RUSSIAN": "Отображается список коннекторов, через которые можно экспортировать файл отчета.",
        "FRENCH": "Une liste des connecteurs est affichée, via lesquels le fichier de rapport peut être exporté.",
        "SPANISH": "Se muestra una lista de los conectores, a través de los cuales se puede exportar el archivo de informe.",
        "ITALIAN": "Viene visualizzata una lista dei connettori attraverso i quali il file di report può essere esportato.",
        "CHINESE": "显示连接器列表，通过该列表可导出报告文件。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Отображается список коннекторов, через которые можно экспортировать файл отчета.",
        "FRENCH": "Une liste des connecteurs est affichée, via lesquels le fichier de rapport peut être exporté.",
        "SPANISH": "Se muestra una lista de los conectores, a través de los cuales se puede exportar el archivo de informe.",
        "ITALIAN": "Viene visualizzata una lista dei connettori attraverso i quali il file di report può essere esportato.",
        "CHINESE": "显示连接器列表，通过该列表可导出报告文件。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "MENU_SETTINGS_REPORT_SMB_APPL_STEP_4": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Select your created connector e.g., [My SMB server for settings]. The report file is created and exported to the SMB server via the connector.",
        "GERMAN": "Wählen Sie Ihren angelegten Konnektor z. B. [Mein SMB Server für Einstellungen] aus. Die Report-Datei wird erstellt und über den Konnektor zum SMB Server exportiert.",
        "RUSSIAN": "Выберите созданный коннектор, например, [Мой SMB-сервер для настроек]. Файл отчета создается и экспортируется на SMB-сервер через коннектор.",
        "FRENCH": "Sélectionnez le connecteur que vous avez créé, par exemple, [Mon serveur SMB pour les paramètres]. Le fichier de rapport est créé et exporté vers le serveur SMB via le connecteur.",
        "SPANISH": "Seleccione el conector creado, por ejemplo, [Mi servidor SMB para la configuración]. El archivo de informe se crea y se exporta al servidor SMB a través del conector.",
        "ITALIAN": "Selezionare il connettore creato, ad esempio, [Il mio server SMB per le impostazioni]. Il file di report viene creato ed esportato al server SMB tramite il connettore.",
        "CHINESE": "选择创建的连接器，例如[我的 SMB 服务器设置]。报告文件将通过连接器创建并导出到 SMB 服务器。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Выберите созданный коннектор, например, [Мой SMB-сервер для настроек]. Файл отчета создается и экспортируется на SMB-сервер через коннектор.",
        "FRENCH": "Sélectionnez le connecteur que vous avez créé, par exemple, [Mon serveur SMB pour les paramètres]. Le fichier de rapport est créé et exporté vers le serveur SMB via le connecteur.",
        "SPANISH": "Seleccione el conector creado, por ejemplo, [Mi servidor SMB para la configuración]. El archivo de informe se crea y se exporta al servidor SMB a través del conector.",
        "ITALIAN": "Selezionare il connettore creato, ad esempio, [Il mio server SMB per le impostazioni]. Il file di report viene creato ed esportato al server SMB tramite il connettore.",
        "CHINESE": "选择创建的连接器，例如[我的 SMB 服务器设置]。报告文件将通过连接器创建并导出到 SMB 服务器。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "MENU_SETTINGS_REPORT_SMB_APPL_STEP_5": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "You get the [Report sent] and [Process completed] messages as confirmation for a successful export. The report file in the PDF format, with the related check file, is now present in the server and can be viewed.",
        "GERMAN": "Als Bestätigung für einen erfolgreichen Export erhalten Sie die Meldungen [Report gesendet] und [Prozess beendet]. Die Report-Datei im PDF Format mit der dazugehörigen Prüf-Datei liegt jetzt auf dem Server und kann angesehen werden.",
        "RUSSIAN": "В качестве подтверждения успешного экспорта вы получаете сообщения [Отчет отправлен] и [Процесс завершен]. Файл отчета в формате PDF с соответствующим файлом проверки теперь находится на сервере и может быть просмотрен.",
        "FRENCH": "Vous obtenez les messages [Rapport envoyé] et [Processus terminé] comme confirmation d'une exportation réussie. Le fichier de rapport au format PDF, avec le fichier de contrôle associé, est maintenant présent sur le serveur et peut être consulté.",
        "SPANISH": "Obtendrá los mensajes [Informe enviado] y [Proceso finalizado] como confirmación de que la exportación se ha realizado correctamente. El archivo de informe en formato PDF, con el archivo de comprobación relacionado, está ahora presente en el servidor y se puede ver.",
        "ITALIAN": "Si ottengono i messaggi [Report inviato] e [Processo completato] come conferma del successo dell'esportazione. Il file di report in formato PDF, con il relativo file di controllo, è ora presente nel server e può essere visualizzato.",
        "CHINESE": "您将收到 [报告已发送] 和 [处理已完成] 消息，确认导出成功。PDF 格式的报告文件以及相关的检查文件现在已存在服务器中，可以查看。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "В качестве подтверждения успешного экспорта вы получаете сообщения [Отчет отправлен] и [Процесс завершен]. Файл отчета в формате PDF с соответствующим файлом проверки теперь находится на сервере и может быть просмотрен.",
        "FRENCH": "Vous obtenez les messages [Rapport envoyé] et [Processus terminé] comme confirmation d'une exportation réussie. Le fichier de rapport au format PDF, avec le fichier de contrôle associé, est maintenant présent sur le serveur et peut être consulté.",
        "SPANISH": "Obtendrá los mensajes [Informe enviado] y [Proceso finalizado] como confirmación de que la exportación se ha realizado correctamente. El archivo de informe en formato PDF, con el archivo de comprobación relacionado, está ahora presente en el servidor y se puede ver.",
        "ITALIAN": "Si ottengono i messaggi [Report inviato] e [Processo completato] come conferma del successo dell'esportazione. Il file di report in formato PDF, con il relativo file di controllo, è ora presente nel server e può essere visualizzato.",
        "CHINESE": "您将收到 [报告已发送] 和 [处理已完成] 消息，确认导出成功。PDF 格式的报告文件以及相关的检查文件现在已存在服务器中，可以查看。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "MENU_SETTINGS_REPORT_SMB_APPL_STEP_6": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "If the report file could not be exported, then this file is not lost, see Troubleshooting.",
        "GERMAN": "Falls der Export der Report-Datei nicht erfolgen konnte, geht diese Datei nicht verloren, siehe Fehlerbehandlung.",
        "RUSSIAN": "Если файл отчета не удалось экспортировать, то этот файл не потерян, см. раздел Устранение неполадок.",
        "FRENCH": "Si le fichier de rapport n'a pas pu être exporté, alors ce fichier n'est pas perdu, voir Dépannage.",
        "SPANISH": "Si no se ha podido exportar el archivo del informe, este archivo no se ha perdido, consulte la sección de resolución de problemas.",
        "ITALIAN": "Se il file di report non può essere esportato, allora questo file non è perso, vedi Risoluzione dei problemi.",
        "CHINESE": "如果报告文件无法导出，则该文件不会丢失，请参阅故障排除。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Если файл отчета не удалось экспортировать, то этот файл не потерян, см. раздел Устранение неполадок.",
        "FRENCH": "Si le fichier de rapport n'a pas pu être exporté, alors ce fichier n'est pas perdu, voir Dépannage.",
        "SPANISH": "Si no se ha podido exportar el archivo del informe, este archivo no se ha perdido, consulte la sección de resolución de problemas.",
        "ITALIAN": "Se il file di report non può essere esportato, allora questo file non è perso, vedi Risoluzione dei problemi.",
        "CHINESE": "如果报告文件无法导出，则该文件不会丢失，请参阅故障排除。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "MENU_SETTINGS_REPORT_SMB_APPL_NOTE": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Note: The PDF file format is a platform-independent data format for documents. Print output in this format can be viewed on each computer. For each PDF output file, a matching test file containing the checksum (MD5 hash value) of the PDF data is created. When the file is transferred, this checksum is saved in the audit trail. Using an appropriate tool, this PDF file can be compared with the check file to ensure the integrity of the PDF data.",
        "GERMAN": "Anmerkung: Das Dateiformat PDF ist ein plattformunabhängiges Dateiformat für Dokumente. Druckausgaben in diesem Format können damit auf jedem Rechner angesehen werden. Zu jeder Ausgabe-Datei in PDF-Format wird eine passende Prüf-Datei mit der Prüfsumme (MD5-Hashwert) der PDF-Daten angelegt. Diese Prüfsumme wird zusätzlich beim Übertragen der Datei im Audit Trail gespeichert. Über ein passendes Tool kann die PDF-Datei mit dieser Prüf-Datei verglichen werden und damit die Integrität der PDF-Daten sichergestellt werden.",
        "RUSSIAN": "Примечание: Формат файлов PDF - это независимый от платформы формат данных для документов. Распечатки в этом формате можно просматривать на каждом компьютере. Для каждого выходного файла PDF создается соответствующий тестовый файл, содержащий контрольную сумму (хэш-значение MD5) данных PDF. Когда файл передается, эта контрольная сумма сохраняется в журнале аудита. С помощью соответствующего инструмента этот PDF-файл можно сравнить с контрольным файлом, чтобы убедиться в целостности PDF-данных.",
        "FRENCH": "Remarque : le format de fichier PDF est un format de données indépendant de la plate-forme pour les documents. La sortie imprimée dans ce format peut être visualisée sur chaque ordinateur. Pour chaque fichier de sortie PDF, un fichier test correspondant contenant la somme de contrôle (valeur de hachage MD5) des données PDF est créé. Lorsque le fichier est transféré, cette somme de contrôle est enregistrée dans la piste d'audit. À l'aide d'un outil approprié, ce fichier PDF peut être comparé au fichier de contrôle pour garantir l'intégrité des données PDF.",
        "SPANISH": "Nota: El formato de archivo PDF es un formato de datos para documentos independiente de la plataforma. La salida de impresión en este formato puede verse en cada ordenador. Para cada archivo de salida PDF, se crea un archivo de prueba que contiene la suma de comprobación (valor hash MD5) de los datos PDF. Cuando se transfiere el archivo, esta suma de comprobación se guarda en el registro de auditoría. Utilizando una herramienta adecuada, este archivo PDF puede compararse con el archivo de comprobación para garantizar la integridad de los datos PDF.",
        "ITALIAN": "Nota: Il formato di file PDF è un formato dati indipendente dalla piattaforma per i documenti. L'output di stampa in questo formato può essere visualizzato su ogni computer. Per ogni file di output PDF, viene creato un file di prova corrispondente contenente il checksum (valore di hash MD5) dei dati PDF. Quando il file viene trasferito, questo checksum viene salvato nell'audit trail. Utilizzando uno strumento appropriato, questo file PDF può essere confrontato con il file di controllo per assicurare l'integrità dei dati PDF.",
        "CHINESE": "注意：PDF 文件格式是一种独立于平台的文件数据格式。这种格式的打印输出可以在每台计算机上查看。对于每个 PDF 输出文件，都会创建一个匹配的测试文件，其中包含 PDF 数据的校验和（MD5 哈希值）。文件传输时，该校验和将保存在审计跟踪中。使用适当的工具，可将该 PDF 文件与校验文件进行比较，以确保 PDF 数据的完整性。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Примечание: Формат файлов PDF - это независимый от платформы формат данных для документов. Распечатки в этом формате можно просматривать на каждом компьютере. Для каждого выходного файла PDF создается соответствующий тестовый файл, содержащий контрольную сумму (хэш-значение MD5) данных PDF. Когда файл передается, эта контрольная сумма сохраняется в журнале аудита. С помощью соответствующего инструмента этот PDF-файл можно сравнить с контрольным файлом, чтобы убедиться в целостности PDF-данных.",
        "FRENCH": "Remarque : le format de fichier PDF est un format de données indépendant de la plate-forme pour les documents. La sortie imprimée dans ce format peut être visualisée sur chaque ordinateur. Pour chaque fichier de sortie PDF, un fichier test correspondant contenant la somme de contrôle (valeur de hachage MD5) des données PDF est créé. Lorsque le fichier est transféré, cette somme de contrôle est enregistrée dans la piste d'audit. À l'aide d'un outil approprié, ce fichier PDF peut être comparé au fichier de contrôle pour garantir l'intégrité des données PDF.",
        "SPANISH": "Nota: El formato de archivo PDF es un formato de datos para documentos independiente de la plataforma. La salida de impresión en este formato puede verse en cada ordenador. Para cada archivo de salida PDF, se crea un archivo de prueba que contiene la suma de comprobación (valor hash MD5) de los datos PDF. Cuando se transfiere el archivo, esta suma de comprobación se guarda en el registro de auditoría. Utilizando una herramienta adecuada, este archivo PDF puede compararse con el archivo de comprobación para garantizar la integridad de los datos PDF.",
        "ITALIAN": "Nota: Il formato di file PDF è un formato dati indipendente dalla piattaforma per i documenti. L'output di stampa in questo formato può essere visualizzato su ogni computer. Per ogni file di output PDF, viene creato un file di prova corrispondente contenente il checksum (valore di hash MD5) dei dati PDF. Quando il file viene trasferito, questo checksum viene salvato nell'audit trail. Utilizzando uno strumento appropriato, questo file PDF può essere confrontato con il file di controllo per assicurare l'integrità dei dati PDF.",
        "CHINESE": "注意：PDF 文件格式是一种独立于平台的文件数据格式。这种格式的打印输出可以在每台计算机上查看。对于每个 PDF 输出文件，都会创建一个匹配的测试文件，其中包含 PDF 数据的校验和（MD5 哈希值）。文件传输时，该校验和将保存在审计跟踪中。使用适当的工具，可将该 PDF 文件与校验文件进行比较，以确保 PDF 数据的完整性。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
