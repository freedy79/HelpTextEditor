    "PRINT_GLP_CVS_SMB_CONF_STEP_1": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ]. Do not translate QAPP and QAPP Center.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Activate the [Flexible formulation] QAPP, if this has not yet been done.",
        "GERMAN": "Aktivieren Sie die QAPP [Variable Rezeptur], falls noch nicht erfolgt.",
        "RUSSIAN": "Активируйте [гибкую формулировку] QAPP, если это еще не было сделано.",
        "FRENCH": "Activez le QAPP [formulation souple], si cela n'a pas encore été fait.",
        "SPANISH": "Activar el QAPP [formulación flexible], si aún no se ha hecho.",
        "ITALIAN": "Attivare il QAPP [formulazione flessibile], se questo non è ancora stato fatto.",
        "CHINESE": "激活 QAPP [变量配方]（如果尚未激活）。",
        "JAPANESE": "まだ実施されていない場合は、[柔軟な調合]QAPP を有効にする。",
        "KOREAN": "아직 완료하지 않은 경우 [유연한 공식] QAPP을 활성화합니다."
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Активируйте [гибкую формулировку] QAPP, если это еще не было сделано.",
        "FRENCH": "Activez le QAPP [formulation souple], si cela n'a pas encore été fait.",
        "SPANISH": "Activar el QAPP [formulación flexible], si aún no se ha hecho.",
        "ITALIAN": "Attivare il QAPP [formulazione flessibile], se questo non è ancora stato fatto.",
        "CHINESE": "激活 QAPP [变量配方]（如果尚未激活）。",
        "JAPANESE": "まだ実施されていない場合は、[柔軟な調合]QAPP を有効にする。",
        "KOREAN": "아직 완료하지 않은 경우 [유연한 공식] QAPP을 활성화합니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_GLP_CVS_SMB_CONF_STEP_1_A": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ]. Do not translate QAPP and QAPP Center.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Open the [Task management] menu, followed by the [QAPP Center].",
        "GERMAN": "Das Menü [Task-Verwaltung] und dann das [QAPP Center] öffnen.",
        "RUSSIAN": "Откройте меню [Управление задачами], а затем [QAPP Center].",
        "FRENCH": "Ouvrez le menu [Gestion des tâches], puis le [Centre QAPP].",
        "SPANISH": "Abra el menú [Gestión de tareas], seguido del [Centro QAPP].",
        "ITALIAN": "Apri il menu [Task management], seguito dal [QAPP Center].",
        "CHINESE": "打开 [任务管理] 菜单，然后打开 [QAPP 中心]。",
        "JAPANESE": "タスク管理]メニューを開き、[QAPP センター]を開きます。",
        "KOREAN": "작업 관리] 메뉴를 연 다음, [QAPP 센터]를 엽니다."
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Откройте меню [Управление задачами], а затем [QAPP Center].",
        "FRENCH": "Ouvrez le menu [Gestion des tâches], puis le [Centre QAPP].",
        "SPANISH": "Abra el menú [Gestión de tareas], seguido del [Centro QAPP].",
        "ITALIAN": "Apri il menu [Task management], seguito dal [QAPP Center].",
        "CHINESE": "打开 [任务管理] 菜单，然后打开 [QAPP 中心]。",
        "JAPANESE": "タスク管理]メニューを開き、[QAPP センター]を開きます。",
        "KOREAN": "작업 관리] 메뉴를 연 다음, [QAPP 센터]를 엽니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_GLP_CVS_SMB_CONF_STEP_1_B": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ]. Do not translate QAPP and QAPP Center.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Select the [Advanced] software package and then the [Flexible formulation] QAPP. The description and version of the QAPP will be displayed.",
        "GERMAN": "Wählen Sie das Software-Paket [Advanced] und darin die QAPP [Variable Rezeptur]. Es wird die Beschreibung und Version der QAPP angezeigt.",
        "RUSSIAN": "Выберите пакет программного обеспечения [Advanced], а затем QAPP [Flexible formulation]. Отобразится описание и версия QAPP.",
        "FRENCH": "Sélectionnez le progiciel [Advanced] et ensuite le QAPP [Flexible formulation]. La description et la version du QAPP s'affichent.",
        "SPANISH": "Seleccione el paquete de software [Avanzado] y luego el QAPP [Formulación flexible]. Se mostrará la descripción y la versión del QAPP.",
        "ITALIAN": "Seleziona il pacchetto software [Advanced] e poi il QAPP [Flexible formulation]. Verranno visualizzate la descrizione e la versione del QAPP.",
        "CHINESE": "选择 [高级] 软件包，然后选择 QAPP [变量配方]。将显示 QAPP 的说明和版本。",
        "JAPANESE": "Advanced]ソフトウェアパッケージを選択し、次に[Flexible formulation]QAPPを選択する。QAPPの説明とバージョンが表示されます。",
        "KOREAN": "고급] 소프트웨어 패키지를 선택한 다음 [유연한 제형] QAPP을 선택합니다. QAPP에 대한 설명과 버전이 표시됩니다."
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Выберите пакет программного обеспечения [Advanced], а затем QAPP [Flexible formulation]. Отобразится описание и версия QAPP.",
        "FRENCH": "Sélectionnez le progiciel [Advanced] et ensuite le QAPP [Flexible formulation]. La description et la version du QAPP s'affichent.",
        "SPANISH": "Seleccione el paquete de software [Avanzado] y luego el QAPP [Formulación flexible]. Se mostrará la descripción y la versión del QAPP.",
        "ITALIAN": "Seleziona il pacchetto software [Advanced] e poi il QAPP [Flexible formulation]. Verranno visualizzate la descrizione e la versione del QAPP.",
        "CHINESE": "选择 [高级] 软件包，然后选择 QAPP [变量配方]。将显示 QAPP 的说明和版本。",
        "JAPANESE": "Advanced]ソフトウェアパッケージを選択し、次に[Flexible formulation]QAPPを選択する。QAPPの説明とバージョンが表示されます。",
        "KOREAN": "고급] 소프트웨어 패키지를 선택한 다음 [유연한 제형] QAPP을 선택합니다. QAPP에 대한 설명과 버전이 표시됩니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_GLP_CVS_SMB_CONF_STEP_1_C": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ]. Do not translate QAPP and QAPP Center.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Use the [License] button to activate this QAPP; the order and license information will be displayed.",
        "GERMAN": "Aktivieren Sie mit der Schaltfläche [Lizenz] diese QAPP, die Bestell- und Lizenzinformationen werden angezeigt.",
        "RUSSIAN": "Используйте кнопку [Лицензия] для активации данного QAPP; на экране появится информация о заказе и лицензии.",
        "FRENCH": "Utilisez le bouton [Licence] pour activer ce QAPP ; les informations relatives à la commande et à la licence s'afficheront.",
        "SPANISH": "Utilice el botón [Licencia] para activar este QAPP; se mostrará la información sobre el pedido y la licencia.",
        "ITALIAN": "Usa il pulsante [Licenza] per attivare questo QAPP; verranno visualizzate le informazioni sull'ordine e sulla licenza.",
        "CHINESE": "使用[许可证]按钮激活该 QAPP，显示订单和许可证信息。",
        "JAPANESE": "ライセンス]ボタンを使用してこの QAPP をアクティブにします。",
        "KOREAN": "라이선스] 버튼을 사용하여 이 QAPP을 활성화하면 주문 및 라이선스 정보가 표시됩니다."
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Используйте кнопку [Лицензия] для активации данного QAPP; на экране появится информация о заказе и лицензии.",
        "FRENCH": "Utilisez le bouton [Licence] pour activer ce QAPP ; les informations relatives à la commande et à la licence s'afficheront.",
        "SPANISH": "Utilice el botón [Licencia] para activar este QAPP; se mostrará la información sobre el pedido y la licencia.",
        "ITALIAN": "Usa il pulsante [Licenza] per attivare questo QAPP; verranno visualizzate le informazioni sull'ordine e sulla licenza.",
        "CHINESE": "使用[许可证]按钮激活该 QAPP，显示订单和许可证信息。",
        "JAPANESE": "ライセンス]ボタンを使用してこの QAPP をアクティブにします。",
        "KOREAN": "라이선스] 버튼을 사용하여 이 QAPP을 활성화하면 주문 및 라이선스 정보가 표시됩니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_GLP_CVS_SMB_CONF_STEP_1_D": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ]. Do not translate QAPP and QAPP Center.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "If this QAPP was not ordered as [factory licensed], start the test version or enter the license code that you have purchased for this QAPP.",
        "GERMAN": "Falls diese QAPP nicht ab Werk freigeschaltet bestellt wurde, starten Sie die Testversion oder geben Sie den erworbenen Lizenzcode für diese QAPP ein.",
        "RUSSIAN": "Если этот QAPP не был заказан как [заводская лицензия], запустите тестовую версию или введите код лицензии, который вы приобрели для этого QAPP.",
        "FRENCH": "Si ce QAPP n'a pas été commandé en tant que [licence d'usine], démarrez la version de test ou entrez le code de licence que vous avez acheté pour ce QAPP.",
        "SPANISH": "Si este QAPP no se pidió como [licencia de fábrica], inicie la versión de prueba o introduzca el código de licencia que ha adquirido para este QAPP.",
        "ITALIAN": "Se questo QAPP non è stato ordinato come [con licenza di fabbrica], avvia la versione di prova o inserisci il codice di licenza che hai acquistato per questo QAPP.",
        "CHINESE": "如果本 QAPP 尚未订购激活版本，请启动试用版或输入为本 QAPP 购买的许可代码。",
        "JAPANESE": "この QAPP が[工場出荷時ライセンス]として注文されていない場合は、テストバージョンを開始するか、この QAPP 用に購入したライセンスコードを入力します。",
        "KOREAN": "이 QAPP이 [공장 라이선스]로 주문되지 않은 경우 테스트 버전을 시작하거나 이 QAPP에 대해 구매한 라이선스 코드를 입력합니다."
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Если этот QAPP не был заказан как [заводская лицензия], запустите тестовую версию или введите код лицензии, который вы приобрели для этого QAPP.",
        "FRENCH": "Si ce QAPP n'a pas été commandé en tant que [licence d'usine], démarrez la version de test ou entrez le code de licence que vous avez acheté pour ce QAPP.",
        "SPANISH": "Si este QAPP no se pidió como [licencia de fábrica], inicie la versión de prueba o introduzca el código de licencia que ha adquirido para este QAPP.",
        "ITALIAN": "Se questo QAPP non è stato ordinato come [con licenza di fabbrica], avvia la versione di prova o inserisci il codice di licenza che hai acquistato per questo QAPP.",
        "CHINESE": "如果本 QAPP 尚未订购激活版本，请启动试用版或输入为本 QAPP 购买的许可代码。",
        "JAPANESE": "この QAPP が[工場出荷時ライセンス]として注文されていない場合は、テストバージョンを開始するか、この QAPP 用に購入したライセンスコードを入力します。",
        "KOREAN": "이 QAPP이 [공장 라이선스]로 주문되지 않은 경우 테스트 버전을 시작하거나 이 QAPP에 대해 구매한 라이선스 코드를 입력합니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_GLP_CVS_SMB_CONF_STEP_2": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ]. Do not translate QAPP and QAPP Center.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Activate the [Connection to Windows File Server] QAPP extension, if this has not yet been done.",
        "GERMAN": "Aktivieren Sie die QAPP-Erweiterung [Verbindung zu Windows File Server], falls noch nicht erfolgt.",
        "RUSSIAN": "Активируйте расширение QAPP [Connection to Windows File Server], если это еще не было сделано.",
        "FRENCH": "Activez l'extension QAPP [Connexion au serveur de fichiers Windows], si cela n'a pas encore été fait.",
        "SPANISH": "Active la extensión QAPP [Conexión al servidor de archivos de Windows], si aún no lo ha hecho.",
        "ITALIAN": "Attiva l'estensione QAPP [Connection to Windows File Server], se non è ancora stato fatto.",
        "CHINESE": "激活 QAPP 扩展 [连接到 Windows 文件服务器]（如果尚未完成）。",
        "JAPANESE": "Windows File Server への接続]QAPP 拡張機能がまだ有効になっていない場合は、これを有効にします。",
        "KOREAN": "아직 활성화하지 않은 경우 [Windows 파일 서버에 연결] QAPP 확장을 활성화합니다."
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Активируйте расширение QAPP [Connection to Windows File Server], если это еще не было сделано.",
        "FRENCH": "Activez l'extension QAPP [Connexion au serveur de fichiers Windows], si cela n'a pas encore été fait.",
        "SPANISH": "Active la extensión QAPP [Conexión al servidor de archivos de Windows], si aún no lo ha hecho.",
        "ITALIAN": "Attiva l'estensione QAPP [Connection to Windows File Server], se non è ancora stato fatto.",
        "CHINESE": "激活 QAPP 扩展 [连接到 Windows 文件服务器]（如果尚未完成）。",
        "JAPANESE": "Windows File Server への接続]QAPP 拡張機能がまだ有効になっていない場合は、これを有効にします。",
        "KOREAN": "아직 활성화하지 않은 경우 [Windows 파일 서버에 연결] QAPP 확장을 활성화합니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
