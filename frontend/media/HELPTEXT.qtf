    "NETWORK_WLAN_STICKS_INSTRUCTION_1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Cubis® MCA supports the most common Wi-Fi sticks (USB WLAN adapters) which are available in the market.",
        "GERMAN": "Die Cubis® MCA unterstützt die gängigsten Wi-Fi-Sticks (USB-WLAN-Adapter) die auf dem Markt angeboten werden.",
        "RUSSIAN": "Cubis® MCA поддерживает наиболее распространенные Wi-Fi адаптеры (USB WLAN-адаптеры), которые доступны на рынке.",
        "FRENCH": "Cubis® MCA supporte les clés Wi-Fi les plus courantes (adaptateurs WLAN USB) disponibles sur le marché.",
        "SPANISH": "Cubis® MCA es compatible con las memorias Wi-Fi más comunes (adaptadores WLAN USB) disponibles en el mercado.",
        "ITALIAN": "Cubis® MCA supporta le più comuni chiavette Wi-Fi (adattatori USB WLAN) che sono disponibili sul mercato.",
        "CHINESE": "Cubis® MCA 支持市场上最常见的 Wi-Fi 棒（USB WLAN 适配器）。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Cubis® MCA поддерживает наиболее распространенные Wi-Fi адаптеры (USB WLAN-адаптеры), которые доступны на рынке.",
        "FRENCH": "Cubis® MCA supporte les clés Wi-Fi les plus courantes (adaptateurs WLAN USB) disponibles sur le marché.",
        "SPANISH": "Cubis® MCA es compatible con las memorias Wi-Fi más comunes (adaptadores WLAN USB) disponibles en el mercado.",
        "ITALIAN": "Cubis® MCA supporta le più comuni chiavette Wi-Fi (adattatori USB WLAN) che sono disponibili sul mercato.",
        "CHINESE": "Cubis® MCA 支持市场上最常见的 Wi-Fi 棒（USB WLAN 适配器）。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "NETWORK_WLAN_STICKS_INSTRUCTION_2": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Keep in mind the following items when selecting a Wi-Fi stick:",
        "GERMAN": "Für die Auswahl eines Wi-Fi-Sticks beachten Sie folgende Punkte:",
        "RUSSIAN": "При выборе адаптера Wi-Fi учитывайте следующие моменты:",
        "FRENCH": "Gardez à l'esprit les éléments suivants lors du choix d'une clé Wi-Fi :",
        "SPANISH": "Ten en cuenta los siguientes elementos a la hora de seleccionar un stick Wi-Fi:",
        "ITALIAN": "Tenete a mente i seguenti elementi quando scegliete una chiavetta Wi-Fi:",
        "CHINESE": "在选择 Wi-Fi 棒时，请牢记以下事项："
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "При выборе адаптера Wi-Fi учитывайте следующие моменты:",
        "FRENCH": "Gardez à l'esprit les éléments suivants lors du choix d'une clé Wi-Fi :",
        "SPANISH": "Ten en cuenta los siguientes elementos a la hora de seleccionar un stick Wi-Fi:",
        "ITALIAN": "Tenete a mente i seguenti elementi quando scegliete una chiavetta Wi-Fi:",
        "CHINESE": "在选择 Wi-Fi 棒时，请牢记以下事项："
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "NETWORK_WLAN_STICKS_INSTRUCTION_2_STEP_1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Avoid Wi-Fi sticks without name. Always buy a known brand.",
        "GERMAN": "Vermeiden Sie namenlose Wi-Fi-Sticks. Kaufen Sie bei einer bekannten Marke.",
        "RUSSIAN": "Избегайте адаптеров Wi-Fi без названия. Всегда покупайте известный бренд.",
        "FRENCH": "Évitez les bâtons Wi-Fi sans nom. Achetez toujours une marque connue.",
        "SPANISH": "Evite las barras de Wi-Fi sin nombre. Compre siempre una marca conocida.",
        "ITALIAN": "Evitare i bastoni Wi-Fi senza nome. Comprate sempre una marca conosciuta.",
        "CHINESE": "避免使用无名 Wi-Fi 棒。一定要购买知名品牌。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Избегайте адаптеров Wi-Fi без названия. Всегда покупайте известный бренд.",
        "FRENCH": "Évitez les bâtons Wi-Fi sans nom. Achetez toujours une marque connue.",
        "SPANISH": "Evite las barras de Wi-Fi sin nombre. Compre siempre una marca conocida.",
        "ITALIAN": "Evitare i bastoni Wi-Fi senza nome. Comprate sempre una marca conosciuta.",
        "CHINESE": "避免使用无名 Wi-Fi 棒。一定要购买知名品牌。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "NETWORK_WLAN_STICKS_INSTRUCTION_2_STEP_2": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "If possible, check the data sheet of the Wi-Fi stick to ensure that it contains one of the following supported chip sets.",
        "GERMAN": "Überprüfen Sie nach Möglichkeit das Datenblatt des Wi-Fi-Sticks, um sicherzustellen, dass er einen der folgenden unterstützten Chipsätze enthält.",
        "RUSSIAN": "Если возможно, проверьте спецификацию адаптера Wi-Fi, чтобы убедиться, что он содержит один из следующих поддерживаемых наборов микросхем.",
        "FRENCH": "Si possible, vérifiez la fiche technique de la clé Wi-Fi pour vous assurer qu'elle contient l'un des jeux de puces pris en charge suivants.",
        "SPANISH": "Si es posible, compruebe la hoja de datos del stick Wi-Fi para asegurarse de que contiene uno de los siguientes conjuntos de chips compatibles.",
        "ITALIAN": "Se possibile, controllate la scheda tecnica della chiavetta Wi-Fi per assicurarvi che contenga uno dei seguenti chip set supportati.",
        "CHINESE": "如果可能，请查看 Wi-Fi 棒的数据表，确保它包含以下支持的芯片组之一。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Если возможно, проверьте спецификацию адаптера Wi-Fi, чтобы убедиться, что он содержит один из следующих поддерживаемых наборов микросхем.",
        "FRENCH": "Si possible, vérifiez la fiche technique de la clé Wi-Fi pour vous assurer qu'elle contient l'un des jeux de puces pris en charge suivants.",
        "SPANISH": "Si es posible, compruebe la hoja de datos del stick Wi-Fi para asegurarse de que contiene uno de los siguientes conjuntos de chips compatibles.",
        "ITALIAN": "Se possibile, controllate la scheda tecnica della chiavetta Wi-Fi per assicurarvi che contenga uno dei seguenti chip set supportati.",
        "CHINESE": "如果可能，请查看 Wi-Fi 棒的数据表，确保它包含以下支持的芯片组之一。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
