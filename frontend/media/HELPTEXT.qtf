        "CHINESE": "网络连接器"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Коннекторы",
        "FRENCH": "Connecteurs",
        "SPANISH": "Conectores",
        "ITALIAN": "Connettori",
        "CHINESE": "网络连接器"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
