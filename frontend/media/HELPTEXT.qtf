    "VIEW_AUDIT_TRAIL_VIA_BROWSER_APPL_STEP_2": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Enter the IP address of your balance, which is displayed in the [Status center] under [Device information].",
        "GERMAN": "Geben Sie die IP-Adresse Ihrer Waage ein, die im [Status Center] unter [Geräteinformationen] angezeigt wird.",
        "RUSSIAN": "Введите IP-адрес ваших весов, который отображается в [Центре состояния] в разделе [Информация об устройстве].",
        "FRENCH": "Saisissez l'adresse IP de votre balance, qui est affichée dans le [Centre d'état] sous [Informations sur le périphérique].",
        "SPANISH": "Introduzca la dirección IP de su balanza, que se muestra en el [Centro de estado] en [Información del dispositivo].",
        "ITALIAN": "Inserisci l'indirizzo IP della tua bilancia, che viene visualizzato in [Status center] sotto [Device information].",
        "CHINESE": "输入天平的 IP 地址，该地址显示在 [Device information] （设备信息）下的 [Status center] （状态中心）中。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Введите IP-адрес ваших весов, который отображается в [Центре состояния] в разделе [Информация об устройстве].",
        "FRENCH": "Saisissez l'adresse IP de votre balance, qui est affichée dans le [Centre d'état] sous [Informations sur le périphérique].",
        "SPANISH": "Introduzca la dirección IP de su balanza, que se muestra en el [Centro de estado] en [Información del dispositivo].",
        "ITALIAN": "Inserisci l'indirizzo IP della tua bilancia, che viene visualizzato in [Status center] sotto [Device information].",
        "CHINESE": "输入天平的 IP 地址，该地址显示在 [Device information] （设备信息）下的 [Status center] （状态中心）中。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
