    "SYNC_DATE_TIME_WITH_NTP_CONF_STEP_2_C": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
