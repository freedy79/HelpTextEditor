    "TCA_WAKING_UP_INSTRUCTION_1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "This action switches the balance back on automatically from standby at regular intervals and at a specific time.",
        "GERMAN": "Diese Aktion schaltet die Waage regelmäßig zu einem bestimmten Zeitpunkt aus dem Standby automatisch wieder ein.",
        "RUSSIAN": "Это действие автоматически включает весы из режима ожидания через регулярные промежутки времени и в определенное время.",
        "FRENCH": "Cette action permet de remettre la balance en marche automatiquement à partir du mode veille à intervalles réguliers et à une heure précise.",
        "SPANISH": "Esta acción vuelve a encender la balanza automáticamente desde el modo de espera a intervalos regulares y a una hora determinada.",
        "ITALIAN": "Questa azione riaccende automaticamente la bilancia dallo standby a intervalli regolari e in un momento specifico.",
        "CHINESE": "该操作可在特定时间内将天平从待机状态自动开启。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Это действие автоматически включает весы из режима ожидания через регулярные промежутки времени и в определенное время.",
        "FRENCH": "Cette action permet de remettre la balance en marche automatiquement à partir du mode veille à intervalles réguliers et à une heure précise.",
        "SPANISH": "Esta acción vuelve a encender la balanza automáticamente desde el modo de espera a intervalos regulares y a una hora determinada.",
        "ITALIAN": "Questa azione riaccende automaticamente la bilancia dallo standby a intervalli regolari e in un momento specifico.",
        "CHINESE": "该操作可在特定时间内将天平从待机状态自动开启。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "TCA_SWITCH_OFF_TITLE": {
