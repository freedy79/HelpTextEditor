    "DEVICE_MAINTENANCE_DIAGNOSTIC_FILE_APPL_STEP_3": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Select a suitable connector for data transmission.",
        "GERMAN": "Wählen Sie einen geeigneten Konnektor für die Datenübertragung.",
        "RUSSIAN": "Выберите подходящий коннектор для передачи данных.",
        "FRENCH": "Sélectionnez un connecteur approprié pour la transmission des données.",
        "SPANISH": "Seleccione un conector adecuado para la transmisión de datos.",
        "ITALIAN": "Selezionare un connettore adatto alla trasmissione dei dati.",
        "CHINESE": "选择合适的数据传输连接器。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Выберите подходящий коннектор для передачи данных.",
        "FRENCH": "Sélectionnez un connecteur approprié pour la transmission des données.",
        "SPANISH": "Seleccione un conector adecuado para la transmisión de datos.",
        "ITALIAN": "Selezionare un connettore adatto alla trasmissione dei dati.",
        "CHINESE": "选择合适的数据传输连接器。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "DEVICE_MAINTENANCE_DIAGNOSTIC_FILE_APPL_STEP_4": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Depending on the analysis, select either [Standard content] or [Extended content]. If necessary, a Sartorius employee will inform you of the type of diagnosis.",
        "GERMAN": "Wählen Sie in Abhängigkeit der Analyse entweder [Standardinhalt] oder [Erweiterter Inhalt]. Ggf. weist Sie ein Sartorius-Mitarbeiter auf die Art der Diagnose hin.",
        "RUSSIAN": "В зависимости от анализа выберите либо [Стандартное содержание], либо [Расширенное содержание]. При необходимости сотрудник компании Sartorius проинформирует вас о типе диагностики.",
        "FRENCH": "En fonction de l'analyse, sélectionnez soit [Contenu standard], soit [Contenu étendu]. Si nécessaire, un employé de Sartorius vous informera du type de diagnostic.",
        "SPANISH": "En función del análisis, seleccione [Contenido estándar] o [Contenido ampliado]. En caso necesario, un empleado de Sartorius le informará del tipo de diagnóstico.",
        "ITALIAN": "A seconda dell'analisi, selezionare [Contenuto standard] o [Contenuto esteso]. Se necessario, un collaboratore della Sartorius vi informerà sul tipo di diagnosi.",
        "CHINESE": "根据分析结果，选择 [标准内容] 或 [扩展内容]。如有必要，赛多利斯员工将告知您诊断类型。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "В зависимости от анализа выберите либо [Стандартное содержание], либо [Расширенное содержание]. При необходимости сотрудник компании Sartorius проинформирует вас о типе диагностики.",
        "FRENCH": "En fonction de l'analyse, sélectionnez soit [Contenu standard], soit [Contenu étendu]. Si nécessaire, un employé de Sartorius vous informera du type de diagnostic.",
        "SPANISH": "En función del análisis, seleccione [Contenido estándar] o [Contenido ampliado]. En caso necesario, un empleado de Sartorius le informará del tipo de diagnóstico.",
        "ITALIAN": "A seconda dell'analisi, selezionare [Contenuto standard] o [Contenuto esteso]. Se necessario, un collaboratore della Sartorius vi informerà sul tipo di diagnosi.",
        "CHINESE": "根据分析结果，选择 [标准内容] 或 [扩展内容]。如有必要，赛多利斯员工将告知您诊断类型。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "DEVICE_MAINTENANCE_DIAGNOSTIC_FILE_APPL_STEP_5": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The device collects the necessary information and creates the diagnostic file. It is then automatically copied to the connector. You can exit the dialog by clicking the [Check mark].",
        "GERMAN": "Das Gerät sammelt die notwendigen Informationen und erstellt die Diagnosedatei. Sie wird im Anschluss automatisch auf den Konnektor kopiert. Sie können den Dialog durch Klicken des [Hakens] verlassen.",
        "RUSSIAN": "Устройство собирает необходимую информацию и создает диагностический файл. Затем он автоматически копируется в коннектор. Вы можете выйти из диалогового окна, нажав на кнопку [Check mark].",
        "FRENCH": "L'appareil recueille les informations nécessaires et crée le fichier de diagnostic. Celui-ci est ensuite automatiquement copié sur le connecteur. Vous pouvez quitter la boîte de dialogue en cliquant sur le [Check mark].",
        "SPANISH": "El dispositivo recoge la información necesaria y crea el archivo de diagnóstico. A continuación, se copia automáticamente en el conector. Puede salir del diálogo haciendo clic en la [Marca de verificación].",
        "ITALIAN": "Il dispositivo raccoglie le informazioni necessarie e crea il file diagnostico. Esso viene poi copiato automaticamente sul connettore. È possibile uscire dalla finestra di dialogo cliccando sul [Check mark].",
        "CHINESE": "设备收集必要信息并创建诊断文件。然后自动复制到连接器。单击 [复选标记] 可以退出对话框。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Устройство собирает необходимую информацию и создает диагностический файл. Затем он автоматически копируется в коннектор. Вы можете выйти из диалогового окна, нажав на кнопку [Check mark].",
        "FRENCH": "L'appareil recueille les informations nécessaires et crée le fichier de diagnostic. Celui-ci est ensuite automatiquement copié sur le connecteur. Vous pouvez quitter la boîte de dialogue en cliquant sur le [Check mark].",
        "SPANISH": "El dispositivo recoge la información necesaria y crea el archivo de diagnóstico. A continuación, se copia automáticamente en el conector. Puede salir del diálogo haciendo clic en la [Marca de verificación].",
        "ITALIAN": "Il dispositivo raccoglie le informazioni necessarie e crea il file diagnostico. Esso viene poi copiato automaticamente sul connettore. È possibile uscire dalla finestra di dialogo cliccando sul [Check mark].",
        "CHINESE": "设备收集必要信息并创建诊断文件。然后自动复制到连接器。单击 [复选标记] 可以退出对话框。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "DEVICE_MAINTENANCE_DIAGNOSTIC_FILE_APPL_NOTE": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Send the diagnostic file to your service technician. If you have any further questions, Sartorius Service will contact you.",
        "GERMAN": "Übermitteln Sie die Diagnosedatei an Ihren Servicetechniker. Bei weiteren Fragen wird der Sartorius Service sich mit Ihnen in Verbindung setzen.",
        "RUSSIAN": "Отправьте диагностический файл вашему специалисту по обслуживанию. Если у вас возникнут дополнительные вопросы, сервисная служба Sartorius свяжется с вами.",
        "FRENCH": "Envoyez le fichier de diagnostic à votre technicien de maintenance. Si vous avez d'autres questions, le service après-vente Sartorius vous contactera.",
        "SPANISH": "Envíe el archivo de diagnóstico a su técnico de servicio. Si tiene más preguntas, el servicio técnico de Sartorius se pondrá en contacto con usted.",
        "ITALIAN": "Inviate il file di diagnostica al vostro tecnico di servizio. In caso di ulteriori domande, l'assistenza Sartorius vi contatterà.",
        "CHINESE": "将诊断文件发送给技术服务人员。如有任何问题，赛多利斯服务部门将与您联系。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Отправьте диагностический файл вашему специалисту по обслуживанию. Если у вас возникнут дополнительные вопросы, сервисная служба Sartorius свяжется с вами.",
        "FRENCH": "Envoyez le fichier de diagnostic à votre technicien de maintenance. Si vous avez d'autres questions, le service après-vente Sartorius vous contactera.",
        "SPANISH": "Envíe el archivo de diagnóstico a su técnico de servicio. Si tiene más preguntas, el servicio técnico de Sartorius se pondrá en contacto con usted.",
        "ITALIAN": "Inviate il file di diagnostica al vostro tecnico di servizio. In caso di ulteriori domande, l'assistenza Sartorius vi contatterà.",
        "CHINESE": "将诊断文件发送给技术服务人员。如有任何问题，赛多利斯服务部门将与您联系。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
