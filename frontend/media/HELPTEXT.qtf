    "UPDATE_QAPP_CENTER_FTP_APPL_STEP_1": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "From the main menu, use the [Setup] button to open the menu for the settings of the balance.",
        "GERMAN": "Öffnen Sie vom Hauptmenü aus mit der Schaltfläche [Einstellungen] das Menü für die Einstellungen der Waage.",
        "RUSSIAN": "В главном меню с помощью кнопки [Setup] откройте меню настроек весов.",
        "FRENCH": "Dans le menu principal, utilisez le bouton [Setup] pour ouvrir le menu des réglages de la balance.",
        "SPANISH": "Desde el menú principal, utilice el botón [Setup] para abrir el menú para los ajustes de la balanza.",
        "ITALIAN": "Dal menu principale, usare il pulsante [Setup] per aprire il menu per le impostazioni del bilanciamento.",
        "CHINESE": "在主菜单中，使用 [设置] 按钮打开天平设置菜单。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "В главном меню с помощью кнопки [Setup] откройте меню настроек весов.",
        "FRENCH": "Dans le menu principal, utilisez le bouton [Setup] pour ouvrir le menu des réglages de la balance.",
        "SPANISH": "Desde el menú principal, utilice el botón [Setup] para abrir el menú para los ajustes de la balanza.",
        "ITALIAN": "Dal menu principale, usare il pulsante [Setup] per aprire il menu per le impostazioni del bilanciamento.",
        "CHINESE": "在主菜单中，使用 [设置] 按钮打开天平设置菜单。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "UPDATE_QAPP_CENTER_FTP_APPL_STEP_2": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ]. Do not translate QAPP and QAPP Center.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Navigate to the [Device maintenance] -> [Install QAPP Center] menu item. A list of connectors is displayed, using which a package can be loaded for updating the QAPP Center.",
        "GERMAN": "Navigieren Sie zum Punkt [Gerätewartung] -> [QAPP Center installieren]. Es wird eine Liste der Konnektoren angezeigt, über die ein Paket für die Aktualisierung vom QAPP Center geladen werden kann.",
        "RUSSIAN": "Перейдите к пункту меню [Обслуживание устройства] -> [Установить QAPP Center]. Отображается список соединителей, с помощью которых можно загрузить пакет для обновления QAPP Center.",
        "FRENCH": "Naviguer vers l'article de menu [Device maintenance] -> [Install QAPP Center]. Une liste de connecteurs est affichée, à l'aide de laquelle un paquet peut être chargé pour mettre à jour le QAPP Center.",
        "SPANISH": "Vaya al menú [Mantenimiento de dispositivos] -> [Instalar el Centro QAPP]. Se muestra una lista de conectores con los que se puede cargar un paquete para actualizar el Centro QAPP.",
        "ITALIAN": "Passare alla voce di menu [Device maintenance] -> [Install QAPP Center]. Viene visualizzato un elenco di connettori con i quali è possibile caricare un pacchetto per l'aggiornamento del QAPP Center.",
        "CHINESE": "导航至 [Device maintenance（设备维护）] -> [Install QAPP Center（安装 QAPP 中心）] 菜单项。显示连接器列表，可使用该列表加载用于更新 QAPP 中心的软件包。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Перейдите к пункту меню [Обслуживание устройства] -> [Установить QAPP Center]. Отображается список соединителей, с помощью которых можно загрузить пакет для обновления QAPP Center.",
        "FRENCH": "Naviguer vers l'article de menu [Device maintenance] -> [Install QAPP Center]. Une liste de connecteurs est affichée, à l'aide de laquelle un paquet peut être chargé pour mettre à jour le QAPP Center.",
        "SPANISH": "Vaya al menú [Mantenimiento de dispositivos] -> [Instalar el Centro QAPP]. Se muestra una lista de conectores con los que se puede cargar un paquete para actualizar el Centro QAPP.",
        "ITALIAN": "Passare alla voce di menu [Device maintenance] -> [Install QAPP Center]. Viene visualizzato un elenco di connettori con i quali è possibile caricare un pacchetto per l'aggiornamento del QAPP Center.",
        "CHINESE": "导航至 [Device maintenance（设备维护）] -> [Install QAPP Center（安装 QAPP 中心）] 菜单项。显示连接器列表，可使用该列表加载用于更新 QAPP 中心的软件包。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "UPDATE_QAPP_CENTER_FTP_APPL_STEP_3": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ]. Do not translate QAPP and QAPP Center.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Select your created connector e.g., [My FTP server for QAPP Center update]. The connection to the FTP server is established and a list of available packages for updating the QAPP Center is displayed.",
        "GERMAN": "Wählen Sie Ihren angelegten Konnektor z. B. [Mein FTP Server für Update QAPP Center] aus. Die Verbindung zum FTP Server wird aufgebaut und eine Liste der verfügbaren Pakete für das Aktualisieren vom QAPP Center wird angezeigt.",
        "RUSSIAN": "Выберите созданный вами соединитель, например, [Мой FTP-сервер для обновления QAPP-центра]. Будет установлено соединение с FTP-сервером и отображен список доступных пакетов для обновления QAPP-центра.",
        "FRENCH": "Sélectionnez le connecteur que vous avez créé, par exemple, [Mon serveur FTP pour la mise à jour du Centre QAPP]. La connexion au serveur FTP est établie et une liste des paquets disponibles pour la mise à jour du QAPP Center est affichée.",
        "SPANISH": "Seleccione el conector creado, por ejemplo, [Mi servidor FTP para la actualización del Centro QAPP]. Se establece la conexión con el servidor FTP y se muestra una lista de paquetes disponibles para actualizar el Centro QAPP.",
        "ITALIAN": "Selezionare il connettore creato, ad esempio [Il mio server FTP per l'aggiornamento del QAPP Center]. Viene stabilita la connessione al server FTP e viene visualizzato un elenco di pacchetti disponibili per l'aggiornamento del QAPP Center.",
        "CHINESE": "选择您创建的连接器，例如[我的 FTP 服务器用于 QAPP 中心更新]。与 FTP 服务器的连接已建立，并显示用于更新 QAPP 中心的可用软件包列表。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Выберите созданный вами соединитель, например, [Мой FTP-сервер для обновления QAPP-центра]. Будет установлено соединение с FTP-сервером и отображен список доступных пакетов для обновления QAPP-центра.",
        "FRENCH": "Sélectionnez le connecteur que vous avez créé, par exemple, [Mon serveur FTP pour la mise à jour du Centre QAPP]. La connexion au serveur FTP est établie et une liste des paquets disponibles pour la mise à jour du QAPP Center est affichée.",
        "SPANISH": "Seleccione el conector creado, por ejemplo, [Mi servidor FTP para la actualización del Centro QAPP]. Se establece la conexión con el servidor FTP y se muestra una lista de paquetes disponibles para actualizar el Centro QAPP.",
        "ITALIAN": "Selezionare il connettore creato, ad esempio [Il mio server FTP per l'aggiornamento del QAPP Center]. Viene stabilita la connessione al server FTP e viene visualizzato un elenco di pacchetti disponibili per l'aggiornamento del QAPP Center.",
        "CHINESE": "选择您创建的连接器，例如[我的 FTP 服务器用于 QAPP 中心更新]。与 FTP 服务器的连接已建立，并显示用于更新 QAPP 中心的可用软件包列表。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "UPDATE_QAPP_CENTER_FTP_APPL_STEP_4": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not translate QAPP and QAPP Center.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Select the desired version of the QAPP Center and confirm the message for update.",
        "GERMAN": "Wählen Sie die gewünschte Version vom QAPP Center aus und bestätigen Sie die Meldung zur Aktualisierung.",
        "RUSSIAN": "Выберите нужную версию QAPP Center и подтвердите сообщение об обновлении.",
        "FRENCH": "Sélectionnez la version souhaitée du QAPP Center et confirmez le message de mise à jour.",
        "SPANISH": "Seleccione la versión deseada del Centro QAPP y confirme el mensaje de actualización.",
        "ITALIAN": "Selezionare la versione desiderata del Centro QAPP e confermare il messaggio di aggiornamento.",
        "CHINESE": "选择所需的 QAPP 中心版本并确认更新信息。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Выберите нужную версию QAPP Center и подтвердите сообщение об обновлении.",
        "FRENCH": "Sélectionnez la version souhaitée du QAPP Center et confirmez le message de mise à jour.",
        "SPANISH": "Seleccione la versión deseada del Centro QAPP y confirme el mensaje de actualización.",
        "ITALIAN": "Selezionare la versione desiderata del Centro QAPP e confermare il messaggio di aggiornamento.",
        "CHINESE": "选择所需的 QAPP 中心版本并确认更新信息。"
      },
      "VERIFIED": {
