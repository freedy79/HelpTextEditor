      "TRANSLATIONS": {
        "ENGLISH": "Set up a connector to an FTP server e.g., [My FTP server for QAPP Center update].",
        "GERMAN": "Richten Sie einen Konnektor zu einem FTP Server ein, z. B. [Mein FTP Server für Update QAPP Center].",
        "RUSSIAN": "Установите соединение с FTP-сервером, например, [Мой FTP-сервер для обновления QAPP-центра].",
        "FRENCH": "Configurez un connecteur vers un serveur FTP, par exemple, [Mon serveur FTP pour la mise à jour du QAPP Center].",
        "SPANISH": "Configure un conector a un servidor FTP, por ejemplo, [Mi servidor FTP para la actualización del Centro QAPP].",
        "ITALIAN": "Impostare un connettore a un server FTP, ad esempio, [Il mio server FTP per l'aggiornamento del Centro QAPP].",
        "CHINESE": "设置连接 FTP 服务器的连接器，例如[我的 FTP 服务器用于 QAPP 中心更新]。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Установите соединение с FTP-сервером, например, [Мой FTP-сервер для обновления QAPP-центра].",
        "FRENCH": "Configurez un connecteur vers un serveur FTP, par exemple, [Mon serveur FTP pour la mise à jour du QAPP Center].",
        "SPANISH": "Configure un conector a un servidor FTP, por ejemplo, [Mi servidor FTP para la actualización del Centro QAPP].",
        "ITALIAN": "Impostare un connettore a un server FTP, ad esempio, [Il mio server FTP per l'aggiornamento del Centro QAPP].",
        "CHINESE": "设置连接 FTP 服务器的连接器，例如[我的 FTP 服务器用于 QAPP 中心更新]。"
