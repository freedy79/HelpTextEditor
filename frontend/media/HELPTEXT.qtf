    "PRINT_YDP30_LABEL_ERROR_STEP_1": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Ensure that all the configuration steps described above have been followed, especially the allocation of the print profile to the task, e.g. [My label print to YDP30].",
        "GERMAN": "Stellen Sie sicher, dass alle oben genannten Konfigurationsschritte befolgt wurden, insbesondere die Zuordnung des Druckprofils z. B. [Mein Etiketten Druck auf YDP30] zur Task.",
        "FRENCH": "Assurez-vous que toutes les étapes de configuration décrites ci-dessus ont été suivies, notamment l'attribution du profil d'impression à la tâche, par exemple [Mon étiquette s'imprime sur YDP30].",
        "RUSSIAN": "Убедитесь, что все описанные выше шаги по настройке были выполнены, особенно назначение профиля печати для задачи, например, [My label print to YDP30].",
        "SPANISH": "Asegúrese de que se han seguido todos los pasos de configuración descritos anteriormente, especialmente la asignación del perfil de impresión a la tarea, por ejemplo, [Mi impresión de etiquetas a YDP30].",
        "ITALIAN": "Assicuratevi che tutti i passi di configurazione descritti sopra siano stati seguiti, specialmente l'assegnazione del profilo di stampa all'attività, per esempio [My label print to YDP30].",
        "CHINESE": "确保已遵循上述所有配置步骤，特别是将打印配置文件分配给任务，例如 [我的标签打印到 YDP30]。",
        "JAPANESE": "上記のすべての設定ステップ、特にタスクへの印刷プロファイルの割り当て（例：[My label print to YDP30]）が実行されていることを確認します。",
        "KOREAN": "위에서 설명한 모든 구성 단계, 특히 작업에 대한 인쇄 프로필 할당(예: [내 라벨을 YDP30으로 인쇄])을 따랐는지 확인합니다."
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Assurez-vous que toutes les étapes de configuration décrites ci-dessus ont été suivies, notamment l'attribution du profil d'impression à la tâche, par exemple [Mon étiquette s'imprime sur YDP30].",
        "RUSSIAN": "Убедитесь, что все описанные выше шаги по настройке были выполнены, особенно назначение профиля печати для задачи, например, [My label print to YDP30].",
        "SPANISH": "Asegúrese de que se han seguido todos los pasos de configuración descritos anteriormente, especialmente la asignación del perfil de impresión a la tarea, por ejemplo, [Mi impresión de etiquetas a YDP30].",
        "ITALIAN": "Assicuratevi che tutti i passi di configurazione descritti sopra siano stati seguiti, specialmente l'assegnazione del profilo di stampa all'attività, per esempio [My label print to YDP30].",
        "CHINESE": "确保已遵循上述所有配置步骤，特别是将打印配置文件分配给任务，例如 [我的标签打印到 YDP30]。",
        "JAPANESE": "上記のすべての設定ステップ、特にタスクへの印刷プロファイルの割り当て（例：[My label print to YDP30]）が実行されていることを確認します。",
        "KOREAN": "위에서 설명한 모든 구성 단계, 특히 작업에 대한 인쇄 프로필 할당(예: [내 라벨을 YDP30으로 인쇄])을 따랐는지 확인합니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
        "RUSSIAN": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_YDP30_LABEL_ERROR_STEP_2": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Check that the balance is correctly connected to the YDP30 printer using a USB-A to B cable, and that the printer is switched on.",
        "GERMAN": "Überprüfen Sie, ob die Waage mit dem Drucker YDP30 per USB-Kabel A auf B richtig verbunden ist und der Drucker auch eingeschaltet ist.",
        "FRENCH": "Vérifiez que la balance est correctement connectée à l'imprimante YDP30 à l'aide d'un câble USB-A vers B et que l'imprimante est allumée.",
        "RUSSIAN": "Убедитесь, что весы правильно подключены к принтеру YDP30 с помощью кабеля USB-A - B и что принтер включен.",
        "SPANISH": "Compruebe que la balanza está correctamente conectada a la impresora YDP30 mediante un cable USB-A a B, y que la impresora está encendida.",
        "ITALIAN": "Controllare che la bilancia sia collegata correttamente alla stampante YDP30 con un cavo da USB-A a B e che la stampante sia accesa.",
        "CHINESE": "检查天平是否使用 USB-A 到 B 电缆正确连接到 YDP30 打印机，以及打印机是否打开。",
        "JAPANESE": "天びんが USB-A to B ケーブルで YDP30 プリンタに正しく接続され、 プリンタの電源が入っていることを確認します。",
        "KOREAN": "USB-A-B 케이블을 사용하여 저울이 YDP30 프린터에 올바르게 연결되어 있고 프린터의 전원이 켜져 있는지 확인합니다."
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Vérifiez que la balance est correctement connectée à l'imprimante YDP30 à l'aide d'un câble USB-A vers B et que l'imprimante est allumée.",
        "RUSSIAN": "Убедитесь, что весы правильно подключены к принтеру YDP30 с помощью кабеля USB-A - B и что принтер включен.",
        "SPANISH": "Compruebe que la balanza está correctamente conectada a la impresora YDP30 mediante un cable USB-A a B, y que la impresora está encendida.",
        "ITALIAN": "Controllare che la bilancia sia collegata correttamente alla stampante YDP30 con un cavo da USB-A a B e che la stampante sia accesa.",
        "CHINESE": "检查天平是否使用 USB-A 到 B 电缆正确连接到 YDP30 打印机，以及打印机是否打开。",
        "JAPANESE": "天びんが USB-A to B ケーブルで YDP30 プリンタに正しく接続され、 プリンタの電源が入っていることを確認します。",
        "KOREAN": "USB-A-B 케이블을 사용하여 저울이 YDP30 프린터에 올바르게 연결되어 있고 프린터의 전원이 켜져 있는지 확인합니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
        "RUSSIAN": false,
