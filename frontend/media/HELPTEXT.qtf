      "TRANSLATIONS": {
        "ENGLISH": "Set preload",
        "GERMAN": "Setze Vorlast",
        "RUSSIAN": "Установите предварительную нагрузку",
        "FRENCH": "Régler la précharge",
        "SPANISH": "Ajustar la precarga",
        "ITALIAN": "Impostare il precarico",
        "CHINESE": "设置预紧力"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Установите предварительную нагрузку",
        "FRENCH": "Régler la précharge",
        "SPANISH": "Ajustar la precarga",
        "ITALIAN": "Impostare il precarico",
        "CHINESE": "设置预紧力"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
