      "TRANSLATIONS": {
        "ENGLISH": "Report of menu settings on Windows file server",
        "GERMAN": "Report der Menü-Einstellungen auf Windows File Server",
        "RUSSIAN": "Отчет о настройках меню на файловом сервере Windows",
        "FRENCH": "Rapport sur les paramètres des menus sur le serveur de fichiers Windows",
        "SPANISH": "Informe de la configuración del menú en el servidor de archivos de Windows",
        "ITALIAN": "Segnalazione delle impostazioni dei menu sul file server di Windows",
        "CHINESE": "报告 Windows 文件服务器上的菜单设置"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Отчет о настройках меню на файловом сервере Windows",
        "FRENCH": "Rapport sur les paramètres des menus sur le serveur de fichiers Windows",
        "SPANISH": "Informe de la configuración del menú en el servidor de archivos de Windows",
        "ITALIAN": "Segnalazione delle impostazioni dei menu sul file server di Windows",
        "CHINESE": "报告 Windows 文件服务器上的菜单设置"
      },
      "VERIFIED": {
