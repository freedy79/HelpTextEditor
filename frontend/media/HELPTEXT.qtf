    "EXAMPLE_AUTOM_CREATE_NETWORK_USER_CONF_STEP_5": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Thereafter, enter the password as stored in the network.",
        "GERMAN": "Geben Sie anschließend das Passwort ein, wie im Netzwerk hinterlegt.",
        "RUSSIAN": "После этого введите пароль, хранящийся в сети.",
        "FRENCH": "Ensuite, entrez le mot de passe tel qu'il est stocké dans le réseau.",
        "SPANISH": "A continuación, introduzca la contraseña almacenada en la red.",
        "ITALIAN": "In seguito, inserite la password come memorizzata nella rete.",
        "CHINESE": "然后，输入存储在网络中的密码。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "После этого введите пароль, хранящийся в сети.",
        "FRENCH": "Ensuite, entrez le mot de passe tel qu'il est stocké dans le réseau.",
        "SPANISH": "A continuación, introduzca la contraseña almacenada en la red.",
        "ITALIAN": "In seguito, inserite la password come memorizzata nella rete.",
        "CHINESE": "然后，输入存储在网络中的密码。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "EXAMPLE_AUTOM_CREATE_NETWORK_USER_CONF_STEP_6": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "After a successful login to the network, this user is created automatically in the balance, with the entered username and the predefined language as well as the predefined role.",
        "GERMAN": "Nach erfolgreicher Anmeldung im Netzwerk wird dieser Benutzer automatisch auf der Waage angelegt, mit dem eingegebenen Benutzernamen und der voreingestellten Sprache sowie der vorgegebenen Rolle.",
        "RUSSIAN": "После успешного входа в сеть этот пользователь автоматически создается в весах, с введенным именем пользователя и предопределенным языком, а также предопределенной ролью.",
        "FRENCH": "Après une connexion réussie au réseau, cet utilisateur est créé automatiquement dans la balance, avec le nom d'utilisateur saisi et la langue prédéfinie ainsi que le rôle prédéfini.",
        "SPANISH": "Tras un inicio de sesión exitoso en la red, este usuario se crea automáticamente en la balanza, con el nombre de usuario introducido y el idioma predefinido, así como el rol predefinido.",
        "ITALIAN": "Dopo un login di successo alla rete, questo utente viene creato automaticamente nella bilancia, con il nome utente inserito e la lingua predefinita così come il ruolo predefinito.",
        "CHINESE": "成功登录网络后，该用户将自动在余额中创建，并使用输入的用户名、预定义的语言和预定义的角色。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "После успешного входа в сеть этот пользователь автоматически создается в весах, с введенным именем пользователя и предопределенным языком, а также предопределенной ролью.",
        "FRENCH": "Après une connexion réussie au réseau, cet utilisateur est créé automatiquement dans la balance, avec le nom d'utilisateur saisi et la langue prédéfinie ainsi que le rôle prédéfini.",
        "SPANISH": "Tras un inicio de sesión exitoso en la red, este usuario se crea automáticamente en la balanza, con el nombre de usuario introducido y el idioma predefinido, así como el rol predefinido.",
        "ITALIAN": "Dopo un login di successo alla rete, questo utente viene creato automaticamente nella bilancia, con il nome utente inserito e la lingua predefinita così come il ruolo predefinito.",
        "CHINESE": "成功登录网络后，该用户将自动在余额中创建，并使用输入的用户名、预定义的语言和预定义的角色。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "EXAMPLE_AUTOM_CREATE_NETWORK_USER_CONF_STEP_7": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
