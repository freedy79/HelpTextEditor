    "EXAMPLE_CREATE_NETWORK_USER_CONF_STEP_2_D": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Enter the login name in exactly the same way as configured in the network e.g., [First name.Surname]. Additionally the input of the display name is necessary e.g. [Surname].",
        "GERMAN": "Geben Sie den Anmeldenamen genauso ein, wie im Netzwerk eingerichtet, z. B. [Vorname.Nachname]. Zusätzlich ist die Eingabe des Anzeigenamens nötig z. B. [Nachname].",
        "RUSSIAN": "Введите имя пользователя точно так же, как оно настроено в сети, например, [Имя.Фамилия].",
        "FRENCH": "Entrez le nom d'utilisateur exactement de la même manière que celui configuré dans le réseau, par exemple [Prénom.Nom].",
        "SPANISH": "Introduzca el nombre de usuario exactamente igual que el configurado en la red, por ejemplo, [Nombre.Apellido].",
        "ITALIAN": "Inserisci il nome utente esattamente come configurato nella rete, ad esempio, [Nome.Cognome].",
        "CHINESE": "输入与网络配置完全相同的登录名，例如 [名.姓]。此外，还需要输入显示名称，例如 [姓]。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Введите имя пользователя точно так же, как оно настроено в сети, например, [Имя.Фамилия].",
        "FRENCH": "Entrez le nom d'utilisateur exactement de la même manière que celui configuré dans le réseau, par exemple [Prénom.Nom].",
        "SPANISH": "Introduzca el nombre de usuario exactamente igual que el configurado en la red, por ejemplo, [Nombre.Apellido].",
        "ITALIAN": "Inserisci il nome utente esattamente come configurato nella rete, ad esempio, [Nome.Cognome].",
        "CHINESE": "输入与网络配置完全相同的登录名，例如 [名.姓]。此外，还需要输入显示名称，例如 [姓]。"
      },
