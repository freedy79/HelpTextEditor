      "TRANSLATIONS": {
        "ENGLISH": "Output of Display Values",
        "GERMAN": "Ausgabe von Anzeigewerten",
        "FRENCH": "Sortie des valeurs d'affichage",
        "RUSSIAN": "Вывод значений на дисплей",
        "SPANISH": "Salida de los valores de la pantalla",
        "ITALIAN": "Uscita dei valori di visualizzazione",
        "CHINESE": "输出显示值",
        "JAPANESE": "表示値の出力",
        "KOREAN": "디스플레이 값 출력"
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Sortie des valeurs d'affichage",
        "RUSSIAN": "Вывод значений на дисплей",
        "SPANISH": "Salida de los valores de la pantalla",
        "ITALIAN": "Uscita dei valori di visualizzazione",
        "CHINESE": "输出显示值",
        "JAPANESE": "表示値の出力",
        "KOREAN": "디스플레이 값 출력"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
        "RUSSIAN": false,
        "SPANISH": false,
