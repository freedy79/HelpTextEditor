    "DEVICE_MAINTENANCE_RESTORE_APPL_STEP_4": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Select the file that contains the backup you want to restore based on the file name.",
        "GERMAN": "Wählen Sie die Datei, die die gewünschte Sicherung zur Wiederherstellung enthält, anhand des Dateinamens aus.",
        "RUSSIAN": "Выберите файл, содержащий резервную копию, которую вы хотите восстановить, на основе имени файла.",
        "FRENCH": "Sélectionnez le fichier qui contient la sauvegarde que vous voulez restaurer en fonction du nom du fichier.",
        "SPANISH": "Seleccione el archivo que contiene la copia de seguridad que desea restaurar basándose en el nombre del archivo.",
        "ITALIAN": "Seleziona il file che contiene il backup che vuoi ripristinare in base al nome del file.",
        "CHINESE": "使用文件名选择包含所需恢复备份的文件。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Выберите файл, содержащий резервную копию, которую вы хотите восстановить, на основе имени файла.",
        "FRENCH": "Sélectionnez le fichier qui contient la sauvegarde que vous voulez restaurer en fonction du nom du fichier.",
        "SPANISH": "Seleccione el archivo que contiene la copia de seguridad que desea restaurar basándose en el nombre del archivo.",
        "ITALIAN": "Seleziona il file che contiene il backup che vuoi ripristinare in base al nome del file.",
        "CHINESE": "使用文件名选择包含所需恢复备份的文件。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "DEVICE_MAINTENANCE_RESTORE_APPL_STEP_5": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The device loads the recovery file and transfers the data to the system. The device is then restarted. After the restart, the balance can be used with the restored data.",
        "GERMAN": "Das Gerät lädt die Wiederherstellungsdatei und überträgt die Daten in das System. Das Gerät wird anschließend neu gestartet. Nach dem Neustart kann die Waage mit den wiederhergestellten Daten genutzt werden.",
        "RUSSIAN": "Устройство загружает файл восстановления и передает данные в систему. Затем устройство перезапускается. После перезапуска весы можно использовать с восстановленными данными.",
        "FRENCH": "L'appareil charge le fichier de récupération et transfère les données au système. L'appareil est ensuite redémarré. Après le redémarrage, la balance peut être utilisée avec les données restaurées.",
        "SPANISH": "El dispositivo carga el archivo de recuperación y transfiere los datos al sistema. A continuación, el dispositivo se reinicia. Tras el reinicio, la balanza puede utilizarse con los datos restaurados.",
        "ITALIAN": "Il dispositivo carica il file di recupero e trasferisce i dati al sistema. Il dispositivo viene quindi riavviato. Dopo il riavvio, la bilancia può essere utilizzata con i dati ripristinati.",
        "CHINESE": "设备加载恢复文件并将数据传输到系统。然后重新启动设备。重新启动后，刻度尺就可以使用恢复的数据了。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Устройство загружает файл восстановления и передает данные в систему. Затем устройство перезапускается. После перезапуска весы можно использовать с восстановленными данными.",
        "FRENCH": "L'appareil charge le fichier de récupération et transfère les données au système. L'appareil est ensuite redémarré. Après le redémarrage, la balance peut être utilisée avec les données restaurées.",
        "SPANISH": "El dispositivo carga el archivo de recuperación y transfiere los datos al sistema. A continuación, el dispositivo se reinicia. Tras el reinicio, la balanza puede utilizarse con los datos restaurados.",
        "ITALIAN": "Il dispositivo carica il file di recupero e trasferisce i dati al sistema. Il dispositivo viene quindi riavviato. Dopo il riavvio, la bilancia può essere utilizzata con i dati ripristinati.",
        "CHINESE": "设备加载恢复文件并将数据传输到系统。然后重新启动设备。重新启动后，刻度尺就可以使用恢复的数据了。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "DEVICE_MAINTENANCE_RESTORE_INSTRUCTION_2": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "In service mode (logging in as a service), the data storage and audit trail are also restored to the status of the backup. This mode is used exclusively for recovery after a repair.",
        "GERMAN": "Im Service-Modus (Anmeldung als Service) werden auch Datenspeicher und Audit Trail auf den Stand der Sicherung zurückgespeichert. Dieser Betrieb dient ausschließlich der Wiederherstellung nach einer Reparatur.",
        "RUSSIAN": "В сервисном режиме (вход в систему как сервис) хранилище данных и журнал аудита также восстанавливаются до состояния резервной копии. Этот режим используется исключительно для восстановления после ремонта.",
        "FRENCH": "En mode service (connexion en tant que service), le stockage des données et la piste d'audit sont également restaurés à l'état de la sauvegarde. Ce mode est utilisé exclusivement pour la récupération après une réparation.",
        "SPANISH": "En el modo de servicio (inicio de sesión como servicio), el almacenamiento de datos y la pista de auditoría también se restauran al estado de la copia de seguridad. Este modo se utiliza exclusivamente para la recuperación después de una reparación.",
        "ITALIAN": "Nella modalità di servizio (accesso come servizio), anche la memorizzazione dei dati e la traccia di controllo sono ripristinate allo stato del backup. Questa modalità viene utilizzata esclusivamente per il ripristino dopo una riparazione.",
        "CHINESE": "在服务模式下（以服务身份登录），数据存储器和审计跟踪也会恢复到备份状态。该模式专门用于修复后的恢复。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "В сервисном режиме (вход в систему как сервис) хранилище данных и журнал аудита также восстанавливаются до состояния резервной копии. Этот режим используется исключительно для восстановления после ремонта.",
        "FRENCH": "En mode service (connexion en tant que service), le stockage des données et la piste d'audit sont également restaurés à l'état de la sauvegarde. Ce mode est utilisé exclusivement pour la récupération après une réparation.",
        "SPANISH": "En el modo de servicio (inicio de sesión como servicio), el almacenamiento de datos y la pista de auditoría también se restauran al estado de la copia de seguridad. Este modo se utiliza exclusivamente para la recuperación después de una reparación.",
        "ITALIAN": "Nella modalità di servizio (accesso come servizio), anche la memorizzazione dei dati e la traccia di controllo sono ripristinate allo stato del backup. Questa modalità viene utilizzata esclusivamente per il ripristino dopo una riparazione.",
        "CHINESE": "在服务模式下（以服务身份登录），数据存储器和审计跟踪也会恢复到备份状态。该模式专门用于修复后的恢复。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
