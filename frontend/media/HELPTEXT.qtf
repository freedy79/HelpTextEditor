    "ISOCAL_EXEC_MODE_TITLE": {
      "group": "HELP_TITLE",
      "topic": "HELPTEXT",
      "comment": "Do not translate isoCAL.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "isoCAL execution mode",
        "GERMAN": "isoCAL Ausführungsmodus",
        "RUSSIAN": "Режим выполнения isoCAL",
        "FRENCH": "Mode d'exécution d'isoCAL",
        "SPANISH": "Modo de ejecución de isoCAL",
        "ITALIAN": "modalità di esecuzione isoCAL",
        "CHINESE": "isoCAL 执行模式"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Режим выполнения isoCAL",
        "FRENCH": "Mode d'exécution d'isoCAL",
        "SPANISH": "Modo de ejecución de isoCAL",
        "ITALIAN": "modalità di esecuzione isoCAL",
        "CHINESE": "isoCAL 执行模式"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "ISOCAL_EXEC_MODE_INSTRUCTION_1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "Do not translate isoCAL.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The isoCAL function is a fully automatic internal adjustment function of the balance, which is carried out after certain time intervals or temperature changes, as well as after a successful leveling.",
        "GERMAN": "Die isoCAL Funktion ist eine vollautomatische interne Justierfunktion der Waage, die nach bestimmten Zeitintervallen oder Temperaturänderungen sowie nach einer erfolgreichen Nivellierung ausgeführt wird.",
        "RUSSIAN": "Функция isoCAL - это полностью автоматическая функция внутренней настройки весов, которая выполняется после определенных временных интервалов или изменения температуры, а также после успешного нивелирования.",
        "FRENCH": "La fonction isoCAL est une fonction d'ajustement interne entièrement automatique de la balance, qui s'effectue après certains intervalles de temps ou changements de température, ainsi qu'après une mise à niveau réussie.",
        "SPANISH": "La función isoCAL es una función de ajuste interno de la balanza totalmente automática, que se lleva a cabo después de determinados intervalos de tiempo o cambios de temperatura, así como después de una nivelación exitosa.",
        "ITALIAN": "La funzione isoCAL è una funzione di regolazione interna della bilancia completamente automatica, che viene eseguita dopo determinati intervalli di tempo o cambiamenti di temperatura, così come dopo un livellamento riuscito.",
        "CHINESE": "isoCAL功能是天平的一种全自动内部调整功能，在一定的时间间隔或温度变化后，以及在成功调平后都会进行调整。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Функция isoCAL - это полностью автоматическая функция внутренней настройки весов, которая выполняется после определенных временных интервалов или изменения температуры, а также после успешного нивелирования.",
        "FRENCH": "La fonction isoCAL est une fonction d'ajustement interne entièrement automatique de la balance, qui s'effectue après certains intervalles de temps ou changements de température, ainsi qu'après une mise à niveau réussie.",
        "SPANISH": "La función isoCAL es una función de ajuste interno de la balanza totalmente automática, que se lleva a cabo después de determinados intervalos de tiempo o cambios de temperatura, así como después de una nivelación exitosa.",
        "ITALIAN": "La funzione isoCAL è una funzione di regolazione interna della bilancia completamente automatica, che viene eseguita dopo determinati intervalli di tempo o cambiamenti di temperatura, così come dopo un livellamento riuscito.",
        "CHINESE": "isoCAL功能是天平的一种全自动内部调整功能，在一定的时间间隔或温度变化后，以及在成功调平后都会进行调整。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "ISOCAL_EXEC_MODE_INSTRUCTION_2": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "Do not translate isoCAL.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The execution mode of the isoCAL function can be set depending upon the requirement.",
        "GERMAN": "Der Ausführungsmodus der isoCAL Funktion kann je nach Anforderung eingestellt werden.",
        "RUSSIAN": "Режим выполнения функции isoCAL может быть установлен в зависимости от требований.",
        "FRENCH": "Le mode d'exécution de la fonction isoCAL peut être défini en fonction des besoins.",
        "SPANISH": "El modo de ejecución de la función isoCAL puede establecerse en función de las necesidades.",
        "ITALIAN": "La modalità di esecuzione della funzione isoCAL può essere impostata a seconda delle esigenze.",
        "CHINESE": "可以根据需要设置等价换算功能的执行模式。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Режим выполнения функции isoCAL может быть установлен в зависимости от требований.",
        "FRENCH": "Le mode d'exécution de la fonction isoCAL peut être défini en fonction des besoins.",
        "SPANISH": "El modo de ejecución de la función isoCAL puede establecerse en función de las necesidades.",
        "ITALIAN": "La modalità di esecuzione della funzione isoCAL può essere impostata a seconda delle esigenze.",
        "CHINESE": "可以根据需要设置等价换算功能的执行模式。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "ISOCAL_EXEC_MODE_INSTRUCTION_2_STEP_1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "Do not translate HTML command <b> and </b>. Do not translate isoCAL.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "<b>Off:</b> The isoCAL function is deactivated. Depending upon the national legislation, this setting is not possible in conformity-evaluated (calibrated) balances or else the balance may only be operated in a restricted temperature range.",
        "GERMAN": "<b>Aus:</b> Die isoCAL Funktion ist deaktiviert. Abhängig von nationalen Gesetzgebungen ist bei konformitätsbewerteten (geeichten) Waagen diese Einstellung nicht möglich oder die Waage darf nur in einem eingeschränkten Temperaturbereich betrieben werden.",
        "RUSSIAN": "<b>Выкл.:</b> Функция isoCAL деактивирована. В зависимости от национального законодательства, эта настройка невозможна для весов, прошедших оценку соответствия (калибровку), иначе весы могут эксплуатироваться только в ограниченном диапазоне температур.",
        "FRENCH": "<b>Off:</b> La fonction isoCAL est désactivée. Selon la législation nationale, ce réglage n'est pas possible sur les balances évaluées en conformité (étalonnées) ou alors la balance ne peut être utilisée que dans une plage de température restreinte.",
        "SPANISH": "<b>Off:</b> La función isoCAL está desactivada. Dependiendo de la legislación nacional, este ajuste no es posible en las balanzas evaluadas de conformidad (calibradas) o bien la balanza sólo puede funcionar en un rango de temperatura restringido.",
        "ITALIAN": "<b>Off:</b> La funzione isoCAL è disattivata. A seconda della legislazione nazionale, questa impostazione non è possibile nelle bilance valutate in conformità (calibrate), oppure la bilancia può essere utilizzata solo in un campo di temperatura limitato.",
        "CHINESE": "<b>Off（关闭）：</b> isoCAL（等标定）功能被禁用。根据不同的国家法律，在合格评定（校准）天平中不能进行此设置，否则天平只能在限定的温度范围内运行。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "<b>Выкл.:</b> Функция isoCAL деактивирована. В зависимости от национального законодательства, эта настройка невозможна для весов, прошедших оценку соответствия (калибровку), иначе весы могут эксплуатироваться только в ограниченном диапазоне температур.",
        "FRENCH": "<b>Off:</b> La fonction isoCAL est désactivée. Selon la législation nationale, ce réglage n'est pas possible sur les balances évaluées en conformité (étalonnées) ou alors la balance ne peut être utilisée que dans une plage de température restreinte.",
        "SPANISH": "<b>Off:</b> La función isoCAL está desactivada. Dependiendo de la legislación nacional, este ajuste no es posible en las balanzas evaluadas de conformidad (calibradas) o bien la balanza sólo puede funcionar en un rango de temperatura restringido.",
        "ITALIAN": "<b>Off:</b> La funzione isoCAL è disattivata. A seconda della legislazione nazionale, questa impostazione non è possibile nelle bilance valutate in conformità (calibrate), oppure la bilancia può essere utilizzata solo in un campo di temperatura limitato.",
        "CHINESE": "<b>Off（关闭）：</b> isoCAL（等标定）功能被禁用。根据不同的国家法律，在合格评定（校准）天平中不能进行此设置，否则天平只能在限定的温度范围内运行。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "ISOCAL_EXEC_MODE_INSTRUCTION_2_STEP_2": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ]. Do not translate HTML command <b> and </b>. Do not translate isoCAL.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "<b>Display status field, manual start:</b> The flashing [isoCAL] button displays the adjustment request based on time, temperature or leveling. The isoCAL function must be started manually by using this button.",
        "GERMAN": "<b>Statusfeld anzeigen, manueller Start:</b> Die Justieranforderung auf Grund von Zeit, Temperatur oder Nivellierung wird durch die blinkende Schaltfläche [isoCAL] angezeigt. Die isoCAL Funktion muss manuell über diese Schaltfläche gestartet werden.",
        "RUSSIAN": "<b>Показ состояния, ручной запуск:</b> Мигающая кнопка [isoCAL] отображает запрос на настройку на основе времени, температуры или нивелирования. Функция isoCAL должна быть запущена вручную с помощью этой кнопки.",
        "FRENCH": "<b>Afficher le champ d'état, démarrage manuel :</b> Le bouton [isoCAL] clignotant affiche la demande de réglage en fonction de l'heure, de la température ou du nivellement. La fonction isoCAL doit être lancée manuellement à l'aide de ce bouton.",
        "SPANISH": "<b>Mostrar campo de estado, inicio manual:</b> El botón [isoCAL] parpadeante muestra la solicitud de ajuste basada en la hora, la temperatura o la nivelación. La función isoCAL debe iniciarse manualmente mediante este botón.",
        "ITALIAN": "<b>Mostra campo di stato, avvio manuale:</b> Il pulsante [isoCAL] lampeggiante visualizza la richiesta di regolazione in base a tempo, temperatura o livellamento. La funzione isoCAL deve essere avviata manualmente utilizzando questo pulsante.",
        "CHINESE": "<b>显示状态栏，手动启动：</b>闪烁的 [isoCAL] 按钮显示基于时间、温度或水平的调节要求。必须使用此按钮手动启动等标定功能。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "<b>Показ состояния, ручной запуск:</b> Мигающая кнопка [isoCAL] отображает запрос на настройку на основе времени, температуры или нивелирования. Функция isoCAL должна быть запущена вручную с помощью этой кнопки.",
        "FRENCH": "<b>Afficher le champ d'état, démarrage manuel :</b> Le bouton [isoCAL] clignotant affiche la demande de réglage en fonction de l'heure, de la température ou du nivellement. La fonction isoCAL doit être lancée manuellement à l'aide de ce bouton.",
        "SPANISH": "<b>Mostrar campo de estado, inicio manual:</b> El botón [isoCAL] parpadeante muestra la solicitud de ajuste basada en la hora, la temperatura o la nivelación. La función isoCAL debe iniciarse manualmente mediante este botón.",
        "ITALIAN": "<b>Mostra campo di stato, avvio manuale:</b> Il pulsante [isoCAL] lampeggiante visualizza la richiesta di regolazione in base a tempo, temperatura o livellamento. La funzione isoCAL deve essere avviata manualmente utilizzando questo pulsante.",
        "CHINESE": "<b>显示状态栏，手动启动：</b>闪烁的 [isoCAL] 按钮显示基于时间、温度或水平的调节要求。必须使用此按钮手动启动等标定功能。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "ISOCAL_EXEC_MODE_INSTRUCTION_2_STEP_3": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "Do not translate HTML command <b> and </b>. Do not translate isoCAL.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "<b>On, automatic execution:</b> The isoCAL function is started automatically if the adjustment request based on time, temperature or leveling is present and specific preconditions are fulfilled. (Default setting)",
        "GERMAN": "<b>Ein, automatische Ausführung:</b> Die isoCAL Funktion wird automatisch gestartet, wenn die Justieranforderung aufgrund von Zeit, Temperatur oder Nivellierung vorliegt und bestimmte Voraussetzungen erfüllt sind. (Voreinstellung)",
        "RUSSIAN": "<b>Вкл, автоматическое выполнение:</b> Функция isoCAL запускается автоматически при наличии запроса на регулировку по времени, температуре или нивелированию и выполнении определенных предварительных условий. (Настройка по умолчанию)",
        "FRENCH": "<b>On, exécution automatique:</b> La fonction isoCAL est lancée automatiquement si la demande de réglage basée sur le temps, la température ou le nivellement est présente et que des conditions préalables spécifiques sont remplies. (Réglage par défaut)",
        "SPANISH": "<b>Activado, ejecución automática:</b> La función isoCAL se inicia automáticamente si la solicitud de ajuste basada en el tiempo, la temperatura o la nivelación está presente y se cumplen las condiciones previas específicas. (Ajuste por defecto)",
        "ITALIAN": "<b>On, esecuzione automatica:</b> La funzione isoCAL viene avviata automaticamente se la richiesta di regolazione basata su tempo, temperatura o livellamento è presente e sono soddisfatte specifiche precondizioni. (Impostazione predefinita)",
        "CHINESE": "<b>开启，自动执行：</b>如果存在基于时间、温度或水平的调节请求，并且满足特定的先决条件，则等标定功能自动启动。(默认设置）"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "<b>Вкл, автоматическое выполнение:</b> Функция isoCAL запускается автоматически при наличии запроса на регулировку по времени, температуре или нивелированию и выполнении определенных предварительных условий. (Настройка по умолчанию)",
        "FRENCH": "<b>On, exécution automatique:</b> La fonction isoCAL est lancée automatiquement si la demande de réglage basée sur le temps, la température ou le nivellement est présente et que des conditions préalables spécifiques sont remplies. (Réglage par défaut)",
        "SPANISH": "<b>Activado, ejecución automática:</b> La función isoCAL se inicia automáticamente si la solicitud de ajuste basada en el tiempo, la temperatura o la nivelación está presente y se cumplen las condiciones previas específicas. (Ajuste por defecto)",
        "ITALIAN": "<b>On, esecuzione automatica:</b> La funzione isoCAL viene avviata automaticamente se la richiesta di regolazione basata su tempo, temperatura o livellamento è presente e sono soddisfatte specifiche precondizioni. (Impostazione predefinita)",
        "CHINESE": "<b>开启，自动执行：</b>如果存在基于时间、温度或水平的调节请求，并且满足特定的先决条件，则等标定功能自动启动。(默认设置）"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "ISOCAL_EXEC_MODE_INSTRUCTION_3": {
      "group": "HELP_INSTRUCTION",
