    "TCA_EXAMPLE_AUTO_BACKUP_CONF_STEP_2_E": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Enter the network path for Host and Share, making sure that you use the correct spelling //Host Name/Share Name.",
        "GERMAN": "Geben Sie den Netzwerkpfad für Host und Share ein, achten Sie auf die richtige Schreibweise //Host Name/Share Name.",
        "RUSSIAN": "Введите сетевой путь для Host и Share, убедившись, что вы используете правильное написание //Host Name/Share Name.",
        "FRENCH": "Saisissez le chemin d'accès réseau pour l'hôte et le partage, en veillant à utiliser l'orthographe correcte /Nom de l'hôte/Nom du partage.",
        "SPANISH": "Introduzca la ruta de red para el host y el recurso compartido, asegurándose de utilizar la ortografía correcta //Nombre del host/Nombre del recurso compartido.",
        "ITALIAN": "Inserisci il percorso di rete per Host e Share, assicurandoti di usare l'ortografia corretta //Host Name/Share Name.",
        "CHINESE": "输入主机和共享的网络路径，确保拼写正确 //Host Name/Share Name。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Введите сетевой путь для Host и Share, убедившись, что вы используете правильное написание //Host Name/Share Name.",
        "FRENCH": "Saisissez le chemin d'accès réseau pour l'hôte et le partage, en veillant à utiliser l'orthographe correcte /Nom de l'hôte/Nom du partage.",
        "SPANISH": "Introduzca la ruta de red para el host y el recurso compartido, asegurándose de utilizar la ortografía correcta //Nombre del host/Nombre del recurso compartido.",
        "ITALIAN": "Inserisci il percorso di rete per Host e Share, assicurandoti di usare l'ortografia corretta //Host Name/Share Name.",
        "CHINESE": "输入主机和共享的网络路径，确保拼写正确 //Host Name/Share Name。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "TCA_EXAMPLE_AUTO_BACKUP_CONF_STEP_2_F": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Enter the name of a sub-directory on the server, in which to save the files.",
        "GERMAN": "Für die Ablage der Dateien können Sie ein Unterverzeichnis auf dem Server angeben.",
        "RUSSIAN": "Введите имя подкаталога на сервере, в котором будут сохранены файлы.",
        "FRENCH": "Entrez le nom d'un sous-répertoire sur le serveur, dans lequel enregistrer les fichiers.",
        "SPANISH": "Introduzca el nombre de un subdirectorio en el servidor, en el que guardar los archivos.",
