      "TRANSLATIONS": {
        "GERMAN": "Systemzertifikate und anschließend Gerätezertifikate auswählen",
        "ENGLISH": "Select System Certificates and Device Certificates",
        "FRENCH": "Sélectionnez Device Certificates",
        "CHINESE": "选择系统证书，然后选择设备证书",
        "ITALIAN": "Selezionare i certificati di sistema e poi i certificati del dispositivo",
        "SPANISH": "Seleccione Certificados de sistema y Certificados de dispositivo",
        "RUSSIAN": "Выберите Сертификаты системы и Сертификаты устройства"
      },
      "AUTOTRANSLATIONS": {
