      "TRANSLATIONS": {
        "ENGLISH": "Using the buttons, it is now possible for you to [Deactivate]/[Activate] this user, to set the [Password], to [Delete] the user or to [Edit] the settings.",
        "GERMAN": "Sie haben jetzt die Möglichkeit über Schaltflächen diesen Benutzer, zu [Deaktivieren]/[Aktivieren], das [Passwort] zu setzen, den Benutzer zu [löschen] oder die Einstellungen zu [ändern].",
        "RUSSIAN": "С помощью кнопок теперь можно [Деактивировать]/[Активировать] этого пользователя, установить [Пароль], [Удалить] пользователя или [Редактировать] настройки.",
        "FRENCH": "À l'aide des boutons, il vous est maintenant possible de [Désactiver]/[Activer] cet utilisateur, de définir le [Mot de passe], de [Supprimer] l'utilisateur ou de [Modifier] les paramètres.",
        "SPANISH": "A través de los botones, ahora es posible [Desactivar]/[Activar] este usuario, establecer la [Contraseña], [Borrar] el usuario o [Editar] la configuración.",
        "ITALIAN": "Usando i pulsanti, è ora possibile [Disattivare]/[Attivare] questo utente, impostare la [Password], [Cancellare] l'utente o [Modificare] le impostazioni.",
        "CHINESE": "现在您可以使用这些按钮来 [停用]/[激活]该用户、设置 [密码]、[删除] 用户或 [编辑] 设置。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "С помощью кнопок теперь можно [Деактивировать]/[Активировать] этого пользователя, установить [Пароль], [Удалить] пользователя или [Редактировать] настройки.",
        "FRENCH": "À l'aide des boutons, il vous est maintenant possible de [Désactiver]/[Activer] cet utilisateur, de définir le [Mot de passe], de [Supprimer] l'utilisateur ou de [Modifier] les paramètres.",
        "SPANISH": "A través de los botones, ahora es posible [Desactivar]/[Activar] este usuario, establecer la [Contraseña], [Borrar] el usuario o [Editar] la configuración.",
        "ITALIAN": "Usando i pulsanti, è ora possibile [Disattivare]/[Attivare] questo utente, impostare la [Password], [Cancellare] l'utente o [Modificare] le impostazioni.",
        "CHINESE": "现在您可以使用这些按钮来 [停用]/[激活]该用户、设置 [密码]、[删除] 用户或 [编辑] 设置。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "EXAMPLE_CREATE_LOCAL_USER_CONF_STEP_2_J": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Exit the menu and log out from the main menu by using the [User logout] button.",
        "GERMAN": "Verlassen Sie das Menü und melden Sie sich über die Schaltfläche [Benutzer abmelden] aus dem Hauptmenü ab.",
        "RUSSIAN": "Выйдите из меню и выйдите из главного меню с помощью кнопки [Выход пользователя].",
        "FRENCH": "Quittez le menu et déconnectez-vous du menu principal à l'aide du bouton [Déconnexion utilisateur].",
        "SPANISH": "Salga del menú y cierre la sesión en el menú principal utilizando el botón [User logout].",
        "ITALIAN": "Esci dal menu e fai il logout dal menu principale usando il pulsante [User logout].",
        "CHINESE": "使用 [用户注销] 按钮退出菜单并从主菜单注销。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Выйдите из меню и выйдите из главного меню с помощью кнопки [Выход пользователя].",
        "FRENCH": "Quittez le menu et déconnectez-vous du menu principal à l'aide du bouton [Déconnexion utilisateur].",
        "SPANISH": "Salga del menú y cierre la sesión en el menú principal utilizando el botón [User logout].",
        "ITALIAN": "Esci dal menu e fai il logout dal menu principale usando il pulsante [User logout].",
        "CHINESE": "使用 [用户注销] 按钮退出菜单并从主菜单注销。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
