    "TASK_CONCEPT_QAPP_CENTER_UPDATE_TITLE": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "TRANSLATIONS": {
        "GERMAN": "QAPP-Center aktualisieren",
        "ENGLISH": "",
        "FRENCH": "",
        "CHINESE": "",
