    "EXAMPLE_WITH_DEFAULT_PROFILE_APPL_STEP_1": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Start the task e.g., [My weighing in safety cabinet] with the assigned [Weighing in safety cabinet] weighing profile.",
        "GERMAN": "Starten Sie die Task z. B. [Mein Wägen in Sicherheitswerkbank] mit dem darin zugewiesenen Wägenprofil [Wägen in Sicherheitswerkbank].",
        "RUSSIAN": "Запустите задачу, например, [Мое взвешивание в шкафу безопасности] с установленным профилем взвешивания [Взвешивание в шкафу безопасности].",
        "FRENCH": "Lancez la tâche, par exemple, [Ma pesée dans une enceinte de sécurité] avec le profil de pesée attribué [Pesée dans une enceinte de sécurité].",
        "SPANISH": "Inicie la tarea, por ejemplo, [Mi pesaje en cabina de seguridad] con el perfil de pesaje asignado [Pesaje en cabina de seguridad].",
        "ITALIAN": "Avviare l'ordine per es. [La mia pesatura nell'armadio di sicurezza] con il profilo di pesatura assegnato [Pesatura nell'armadio di sicurezza].",
        "CHINESE": "使用指定的[在安全柜中称重]称重配置启动任务，例如[我在安全柜中称重]。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Запустите задачу, например, [Мое взвешивание в шкафу безопасности] с установленным профилем взвешивания [Взвешивание в шкафу безопасности].",
        "FRENCH": "Lancez la tâche, par exemple, [Ma pesée dans une enceinte de sécurité] avec le profil de pesée attribué [Pesée dans une enceinte de sécurité].",
        "SPANISH": "Inicie la tarea, por ejemplo, [Mi pesaje en cabina de seguridad] con el perfil de pesaje asignado [Pesaje en cabina de seguridad].",
        "ITALIAN": "Avviare l'ordine per es. [La mia pesatura nell'armadio di sicurezza] con il profilo di pesatura assegnato [Pesatura nell'armadio di sicurezza].",
        "CHINESE": "使用指定的[在安全柜中称重]称重配置启动任务，例如[我在安全柜中称重]。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "EXAMPLE_WITH_DEFAULT_PROFILE_APPL_STEP_2": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "If you have selected identifiers for the batch, these must now be entered or scanned.",
        "GERMAN": "Falls Sie Bezeichner für die Charge gewählt haben, müssen diese jetzt eingegeben oder eingescannt werden.",
        "RUSSIAN": "Если вы выбрали идентификаторы для партии, их необходимо ввести или отсканировать.",
        "FRENCH": "Si vous avez sélectionné des identifiants pour le lot, ceux-ci doivent maintenant être saisis ou scannés.",
        "SPANISH": "Si ha seleccionado identificadores para el lote, estos deben ser introducidos o escaneados.",
        "ITALIAN": "Se avete selezionato degli identificatori per il lotto, questi devono ora essere inseriti o scannerizzati.",
        "CHINESE": "如果您为批次选择了标识符，现在必须输入或扫描这些标识符。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Если вы выбрали идентификаторы для партии, их необходимо ввести или отсканировать.",
        "FRENCH": "Si vous avez sélectionné des identifiants pour le lot, ceux-ci doivent maintenant être saisis ou scannés.",
        "SPANISH": "Si ha seleccionado identificadores para el lote, estos deben ser introducidos o escaneados.",
        "ITALIAN": "Se avete selezionato degli identificatori per il lotto, questi devono ora essere inseriti o scannerizzati.",
        "CHINESE": "如果您为批次选择了标识符，现在必须输入或扫描这些标识符。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "EXAMPLE_WITH_DEFAULT_PROFILE_APPL_STEP_3": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The [Weighing] application is then activated with the settings defined in the weighing profile and thus with adapted weighing behavior.",
        "GERMAN": "Anschließend erfolgt die Aktivierung der Anwendung [Wägen] mit den im Wägeprofil festgelegten Einstellungen und damit angepasstem Wägeverhalten.",
        "RUSSIAN": "Затем активируется приложение [Взвешивание] с настройками, определенными в профиле взвешивания, и, таким образом, с адаптированным поведением взвешивания.",
        "FRENCH": "L'application [Pesage] est alors activée avec les paramètres définis dans le profil de pesage et donc avec un comportement de pesage adapté.",
        "SPANISH": "La aplicación [Pesaje] se activa entonces con los ajustes definidos en el perfil de pesaje y, por tanto, con un comportamiento de pesaje adaptado.",
        "ITALIAN": "L'applicazione [Pesatura] viene quindi attivata con le impostazioni definite nel profilo di pesatura e quindi con un comportamento di pesatura adattato.",
        "CHINESE": "然后，[称重] 应用程序将根据称重配置文件中定义的设置激活，从而调整称重操作。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Затем активируется приложение [Взвешивание] с настройками, определенными в профиле взвешивания, и, таким образом, с адаптированным поведением взвешивания.",
        "FRENCH": "L'application [Pesage] est alors activée avec les paramètres définis dans le profil de pesage et donc avec un comportement de pesage adapté.",
        "SPANISH": "La aplicación [Pesaje] se activa entonces con los ajustes definidos en el perfil de pesaje y, por tanto, con un comportamiento de pesaje adaptado.",
        "ITALIAN": "L'applicazione [Pesatura] viene quindi attivata con le impostazioni definite nel profilo di pesatura e quindi con un comportamento di pesatura adattato.",
        "CHINESE": "然后，[称重] 应用程序将根据称重配置文件中定义的设置激活，从而调整称重操作。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
