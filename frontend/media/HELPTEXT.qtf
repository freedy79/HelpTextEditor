      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "<b>Fast: </b> Criterion for stability is low, the standstill is displayed fast.",
        "GERMAN": "<b>Schnell: </b> Kriterium für die Stabilität niedrig, der Stillstand wird schnell angezeigt.",
        "RUSSIAN": "<b>Быстро: </b> Критерий стабильности низкий, остановка отображается быстро.",
        "FRENCH": "<b>Rapide : </b> Le critère de stabilité est faible, l'arrêt est affiché rapidement.",
        "SPANISH": "<b>Rápido: </b> El criterio de estabilidad es bajo, la parada se muestra rápida.",
        "ITALIAN": "<b>Veloce: </b> Il criterio di stabilità è basso, lo standstill viene visualizzato velocemente.",
        "CHINESE": "<b>快速：</b>稳定性标准较低，静止显示较快。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "<b>Быстро: </b> Критерий стабильности низкий, остановка отображается быстро.",
        "FRENCH": "<b>Rapide : </b> Le critère de stabilité est faible, l'arrêt est affiché rapidement.",
        "SPANISH": "<b>Rápido: </b> El criterio de estabilidad es bajo, la parada se muestra rápida.",
        "ITALIAN": "<b>Veloce: </b> Il criterio di stabilità è basso, lo standstill viene visualizzato velocemente.",
        "CHINESE": "<b>快速：</b>稳定性标准较低，静止显示较快。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
