    "WEIGHING_PROFILE_OVERVIEW_INSTRUCTION_1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The differences from the profile [Default weighing] are highlighted in bold. Depending upon the model, the specified units are [mg] and [g] or [g] and [mg].",
        "GERMAN": "Die Unterschiede zum Profil [Standard Wägen] sind fett markiert. Je nach Modell sind die vorgegebenen Einheiten [mg] und [g] oder [g] und [mg].",
        "RUSSIAN": "Отличия от профиля [Взвешивание по умолчанию] выделены жирным шрифтом. В зависимости от модели, указанными единицами являются [мг] и [г] или [г] и [мг].",
        "FRENCH": "Les différences par rapport au profil [Pesée par défaut] sont mises en évidence en gras. Selon le modèle, les unités spécifiées sont [mg] et [g] ou [g] et [mg].",
        "SPANISH": "Las diferencias con el perfil [Pesaje por defecto] se destacan en negrita. Dependiendo del modelo, las unidades especificadas son [mg] y [g] o [g] y [mg].",
        "ITALIAN": "Le differenze rispetto al profilo [Pesata di default] sono evidenziate in grassetto. A seconda del modello, le unità specificate sono [mg] e [g] o [g] e [mg].",
        "CHINESE": "与[默认称量]配置文件的不同之处以粗体标出。根据型号的不同，指定单位为 [mg] 和 [g] 或 [g] 和 [mg]。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Отличия от профиля [Взвешивание по умолчанию] выделены жирным шрифтом. В зависимости от модели, указанными единицами являются [мг] и [г] или [г] и [мг].",
        "FRENCH": "Les différences par rapport au profil [Pesée par défaut] sont mises en évidence en gras. Selon le modèle, les unités spécifiées sont [mg] et [g] ou [g] et [mg].",
        "SPANISH": "Las diferencias con el perfil [Pesaje por defecto] se destacan en negrita. Dependiendo del modelo, las unidades especificadas son [mg] y [g] o [g] y [mg].",
        "ITALIAN": "Le differenze rispetto al profilo [Pesata di default] sono evidenziate in grassetto. A seconda del modello, le unità specificate sono [mg] e [g] o [g] e [mg].",
        "CHINESE": "与[默认称量]配置文件的不同之处以粗体标出。根据型号的不同，指定单位为 [mg] 和 [g] 或 [g] 和 [mg]。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
