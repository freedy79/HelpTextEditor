      "TRANSLATIONS": {
        "ENGLISH": "Interfaces and Protocols",
        "GERMAN": "Schnittstellen und Protokolle",
        "FRENCH": "Interfaces et protocoles",
        "RUSSIAN": "Интерфейсы и протоколы",
        "SPANISH": "Interfaces y protocolos",
        "ITALIAN": "Interfacce e protocolli",
        "CHINESE": "接口和协议",
        "JAPANESE": "インターフェイスとプロトコル",
        "KOREAN": "인터페이스 및 프로토콜"
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Interfaces et protocoles",
        "RUSSIAN": "Интерфейсы и протоколы",
        "SPANISH": "Interfaces y protocolos",
        "ITALIAN": "Interfacce e protocolli",
        "CHINESE": "接口和协议",
        "JAPANESE": "インターフェイスとプロトコル",
        "KOREAN": "인터페이스 및 프로토콜"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
