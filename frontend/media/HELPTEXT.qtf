        "RUSSIAN": false,
        "ITALIAN": false
      }
    },
    "DEVICE_CLEANING_APPLICATION_EXAMPLE_2_INSTRUCTION_1": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Basic cleaning after a use is useful when the balance is used by different users with substances that make cleaning essential. In this example, the notification to the user is activated so that the user is reminded of the cleaning after logging off.",
        "GERMAN": "Die normale Reinigung nach einer Benutzung ist dann sinnvoll, wenn die Waage von unterschiedlichen Benutzern mit Substanzen verwendet wird, die eine Reinigung unerlässlich machen. In diesem Beispiel wird die Benachrichtigung an den Benutzer aktiviert, damit dieser nach seiner Abmeldung an die Reinigung erinnert wird.",
        "CHINESE": "当天平被不同的用户使用时，使用后的基本清洁非常有用，因为使用的物质会使清洁变得非常必要。在本示例中，用户通知被激活，以便在注销后提醒用户进行清洁。",
        "FRENCH": "Le nettoyage normal après une utilisation est utile lorsque la balance est utilisée par différents utilisateurs avec des substances qui rendent le nettoyage indispensable. Dans cet exemple, la notification à l'utilisateur est activée afin de lui rappeler le nettoyage après sa déconnexion.",
        "SPANISH": "La limpieza básica después de un uso es útil cuando la balanza es utilizada por diferentes usuarios con sustancias que hacen imprescindible la limpieza. En este ejemplo, se activa la notificación al usuario para que se le recuerde la limpieza después de desconectarse.",
        "RUSSIAN": "Базовая очистка после использования полезна, когда весы используются разными пользователями с веществами, которые делают очистку необходимой. В этом примере активировано уведомление пользователя, чтобы он получил напоминание об очистке после выхода из системы.",
        "ITALIAN": "La pulizia di base dopo un utilizzo è utile quando la bilancia viene utilizzata da diversi utenti con sostanze che rendono indispensabile la pulizia. In questo esempio, la notifica all'utente viene attivata in modo da ricordargli la pulizia dopo la disconnessione."
      },
      "AUTOTRANSLATIONS": {
        "CHINESE": "当天平被不同的用户使用时，使用后的基本清洁非常有用，因为使用的物质会使清洁变得非常必要。在本示例中，用户通知被激活，以便在注销后提醒用户进行清洁。",
        "FRENCH": "Le nettoyage normal après une utilisation est utile lorsque la balance est utilisée par différents utilisateurs avec des substances qui rendent le nettoyage indispensable. Dans cet exemple, la notification à l'utilisateur est activée afin de lui rappeler le nettoyage après sa déconnexion.",
        "SPANISH": "La limpieza básica después de un uso es útil cuando la balanza es utilizada por diferentes usuarios con sustancias que hacen imprescindible la limpieza. En este ejemplo, se activa la notificación al usuario para que se le recuerde la limpieza después de desconectarse.",
        "RUSSIAN": "Базовая очистка после использования полезна, когда весы используются разными пользователями с веществами, которые делают очистку необходимой. В этом примере активировано уведомление пользователя, чтобы он получил напоминание об очистке после выхода из системы.",
        "ITALIAN": "La pulizia di base dopo un utilizzo è utile quando la bilancia viene utilizzata da diversi utenti con sostanze che rendono indispensabile la pulizia. In questo esempio, la notifica all'utente viene attivata in modo da ricordargli la pulizia dopo la disconnessione."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "CHINESE": false,
        "FRENCH": false,
        "SPANISH": false,
        "RUSSIAN": false,
        "ITALIAN": false
      }
    },
    "DEVICE_CLEANING_APPLICATION_EXAMPLE_2_STEP_1": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Create a cleaning task as described in <a href=#DEVICE_CLEANING_CREATE_TASK>chapter 4</a>",
        "GERMAN": "Erstellen Sie eine Reinigungs-Task wie in <a href=#DEVICE_CLEANING_CREATE_TASK>Kapitel 4</a> beschrieben",
        "CHINESE": "按照<a href=#DEVICE_CLEANING_CREATE_TASK>第 4 章</a>中的描述创建一个清洁任务",
        "FRENCH": "Créez une tâche de nettoyage comme décrit dans <a href=#DEVICE_CLEANING_CREATE_TASK>Chapitre 4</a",
        "SPANISH": "Cree una tarea de limpieza como se describe en <a href=#DEVICE_CLEANING_CREATE_TASK>capítulo 4</a>.",
        "RUSSIAN": "Создайте задачу очистки, как описано в <a href=#DEVICE_CLEANING_CREATE_TASK>главе 4</a>.",
        "ITALIAN": "Creare un'attività di pulizia come descritto in <a href=#DEVICE_CLEANING_CREATE_TASK>capitolo 4</a>."
      },
      "AUTOTRANSLATIONS": {
        "CHINESE": "按照<a href=#DEVICE_CLEANING_CREATE_TASK>第 4 章</a>中的描述创建一个清洁任务",
        "FRENCH": "Créez une tâche de nettoyage comme décrit dans <a href=#DEVICE_CLEANING_CREATE_TASK>Chapitre 4</a",
        "SPANISH": "Cree una tarea de limpieza como se describe en <a href=#DEVICE_CLEANING_CREATE_TASK>capítulo 4</a>.",
        "RUSSIAN": "Создайте задачу очистки, как описано в <a href=#DEVICE_CLEANING_CREATE_TASK>главе 4</a>.",
        "ITALIAN": "Creare un'attività di pulizia come descritto in <a href=#DEVICE_CLEANING_CREATE_TASK>capitolo 4</a>."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "CHINESE": false,
        "FRENCH": false,
        "SPANISH": false,
        "RUSSIAN": false,
        "ITALIAN": false
      }
    },
    "DEVICE_CLEANING_APPLICATION_EXAMPLE_2_STEP_2": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Navigate to [Device settings] -> [Device cleaning]",
        "GERMAN": "Navigieren Sie zu [Geräteeinstellungen] -> [Gerätereinigung]",
        "CHINESE": "导航至 [设备设置] -> [设备清洁］",
        "FRENCH": "Naviguez vers [Réglages de l'appareil] -> [Nettoyage de l'appareil].",
        "SPANISH": "Navegue hasta [Device settings] -> [Device cleaning].",
        "RUSSIAN": "Перейдите в меню [Настройки устройства] -> [Очистка устройства].",
        "ITALIAN": "Spostarsi su [Impostazioni dispositivo] -> [Pulizia dispositivo]."
      },
      "AUTOTRANSLATIONS": {
        "CHINESE": "导航至 [设备设置] -> [设备清洁］",
        "FRENCH": "Naviguez vers [Réglages de l'appareil] -> [Nettoyage de l'appareil].",
        "SPANISH": "Navegue hasta [Device settings] -> [Device cleaning].",
        "RUSSIAN": "Перейдите в меню [Настройки устройства] -> [Очистка устройства].",
        "ITALIAN": "Spostarsi su [Impostazioni dispositivo] -> [Pulizia dispositivo]."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "CHINESE": false,
        "FRENCH": false,
        "SPANISH": false,
        "RUSSIAN": false,
        "ITALIAN": false
      }
    },
    "DEVICE_CLEANING_APPLICATION_EXAMPLE_2_STEP_3": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Activate [Cleaning support] to <b>Basic</b>, the appropriate settings get visible",
        "GERMAN": "Selektieren Sie in der [Reinigungsunterstützung] <b>Normal</b>, die weiteren Einstellungen werden sichtbar",
        "CHINESE": "将[清洁支持]激活为<b>基本</b>，相应的设置将可见",
        "FRENCH": "Sélectionnez <b>Normal</b> dans le [Support de nettoyage], les autres réglages sont visibles.",
        "SPANISH": "Activar [Soporte de limpieza] en <b>Básico</b>, los ajustes apropiados se hacen visibles.",
        "RUSSIAN": "Активируйте [Поддержка очистки] на <b>Basic</b>, соответствующие настройки станут видимыми",
        "ITALIAN": "Attivare [Supporto pulizia] su <b>Basic</b>, le impostazioni appropriate diventano visibili."
      },
      "AUTOTRANSLATIONS": {
        "CHINESE": "将[清洁支持]激活为<b>基本</b>，相应的设置将可见",
        "FRENCH": "Sélectionnez <b>Normal</b> dans le [Support de nettoyage], les autres réglages sont visibles.",
        "SPANISH": "Activar [Soporte de limpieza] en <b>Básico</b>, los ajustes apropiados se hacen visibles.",
        "RUSSIAN": "Активируйте [Поддержка очистки] на <b>Basic</b>, соответствующие настройки станут видимыми",
        "ITALIAN": "Attivare [Supporto pulizia] su <b>Basic</b>, le impostazioni appropriate diventano visibili."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "CHINESE": false,
        "FRENCH": false,
        "SPANISH": false,
        "RUSSIAN": false,
        "ITALIAN": false
      }
    },
    "DEVICE_CLEANING_APPLICATION_EXAMPLE_2_STEP_4": {
