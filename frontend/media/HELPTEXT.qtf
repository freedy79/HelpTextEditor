    "EXAMPLE_SET_LOCAL_PASSW_RULES_CONF_STEP_2_D": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Open the [Password length (characters)] selection and select the necessary characters to be used in the password, [Lower-case letters], [Uper-case letters] and [Numbers].",
        "GERMAN": "Öffnen Sie die Auswahl [Passwortlänge (Zeichen)] und wählen Sie die erforderlichen Zeichen, die im Passwort verwendet werden sollen, [Kleinbuchstaben], [Großbuchstaben] und [Zahlen].",
        "RUSSIAN": "Откройте пункт [Длина пароля (символы)] и выберите необходимые символы для пароля, [Строчные буквы], [Прописные буквы] и [Цифры].",
        "FRENCH": "Ouvrez la sélection [Longueur du mot de passe (caractères)] et sélectionnez les caractères nécessaires à utiliser dans le mot de passe, [Lettres minuscules], [Lettres majuscules] et [Chiffres].",
        "SPANISH": "Abra la selección [Longitud de la contraseña (caracteres)] y seleccione los caracteres necesarios para la contraseña, [Letras minúsculas], [Letras mayúsculas] y [Números].",
        "ITALIAN": "Aprire la selezione [Lunghezza della password (caratteri)] e selezionare i caratteri necessari da usare nella password, [Lettere minuscole], [Lettere maiuscole] e [Numeri].",
        "CHINESE": "打开 [密码长度（字符）] 选项，选择密码中需要使用的 [小写字母]、[大写字母] 和 [数字]。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Откройте пункт [Длина пароля (символы)] и выберите необходимые символы для пароля, [Строчные буквы], [Прописные буквы] и [Цифры].",
        "FRENCH": "Ouvrez la sélection [Longueur du mot de passe (caractères)] et sélectionnez les caractères nécessaires à utiliser dans le mot de passe, [Lettres minuscules], [Lettres majuscules] et [Chiffres].",
        "SPANISH": "Abra la selección [Longitud de la contraseña (caracteres)] y seleccione los caracteres necesarios para la contraseña, [Letras minúsculas], [Letras mayúsculas] y [Números].",
        "ITALIAN": "Aprire la selezione [Lunghezza della password (caratteri)] e selezionare i caratteri necessari da usare nella password, [Lettere minuscole], [Lettere maiuscole] e [Numeri].",
        "CHINESE": "打开 [密码长度（字符）] 选项，选择密码中需要使用的 [小写字母]、[大写字母] 和 [数字]。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
