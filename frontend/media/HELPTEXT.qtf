    "TASK_CONCEPT_ACTIVATE_STEP1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "TRANSLATIONS": {
        "GERMAN": "Die Task-Verwaltung öffnen",
        "ENGLISH": "",
        "FRENCH": "",
        "CHINESE": "",
        "RUSSIAN": "",
        "SPANISH": "",
        "ITALIAN": "",
        "JAPANESE": "",
        "KOREAN": ""
      },
      "AUTOTRANSLATIONS": {},
      "VERIFIED": {}
    },
    "TASK_CONCEPT_ACTIVATE_STEP2": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "TRANSLATIONS": {
        "GERMAN": "Auf die Schaltfläche [QAPP-Center] tippen.",
        "ENGLISH": "",
        "FRENCH": "",
        "CHINESE": "",
        "RUSSIAN": "",
        "SPANISH": "",
        "ITALIAN": "",
        "JAPANESE": "",
        "KOREAN": ""
      },
      "AUTOTRANSLATIONS": {},
      "VERIFIED": {}
    },
    "TASK_CONCEPT_INSTRUCTION_2": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "TRANSLATIONS": {
        "GERMAN": "Da eine Anwendung in der Praxis häufig in unterschiedlichen Varianten genutzt wird, ermöglicht das Task-Konzept eine flexible Anpassung:\nJede Task basiert auf derselben zugrunde liegenden Anwendung, kann jedoch mit individuellen Parametern konfiguriert werden. Dadurch lassen sich mehrere unterschiedliche Ausprägungen derselben QAPP erstellen, ohne das Grundprogramm zu verändern.",
        "ENGLISH": "",
        "FRENCH": "",
        "CHINESE": "",
        "RUSSIAN": "",
        "SPANISH": "",
        "ITALIAN": "",
        "JAPANESE": "",
        "KOREAN": ""
      },
      "AUTOTRANSLATIONS": {},
      "VERIFIED": {}
    },
    "TASK_CONCEPT_INSTRUCTION_1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "TRANSLATIONS": {
        "GERMAN": "Auf der Cubis II-Waage bildet eine Task eine vollständig konfigurierte Anwendung (QAPP), die einen bestimmten Arbeitsablauf auf der Waage abbildet. Eine Anwendung (QAPP) ist ein fest definiertes Programm, das auf der Waage ausgeführt wird und einen spezifischen Workflow umfasst – einschließlich aller hierfür notwendigen Funktionen, Prozessschritte und Parameter.",
        "ENGLISH": "",
        "FRENCH": "",
        "CHINESE": "",
        "RUSSIAN": "",
        "SPANISH": "",
        "ITALIAN": "",
        "JAPANESE": "",
        "KOREAN": ""
      },
      "AUTOTRANSLATIONS": {},
      "VERIFIED": {}
    },
    "TASK_CONCEPT_PARAMETER_TITLE1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "TRANSLATIONS": {
        "GERMAN": "Anwendungsparameter\n",
        "ENGLISH": "",
        "FRENCH": "",
        "CHINESE": "",
        "RUSSIAN": "",
        "SPANISH": "",
        "ITALIAN": "",
        "JAPANESE": "",
        "KOREAN": ""
      },
      "AUTOTRANSLATIONS": {},
      "VERIFIED": {}
    },
    "TASK_CONCEPT_PARAMETER_INSTRUCTION1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "TRANSLATIONS": {
        "GERMAN": "Jede Task enthält eine Reihe obligatorischer Parameter, die ihre Identität und ihr grundlegendes Verhalten definieren:",
        "ENGLISH": "",
        "FRENCH": "",
        "CHINESE": "",
        "RUSSIAN": "",
        "SPANISH": "",
        "ITALIAN": "",
        "JAPANESE": "",
        "KOREAN": ""
      },
      "AUTOTRANSLATIONS": {},
      "VERIFIED": {}
    },
    "TASK_CONCEPT_ACTIVATE_STEP3": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "TRANSLATIONS": {
        "GERMAN": "Eine Übersicht der verfügbaren QAPP-Pakete wird angezeigt.",
        "ENGLISH": "",
        "FRENCH": "",
        "CHINESE": "",
        "RUSSIAN": "",
        "SPANISH": "",
        "ITALIAN": "",
        "JAPANESE": "",
        "KOREAN": ""
      },
      "AUTOTRANSLATIONS": {},
      "VERIFIED": {}
    },
    "TASK_CONCEPT_ACTIVATE_STEP4": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "TRANSLATIONS": {
        "GERMAN": "Das gewünschte QAPP-Paket auswählen.",
        "ENGLISH": "",
        "FRENCH": "",
        "CHINESE": "",
        "RUSSIAN": "",
        "SPANISH": "",
        "ITALIAN": "",
        "JAPANESE": "",
        "KOREAN": ""
      },
      "AUTOTRANSLATIONS": {},
      "VERIFIED": {}
    },
