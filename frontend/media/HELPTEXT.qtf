    "TASK_CONCEPT_QAPP_CENTER_UPDATE_TITLE_INSTRUCTION_6vmxhowpw8c": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "TRANSLATIONS": {
        "GERMAN": "Das QAPP-Center mit seinen Anwendungen kann unabhängig von der Geräte-Firmware aktualisiert werden. Dazu muss die QAPP-Center-Datei mit der dazugehörigen MD5-Datei über einen Konnektor z. B. USB-Stick erreichbar sein. ",
        "ENGLISH": "",
        "FRENCH": "",
        "CHINESE": "",
        "RUSSIAN": "",
        "SPANISH": "",
        "ITALIAN": "",
        "JAPANESE": "",
        "KOREAN": ""
      },
      "AUTOTRANSLATIONS": {},
      "VERIFIED": {}
    },
