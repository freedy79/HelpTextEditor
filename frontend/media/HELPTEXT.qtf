      "TRANSLATIONS": {
        "ENGLISH": "Printing Concept for the Cubis® MCA Balance",
        "GERMAN": "Druckkonzept der Cubis® MCA Waage",
        "FRENCH": "Concept d'impression pour la balance Cubis® MCA",
        "RUSSIAN": "Концепция печати для весов Cubis® MCA",
        "SPANISH": "Concepto de impresión para la balanza MCA Cubis®",
        "ITALIAN": "Concetto di stampa per la bilancia Cubis® MCA",
        "CHINESE": "Cubis® MCA 天平的印刷概念",
        "JAPANESE": "キュービス®MCA天秤の印刷コンセプト",
        "KOREAN": "Cubis® MCA 밸런스의 인쇄 콘셉트"
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Concept d'impression pour la balance Cubis® MCA",
        "RUSSIAN": "Концепция печати для весов Cubis® MCA",
        "SPANISH": "Concepto de impresión para la balanza MCA Cubis®",
        "ITALIAN": "Concetto di stampa per la bilancia Cubis® MCA",
        "CHINESE": "Cubis® MCA 天平的印刷概念",
        "JAPANESE": "キュービス®MCA天秤の印刷コンセプト",
        "KOREAN": "Cubis® MCA 밸런스의 인쇄 콘셉트"
      },
      "VERIFIED": {
        "ENGLISH": true,
        "GERMAN": false,
