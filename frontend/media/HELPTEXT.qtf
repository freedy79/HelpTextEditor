    "OUTPUT_EXAMPLES_YDP30_STRIP_INSTRUCTION": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ]. Do not replace the control character <BR>.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "<BR><BR>[Weighing] sample application with GLP header and footer.<BR><BR> - Device ID for inventory number, for example.<BR> - Additional lines for company name and department, for example.<BR> - L ID for lot designation.<BR> - S ID for designation of sample(s).",
        "GERMAN": "<BR><BR>Beispielanwendung [Wägen] mit GLP-Kopf und Fuß.<BR><BR> - Geräte ID für z. B. Inventar-Nummer.<BR> - Zusätzliche Zeilen für z. B. Firmenname und Abteilung.<BR> - L ID für Bezeichnung der Charge.<BR> - S ID für Bezeichnung der Probe(n).",
        "RUSSIAN": "<BR><BR>[Весовая] заявка на образец с заголовком и колонтитулом GLP.<BR><BR> - ID устройства для инвентарного номера, например.<BR> - Дополнительные строки для названия компании и отдела, например.<BR> - L ID для обозначения партии.<BR> - S ID для обозначения образца(ов).",
        "FRENCH": "<BR><BR>Demande d'échantillon [de pesée] avec en-tête et pied de page BPL.<BR><BR> - ID de l'appareil pour le numéro d'inventaire, par exemple.<BR> - Lignes supplémentaires pour le nom de la société et le département, par exemple.<BR> - ID L pour la désignation du lot.<BR> - ID S pour la désignation du ou des échantillons.",
        "SPANISH": "<BR><BR>Solicitud de muestras [de pesaje] con encabezado y pie de página GLP.<BR><BR> - ID del dispositivo para el número de inventario, por ejemplo.<BR> - Líneas adicionales para el nombre de la empresa y el departamento, por ejemplo.<BR> - L ID para la designación del lote.<BR> - S ID para la designación de la(s) muestra(s).",
        "ITALIAN": "<BR><BR>[Pesatura] applicazione campione con intestazione e piè di pagina GLP.<BR><BR> - ID dispositivo per il numero di inventario, per esempio.<BR> - Linee aggiuntive per il nome della società e del dipartimento, per esempio.<BR> - L ID per la designazione del lotto.<BR> - S ID per la designazione del campione (o dei campioni).",
        "CHINESE": "<BR><BR>[Weighing] sample application with GLP header and footer.<BR><BR> - Device ID for inventory number, for example.<BR> - Additional lines for company name and department, for example.<BR> - L ID for lot designation.<BR> - S ID for designation of sample(s).",
        "JAPANESE": "<BR><BR>[計量]サンプル・アプリケーション（GLPヘッダーおよびフッター付き）<BR><BR> - デバイスID（在庫番号など）<BR> - 追加行（会社名、部署名など）<BR> - L ID（ロット指定用）<BR> - S ID（サンプル指定用）。",
        "KOREAN": "<BR><BR>[계량] GLP 헤더 및 푸터가 있는 샘플 신청서.<BR><BR> - 예를 들어 재고 번호를 위한 장치 ID.<BR> - 회사 이름 및 부서 등을 위한 추가 줄.<BR> - 로트 지정을 위한 L ID.<BR> - 샘플을 지정하기 위한 S ID입니다."
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "<BR><BR>[Весовая] заявка на образец с заголовком и колонтитулом GLP.<BR><BR> - ID устройства для инвентарного номера, например.<BR> - Дополнительные строки для названия компании и отдела, например.<BR> - L ID для обозначения партии.<BR> - S ID для обозначения образца(ов).",
        "FRENCH": "<BR><BR>Demande d'échantillon [de pesée] avec en-tête et pied de page BPL.<BR><BR> - ID de l'appareil pour le numéro d'inventaire, par exemple.<BR> - Lignes supplémentaires pour le nom de la société et le département, par exemple.<BR> - ID L pour la désignation du lot.<BR> - ID S pour la désignation du ou des échantillons.",
        "SPANISH": "<BR><BR>Solicitud de muestras [de pesaje] con encabezado y pie de página GLP.<BR><BR> - ID del dispositivo para el número de inventario, por ejemplo.<BR> - Líneas adicionales para el nombre de la empresa y el departamento, por ejemplo.<BR> - L ID para la designación del lote.<BR> - S ID para la designación de la(s) muestra(s).",
        "ITALIAN": "<BR><BR>[Pesatura] applicazione campione con intestazione e piè di pagina GLP.<BR><BR> - ID dispositivo per il numero di inventario, per esempio.<BR> - Linee aggiuntive per il nome della società e del dipartimento, per esempio.<BR> - L ID per la designazione del lotto.<BR> - S ID per la designazione del campione (o dei campioni).",
        "CHINESE": "<BR><BR>[Weighing] sample application with GLP header and footer.<BR><BR> - Device ID for inventory number, for example.<BR> - Additional lines for company name and department, for example.<BR> - L ID for lot designation.<BR> - S ID for designation of sample(s).",
        "JAPANESE": "<BR><BR>[計量]サンプル・アプリケーション（GLPヘッダーおよびフッター付き）<BR><BR> - デバイスID（在庫番号など）<BR> - 追加行（会社名、部署名など）<BR> - L ID（ロット指定用）<BR> - S ID（サンプル指定用）。",
        "KOREAN": "<BR><BR>[계량] GLP 헤더 및 푸터가 있는 샘플 신청서.<BR><BR> - 예를 들어 재고 번호를 위한 장치 ID.<BR> - 회사 이름 및 부서 등을 위한 추가 줄.<BR> - 로트 지정을 위한 L ID.<BR> - 샘플을 지정하기 위한 S ID입니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
