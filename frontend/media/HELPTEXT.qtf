      "TRANSLATIONS": {
        "ENGLISH": "SBI Protocol",
        "GERMAN": "SBI-Protokoll",
        "FRENCH": "Protocole SBI",
        "RUSSIAN": "Протокол SBI",
        "SPANISH": "Protocolo del SBI",
        "ITALIAN": "Protocollo SBI",
        "CHINESE": "履行机构协议",
        "JAPANESE": "SBIプロトコル",
        "KOREAN": "SBI 프로토콜"
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Protocole SBI",
        "RUSSIAN": "Протокол SBI",
        "SPANISH": "Protocolo del SBI",
        "ITALIAN": "Protocollo SBI",
        "CHINESE": "履行机构协议",
        "JAPANESE": "SBIプロトコル",
        "KOREAN": "SBI 프로토콜"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
        "RUSSIAN": false,
        "SPANISH": false,
        "ITALIAN": false,
