    "WEIGHING_SET_PRELOAD_INSTRUCTION_1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The load present on the balance is set as a preload and thus taken into account for the zero point of the balance. The weighing range is reduced by the set preload.",
        "GERMAN": "Die auf der Waage vorhandene Last wird als Vorlast gesetzt und damit für den Nullpunkt der Waage berücksichtigt. Der Wägebereich wird um die gesetzte Vorlast reduziert.",
        "RUSSIAN": "Груз, находящийся на весах, устанавливается как предварительная нагрузка и таким образом учитывается при определении нулевой точки весов. Диапазон взвешивания уменьшается на величину установленного предварительного груза.",
        "FRENCH": "La charge présente sur la balance est réglée comme une précharge et donc prise en compte pour le point zéro de la balance. La plage de pesage est réduite par la précharge réglée.",
        "SPANISH": "La carga presente en la balanza se ajusta como precarga y, por tanto, se tiene en cuenta para el punto cero de la balanza. El rango de pesaje se reduce por la precarga ajustada.",
        "ITALIAN": "Il carico presente sulla bilancia viene impostato come precarico e quindi preso in considerazione per il punto zero della bilancia. Il campo di pesatura viene ridotto dal precarico impostato.",
        "CHINESE": "天平上的载荷被设定为预紧力，因此在天平的零点时会被考虑在内。秤量范围因设定的预紧力而减小。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Груз, находящийся на весах, устанавливается как предварительная нагрузка и таким образом учитывается при определении нулевой точки весов. Диапазон взвешивания уменьшается на величину установленного предварительного груза.",
        "FRENCH": "La charge présente sur la balance est réglée comme une précharge et donc prise en compte pour le point zéro de la balance. La plage de pesage est réduite par la précharge réglée.",
        "SPANISH": "La carga presente en la balanza se ajusta como precarga y, por tanto, se tiene en cuenta para el punto cero de la balanza. El rango de pesaje se reduce por la precarga ajustada.",
        "ITALIAN": "Il carico presente sulla bilancia viene impostato come precarico e quindi preso in considerazione per il punto zero della bilancia. Il campo di pesatura viene ridotto dal precarico impostato.",
        "CHINESE": "天平上的载荷被设定为预紧力，因此在天平的零点时会被考虑在内。秤量范围因设定的预紧力而减小。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "WEIGHING_DEL_PRELOAD_TITLE": {
      "group": "HELP_TITLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
