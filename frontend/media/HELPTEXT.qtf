    "TCA_EXAMPLE_START_TASK_CONF_STEP_1": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ]. Do not translate QAPP and QAPP Center.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Activate the QAPP [User calibration], if not yet done.",
        "GERMAN": "Aktivieren Sie die QAPP [Benutzerkalibrierung], falls noch nicht erfolgt.",
        "RUSSIAN": "Активируйте QAPP [калибровка пользователя], если это еще не сделано.",
        "FRENCH": "Activez le QAPP [calibrage par l'utilisateur], si ce n'est pas encore fait.",
        "SPANISH": "Active el QAPP [Calibración del usuario], si aún no lo ha hecho.",
        "ITALIAN": "Attivare il QAPP [calibrazione utente], se non ancora fatto.",
        "CHINESE": "激活 QAPP [用户校准]（如果尚未完成）。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Активируйте QAPP [калибровка пользователя], если это еще не сделано.",
        "FRENCH": "Activez le QAPP [calibrage par l'utilisateur], si ce n'est pas encore fait.",
        "SPANISH": "Active el QAPP [Calibración del usuario], si aún no lo ha hecho.",
        "ITALIAN": "Attivare il QAPP [calibrazione utente], se non ancora fatto.",
        "CHINESE": "激活 QAPP [用户校准]（如果尚未完成）。"
      },
      "VERIFIED": {
        "ENGLISH": false,
