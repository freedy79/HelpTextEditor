    "TCA_EXAMPLE_START_TASK_CONF_STEP_2_D": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Customize the given settings to your requirements e.g., internal adjustment before starting, number of weights, units of limits, etc.",
        "GERMAN": "Passen Sie die vorgegebenen Einstellungen Ihren Anforderungen an, z. B. Interne Justage vor dem Start, Anzahl der Gewichte, Einheiten der Grenzen, usw.",
        "RUSSIAN": "Настройте заданные параметры в соответствии с вашими требованиями, например, внутренняя регулировка перед запуском, количество весов, единицы измерения пределов и т.д.",
        "FRENCH": "Adaptez les paramètres donnés à vos besoins, par exemple, le réglage interne avant le démarrage, le nombre de poids, les unités des limites, etc.",
        "SPANISH": "Personalice los ajustes dados a sus necesidades, por ejemplo, el ajuste interno antes de empezar, el número de pesos, las unidades de límites, etc.",
        "ITALIAN": "Personalizza le impostazioni date alle tue esigenze, ad esempio, la regolazione interna prima di iniziare, il numero di pesi, le unità dei limiti, ecc.",
        "CHINESE": "根据您的要求自定义给定设置，例如，启动前的内部调整、砝码数量、限值单位等。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Настройте заданные параметры в соответствии с вашими требованиями, например, внутренняя регулировка перед запуском, количество весов, единицы измерения пределов и т.д.",
        "FRENCH": "Adaptez les paramètres donnés à vos besoins, par exemple, le réglage interne avant le démarrage, le nombre de poids, les unités des limites, etc.",
        "SPANISH": "Personalice los ajustes dados a sus necesidades, por ejemplo, el ajuste interno antes de empezar, el número de pesos, las unidades de límites, etc.",
        "ITALIAN": "Personalizza le impostazioni date alle tue esigenze, ad esempio, la regolazione interna prima di iniziare, il numero di pesi, le unità dei limiti, ecc.",
        "CHINESE": "根据您的要求自定义给定设置，例如，启动前的内部调整、砝码数量、限值单位等。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "TCA_EXAMPLE_START_TASK_CONF_STEP_2_E": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Enter the values for the test weight, ID, nominal value, deviation and select the warning and intervention limits.",
        "GERMAN": "Geben Sie die Werte für das Prüfgewicht ein, ID, Nominalwert, Abweichung und wählen Sie die Warn- und Eingreifgrenze.",
        "RUSSIAN": "Введите значения для контрольного веса, идентификатора, номинального значения, отклонения и выберите пределы предупреждения и вмешательства.",
        "FRENCH": "Saisissez les valeurs du poids de test, de l'ID, de la valeur nominale, de l'écart et sélectionnez les limites d'alerte et d'intervention.",
        "SPANISH": "Introduzca los valores del peso de la prueba, el ID, el valor nominal, la desviación y seleccione los límites de advertencia e intervención.",
        "ITALIAN": "Inserire i valori per il peso di prova, ID, valore nominale, deviazione e selezionare i limiti di avvertimento e di intervento.",
        "CHINESE": "输入测试重量、内径、标称值和偏差值，并选择警告和干预限值。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Введите значения для контрольного веса, идентификатора, номинального значения, отклонения и выберите пределы предупреждения и вмешательства.",
        "FRENCH": "Saisissez les valeurs du poids de test, de l'ID, de la valeur nominale, de l'écart et sélectionnez les limites d'alerte et d'intervention.",
        "SPANISH": "Introduzca los valores del peso de la prueba, el ID, el valor nominal, la desviación y seleccione los límites de advertencia e intervención.",
        "ITALIAN": "Inserire i valori per il peso di prova, ID, valore nominale, deviazione e selezionare i limiti di avvertimento e di intervento.",
        "CHINESE": "输入测试重量、内径、标称值和偏差值，并选择警告和干预限值。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
