    "DEVICE_MAINTENANCE_RESTORE_APPL_STEP_2": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Navigate via the [General device settings] -> [Device maintenance] to the menu item [Restore of device settings].",
        "GERMAN": "Navigieren Sie über die [Gerätewartung] zum Menüpunkt [Wiederherstellen der Gerätedaten].",
        "RUSSIAN": "Перейдите через меню [Общие настройки устройства] -> [Обслуживание устройства] к пункту меню [Восстановление настроек устройства].",
        "FRENCH": "Passez par [Paramètres généraux de l'appareil] -> [Maintenance de l'appareil] pour atteindre l'élément de menu [Restauration des paramètres de l'appareil].",
        "SPANISH": "Navegue a través de [Ajustes generales del dispositivo] -> [Mantenimiento del dispositivo] hasta la opción de menú [Restauración de los ajustes del dispositivo].",
        "ITALIAN": "Navigare attraverso le [Impostazioni generali del dispositivo] -> [Manutenzione del dispositivo] fino alla voce di menu [Ripristino delle impostazioni del dispositivo].",
        "CHINESE": "通过 [设备维护] 进入 [还原设备数据] 菜单项。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Перейдите через меню [Общие настройки устройства] -> [Обслуживание устройства] к пункту меню [Восстановление настроек устройства].",
        "FRENCH": "Passez par [Paramètres généraux de l'appareil] -> [Maintenance de l'appareil] pour atteindre l'élément de menu [Restauration des paramètres de l'appareil].",
        "SPANISH": "Navegue a través de [Ajustes generales del dispositivo] -> [Mantenimiento del dispositivo] hasta la opción de menú [Restauración de los ajustes del dispositivo].",
        "ITALIAN": "Navigare attraverso le [Impostazioni generali del dispositivo] -> [Manutenzione del dispositivo] fino alla voce di menu [Ripristino delle impostazioni del dispositivo].",
        "CHINESE": "通过 [设备维护] 进入 [还原设备数据] 菜单项。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "DEVICE_MAINTENANCE_RESTORE_APPL_STEP_3": {
