      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Exemples d'application",
        "RUSSIAN": "Примеры применения",
        "SPANISH": "Ejemplos de aplicación",
        "ITALIAN": "Esempi di applicazioni",
        "CHINESE": "应用实例",
        "JAPANESE": "応用例",
        "KOREAN": "적용 사례"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
