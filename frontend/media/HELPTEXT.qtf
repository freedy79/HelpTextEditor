      }
    },
    "TCA_EXAMPLE_EXPORT_DSD_CONF_STEP_3_D": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
