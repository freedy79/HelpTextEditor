      "TRANSLATIONS": {
        "ENGLISH": "The [Operator] role can only execute the tasks.",
        "GERMAN": "Die Rolle [Anwender] kann nur Tasks ausführen.",
        "RUSSIAN": "Роль [Оператор] может только выполнять задания.",
        "FRENCH": "Le rôle [Utilisateur] peut uniquement exécuter les tâches.",
        "SPANISH": "El rol [Usuario] sólo puede ejecutar las tareas.",
        "ITALIAN": "Il ruolo [Utente] può solo eseguire i compiti.",
        "CHINESE": "操作员]角色只能执行任务。"
      },
      "AUTOTRANSLATIONS": {
