        "GERMAN": false,
        "FRENCH": false,
        "RUSSIAN": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_YDP30_LABEL_CONF_STEP_2_G": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The name and task description are then entered, followed by the selection and storage of user roles (wrong separation).",
        "GERMAN": "Anschließend Name und Beschreibung der Task eingeben, Benutzerrollen auswählen und Task speichern.",
        "FRENCH": "Le nom et la description de la tâche sont ensuite saisis, suivis de la sélection et du stockage des rôles des utilisateurs (séparation erronée).",
        "RUSSIAN": "Затем вводятся название и описание задачи, после чего выбираются и сохраняются роли пользователей (неправильное разделение).",
        "SPANISH": "A continuación se introducen el nombre y la descripción de la tarea, seguidos de la selección y el almacenamiento de los roles de usuario (separación errónea).",
        "ITALIAN": "Si inseriscono poi il nome e la descrizione del compito, seguiti dalla selezione e dalla memorizzazione dei ruoli utente (separazione errata).",
        "CHINESE": "然后输入名称和任务描述，接着选择和存储用户角色（错误的分离）。",
        "JAPANESE": "次に、名前とタスクの説明が入力され、ユーザーの役割が選択され、保存される（間違った分離）。",
        "KOREAN": "그런 다음 이름과 작업 설명을 입력한 다음 사용자 역할을 선택하고 저장합니다(잘못된 분리)."
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Le nom et la description de la tâche sont ensuite saisis, suivis de la sélection et du stockage des rôles des utilisateurs (séparation erronée).",
        "RUSSIAN": "Затем вводятся название и описание задачи, после чего выбираются и сохраняются роли пользователей (неправильное разделение).",
        "SPANISH": "A continuación se introducen el nombre y la descripción de la tarea, seguidos de la selección y el almacenamiento de los roles de usuario (separación errónea).",
        "ITALIAN": "Si inseriscono poi il nome e la descrizione del compito, seguiti dalla selezione e dalla memorizzazione dei ruoli utente (separazione errata).",
        "CHINESE": "然后输入名称和任务描述，接着选择和存储用户角色（错误的分离）。",
        "JAPANESE": "次に、名前とタスクの説明が入力され、ユーザーの役割が選択され、保存される（間違った分離）。",
        "KOREAN": "그런 다음 이름과 작업 설명을 입력한 다음 사용자 역할을 선택하고 저장합니다(잘못된 분리)."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
        "RUSSIAN": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
