    "LDAP_SERVER_SETTINGS_INSTRUCTION_5-1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The password of the user account [Manager], in order to be able to log on to the server for the search request.",
        "GERMAN": "Das Passwort des Benutzerkontos [Manager] um sich auf den Server für die Suchanfrage einloggen zu können.",
        "RUSSIAN": "Пароль учетной записи пользователя [Manager], чтобы иметь возможность войти на сервер для выполнения поискового запроса.",
        "FRENCH": "Le mot de passe du compte utilisateur [Manager], afin de pouvoir se connecter au serveur pour la demande de recherche.",
        "SPANISH": "La contraseña de la cuenta de usuario [Gestor], para poder iniciar la sesión en el servidor para la solicitud de búsqueda.",
        "ITALIAN": "La password dell'account utente [Manager], per poter accedere al server per la richiesta di ricerca.",
        "CHINESE": "用户账户 [Manager] 的密码，用于登录服务器进行搜索请求。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Пароль учетной записи пользователя [Manager], чтобы иметь возможность войти на сервер для выполнения поискового запроса.",
        "FRENCH": "Le mot de passe du compte utilisateur [Manager], afin de pouvoir se connecter au serveur pour la demande de recherche.",
        "SPANISH": "La contraseña de la cuenta de usuario [Gestor], para poder iniciar la sesión en el servidor para la solicitud de búsqueda.",
        "ITALIAN": "La password dell'account utente [Manager], per poter accedere al server per la richiesta di ricerca.",
        "CHINESE": "用户账户 [Manager] 的密码，用于登录服务器进行搜索请求。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
