    "CONNECTOR_USB_TITLE": {
      "group": "HELP_TITLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "USB Connector",
        "GERMAN": "Konnektor USB",
        "FRENCH": "Connecteur USB",
        "RUSSIAN": "Разъем USB",
        "SPANISH": "Conector USB",
        "ITALIAN": "Connettore USB",
        "CHINESE": "USB 连接器",
        "JAPANESE": "USBコネクタ",
        "KOREAN": "USB 커넥터"
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Connecteur USB",
        "RUSSIAN": "Разъем USB",
        "SPANISH": "Conector USB",
        "ITALIAN": "Connettore USB",
        "CHINESE": "USB 连接器",
        "JAPANESE": "USBコネクタ",
        "KOREAN": "USB 커넥터"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
        "RUSSIAN": false,
        "SPANISH": false,
