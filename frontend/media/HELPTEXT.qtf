      "TRANSLATIONS": {
        "ENGLISH": "Network connection Ethernet and Wi-Fi",
        "GERMAN": "Netzwerkverbindung Ethernet und Wi-Fi",
        "RUSSIAN": "Сетевое подключение Ethernet и Wi-Fi",
        "FRENCH": "Connexion réseau Ethernet et Wi-Fi",
        "SPANISH": "Conexión de red Ethernet y Wi-Fi",
        "ITALIAN": "Connessione di rete Ethernet e Wi-Fi",
        "CHINESE": "网络连接 以太网和 Wi-Fi"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Сетевое подключение Ethernet и Wi-Fi",
        "FRENCH": "Connexion réseau Ethernet et Wi-Fi",
        "SPANISH": "Conexión de red Ethernet y Wi-Fi",
        "ITALIAN": "Connessione di rete Ethernet e Wi-Fi",
        "CHINESE": "网络连接 以太网和 Wi-Fi"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
