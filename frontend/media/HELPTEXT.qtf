    "PRINT_A4_NETWORK_CONF_STEP_3_I": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the control character <BR>.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Next, assign a unique name and description to the print profile. <BR>This is important if you wish to use this profile for other applications.",
        "GERMAN": "Anschließend geben Sie dem Druckprofil einen eindeutigen Namen und eine Beschreibung. <BR>Das ist wichtig, falls Sie dieses Profil ggf. für andere Anwendungen nutzen möchten.",
        "RUSSIAN": "Затем присвойте профилю печати уникальное имя и описание. <BR>Это важно, если вы хотите использовать этот профиль для других приложений.",
        "FRENCH": "Ensuite, attribuez un nom et une description uniques au profil d'impression. <BR>Ceci est important si vous souhaitez utiliser ce profil pour d'autres applications.",
        "SPANISH": "A continuación, asigne un nombre y una descripción únicos al perfil de impresión. <BR>Esto es importante si desea utilizar este perfil para otras aplicaciones.",
        "ITALIAN": "Successivamente, assegnate un nome e una descrizione unici al profilo di stampa. <BR>Questo è importante se vuoi usare questo profilo per altre applicazioni.",
        "CHINESE": "然后，为打印预案指定一个唯一的名称和描述。<BR>如果您希望在其他应用程序中使用此预案，这一点非常重要。",
        "JAPANESE": "次に、印刷プロファイルに固有の名前と説明を割り当てます。<BR>これは、このプロファイルを他のアプリケーションで使用する場合に重要です。",
        "KOREAN": "다음으로 인쇄 프로필에 고유한 이름과 설명을 지정합니다. <BR>이 프로필을 다른 애플리케이션에 사용하려는 경우 이 작업이 중요합니다."
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Затем присвойте профилю печати уникальное имя и описание. <BR>Это важно, если вы хотите использовать этот профиль для других приложений.",
        "FRENCH": "Ensuite, attribuez un nom et une description uniques au profil d'impression. <BR>Ceci est important si vous souhaitez utiliser ce profil pour d'autres applications.",
        "SPANISH": "A continuación, asigne un nombre y una descripción únicos al perfil de impresión. <BR>Esto es importante si desea utilizar este perfil para otras aplicaciones.",
        "ITALIAN": "Successivamente, assegnate un nome e una descrizione unici al profilo di stampa. <BR>Questo è importante se vuoi usare questo profilo per altre applicazioni.",
        "CHINESE": "然后，为打印预案指定一个唯一的名称和描述。<BR>如果您希望在其他应用程序中使用此预案，这一点非常重要。",
        "JAPANESE": "次に、印刷プロファイルに固有の名前と説明を割り当てます。<BR>これは、このプロファイルを他のアプリケーションで使用する場合に重要です。",
        "KOREAN": "다음으로 인쇄 프로필에 고유한 이름과 설명을 지정합니다. <BR>이 프로필을 다른 애플리케이션에 사용하려는 경우 이 작업이 중요합니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_A4_NETWORK_CONF_STEP_4": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Allocate the print profile [My GLP print to A4 network printer] to your task, e.g. [My backweighing with GLP print to DIN A4].",
        "GERMAN": "Ordnen Sie das Druckprofil [Mein GLP Druck auf A4 Netzwerk-Drucker] Ihrer Task zu, z. B. [Mein Rückwägen mit GLP Druck auf DIN A4].",
        "RUSSIAN": "Назначьте профиль печати [My GLP print to A4 network printer] для вашей задачи, например, [My backweighing with GLP print to DIN A4].",
        "FRENCH": "Attribuez le profil d'impression [My GLP print to A4 network printer] à votre tâche, par exemple [My backweighing with GLP print to DIN A4].",
        "SPANISH": "Asigne a su tarea el perfil de impresión [Mi impresión GLP en impresora de red A4], por ejemplo, [Mi pesaje de espalda con impresión GLP en DIN A4].",
        "ITALIAN": "Assegnare il profilo di stampa [My GLP print to A4 network printer] al vostro compito, ad esempio [My backweighing with GLP print to DIN A4].",
        "CHINESE": "将打印配置文件 [我的 GLP 打印到 A4 网络打印机] 分配给您的任务，例如 [我的背磅与 GLP 打印到 DIN A4]。",
        "JAPANESE": "例えば、[My back weighing with GLP print to DIN A4]のように、印刷プロファイル[My GLP print to A4 network printer]をタスクに割り当てます。",
        "KOREAN": "인쇄 프로필 [A4 네트워크 프린터로 내 GLP 인쇄]를 작업에 할당합니다(예: [DIN A4로 GLP 인쇄로 내 중량 측정])."
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Назначьте профиль печати [My GLP print to A4 network printer] для вашей задачи, например, [My backweighing with GLP print to DIN A4].",
        "FRENCH": "Attribuez le profil d'impression [My GLP print to A4 network printer] à votre tâche, par exemple [My backweighing with GLP print to DIN A4].",
        "SPANISH": "Asigne a su tarea el perfil de impresión [Mi impresión GLP en impresora de red A4], por ejemplo, [Mi pesaje de espalda con impresión GLP en DIN A4].",
        "ITALIAN": "Assegnare il profilo di stampa [My GLP print to A4 network printer] al vostro compito, ad esempio [My backweighing with GLP print to DIN A4].",
        "CHINESE": "将打印配置文件 [我的 GLP 打印到 A4 网络打印机] 分配给您的任务，例如 [我的背磅与 GLP 打印到 DIN A4]。",
        "JAPANESE": "例えば、[My back weighing with GLP print to DIN A4]のように、印刷プロファイル[My GLP print to A4 network printer]をタスクに割り当てます。",
        "KOREAN": "인쇄 프로필 [A4 네트워크 프린터로 내 GLP 인쇄]를 작업에 할당합니다(예: [DIN A4로 GLP 인쇄로 내 중량 측정])."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
