    "MENU_SETTINGS_REPORT_SMB_CONF_STEP_2_E": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Enter the network path for Host and Share, making sure that you use the correct spelling [//Host name/Share name].",
        "GERMAN": "Geben Sie den Netzwerkpfad für Host und Share ein, achten Sie auf die richtige Schreibweise [//HostName/ShareName].",
        "RUSSIAN": "Введите сетевой путь для Host и Share, убедившись, что вы используете правильное написание [//Host name/Share name].",
        "FRENCH": "Saisissez le chemin d'accès réseau pour l'hôte et le partage, en veillant à utiliser l'orthographe correcte [/Nom de l'hôte/Nom du partage].",
        "SPANISH": "Introduzca la ruta de red para el host y el recurso compartido, asegurándose de utilizar la ortografía correcta [//Nombre del host/Nombre del recurso compartido].",
        "ITALIAN": "Inserisci il percorso di rete per Host e Share, assicurandoti di usare l'ortografia corretta [//nome host/nome share].",
        "CHINESE": "输入主机和共享的网络路径，确保拼写正确 [//Host name/Share name]。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Введите сетевой путь для Host и Share, убедившись, что вы используете правильное написание [//Host name/Share name].",
        "FRENCH": "Saisissez le chemin d'accès réseau pour l'hôte et le partage, en veillant à utiliser l'orthographe correcte [/Nom de l'hôte/Nom du partage].",
        "SPANISH": "Introduzca la ruta de red para el host y el recurso compartido, asegurándose de utilizar la ortografía correcta [//Nombre del host/Nombre del recurso compartido].",
        "ITALIAN": "Inserisci il percorso di rete per Host e Share, assicurandoti di usare l'ortografia corretta [//nome host/nome share].",
        "CHINESE": "输入主机和共享的网络路径，确保拼写正确 [//Host name/Share name]。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
