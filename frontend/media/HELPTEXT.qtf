      "TRANSLATIONS": {
        "ENGLISH": "Choose the [Backweighing] application.",
        "GERMAN": "Wählen Sie die Applikation [Rückwägen] aus.",
        "RUSSIAN": "Выберите приложение [Взвешивание спины].",
