    "EXAMPLE_CREATE_NEW_ROLE_INSTRUCTION": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "In this example, a new role is to be created with the right of task management and access to the Setup menu.",
        "GERMAN": "In diesem Beispiel soll eine neue Rolle angelegt werden mit dem Recht der Task-Verwaltung und den Zugriff auf das Setup Menü.",
        "RUSSIAN": "В данном примере необходимо создать новую роль с правом управления задачами и доступом к меню Setup.",
        "FRENCH": "Dans cet exemple, un nouveau rôle doit être créé avec le droit de gestion des tâches et l'accès au menu de configuration.",
        "SPANISH": "En este ejemplo, se va a crear un nuevo rol con derecho a gestión de tareas y acceso al menú de Configuración.",
        "ITALIAN": "In questo esempio, un nuovo ruolo deve essere creato con il diritto di gestione dei compiti e l'accesso al menu Setup.",
        "CHINESE": "在本例中，将创建一个新角色，赋予其任务管理权和设置菜单访问权。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "В данном примере необходимо создать новую роль с правом управления задачами и доступом к меню Setup.",
        "FRENCH": "Dans cet exemple, un nouveau rôle doit être créé avec le droit de gestion des tâches et l'accès au menu de configuration.",
        "SPANISH": "En este ejemplo, se va a crear un nuevo rol con derecho a gestión de tareas y acceso al menú de Configuración.",
        "ITALIAN": "In questo esempio, un nuovo ruolo deve essere creato con il diritto di gestione dei compiti e l'accesso al menu Setup.",
        "CHINESE": "在本例中，将创建一个新角色，赋予其任务管理权和设置菜单访问权。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
