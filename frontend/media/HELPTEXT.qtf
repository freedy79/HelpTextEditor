      "TRANSLATIONS": {
        "ENGLISH": "Set up a connector to a Windows File Server, e.g. [My SMB server].",
        "GERMAN": "Richten Sie einen Konnektor zu einem Windows File Server ein, z. B. [Mein SMB-Server].",
        "RUSSIAN": "Настройте подключение к файловому серверу Windows, например, [Мой SMB-сервер].",
        "FRENCH": "Configurez un connecteur vers un serveur de fichiers Windows, par exemple [Mon serveur SMB].",
        "SPANISH": "Configure un conector a un servidor de archivos de Windows, por ejemplo, [Mi servidor SMB].",
        "ITALIAN": "Impostare un connettore a un file server di Windows, ad esempio [Il mio server SMB].",
        "CHINESE": "设置一个连接 Windows 文件服务器的连接器，例如 [我的 SMB 服务器]。",
        "JAPANESE": "マイSMBサーバー]など、Windowsファイルサーバーへのコネクターを設定する。",
        "KOREAN": "Windows 파일 서버에 대한 커넥터를 설정합니다(예: [내 SMB 서버])."
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Настройте подключение к файловому серверу Windows, например, [Мой SMB-сервер].",
        "FRENCH": "Configurez un connecteur vers un serveur de fichiers Windows, par exemple [Mon serveur SMB].",
        "SPANISH": "Configure un conector a un servidor de archivos de Windows, por ejemplo, [Mi servidor SMB].",
        "ITALIAN": "Impostare un connettore a un file server di Windows, ad esempio [Il mio server SMB].",
        "CHINESE": "设置一个连接 Windows 文件服务器的连接器，例如 [我的 SMB 服务器]。",
        "JAPANESE": "マイSMBサーバー]など、Windowsファイルサーバーへのコネクターを設定する。",
        "KOREAN": "Windows 파일 서버에 대한 커넥터를 설정합니다(예: [내 SMB 서버])."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
