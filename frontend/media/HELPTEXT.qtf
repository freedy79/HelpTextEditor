    "PRINT_GLP_CVS_SMB_CONF_STEP_4_I": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the control character <BR>.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Next, assign a unique name and description to the print profile. <BR>This is important if you wish to use this profile for other applications.",
        "GERMAN": "Anschließend geben Sie dem Druckprofil einen eindeutigen Namen und eine Beschreibung. <BR>Das ist wichtig, falls Sie dieses Profil ggf. für andere Anwendungen nutzen möchten.",
        "RUSSIAN": "Затем присвойте профилю печати уникальное имя и описание. <BR>Это важно, если вы хотите использовать этот профиль для других приложений.",
        "FRENCH": "Ensuite, attribuez un nom et une description uniques au profil d'impression. <BR>Ceci est important si vous souhaitez utiliser ce profil pour d'autres applications.",
        "SPANISH": "A continuación, asigne un nombre y una descripción únicos al perfil de impresión. <BR>Esto es importante si desea utilizar este perfil para otras aplicaciones.",
        "ITALIAN": "Successivamente, assegnate un nome e una descrizione unici al profilo di stampa. <BR>Questo è importante se vuoi usare questo profilo per altre applicazioni.",
        "CHINESE": "然后给打印预案起一个唯一的名称和描述。<BR>如果您想在其他应用程序中使用此预案，这一点非常重要。",
        "JAPANESE": "次に、印刷プロファイルに固有の名前と説明を割り当てます。<BR>これは、このプロファイルを他のアプリケーションで使用する場合に重要です。",
        "KOREAN": "다음으로 인쇄 프로필에 고유한 이름과 설명을 지정합니다. <BR>이 프로필을 다른 애플리케이션에 사용하려는 경우 이 작업이 중요합니다."
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Затем присвойте профилю печати уникальное имя и описание. <BR>Это важно, если вы хотите использовать этот профиль для других приложений.",
        "FRENCH": "Ensuite, attribuez un nom et une description uniques au profil d'impression. <BR>Ceci est important si vous souhaitez utiliser ce profil pour d'autres applications.",
        "SPANISH": "A continuación, asigne un nombre y una descripción únicos al perfil de impresión. <BR>Esto es importante si desea utilizar este perfil para otras aplicaciones.",
        "ITALIAN": "Successivamente, assegnate un nome e una descrizione unici al profilo di stampa. <BR>Questo è importante se vuoi usare questo profilo per altre applicazioni.",
        "CHINESE": "然后给打印预案起一个唯一的名称和描述。<BR>如果您想在其他应用程序中使用此预案，这一点非常重要。",
        "JAPANESE": "次に、印刷プロファイルに固有の名前と説明を割り当てます。<BR>これは、このプロファイルを他のアプリケーションで使用する場合に重要です。",
        "KOREAN": "다음으로 인쇄 프로필에 고유한 이름과 설명을 지정합니다. <BR>이 프로필을 다른 애플리케이션에 사용하려는 경우 이 작업이 중요합니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_GLP_CVS_SMB_CONF_STEP_5": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Assign the [My CSV print on SMB server] print profile to your task, e.g. [My flexible formulation with CSV print on SMB server].",
        "GERMAN": "Ordnen Sie das Druckprofil [Mein CSV-Druck auf SMB-Server] Ihrer Task zu, z. B. [Meine variable Rezeptur mit CSV-Druck auf SMB-Server].",
        "RUSSIAN": "Назначьте профиль печати [My CSV print on SMB server] для вашей задачи, например, [My flexible formulation with CSV print on SMB server].",
        "FRENCH": "Attribuez le profil d'impression [Mon impression CSV sur le serveur SMB] à votre tâche, par exemple [Ma formulation flexible avec impression CSV sur le serveur SMB].",
        "SPANISH": "Asigne el perfil de impresión [Mi impresión CSV en el servidor SMB] a su tarea, por ejemplo [Mi formulación flexible con impresión CSV en el servidor SMB].",
        "ITALIAN": "Assegnate il profilo di stampa [La mia stampa CSV sul server SMB] al vostro compito, ad esempio [La mia formulazione flessibile con stampa CSV sul server SMB].",
        "CHINESE": "为您的任务分配打印配置文件 [我的 CSV 打印在 SMB 服务器上]，例如 [我的变量配方与 CSV 打印在 SMB 服务器上]。",
        "JAPANESE": "例えば、[SMBサーバーにCSVプリントするマイフレキシブルフォーミュレーション]のように、[SMBサーバーにCSVプリントするマイフレキシブルフォーミュレーション]プリントプロファイルをタスクに割り当てます。",
        "KOREAN": "SMB 서버에서 내 CSV 인쇄] 인쇄 프로필을 작업에 할당합니다(예: [SMB 서버에서 CSV 인쇄를 사용하는 내 유연한 공식])."
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Назначьте профиль печати [My CSV print on SMB server] для вашей задачи, например, [My flexible formulation with CSV print on SMB server].",
        "FRENCH": "Attribuez le profil d'impression [Mon impression CSV sur le serveur SMB] à votre tâche, par exemple [Ma formulation flexible avec impression CSV sur le serveur SMB].",
        "SPANISH": "Asigne el perfil de impresión [Mi impresión CSV en el servidor SMB] a su tarea, por ejemplo [Mi formulación flexible con impresión CSV en el servidor SMB].",
        "ITALIAN": "Assegnate il profilo di stampa [La mia stampa CSV sul server SMB] al vostro compito, ad esempio [La mia formulazione flessibile con stampa CSV sul server SMB].",
        "CHINESE": "为您的任务分配打印配置文件 [我的 CSV 打印在 SMB 服务器上]，例如 [我的变量配方与 CSV 打印在 SMB 服务器上]。",
        "JAPANESE": "例えば、[SMBサーバーにCSVプリントするマイフレキシブルフォーミュレーション]のように、[SMBサーバーにCSVプリントするマイフレキシブルフォーミュレーション]プリントプロファイルをタスクに割り当てます。",
        "KOREAN": "SMB 서버에서 내 CSV 인쇄] 인쇄 프로필을 작업에 할당합니다(예: [SMB 서버에서 CSV 인쇄를 사용하는 내 유연한 공식])."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
