    "UPDATE_QAPP_CENTER_FTP_CONF_STEP_1": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ]. Do not translate QAPP and QAPP Center.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Activate the [Connection to FTP/FTPS] QAPP extension, if this has not yet been done.",
        "GERMAN": "Aktivieren Sie die QAPP-Erweiterung [Verbindung zu FTP/FTPS], falls noch nicht erfolgt.",
        "RUSSIAN": "Активируйте расширение QAPP [Подключение к FTP/FTPS], если это еще не было сделано.",
        "FRENCH": "Activez l'extension QAPP [Connexion à FTP/FTPS], si cela n'a pas encore été fait.",
        "SPANISH": "Active la extensión QAPP [Conexión a FTP/FTPS], si aún no lo ha hecho.",
        "ITALIAN": "Attivare l'estensione QAPP [Connessione a FTP/FTPS], se questo non è stato ancora fatto.",
        "CHINESE": "如果尚未激活[连接到 FTP/FTPS] QAPP 扩展，则激活此扩展。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Активируйте расширение QAPP [Подключение к FTP/FTPS], если это еще не было сделано.",
        "FRENCH": "Activez l'extension QAPP [Connexion à FTP/FTPS], si cela n'a pas encore été fait.",
        "SPANISH": "Active la extensión QAPP [Conexión a FTP/FTPS], si aún no lo ha hecho.",
        "ITALIAN": "Attivare l'estensione QAPP [Connessione a FTP/FTPS], se questo non è stato ancora fatto.",
        "CHINESE": "如果尚未激活[连接到 FTP/FTPS] QAPP 扩展，则激活此扩展。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "UPDATE_QAPP_CENTER_FTP_CONF_STEP_1_A": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ]. Do not translate QAPP and QAPP Center.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Open the [Task management] menu, followed by the [QAPP Center].",
        "GERMAN": "Das Menü [Task-Verwaltung] und dann das [QAPP Center] öffnen.",
        "RUSSIAN": "Откройте меню [Управление задачами], а затем [QAPP Center].",
        "FRENCH": "Ouvrez le menu [Gestion des tâches], puis le [Centre QAPP].",
        "SPANISH": "Abra el menú [Gestión de tareas], seguido del [Centro QAPP].",
        "ITALIAN": "Apri il menu [Task management], seguito dal [QAPP Center].",
        "CHINESE": "打开 [任务管理] 菜单，然后打开 [QAPP 中心]。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Откройте меню [Управление задачами], а затем [QAPP Center].",
        "FRENCH": "Ouvrez le menu [Gestion des tâches], puis le [Centre QAPP].",
        "SPANISH": "Abra el menú [Gestión de tareas], seguido del [Centro QAPP].",
        "ITALIAN": "Apri il menu [Task management], seguito dal [QAPP Center].",
        "CHINESE": "打开 [任务管理] 菜单，然后打开 [QAPP 中心]。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "UPDATE_QAPP_CENTER_FTP_CONF_STEP_1_B": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ]. Do not translate QAPP and QAPP Center.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Select the [Connectivity] software package, and within it, the [Connection to FTP/FTPS] QAPP. The description and version of the QAPP will be displayed.",
        "GERMAN": "Wählen Sie das Software-Paket [Connectivity] und darin die QAPP [Verbindung zu FTP/FTPS]. Es wird die Beschreibung und Version der QAPP angezeigt.",
        "RUSSIAN": "Выберите пакет программного обеспечения [Connectivity], а в нем - QAPP [Connection to FTP/FTPS]. Отобразится описание и версия QAPP.",
        "FRENCH": "Sélectionnez le progiciel [Connectivité], et à l'intérieur de celui-ci, le QAPP [Connexion à FTP/FTPS]. La description et la version du QAPP s'affichent.",
        "SPANISH": "Seleccione el paquete de software [Conectividad] y, dentro de él, el QAPP [Conexión a FTP/FTPS]. Se mostrará la descripción y la versión del QAPP.",
        "ITALIAN": "Seleziona il pacchetto software [Connectivity] e, al suo interno, la QAPP [Connection to FTP/FTPS]. Verranno visualizzate la descrizione e la versione del QAPP.",
        "CHINESE": "选择 [Connectivity] 软件包，并在其中选择 [Connection to FTP/FTPS] QAPP。将显示 QAPP 的说明和版本。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Выберите пакет программного обеспечения [Connectivity], а в нем - QAPP [Connection to FTP/FTPS]. Отобразится описание и версия QAPP.",
        "FRENCH": "Sélectionnez le progiciel [Connectivité], et à l'intérieur de celui-ci, le QAPP [Connexion à FTP/FTPS]. La description et la version du QAPP s'affichent.",
        "SPANISH": "Seleccione el paquete de software [Conectividad] y, dentro de él, el QAPP [Conexión a FTP/FTPS]. Se mostrará la descripción y la versión del QAPP.",
        "ITALIAN": "Seleziona il pacchetto software [Connectivity] e, al suo interno, la QAPP [Connection to FTP/FTPS]. Verranno visualizzate la descrizione e la versione del QAPP.",
        "CHINESE": "选择 [Connectivity] 软件包，并在其中选择 [Connection to FTP/FTPS] QAPP。将显示 QAPP 的说明和版本。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
