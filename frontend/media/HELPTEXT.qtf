    "NETWORK_WLAN_INSTRUCTION_3_STEP_2": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Disconnected - No connection to the Wi-Fi network e.g., not logged in with Wi-Fi SSID and password.",
        "GERMAN": "Getrennt - Keine Verbindung mit dem Wi-Fi Netzwerk, z. B. nicht mit Wi-Fi SSID und Passwort angemeldet.",
        "RUSSIAN": "Отключено - Нет подключения к сети Wi-Fi, например, не выполнен вход в систему с помощью идентификатора Wi-Fi SSID и пароля.",
        "FRENCH": "Déconnecté - Pas de connexion au réseau Wi-Fi, par exemple, pas de connexion avec le SSID et le mot de passe Wi-Fi.",
        "SPANISH": "Desconectado - No hay conexión con la red Wi-Fi, por ejemplo, no se ha iniciado la sesión con el SSID y la contraseña del Wi-Fi.",
        "ITALIAN": "Disconnesso - Nessuna connessione alla rete Wi-Fi, ad esempio, non ha effettuato l'accesso con SSID Wi-Fi e password.",
        "CHINESE": "断开连接 - 无法连接到 Wi-Fi 网络，例如未使用 Wi-Fi SSID 和密码登录。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Отключено - Нет подключения к сети Wi-Fi, например, не выполнен вход в систему с помощью идентификатора Wi-Fi SSID и пароля.",
        "FRENCH": "Déconnecté - Pas de connexion au réseau Wi-Fi, par exemple, pas de connexion avec le SSID et le mot de passe Wi-Fi.",
        "SPANISH": "Desconectado - No hay conexión con la red Wi-Fi, por ejemplo, no se ha iniciado la sesión con el SSID y la contraseña del Wi-Fi.",
        "ITALIAN": "Disconnesso - Nessuna connessione alla rete Wi-Fi, ad esempio, non ha effettuato l'accesso con SSID Wi-Fi e password.",
        "CHINESE": "断开连接 - 无法连接到 Wi-Fi 网络，例如未使用 Wi-Fi SSID 和密码登录。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "NETWORK_WLAN_INSTRUCTION_3_STEP_3": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Ready - Connection established with the Wi-Fi network.",
        "GERMAN": "Bereit - Verbindung mit dem Wi-Fi Netzwerk vorhanden.",
        "RUSSIAN": "Готов - Установлено соединение с сетью Wi-Fi.",
        "FRENCH": "Prêt - Connexion établie avec le réseau Wi-Fi.",
        "SPANISH": "Listo - Conexión establecida con la red Wi-Fi.",
        "ITALIAN": "Pronto - Connessione stabilita con la rete Wi-Fi.",
        "CHINESE": "就绪 - 已与 Wi-Fi 网络建立连接。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Готов - Установлено соединение с сетью Wi-Fi.",
        "FRENCH": "Prêt - Connexion établie avec le réseau Wi-Fi.",
        "SPANISH": "Listo - Conexión establecida con la red Wi-Fi.",
        "ITALIAN": "Pronto - Connessione stabilita con la rete Wi-Fi.",
        "CHINESE": "就绪 - 已与 Wi-Fi 网络建立连接。"
      },
      "VERIFIED": {
