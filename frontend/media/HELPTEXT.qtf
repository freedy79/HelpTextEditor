    "TCA_EXAMPLE_AUTO_BACKUP_CONF_STEP_1_A": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ]. Do not translate QAPP and QAPP Center.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Open the [Task management] menu, followed by the [QAPP Center].",
        "GERMAN": "Das Menü [Task-Verwaltung] und dann das [QAPP Center] öffnen.",
        "RUSSIAN": "Откройте меню [Управление задачами], а затем [QAPP Center].",
        "FRENCH": "Ouvrez le menu [Gestion des tâches], puis le [Centre QAPP].",
        "SPANISH": "Abra el menú [Gestión de tareas], seguido del [Centro QAPP].",
        "ITALIAN": "Apri il menu [Task management], seguito dal [QAPP Center].",
        "CHINESE": "打开 [任务管理] 菜单，然后打开 [QAPP 中心]。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Откройте меню [Управление задачами], а затем [QAPP Center].",
        "FRENCH": "Ouvrez le menu [Gestion des tâches], puis le [Centre QAPP].",
        "SPANISH": "Abra el menú [Gestión de tareas], seguido del [Centro QAPP].",
        "ITALIAN": "Apri il menu [Task management], seguito dal [QAPP Center].",
        "CHINESE": "打开 [任务管理] 菜单，然后打开 [QAPP 中心]。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "TCA_EXAMPLE_AUTO_BACKUP_CONF_STEP_1_B": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ]. Do not translate QAPP and QAPP Center.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Choose the [Connectivity] software package, and within it the [Connection to Windows File Server] QAPP. The description and version of the QAPP will be displayed.",
        "GERMAN": "Wählen Sie das Software-Paket [Connectivity] und darin die QAPP [Verbindung zu Windows File Server]. Es wird die Beschreibung und Version der QAPP angezeigt.",
        "RUSSIAN": "Выберите пакет программного обеспечения [Connectivity], а в нем - QAPP [Connection to Windows File Server]. Появится описание и версия QAPP.",
        "FRENCH": "Choisissez le progiciel [Connectivité], et à l'intérieur de celui-ci le QAPP [Connexion au serveur de fichiers Windows]. La description et la version du QAPP s'affichent.",
        "SPANISH": "Elija el paquete de software [Conectividad] y, dentro de él, el QAPP [Conexión al servidor de archivos de Windows]. Se mostrará la descripción y la versión del QAPP.",
        "ITALIAN": "Scegli il pacchetto software [Connectivity] e al suo interno il QAPP [Connection to Windows File Server]. Verranno visualizzate la descrizione e la versione del QAPP.",
        "CHINESE": "选择 [Connectivity] 软件包，并在其中选择 [Connection to Windows File Server] QAPP。将显示 QAPP 的说明和版本。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Выберите пакет программного обеспечения [Connectivity], а в нем - QAPP [Connection to Windows File Server]. Появится описание и версия QAPP.",
        "FRENCH": "Choisissez le progiciel [Connectivité], et à l'intérieur de celui-ci le QAPP [Connexion au serveur de fichiers Windows]. La description et la version du QAPP s'affichent.",
        "SPANISH": "Elija el paquete de software [Conectividad] y, dentro de él, el QAPP [Conexión al servidor de archivos de Windows]. Se mostrará la descripción y la versión del QAPP.",
        "ITALIAN": "Scegli il pacchetto software [Connectivity] e al suo interno il QAPP [Connection to Windows File Server]. Verranno visualizzate la descrizione e la versione del QAPP.",
        "CHINESE": "选择 [Connectivity] 软件包，并在其中选择 [Connection to Windows File Server] QAPP。将显示 QAPP 的说明和版本。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "TCA_EXAMPLE_AUTO_BACKUP_CONF_STEP_1_C": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ]. Do not translate QAPP and QAPP Center.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Use the [License] button to activate this QAPP; the order and license information will be displayed.",
        "GERMAN": "Aktivieren Sie mit der Schaltfläche [Lizenz] diese QAPP, die Bestell- und Lizenzinformationen werden angezeigt.",
        "RUSSIAN": "Используйте кнопку [Лицензия] для активации данного QAPP; на экране появится информация о заказе и лицензии.",
        "FRENCH": "Utilisez le bouton [Licence] pour activer ce QAPP ; les informations relatives à la commande et à la licence s'afficheront.",
        "SPANISH": "Utilice el botón [Licencia] para activar este QAPP; se mostrará la información sobre el pedido y la licencia.",
        "ITALIAN": "Usa il pulsante [Licenza] per attivare questo QAPP; verranno visualizzate le informazioni sull'ordine e sulla licenza.",
        "CHINESE": "使用 [许可证] 按钮激活本 QAPP；将显示订单和许可证信息。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Используйте кнопку [Лицензия] для активации данного QAPP; на экране появится информация о заказе и лицензии.",
        "FRENCH": "Utilisez le bouton [Licence] pour activer ce QAPP ; les informations relatives à la commande et à la licence s'afficheront.",
        "SPANISH": "Utilice el botón [Licencia] para activar este QAPP; se mostrará la información sobre el pedido y la licencia.",
        "ITALIAN": "Usa il pulsante [Licenza] per attivare questo QAPP; verranno visualizzate le informazioni sull'ordine e sulla licenza.",
        "CHINESE": "使用 [许可证] 按钮激活本 QAPP；将显示订单和许可证信息。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "TCA_EXAMPLE_AUTO_BACKUP_CONF_STEP_1_D": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ]. Do not translate QAPP and QAPP Center.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "If this QAPP was not ordered as [factory licensed], start the test version or enter the license code that you have purchased for this QAPP.",
        "GERMAN": "Falls diese QAPP nicht ab Werk freigeschaltet bestellt wurde, starten Sie die Testversion oder geben Sie den erworbenen Lizenzcode für diese QAPP ein.",
        "RUSSIAN": "Если этот QAPP не был заказан как [заводская лицензия], запустите тестовую версию или введите код лицензии, который вы приобрели для этого QAPP.",
        "FRENCH": "Si ce QAPP n'a pas été commandé en tant que [licence d'usine], démarrez la version de test ou entrez le code de licence que vous avez acheté pour ce QAPP.",
        "SPANISH": "Si este QAPP no se pidió como [licencia de fábrica], inicie la versión de prueba o introduzca el código de licencia que ha adquirido para este QAPP.",
        "ITALIAN": "Se questo QAPP non è stato ordinato come [con licenza di fabbrica], avvia la versione di prova o inserisci il codice di licenza che hai acquistato per questo QAPP.",
        "CHINESE": "如果本 QAPP 订购时没有[出厂许可]，请启动测试版本或输入您为本 QAPP 购买的许可代码。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Если этот QAPP не был заказан как [заводская лицензия], запустите тестовую версию или введите код лицензии, который вы приобрели для этого QAPP.",
        "FRENCH": "Si ce QAPP n'a pas été commandé en tant que [licence d'usine], démarrez la version de test ou entrez le code de licence que vous avez acheté pour ce QAPP.",
        "SPANISH": "Si este QAPP no se pidió como [licencia de fábrica], inicie la versión de prueba o introduzca el código de licencia que ha adquirido para este QAPP.",
        "ITALIAN": "Se questo QAPP non è stato ordinato come [con licenza di fabbrica], avvia la versione di prova o inserisci il codice di licenza che hai acquistato per questo QAPP.",
        "CHINESE": "如果本 QAPP 订购时没有[出厂许可]，请启动测试版本或输入您为本 QAPP 购买的许可代码。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "TCA_EXAMPLE_AUTO_BACKUP_CONF_STEP_2": {
      "group": "HELP_EXAMPLE",
