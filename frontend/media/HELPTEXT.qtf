    "PRINT_YDP30_LABEL_CONF_STEP_1": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Configure a print profile, e.g. [My label print on YDP30].",
        "GERMAN": "Konfigurieren Sie ein Druckprofil z. B. [Mein Etiketten Druck auf YDP30].",
        "FRENCH": "Configurez un profil d'impression, par exemple [Mon étiquette s'imprime sur YDP30].",
        "RUSSIAN": "Настройте профиль печати, например, [Моя этикетка печатается на YDP30].",
        "SPANISH": "Configure un perfil de impresión, por ejemplo, [Mi impresión de etiquetas en YDP30].",
        "ITALIAN": "Configurare un profilo di stampa, ad esempio [La mia stampa di etichette su YDP30].",
        "CHINESE": "配置打印配置文件，例如[我的标签在 YDP30 上打印]。",
        "JAPANESE": "印刷プロファイルを設定します（例：[My label print on YDP30]）。",
