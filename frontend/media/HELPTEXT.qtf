    "UPDATE_QAPP_CENTER_FTP_CONF_STEP_2_E": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Enter the IP address of the network server, ensuring that you spell it correctly",
        "GERMAN": "Geben Sie die IP-Adresse vom Netzwerk-Server ein, achten Sie auf die richtige Schreibweise.",
        "RUSSIAN": "Введите IP-адрес сетевого сервера, убедившись, что вы правильно его написали",
        "FRENCH": "Saisissez l'adresse IP du serveur réseau, en veillant à l'orthographier correctement.",
        "SPANISH": "Introduzca la dirección IP del servidor de red, asegurándose de escribirla correctamente",
        "ITALIAN": "Inserisci l'indirizzo IP del server di rete, assicurandoti di scriverlo correttamente",
        "CHINESE": "输入网络服务器的 IP 地址，确保拼写正确"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Введите IP-адрес сетевого сервера, убедившись, что вы правильно его написали",
        "FRENCH": "Saisissez l'adresse IP du serveur réseau, en veillant à l'orthographier correctement.",
        "SPANISH": "Introduzca la dirección IP del servidor de red, asegurándose de escribirla correctamente",
        "ITALIAN": "Inserisci l'indirizzo IP del server di rete, assicurandoti di scriverlo correttamente",
        "CHINESE": "输入网络服务器的 IP 地址，确保拼写正确"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
