    "PRINT_GLP_PDF_FTPS_INSTRUCTION_4": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "An appropriately set up FTPS server in your network is a requirement for this application.",
        "GERMAN": "Voraussetzung für diese Anwendung ist ein entsprechend eingerichteter FTPS-Server in Ihrem Netzwerk.",
        "FRENCH": "Un serveur FTPS correctement configuré dans votre réseau est nécessaire pour cette application.",
        "RUSSIAN": "Для этого приложения необходимо наличие в вашей сети соответствующим образом настроенного сервера FTPS.",
        "SPANISH": "Un servidor FTPS debidamente configurado en su red es un requisito para esta aplicación.",
        "ITALIAN": "Un server FTPS opportunamente impostato nella vostra rete è un requisito per questa applicazione.",
        "CHINESE": "此应用程序需要在网络中适当设置 FTPS 服务器。",
        "JAPANESE": "このアプリケーションには、ネットワーク内に適切に設定されたFTPSサーバーが必要です。",
        "KOREAN": "이 애플리케이션을 사용하려면 네트워크에 적절하게 설정된 FTPS 서버가 있어야 합니다."
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Un serveur FTPS correctement configuré dans votre réseau est nécessaire pour cette application.",
        "RUSSIAN": "Для этого приложения необходимо наличие в вашей сети соответствующим образом настроенного сервера FTPS.",
        "SPANISH": "Un servidor FTPS debidamente configurado en su red es un requisito para esta aplicación.",
        "ITALIAN": "Un server FTPS opportunamente impostato nella vostra rete è un requisito per questa applicazione.",
        "CHINESE": "此应用程序需要在网络中适当设置 FTPS 服务器。",
        "JAPANESE": "このアプリケーションには、ネットワーク内に適切に設定されたFTPSサーバーが必要です。",
        "KOREAN": "이 애플리케이션을 사용하려면 네트워크에 적절하게 설정된 FTPS 서버가 있어야 합니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
        "RUSSIAN": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
