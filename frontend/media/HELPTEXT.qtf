      "TRANSLATIONS": {
        "ENGLISH": "Execution date",
        "GERMAN": "Zeitpunkt der Ausführung",
        "RUSSIAN": "Дата исполнения",
        "FRENCH": "Date d'exécution",
        "SPANISH": "Fecha de ejecución",
        "ITALIAN": "Data di esecuzione",
        "CHINESE": "执行日期"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Дата исполнения",
        "FRENCH": "Date d'exécution",
        "SPANISH": "Fecha de ejecución",
        "ITALIAN": "Data di esecuzione",
        "CHINESE": "执行日期"
      },
      "VERIFIED": {
        "ENGLISH": false,
