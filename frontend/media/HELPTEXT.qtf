    "NETWORK_CONNECTION_INSTRUCTION_1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "A Cubis® MCA balance can be connected to a TCP/IP-based network using a cable via the Ethernet connection (RJ45 socket) and wireless via a Wi-Fi USB adapter (WLAN stick).",
        "GERMAN": "Der Anschluss einer Cubis® MCA-Waage an ein TCP-/IP-basiertes Netzwerk kann kabelgebunden über den Ethernet-Anschluss (RJ45 Buchse) und kabellos über einen Wi-Fi USB Adapter (WLAN-Stick) erfolgen.",
        "RUSSIAN": "Весы Cubis® MCA могут быть подключены к сети на базе TCP/IP с помощью кабеля через Ethernet-соединение (гнездо RJ45) и беспроводным способом через USB-адаптер Wi-Fi (WLAN адаптер).",
        "FRENCH": "Une balance Cubis® MCA peut être connectée à un réseau basé sur TCP/IP par câble via la connexion Ethernet (prise RJ45) et sans fil via un adaptateur USB Wi-Fi (clé WLAN).",
        "SPANISH": "Una balanza Cubis® MCA puede conectarse a una red basada en TCP/IP mediante un cable a través de la conexión Ethernet (toma RJ45) y de forma inalámbrica a través de un adaptador USB Wi-Fi (WLAN stick).",
        "ITALIAN": "Una bilancia Cubis® MCA può essere collegata a una rete basata su TCP/IP con un cavo tramite la connessione Ethernet (presa RJ45) e senza fili tramite un adattatore USB Wi-Fi (WLAN stick).",
        "CHINESE": "Cubis® MCA 天平可以使用电缆通过以太网连接（RJ45 插座）连接到基于 TCP/IP 的网络，也可以通过 Wi-Fi USB 适配器（WLAN 棒）连接到无线网络。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Весы Cubis® MCA могут быть подключены к сети на базе TCP/IP с помощью кабеля через Ethernet-соединение (гнездо RJ45) и беспроводным способом через USB-адаптер Wi-Fi (WLAN адаптер).",
        "FRENCH": "Une balance Cubis® MCA peut être connectée à un réseau basé sur TCP/IP par câble via la connexion Ethernet (prise RJ45) et sans fil via un adaptateur USB Wi-Fi (clé WLAN).",
        "SPANISH": "Una balanza Cubis® MCA puede conectarse a una red basada en TCP/IP mediante un cable a través de la conexión Ethernet (toma RJ45) y de forma inalámbrica a través de un adaptador USB Wi-Fi (WLAN stick).",
        "ITALIAN": "Una bilancia Cubis® MCA può essere collegata a una rete basata su TCP/IP con un cavo tramite la connessione Ethernet (presa RJ45) e senza fili tramite un adattatore USB Wi-Fi (WLAN stick).",
        "CHINESE": "Cubis® MCA 天平可以使用电缆通过以太网连接（RJ45 插座）连接到基于 TCP/IP 的网络，也可以通过 Wi-Fi USB 适配器（WLAN 棒）连接到无线网络。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "NETWORK_CONNECTION_INSTRUCTION_2": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The transmission rates of the network connection are 10 Mbit/sec (10BASE-T, Ethernet) and 100 Mbit/sec (100BASE-TX Fast Ethernet).",
        "GERMAN": "Die Übertragungsraten der Netzwerkverbindung sind 10 Mbit/sec (10BASE-T, Ethernet) und 100 Mbit/sec (100BASE-TX, Fast Ethernet).",
        "RUSSIAN": "Скорость передачи данных сетевого соединения составляет 10 Мбит/с (10BASE-T, Ethernet) и 100 Мбит/с (100BASE-TX Fast Ethernet).",
        "FRENCH": "Les débits de transmission de la connexion réseau sont de 10 Mbit/sec (10BASE-T, Ethernet) et de 100 Mbit/sec (100BASE-TX Fast Ethernet).",
        "SPANISH": "Las velocidades de transmisión de la conexión de red son de 10 Mbit/seg (10BASE-T, Ethernet) y 100 Mbit/seg (100BASE-TX Fast Ethernet).",
        "ITALIAN": "Le velocità di trasmissione della connessione di rete sono 10 Mbit/sec (10BASE-T, Ethernet) e 100 Mbit/sec (100BASE-TX Fast Ethernet).",
        "CHINESE": "网络连接的传输速率为 10 Mbit/秒（10BASE-T 以太网）和 100 Mbit/秒（100BASE-TX 快速以太网）。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Скорость передачи данных сетевого соединения составляет 10 Мбит/с (10BASE-T, Ethernet) и 100 Мбит/с (100BASE-TX Fast Ethernet).",
        "FRENCH": "Les débits de transmission de la connexion réseau sont de 10 Mbit/sec (10BASE-T, Ethernet) et de 100 Mbit/sec (100BASE-TX Fast Ethernet).",
        "SPANISH": "Las velocidades de transmisión de la conexión de red son de 10 Mbit/seg (10BASE-T, Ethernet) y 100 Mbit/seg (100BASE-TX Fast Ethernet).",
        "ITALIAN": "Le velocità di trasmissione della connessione di rete sono 10 Mbit/sec (10BASE-T, Ethernet) e 100 Mbit/sec (100BASE-TX Fast Ethernet).",
        "CHINESE": "网络连接的传输速率为 10 Mbit/秒（10BASE-T 以太网）和 100 Mbit/秒（100BASE-TX 快速以太网）。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "NETWORK_CONNECTION_INSTRUCTION_3": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The Ethernet connection is made with a connection cable, CAT 5 or higher, twisted in pairs, shielded, 1:1, UTP/STP, plug RJ45; e.g., patch cable CAT 5 depending upon the use (straight/cross-over).",
        "GERMAN": "Der Ethernet-Anschluss erfolgt mit einem Verbindungskabel, CAT-5 oder höher, paarweise verdrillt, abgeschirmt, 1:1, UTP / STP, Stecker RJ45; z. B. Patchkabel CAT-5 je nach Einsatz (straight/crossover).",
        "RUSSIAN": "Соединение Ethernet осуществляется с помощью соединительного кабеля CAT 5 или выше, скрученного попарно, экранированного, 1:1, UTP/STP, разъем RJ45; например, коммутационный кабель CAT 5 в зависимости от использования (прямой/перекрестный).",
        "FRENCH": "La connexion Ethernet est réalisée à l'aide d'un câble de connexion, CAT 5 ou supérieur, torsadé par paires, blindé, 1:1, UTP/STP, fiche RJ45 ; par exemple, un câble patch CAT 5 en fonction de l'utilisation (droit/croisé).",
        "SPANISH": "La conexión Ethernet se realiza con un cable de conexión, CAT 5 o superior, trenzado en pares, apantallado, 1:1, UTP/STP, enchufe RJ45; por ejemplo, cable de conexión CAT 5 según el uso (recto/transversal).",
        "ITALIAN": "Il collegamento Ethernet viene effettuato con un cavo di collegamento, CAT 5 o superiore, intrecciato a coppie, schermato, 1:1, UTP/STP, spina RJ45; ad esempio, cavo patch CAT 5 a seconda dell'uso (dritto/cross-over).",
        "CHINESE": "以太网连接使用 CAT 5 或更高规格的连接电缆，成对双绞线，屏蔽，1:1，UTP/STP，插头为 RJ45；例如，根据用途（直通/交叉）使用 CAT 5 跳线。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Соединение Ethernet осуществляется с помощью соединительного кабеля CAT 5 или выше, скрученного попарно, экранированного, 1:1, UTP/STP, разъем RJ45; например, коммутационный кабель CAT 5 в зависимости от использования (прямой/перекрестный).",
        "FRENCH": "La connexion Ethernet est réalisée à l'aide d'un câble de connexion, CAT 5 ou supérieur, torsadé par paires, blindé, 1:1, UTP/STP, fiche RJ45 ; par exemple, un câble patch CAT 5 en fonction de l'utilisation (droit/croisé).",
        "SPANISH": "La conexión Ethernet se realiza con un cable de conexión, CAT 5 o superior, trenzado en pares, apantallado, 1:1, UTP/STP, enchufe RJ45; por ejemplo, cable de conexión CAT 5 según el uso (recto/transversal).",
        "ITALIAN": "Il collegamento Ethernet viene effettuato con un cavo di collegamento, CAT 5 o superiore, intrecciato a coppie, schermato, 1:1, UTP/STP, spina RJ45; ad esempio, cavo patch CAT 5 a seconda dell'uso (dritto/cross-over).",
        "CHINESE": "以太网连接使用 CAT 5 或更高规格的连接电缆，成对双绞线，屏蔽，1:1，UTP/STP，插头为 RJ45；例如，根据用途（直通/交叉）使用 CAT 5 跳线。"
      },
      "VERIFIED": {
