    "WLAN_IPV4_IPV6_DNS_INSTRUCTION_1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "Do not translate HTML link commands, e.g. <a href=\"#ETHERNET_IPV4_PROTOCOL\"> and </a>.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "For the protocol IPv4 and IPv6 as well as for DNS 1 and DNS 2, the same description applies to Wi-Fi (WLAN) as in case of <a href=\"#ETHERNET_IPV4_PROTOCOL\">Ethernet (LAN)</a>.",
        "GERMAN": "Für das Protokoll IPv4 und IPv6 sowie für DNS 1 und DNS 2, gilt bei Wi-Fi (WLAN) die gleiche Beschreibung wie bei <a href=\"#ETHERNET_IPV4_PROTOCOL\">Ethernet (LAN)</a>.",
        "RUSSIAN": "Для протокола IPv4 и IPv6, а также для DNS 1 и DNS 2, для Wi-Fi (WLAN) применяется такое же описание, как и в случае <a href=\"#ETHERNET_IPV4_PROTOCOL\">Ethernet (LAN)</a>.",
        "FRENCH": "Pour le protocole IPv4 et IPv6 ainsi que pour DNS 1 et DNS 2, la même description s'applique au Wi-Fi (WLAN) qu'en cas de <a href=\"#ETHERNET_IPV4_PROTOCOL\">Ethernet (LAN)</a>.",
        "SPANISH": "Para el protocolo IPv4 e IPv6, así como para DNS 1 y DNS 2, se aplica la misma descripción para Wi-Fi (WLAN) que en el caso de <a href=\"#ETHERNET_IPV4_PROTOCOL\">Ethernet (LAN)</a>.",
        "ITALIAN": "Per il protocollo IPv4 e IPv6 così come per DNS 1 e DNS 2, la stessa descrizione si applica al Wi-Fi (WLAN) come nel caso di <a href=\"#ETHERNET_IPV4_PROTOCOL\">Ethernet (LAN)</a>.",
        "CHINESE": "对于 IPv4 和 IPv6 协议以及 DNS 1 和 DNS 2，Wi-Fi (WLAN) 的描述与 <a href=\"#ETHERNET_IPV4_PROTOCOL\">Ethernet (LAN)</a> 相同。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Для протокола IPv4 и IPv6, а также для DNS 1 и DNS 2, для Wi-Fi (WLAN) применяется такое же описание, как и в случае <a href=\"#ETHERNET_IPV4_PROTOCOL\">Ethernet (LAN)</a>.",
        "FRENCH": "Pour le protocole IPv4 et IPv6 ainsi que pour DNS 1 et DNS 2, la même description s'applique au Wi-Fi (WLAN) qu'en cas de <a href=\"#ETHERNET_IPV4_PROTOCOL\">Ethernet (LAN)</a>.",
        "SPANISH": "Para el protocolo IPv4 e IPv6, así como para DNS 1 y DNS 2, se aplica la misma descripción para Wi-Fi (WLAN) que en el caso de <a href=\"#ETHERNET_IPV4_PROTOCOL\">Ethernet (LAN)</a>.",
        "ITALIAN": "Per il protocollo IPv4 e IPv6 così come per DNS 1 e DNS 2, la stessa descrizione si applica al Wi-Fi (WLAN) come nel caso di <a href=\"#ETHERNET_IPV4_PROTOCOL\">Ethernet (LAN)</a>.",
        "CHINESE": "对于 IPv4 和 IPv6 协议以及 DNS 1 和 DNS 2，Wi-Fi (WLAN) 的描述与 <a href=\"#ETHERNET_IPV4_PROTOCOL\">Ethernet (LAN)</a> 相同。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
