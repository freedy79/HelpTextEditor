    "TCA_EXAMPLE_SHOW_MESSAGE_CONF_STEP_1_I": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Enter the content of the message to be displayed, such as [Carry out daily cleaning and testing of the balance as per the SOP].",
        "GERMAN": "Geben Sie den Nachrichteninhalt ein der angezeigt werden soll, z. B. [Tägliche Reinigung und Prüfung der Waage gemäß SOP durchführen.].",
        "RUSSIAN": "Введите содержание отображаемого сообщения, например, [Выполняйте ежедневную очистку и тестирование весов в соответствии с SOP].",
        "FRENCH": "Saisissez le contenu du message à afficher, tel que [Effectuer le nettoyage et le test quotidiens de la balance conformément à la SOP].",
        "SPANISH": "Introduzca el contenido del mensaje a mostrar, como por ejemplo [Realizar la limpieza y comprobación diaria de la balanza según el PNT].",
        "ITALIAN": "Inserire il contenuto del messaggio da visualizzare, come ad esempio [Carry out daily cleaning and testing of the balance as per the SOP].",
        "CHINESE": "输入要显示的信息内容，例如 [按照 SOP 对天平进行日常清洁和测试]。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Введите содержание отображаемого сообщения, например, [Выполняйте ежедневную очистку и тестирование весов в соответствии с SOP].",
        "FRENCH": "Saisissez le contenu du message à afficher, tel que [Effectuer le nettoyage et le test quotidiens de la balance conformément à la SOP].",
        "SPANISH": "Introduzca el contenido del mensaje a mostrar, como por ejemplo [Realizar la limpieza y comprobación diaria de la balanza según el PNT].",
        "ITALIAN": "Inserire il contenuto del messaggio da visualizzare, come ad esempio [Carry out daily cleaning and testing of the balance as per the SOP].",
        "CHINESE": "输入要显示的信息内容，例如 [按照 SOP 对天平进行日常清洁和测试]。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
