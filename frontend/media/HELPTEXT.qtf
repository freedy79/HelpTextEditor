      "TRANSLATIONS": {
        "ENGLISH": "Domain components, the root of the LDAP director, mostly the company domain.",
        "GERMAN": "Domänenkomponente, die Wurzel des LDAP-Verzeichnisses, meist die Firmendomäne.",
        "RUSSIAN": "Компоненты домена, корень директора LDAP, в основном домена компании.",
        "FRENCH": "Composants du domaine, la racine du directeur LDAP, le plus souvent le domaine de l'entreprise.",
        "SPANISH": "Componentes del dominio, la raíz del director LDAP, principalmente el dominio de la empresa.",
        "ITALIAN": "Componenti del dominio, la radice del direttore LDAP, per lo più il dominio aziendale.",
        "CHINESE": "域组件，即 LDAP 管理器的根，主要是公司域。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Компоненты домена, корень директора LDAP, в основном домена компании.",
        "FRENCH": "Composants du domaine, la racine du directeur LDAP, le plus souvent le domaine de l'entreprise.",
        "SPANISH": "Componentes del dominio, la raíz del director LDAP, principalmente el dominio de la empresa.",
        "ITALIAN": "Componenti del dominio, la radice del direttore LDAP, per lo più il dominio aziendale.",
        "CHINESE": "域组件，即 LDAP 管理器的根，主要是公司域。"
      },
