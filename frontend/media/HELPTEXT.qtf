      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "<b>Short:</b> Short delay for normal conditions (default setting).",
        "GERMAN": "<b>Kurz:</b> Kurze Verzögerung für normale Bedingungen (Voreinstellung).",
        "RUSSIAN": "<b>Короткая:</b> Короткая задержка для нормальных условий (настройка по умолчанию).",
        "FRENCH": "<b>Short:</b> Délai court pour les conditions normales (réglage par défaut).",
        "SPANISH": "<b>Corto:</b> Retardo corto para condiciones normales (ajuste por defecto).",
        "ITALIAN": "<b>Breve:</b> Ritardo breve per condizioni normali (impostazione predefinita).",
        "CHINESE": "<b>短：</b>正常情况下的短延迟（默认设置）。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "<b>Короткая:</b> Короткая задержка для нормальных условий (настройка по умолчанию).",
        "FRENCH": "<b>Short:</b> Délai court pour les conditions normales (réglage par défaut).",
        "SPANISH": "<b>Corto:</b> Retardo corto para condiciones normales (ajuste por defecto).",
        "ITALIAN": "<b>Breve:</b> Ritardo breve per condizioni normali (impostazione predefinita).",
        "CHINESE": "<b>短：</b>正常情况下的短延迟（默认设置）。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "WEIGHING_STABILITY_DELAY_INSTRUCTION_1_STEP_3": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "Do not translate HTML command <b> and </b>",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "<b>Medium:</b> Medium delay e.g., for bridging turbulences in the weighing room, which (in case of analysis balances) are caused by the door closing.",
        "GERMAN": "<b>Mittel:</b> Mittlere Verzögerung, z. B. zur Überbrückung von Turbulenzen im Wägeraum, welche ( z. B. bei Analysewaagen) auf das Schließen der Tür zurückzuführen sind.",
        "RUSSIAN": "<b>Medium:</b> Средняя задержка, например, для преодоления воздушной турбулентности в комнате, которая (в случае аналитических весов) вызывается закрытием двери.",
        "FRENCH": "<b>Moyen:</b> Retard moyen, par exemple pour le pontage des turbulences dans la salle de pesée, qui (dans le cas des balances d'analyse) sont causées par la fermeture de la porte.",
        "SPANISH": "<b>Medio:</b> Retraso medio, por ejemplo, para salvar las turbulencias en la sala de pesaje, que (en el caso de las balanzas de análisis) son causadas por el cierre de la puerta.",
        "ITALIAN": "<b>Medio:</b> Ritardo medio, ad esempio, per superare le turbolenze nella stanza di pesatura, che (nel caso delle bilance analitiche) sono causate dalla chiusura della porta.",
        "CHINESE": "<b>中：</b>中等延迟，例如，用于消除称量室内的湍流，（在分析天平中）湍流是由门关闭引起的。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "<b>Medium:</b> Средняя задержка, например, для преодоления воздушной турбулентности в комнате, которая (в случае аналитических весов) вызывается закрытием двери.",
        "FRENCH": "<b>Moyen:</b> Retard moyen, par exemple pour le pontage des turbulences dans la salle de pesée, qui (dans le cas des balances d'analyse) sont causées par la fermeture de la porte.",
        "SPANISH": "<b>Medio:</b> Retraso medio, por ejemplo, para salvar las turbulencias en la sala de pesaje, que (en el caso de las balanzas de análisis) son causadas por el cierre de la puerta.",
        "ITALIAN": "<b>Medio:</b> Ritardo medio, ad esempio, per superare le turbolenze nella stanza di pesatura, che (nel caso delle bilance analitiche) sono causate dalla chiusura della porta.",
        "CHINESE": "<b>中：</b>中等延迟，例如，用于消除称量室内的湍流，（在分析天平中）湍流是由门关闭引起的。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "WEIGHING_STABILITY_DELAY_INSTRUCTION_1_STEP_4": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "Do not translate HTML command <b> and </b>",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "<b>Long:</b> Long delay, for longer lasting disturbances and more unrest.",
        "GERMAN": "<b>Lang:</b> Lange Verzögerung, bei länger anhaltenden Störungen und mehr Unruhe.",
        "RUSSIAN": "<b>Длинный:</b> Длительная задержка, для более длительных помех и больших колебаний.",
        "FRENCH": "<b>Long : </b> Long délai, pour des perturbations plus durables et plus d'agitation.",
        "SPANISH": "<b>Largo:</b> Retraso prolongado, para que las perturbaciones sean más duraderas y el malestar sea mayor.",
        "ITALIAN": "<b>Lungo:</b> Ritardo lungo, per disturbi più duraturi e più disordini.",
        "CHINESE": "<b>长：</b>长延时，用于更持久的干扰和更多的动荡。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "<b>Длинный:</b> Длительная задержка, для более длительных помех и больших колебаний.",
        "FRENCH": "<b>Long : </b> Long délai, pour des perturbations plus durables et plus d'agitation.",
        "SPANISH": "<b>Largo:</b> Retraso prolongado, para que las perturbaciones sean más duraderas y el malestar sea mayor.",
        "ITALIAN": "<b>Lungo:</b> Ritardo lungo, per disturbi più duraturi e più disordini.",
        "CHINESE": "<b>长：</b>长延时，用于更持久的干扰和更多的动荡。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
