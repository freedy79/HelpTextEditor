    "EXAMPLE_CREATE_LOCAL_USER_APPL_STEP_1": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "If no password was assigned while creating the user, the first entry of the password is done now.",
        "GERMAN": "Falls beim Anlegen des Benutzers kein Passwort vergeben wurde, erfolgt jetzt die Erst-Eingabe des Passworts.",
        "RUSSIAN": "Если при создании пользователя пароль не был назначен, то первый ввод пароля выполняется сейчас.",
        "FRENCH": "Si aucun mot de passe n'a été attribué lors de la création de l'utilisateur, la première entrée du mot de passe est effectuée maintenant.",
        "SPANISH": "Si no se asignó ninguna contraseña al crear el usuario, la primera entrada de la contraseña se realiza ahora.",
        "ITALIAN": "Se non è stata assegnata alcuna password durante la creazione dell'utente, il primo inserimento della password viene fatto ora.",
        "CHINESE": "如果在创建用户时没有指定密码，则现在开始首次输入密码。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Если при создании пользователя пароль не был назначен, то первый ввод пароля выполняется сейчас.",
        "FRENCH": "Si aucun mot de passe n'a été attribué lors de la création de l'utilisateur, la première entrée du mot de passe est effectuée maintenant.",
        "SPANISH": "Si no se asignó ninguna contraseña al crear el usuario, la primera entrada de la contraseña se realiza ahora.",
        "ITALIAN": "Se non è stata assegnata alcuna password durante la creazione dell'utente, il primo inserimento della password viene fatto ora.",
        "CHINESE": "如果在创建用户时没有指定密码，则现在开始首次输入密码。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "EXAMPLE_CREATE_LOCAL_USER_APPL_STEP_1_A": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Press the [New password] button and enter your desired password.",
        "GERMAN": "Drücken Sie die Schaltfläche [Neues Passwort] und geben Sie Ihr gewünschtes Passwort ein.",
        "RUSSIAN": "Нажмите кнопку [Новый пароль] и введите желаемый пароль.",
        "FRENCH": "Appuyez sur le bouton [Nouveau mot de passe] et saisissez le mot de passe de votre choix.",
        "SPANISH": "Pulse el botón [Nueva contraseña] e introduzca la contraseña que desee.",
        "ITALIAN": "Premere il pulsante [Nuova password] e inserire la password desiderata.",
        "CHINESE": "按下 [新密码] 按钮并输入所需的密码。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Нажмите кнопку [Новый пароль] и введите желаемый пароль.",
        "FRENCH": "Appuyez sur le bouton [Nouveau mot de passe] et saisissez le mot de passe de votre choix.",
        "SPANISH": "Pulse el botón [Nueva contraseña] e introduzca la contraseña que desee.",
        "ITALIAN": "Premere il pulsante [Nuova password] e inserire la password desiderata.",
        "CHINESE": "按下 [新密码] 按钮并输入所需的密码。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "EXAMPLE_CREATE_LOCAL_USER_APPL_STEP_1_B": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the control characters <BR>.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "After confirmation, your password must be entered again for security reasons. <BR>If the password entered both the times is identical, then you get the confirmation that your password has been changed successfully.",
        "GERMAN": "Nach der Bestätigung muss zur Sicherheit Ihr Passwort erneut eingegeben werden. <BR>Bei identischer Eingabe erhalten Sie die Bestätigung, dass Ihr Passwort erfolgreich geändert wurde.",
        "RUSSIAN": "После подтверждения в целях безопасности необходимо снова ввести пароль. <BR>Если пароль, введенный оба раза, идентичен, то вы получите подтверждение, что ваш пароль был успешно изменен.",
        "FRENCH": "Après confirmation, votre mot de passe doit être saisi à nouveau pour des raisons de sécurité. <BR>Si le mot de passe saisi les deux fois est identique, alors vous obtenez la confirmation que votre mot de passe a été modifié avec succès.",
        "SPANISH": "Después de la confirmación, su contraseña debe ser introducida de nuevo por razones de seguridad. <BR>Si la contraseña introducida las dos veces es idéntica, entonces obtendrá la confirmación de que su contraseña ha sido cambiada con éxito.",
        "ITALIAN": "Dopo la conferma, la tua password deve essere inserita di nuovo per ragioni di sicurezza. <BR>Se la password inserita entrambe le volte è identica, allora avrai la conferma che la tua password è stata cambiata con successo.",
        "CHINESE": "确认后，出于安全考虑，您必须再次输入密码。<BR>如果两次输入的密码相同，则确认密码已成功更改。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "После подтверждения в целях безопасности необходимо снова ввести пароль. <BR>Если пароль, введенный оба раза, идентичен, то вы получите подтверждение, что ваш пароль был успешно изменен.",
        "FRENCH": "Après confirmation, votre mot de passe doit être saisi à nouveau pour des raisons de sécurité. <BR>Si le mot de passe saisi les deux fois est identique, alors vous obtenez la confirmation que votre mot de passe a été modifié avec succès.",
        "SPANISH": "Después de la confirmación, su contraseña debe ser introducida de nuevo por razones de seguridad. <BR>Si la contraseña introducida las dos veces es idéntica, entonces obtendrá la confirmación de que su contraseña ha sido cambiada con éxito.",
        "ITALIAN": "Dopo la conferma, la tua password deve essere inserita di nuovo per ragioni di sicurezza. <BR>Se la password inserita entrambe le volte è identica, allora avrai la conferma che la tua password è stata cambiata con successo.",
        "CHINESE": "确认后，出于安全考虑，您必须再次输入密码。<BR>如果两次输入的密码相同，则确认密码已成功更改。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "EXAMPLE_CREATE_LOCAL_USER_APPL_NOTE": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Note: Keep your password safe; if lost, it must then be deleted by the [Administrator] user.",
        "GERMAN": "Anmerkung: Merken Sie sich Ihr Passwort, beim Verlust muss es durch den Benutzer [Administrator] gelöscht werden.",
        "RUSSIAN": "Примечание: Храните свой пароль в безопасности; в случае утери он должен быть удален пользователем [Администратор].",
        "FRENCH": "Note : Gardez votre mot de passe en sécurité ; s'il est perdu, il doit être supprimé par l'utilisateur [Administrateur].",
        "SPANISH": "Nota: Guarde su contraseña; si la pierde, debe ser borrada por el usuario [Administrador].",
        "ITALIAN": "Nota: tieni la tua password al sicuro; se la perdi, deve essere cancellata dall'utente [Administrator].",
        "CHINESE": "注意：请妥善保管密码；如果密码丢失，必须由 [Administrator] 用户删除。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Примечание: Храните свой пароль в безопасности; в случае утери он должен быть удален пользователем [Администратор].",
        "FRENCH": "Note : Gardez votre mot de passe en sécurité ; s'il est perdu, il doit être supprimé par l'utilisateur [Administrateur].",
        "SPANISH": "Nota: Guarde su contraseña; si la pierde, debe ser borrada por el usuario [Administrador].",
        "ITALIAN": "Nota: tieni la tua password al sicuro; se la perdi, deve essere cancellata dall'utente [Administrator].",
        "CHINESE": "注意：请妥善保管密码；如果密码丢失，必须由 [Administrator] 用户删除。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
