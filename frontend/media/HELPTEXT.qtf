    "TIMER_CNTRL_ACTION_EXAMPLES_INSTRUCTION_1": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The application examples relate to the MCA version from package 09-03-04.01.xx onwards, along with the settings options and functionalities it contains. Appropriate user rights are required for setting up the timer-controlled actions.",
        "GERMAN": "Die Anwendungsbeispiele beziehen sich auf die MCA Version ab Package 09-03-04.01.xx mit den darin enthaltenen Einstellmöglichkeiten und Funktionalitäten. Für das Einrichten der zeitgesteuerten Aktionen werden entsprechende Benutzerrechte benötigt.",
        "RUSSIAN": "Примеры применения относятся к версии MCA, начиная с пакета 09-03-04.01.xx и далее, вместе с опциями настройки и функциональными возможностями, которые она содержит. Для настройки действий, управляемых таймером, требуются соответствующие права пользователя.",
        "FRENCH": "Les exemples d'application concernent la version du MCA à partir du package 09-03-04.01.xx, ainsi que les options de réglage et les fonctionnalités qu'elle contient. Des droits d'utilisateur appropriés sont nécessaires pour configurer les actions commandées par minuterie.",
        "SPANISH": "Los ejemplos de aplicación se refieren a la versión de MCA a partir del paquete 09-03-04.01.xx, junto con las opciones de configuración y las funcionalidades que contiene. Para configurar las acciones controladas por el temporizador se requieren los derechos de usuario adecuados.",
        "ITALIAN": "Gli esempi di applicazione si riferiscono alla versione MCA dal pacchetto 09-03-04.01.xx in poi, insieme alle opzioni di impostazione e alle funzionalità che contiene. Per l'impostazione delle azioni controllate dal timer sono necessari i diritti utente appropriati.",
        "CHINESE": "应用示例涉及从软件包 09-03-04.01.xx 起的 MCA 版本及其包含的设置选项和功能。设置定时器控制的操作需要适当的用户权限。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Примеры применения относятся к версии MCA, начиная с пакета 09-03-04.01.xx и далее, вместе с опциями настройки и функциональными возможностями, которые она содержит. Для настройки действий, управляемых таймером, требуются соответствующие права пользователя.",
        "FRENCH": "Les exemples d'application concernent la version du MCA à partir du package 09-03-04.01.xx, ainsi que les options de réglage et les fonctionnalités qu'elle contient. Des droits d'utilisateur appropriés sont nécessaires pour configurer les actions commandées par minuterie.",
        "SPANISH": "Los ejemplos de aplicación se refieren a la versión de MCA a partir del paquete 09-03-04.01.xx, junto con las opciones de configuración y las funcionalidades que contiene. Para configurar las acciones controladas por el temporizador se requieren los derechos de usuario adecuados.",
        "ITALIAN": "Gli esempi di applicazione si riferiscono alla versione MCA dal pacchetto 09-03-04.01.xx in poi, insieme alle opzioni di impostazione e alle funzionalità che contiene. Per l'impostazione delle azioni controllate dal timer sono necessari i diritti utente appropriati.",
        "CHINESE": "应用示例涉及从软件包 09-03-04.01.xx 起的 MCA 版本及其包含的设置选项和功能。设置定时器控制的操作需要适当的用户权限。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "TCA_EXAMPLE_START_TASK_TITLE": {
