    "WLAN_SSID_PASSWORD_INSTRUCTION_2": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "For authentication, the MCA balance supports the standards WEP, WPA-PSK and WPA2-PSK and hence also the PSK method for encryption.",
        "GERMAN": "Die MCA Waage unterstützt zur Authentifizierung die Standards WEP, WPA-PSK und WPA2-PSK und somit das PSK Verfahren zur Verschlüsselung.",
        "RUSSIAN": "Для аутентификации весы MCA поддерживает стандарты WEP, WPA-PSK и WPA2-PSK, а следовательно, и метод PSK для шифрования.",
        "FRENCH": "Pour l'authentification, la balance MCA supporte les standards WEP, WPA-PSK et WPA2-PSK et donc aussi la méthode PSK pour le cryptage.",
        "SPANISH": "Para la autenticación, la balanza MCA admite los estándares WEP, WPA-PSK y WPA2-PSK y, por tanto, también el método PSK para el cifrado.",
        "ITALIAN": "Per l'autenticazione, la bilancia MCA supporta gli standard WEP, WPA-PSK e WPA2-PSK e quindi anche il metodo PSK per la crittografia.",
        "CHINESE": "在身份验证方面，MCA 平衡支持 WEP、WPA-PSK 和 WPA2-PSK 标准，因此也支持 PSK 加密方法。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Для аутентификации весы MCA поддерживает стандарты WEP, WPA-PSK и WPA2-PSK, а следовательно, и метод PSK для шифрования.",
        "FRENCH": "Pour l'authentification, la balance MCA supporte les standards WEP, WPA-PSK et WPA2-PSK et donc aussi la méthode PSK pour le cryptage.",
        "SPANISH": "Para la autenticación, la balanza MCA admite los estándares WEP, WPA-PSK y WPA2-PSK y, por tanto, también el método PSK para el cifrado.",
        "ITALIAN": "Per l'autenticazione, la bilancia MCA supporta gli standard WEP, WPA-PSK e WPA2-PSK e quindi anche il metodo PSK per la crittografia.",
        "CHINESE": "在身份验证方面，MCA 平衡支持 WEP、WPA-PSK 和 WPA2-PSK 标准，因此也支持 PSK 加密方法。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
