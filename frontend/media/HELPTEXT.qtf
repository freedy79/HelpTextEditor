      "TRANSLATIONS": {
        "ENGLISH": "Navigate to [Device settings] -> [Device cleaning]",
        "GERMAN": "Navigieren Sie zu [Geräteeinstellungen] -> [Gerätereinigung]",
        "CHINESE": "导航至 [设备设置] -> [设备清洁］",
        "FRENCH": "Naviguez vers [Réglages de l'appareil] -> [Nettoyage de l'appareil].",
        "SPANISH": "Navegue hasta [Device settings] -> [Device cleaning].",
        "RUSSIAN": "Перейдите в меню [Настройки устройства] -> [Очистка устройства].",
        "ITALIAN": "Spostarsi su [Impostazioni dispositivo] -> [Pulizia dispositivo]."
      },
      "AUTOTRANSLATIONS": {
        "CHINESE": "导航至 [设备设置] -> [设备清洁］",
        "FRENCH": "Naviguez vers [Réglages de l'appareil] -> [Nettoyage de l'appareil].",
        "SPANISH": "Navegue hasta [Device settings] -> [Device cleaning].",
        "RUSSIAN": "Перейдите в меню [Настройки устройства] -> [Очистка устройства].",
        "ITALIAN": "Spostarsi su [Impostazioni dispositivo] -> [Pulizia dispositivo]."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "CHINESE": false,
        "FRENCH": false,
        "SPANISH": false,
