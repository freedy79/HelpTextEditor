      }
    },
    "VIEW_AUDIT_TRAIL_VIA_BROWSER_CONF_STEP_1_A": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ]. Do not translate QAPP and QAPP Center.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Open the [Task management] menu, followed by the [QAPP Center].",
        "GERMAN": "Das Menü [Task-Verwaltung] und dann das [QAPP Center] öffnen.",
        "RUSSIAN": "Откройте меню [Управление задачами], а затем [QAPP Center].",
        "FRENCH": "Ouvrez le menu [Gestion des tâches], puis le [Centre QAPP].",
        "SPANISH": "Abra el menú [Gestión de tareas], seguido del [Centro QAPP].",
        "ITALIAN": "Apri il menu [Task management], seguito dal [QAPP Center].",
        "CHINESE": "打开 [任务管理] 菜单，然后打开 [QAPP 中心]。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Откройте меню [Управление задачами], а затем [QAPP Center].",
        "FRENCH": "Ouvrez le menu [Gestion des tâches], puis le [Centre QAPP].",
        "SPANISH": "Abra el menú [Gestión de tareas], seguido del [Centro QAPP].",
        "ITALIAN": "Apri il menu [Task management], seguito dal [QAPP Center].",
        "CHINESE": "打开 [任务管理] 菜单，然后打开 [QAPP 中心]。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "VIEW_AUDIT_TRAIL_VIA_BROWSER_CONF_STEP_1_B": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ]. Do not translate QAPP and QAPP Center.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Select the software package [Pharma] and QAPP [Audit trail] in it. The description and version of the QAPP will be displayed.",
        "GERMAN": "Wählen Sie das Software-Paket [Pharma] und darin die QAPP [Audit trail]. Es wird die Beschreibung und Version der QAPP angezeigt.",
        "RUSSIAN": "Выберите пакет программного обеспечения [Pharma] и QAPP [Audit trail] в нем. Появится описание и версия QAPP.",
        "FRENCH": "Sélectionnez le progiciel [Pharma] et le QAPP [Audit trail] dans celui-ci. La description et la version du QAPP s'affichent.",
        "SPANISH": "Seleccione el paquete de software [Pharma] y el QAPP [Audit trail] en él. Se mostrará la descripción y la versión del QAPP.",
        "ITALIAN": "Seleziona il pacchetto software [Pharma] e il QAPP [Audit trail] in esso. Verranno visualizzate la descrizione e la versione del QAPP.",
        "CHINESE": "选择软件包 [Pharma] 和其中的 QAPP [Audit trail]。将显示 QAPP 的说明和版本。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Выберите пакет программного обеспечения [Pharma] и QAPP [Audit trail] в нем. Появится описание и версия QAPP.",
        "FRENCH": "Sélectionnez le progiciel [Pharma] et le QAPP [Audit trail] dans celui-ci. La description et la version du QAPP s'affichent.",
        "SPANISH": "Seleccione el paquete de software [Pharma] y el QAPP [Audit trail] en él. Se mostrará la descripción y la versión del QAPP.",
        "ITALIAN": "Seleziona il pacchetto software [Pharma] e il QAPP [Audit trail] in esso. Verranno visualizzate la descrizione e la versione del QAPP.",
        "CHINESE": "选择软件包 [Pharma] 和其中的 QAPP [Audit trail]。将显示 QAPP 的说明和版本。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
