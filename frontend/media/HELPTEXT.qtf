      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Following are the prerequisites for an automatic execution of isoCAL:",
        "GERMAN": "Voraussetzungen für eine automatische Ausführung von isoCAL sind:",
        "RUSSIAN": "Ниже перечислены необходимые условия для автоматического выполнения isoCAL:",
        "FRENCH": "Voici les conditions préalables à l'exécution automatique d'isoCAL :",
        "SPANISH": "Los siguientes son los requisitos previos para una ejecución automática de isoCAL:",
        "ITALIAN": "I seguenti sono i prerequisiti per un'esecuzione automatica di isoCAL:",
        "CHINESE": "以下是自动执行 isoCAL 的前提条件："
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Ниже перечислены необходимые условия для автоматического выполнения isoCAL:",
        "FRENCH": "Voici les conditions préalables à l'exécution automatique d'isoCAL :",
        "SPANISH": "Los siguientes son los requisitos previos para una ejecución automática de isoCAL:",
        "ITALIAN": "I seguenti sono i prerequisiti per un'esecuzione automatica di isoCAL:",
        "CHINESE": "以下是自动执行 isoCAL 的前提条件："
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
