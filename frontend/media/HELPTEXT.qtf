    "EXAMPLE_WITH_NEW_PROFILE_APPL_STEP_1": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "For example, start the task [My weighing with the unit g, ct, lb] with the weighing profile [Weighing with the unit g, ct, lb] assigned to it.",
        "GERMAN": "Starten Sie die Task z. B. [Mein Wägen mit der Einheit g, ct, lb] mit dem darin zugewiesenen Wägenprofil [Wägen mit der Einheit g, ct, lb].",
        "RUSSIAN": "Например, запустите задание [Мое взвешивание с единицей измерения g, ct, lb] с назначенным ему профилем взвешивания [Взвешивание с единицей измерения g, ct, lb].",
        "FRENCH": "Par exemple, démarrez la tâche [Ma pesée avec l'unité g, ct, lb] avec le profil de pesée [Pesée avec l'unité g, ct, lb] qui lui est attribué.",
        "SPANISH": "Por ejemplo, inicie la tarea [Mi pesaje con la unidad g, ct, lb] con el perfil de pesaje [Pesaje con la unidad g, ct, lb] asignado.",
        "ITALIAN": "Per esempio, avviate l'ordine [La mia pesatura con l'unità g, ct, lb] con il profilo di pesatura [Pesatura con l'unità g, ct, lb] assegnato ad esso.",
        "CHINESE": "例如，启动任务 [以 g、ct、lb 为单位进行称重]，并为其分配称重配置文件 [以 g、ct、lb 为单位进行称重]。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Например, запустите задание [Мое взвешивание с единицей измерения g, ct, lb] с назначенным ему профилем взвешивания [Взвешивание с единицей измерения g, ct, lb].",
        "FRENCH": "Par exemple, démarrez la tâche [Ma pesée avec l'unité g, ct, lb] avec le profil de pesée [Pesée avec l'unité g, ct, lb] qui lui est attribué.",
        "SPANISH": "Por ejemplo, inicie la tarea [Mi pesaje con la unidad g, ct, lb] con el perfil de pesaje [Pesaje con la unidad g, ct, lb] asignado.",
        "ITALIAN": "Per esempio, avviate l'ordine [La mia pesatura con l'unità g, ct, lb] con il profilo di pesatura [Pesatura con l'unità g, ct, lb] assegnato ad esso.",
        "CHINESE": "例如，启动任务 [以 g、ct、lb 为单位进行称重]，并为其分配称重配置文件 [以 g、ct、lb 为单位进行称重]。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "EXAMPLE_WITH_NEW_PROFILE_APPL_STEP_2": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "If you have selected identifiers for the batch, these must now be entered or scanned.",
        "GERMAN": "Falls Sie Bezeichner für die Charge gewählt haben, müssen diese jetzt eingegeben oder eingescannt werden.",
        "RUSSIAN": "Если вы выбрали идентификаторы для партии, их необходимо ввести или отсканировать.",
        "FRENCH": "Si vous avez sélectionné des identifiants pour le lot, ceux-ci doivent maintenant être saisis ou scannés.",
        "SPANISH": "Si ha seleccionado identificadores para el lote, estos deben ser introducidos o escaneados.",
        "ITALIAN": "Se avete selezionato degli identificatori per il lotto, questi devono ora essere inseriti o scannerizzati.",
        "CHINESE": "如果您为批次选择了标识符，现在必须输入或扫描这些标识符。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Если вы выбрали идентификаторы для партии, их необходимо ввести или отсканировать.",
        "FRENCH": "Si vous avez sélectionné des identifiants pour le lot, ceux-ci doivent maintenant être saisis ou scannés.",
        "SPANISH": "Si ha seleccionado identificadores para el lote, estos deben ser introducidos o escaneados.",
        "ITALIAN": "Se avete selezionato degli identificatori per il lotto, questi devono ora essere inseriti o scannerizzati.",
        "CHINESE": "如果您为批次选择了标识符，现在必须输入或扫描这些标识符。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "EXAMPLE_WITH_NEW_PROFILE_APPL_STEP_3": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The [Weighing] application is then activated with the settings defined in the weighing profile for the weighing behavior.",
        "GERMAN": "Anschließend erfolgt die Aktivierung der Anwendung [Wägen] mit den im Wägeprofil festgelegten Einstellungen für das Wägeverhalten.",
        "RUSSIAN": "Затем активируется приложение [Взвешивание] с настройками, определенными в профиле взвешивания для поведения взвешивания.",
        "FRENCH": "L'application [Pesage] est alors activée avec les paramètres définis dans le profil de pesage pour le comportement de pesage.",
        "SPANISH": "A continuación, se activa la aplicación [Pesaje] con los ajustes definidos en el perfil de pesaje para el comportamiento de pesaje.",
        "ITALIAN": "L'applicazione [Pesatura] viene quindi attivata con le impostazioni definite nel profilo di pesatura per il comportamento di pesatura.",
        "CHINESE": "然后，[称重] 应用程序将根据称重配置文件中定义的称重行为设置启动。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Затем активируется приложение [Взвешивание] с настройками, определенными в профиле взвешивания для поведения взвешивания.",
        "FRENCH": "L'application [Pesage] est alors activée avec les paramètres définis dans le profil de pesage pour le comportement de pesage.",
        "SPANISH": "A continuación, se activa la aplicación [Pesaje] con los ajustes definidos en el perfil de pesaje para el comportamiento de pesaje.",
        "ITALIAN": "L'applicazione [Pesatura] viene quindi attivata con le impostazioni definite nel profilo di pesatura per il comportamento di pesatura.",
        "CHINESE": "然后，[称重] 应用程序将根据称重配置文件中定义的称重行为设置启动。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "EXAMPLE_WITH_NEW_PROFILE_APPL_STEP_4": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Press the button with the displayed unit, the released units and resolutions are displayed in a list.",
        "GERMAN": "Betätigen Sie die Schaltfläche mit der angezeigten Einheit, die freigegebene Einheiten und Auflösungen werden in einer Liste angezeigt.",
        "RUSSIAN": "Нажмите кнопку с отображаемой единицей измерения, разрешенные единицы измерения и разрешения отобразятся в списке.",
        "FRENCH": "Appuyez sur le bouton avec l'unité affichée, les unités et résolutions libérées sont affichées dans une liste.",
        "SPANISH": "Pulse el botón con la unidad mostrada, las unidades y resoluciones liberadas se muestran en una lista.",
        "ITALIAN": "Premere il pulsante con l'unità visualizzata, le unità e le risoluzioni rilasciate vengono visualizzate in una lista.",
        "CHINESE": "按下显示单位的按钮，列表中将显示已释放的单位和分辨率。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Нажмите кнопку с отображаемой единицей измерения, разрешенные единицы измерения и разрешения отобразятся в списке.",
        "FRENCH": "Appuyez sur le bouton avec l'unité affichée, les unités et résolutions libérées sont affichées dans une liste.",
        "SPANISH": "Pulse el botón con la unidad mostrada, las unidades y resoluciones liberadas se muestran en una lista.",
        "ITALIAN": "Premere il pulsante con l'unità visualizzata, le unità e le risoluzioni rilasciate vengono visualizzate in una lista.",
        "CHINESE": "按下显示单位的按钮，列表中将显示已释放的单位和分辨率。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
