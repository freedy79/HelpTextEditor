    },
    "NETWORK_WLAN_INSTRUCTION_4": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "If a connection has been made, then the unique MAC address of the Wi-Fi USB adapter is also shown here e.g., 34:C9:F0:89:6F:D6.",
        "GERMAN": "Wenn eine Verbindung besteht, dann wird hier auch die eindeutige MAC-Adresse des Wi-Fi USB Adapters dargestellt, z. B. 34:C9:F0:89:6F:D6.",
        "RUSSIAN": "Если соединение установлено, то здесь также отображается уникальный MAC-адрес USB-адаптера Wi-Fi, например, 34:C9:F0:89:6F:D6.",
        "FRENCH": "Si une connexion a été établie, l'adresse MAC unique de l'adaptateur USB Wi-Fi est également indiquée ici, par exemple 34:C9:F0:89:6F:D6.",
        "SPANISH": "Si se ha establecido una conexión, también se muestra aquí la dirección MAC única del adaptador USB Wi-Fi, por ejemplo, 34:C9:F0:89:6F:D6.",
        "ITALIAN": "Se è stata stabilita una connessione, l'indirizzo MAC univoco dell'adattatore Wi-Fi USB è mostrato anche qui, ad esempio 34:C9:F0:89:6F:D6.",
        "CHINESE": "如果已建立连接，则 Wi-Fi USB 适配器的唯一 MAC 地址也会在此显示，例如 34:C9:F0:89:6F:D6。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Если соединение установлено, то здесь также отображается уникальный MAC-адрес USB-адаптера Wi-Fi, например, 34:C9:F0:89:6F:D6.",
        "FRENCH": "Si une connexion a été établie, l'adresse MAC unique de l'adaptateur USB Wi-Fi est également indiquée ici, par exemple 34:C9:F0:89:6F:D6.",
        "SPANISH": "Si se ha establecido una conexión, también se muestra aquí la dirección MAC única del adaptador USB Wi-Fi, por ejemplo, 34:C9:F0:89:6F:D6.",
        "ITALIAN": "Se è stata stabilita una connessione, l'indirizzo MAC univoco dell'adattatore Wi-Fi USB è mostrato anche qui, ad esempio 34:C9:F0:89:6F:D6.",
        "CHINESE": "如果已建立连接，则 Wi-Fi USB 适配器的唯一 MAC 地址也会在此显示，例如 34:C9:F0:89:6F:D6。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
