      "TRANSLATIONS": {
        "ENGLISH": "Set up a connector to a Windows file server e.g., [My SMB server for backup].",
        "GERMAN": "Richten Sie einen Konnektor zu einem Windows File Server ein, z. B. [Mein SMB Server für Backup].",
        "RUSSIAN": "Настройте подключение к файловому серверу Windows, например, [Мой SMB-сервер для резервного копирования].",
        "FRENCH": "Configurez un connecteur vers un serveur de fichiers Windows, par exemple, [Mon serveur SMB pour la sauvegarde].",
        "SPANISH": "Configure un conector a un servidor de archivos de Windows, por ejemplo, [Mi servidor SMB para copias de seguridad].",
        "ITALIAN": "Impostare un connettore a un file server Windows, ad esempio, [Il mio server SMB per il backup].",
        "CHINESE": "设置连接 Windows 文件服务器的连接器，例如[我的 SMB 备份服务器]。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Настройте подключение к файловому серверу Windows, например, [Мой SMB-сервер для резервного копирования].",
        "FRENCH": "Configurez un connecteur vers un serveur de fichiers Windows, par exemple, [Mon serveur SMB pour la sauvegarde].",
        "SPANISH": "Configure un conector a un servidor de archivos de Windows, por ejemplo, [Mi servidor SMB para copias de seguridad].",
        "ITALIAN": "Impostare un connettore a un file server Windows, ad esempio, [Il mio server SMB per il backup].",
        "CHINESE": "设置连接 Windows 文件服务器的连接器，例如[我的 SMB 备份服务器]。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
