      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "See also chapter: <a href=\"#EXAMPLE_CREATE_LOCAL_USER\">Example for creating local user</a>.",
        "GERMAN": "Siehe dazu auch Kapitel: <a href=\"#EXAMPLE_CREATE_LOCAL_USER\">Beispiel für Lokalen Benutzer anlegen</a>.",
        "FRENCH": "Voir également le chapitre : <a href=\"#EXAMPLE_CREATE_LOCAL_USER\">Exemple de création d'un utilisateur local</a>.",
        "SPANISH": "Ver también el capítulo: <a href=\"#EXAMPLE_CREATE_LOCAL_USER\">Ejemplo de creación de usuario local</a>.",
        "ITALIAN": "Vedere anche il capitolo: <a href=\"#EXAMPLE_CREATE_LOCAL_USER\">Esempio per creare un utente locale</a>.",
        "RUSSIAN": "См. также главу: <a href=\"#EXAMPLE_CREATE_LOCAL_USER\">Пример создания локального пользователя</a>.",
        "CHINESE": "另请参阅本章：<a href=\"#EXAMPLE_CREATE_LOCAL_USER\">创建本地用户的示例</a>。"
      },
      "AUTOTRANSLATIONS": {
        "CHINESE": "另请参阅本章：<a href=\"#EXAMPLE_CREATE_LOCAL_USER\">创建本地用户的示例</a>。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "RUSSIAN": false,
