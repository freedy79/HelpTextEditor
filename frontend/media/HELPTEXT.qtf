      "TRANSLATIONS": {
        "ENGLISH": "Description of the Timer-controlled actions for the Cubis® MCA Balance",
        "GERMAN": "Beschreibung der zeitgesteuerten Aktionen für Cubis® MCA Waage",
        "RUSSIAN": "Описание действий, контролируемых таймером, для весов Cubis® MCA",
        "FRENCH": "Description des actions commandées par minuterie pour la balance Cubis® MCA",
        "SPANISH": "Descripción de las acciones controladas por el temporizador para la balanza MCA Cubis®",
        "ITALIAN": "Descrizione delle azioni a tempo per la bilancia Cubis® MCA",
        "CHINESE": "Cubis® MCA 天平的定时控制操作说明"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Описание действий, контролируемых таймером, для весов Cubis® MCA",
        "FRENCH": "Description des actions commandées par minuterie pour la balance Cubis® MCA",
        "SPANISH": "Descripción de las acciones controladas por el temporizador para la balanza MCA Cubis®",
        "ITALIAN": "Descrizione delle azioni a tempo per la bilancia Cubis® MCA",
        "CHINESE": "Cubis® MCA 天平的定时控制操作说明"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
