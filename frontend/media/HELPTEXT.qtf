    "EXAMPLE_SET_LOCAL_PASSW_RULES_ERROR_STEP_1": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
