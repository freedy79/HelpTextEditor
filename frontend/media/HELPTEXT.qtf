    "DEVICE_MAINTENANCE_FIRMWARE_UPDATE_ERROR_HANDLING_INSTRUCTION_1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "For various reasons, you may not be able to perform a firmware update.",
        "GERMAN": "Aus verschiedenen Gründen kann es vorkommen, dass Sie ein Firmware-Update nicht durchführen können.",
        "RUSSIAN": "По различным причинам вы можете не иметь возможности выполнить обновление прошивки.",
        "FRENCH": "Pour diverses raisons, il se peut que vous ne puissiez pas effectuer une mise à jour du micrologiciel.",
        "SPANISH": "Por diversas razones, es posible que no pueda realizar una actualización del firmware.",
        "ITALIAN": "Per vari motivi, potreste non essere in grado di eseguire un aggiornamento del firmware.",
        "CHINESE": "由于各种原因，您可能无法执行固件更新。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "По различным причинам вы можете не иметь возможности выполнить обновление прошивки.",
        "FRENCH": "Pour diverses raisons, il se peut que vous ne puissiez pas effectuer une mise à jour du micrologiciel.",
        "SPANISH": "Por diversas razones, es posible que no pueda realizar una actualización del firmware.",
        "ITALIAN": "Per vari motivi, potreste non essere in grado di eseguire un aggiornamento del firmware.",
        "CHINESE": "由于各种原因，您可能无法执行固件更新。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
