    "TCA_EXAMPLE_EXPORT_AUDIT_TRAIL_ERROR_STEP_5_C": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Set the filter for all or only specific modules, which generate entries in the audit trail and which you want to export.",
        "GERMAN": "Setzen Sie das Filter für alle oder nur bestimme Module, die Einträge im Audit Trail erzeugen und die Sie exportiert haben möchten.",
        "RUSSIAN": "Установите фильтр для всех или только определенных модулей, которые генерируют записи в журнале аудита и которые вы хотите экспортировать.",
        "FRENCH": "Définissez le filtre pour tous les modules ou seulement certains d'entre eux, qui génèrent des entrées dans l'audit trail et que vous souhaitez exporter.",
        "SPANISH": "Establezca el filtro para todos los módulos, o sólo para los específicos, que generan entradas en el registro de auditoría y que desea exportar.",
        "ITALIAN": "Impostare il filtro per tutti i moduli o solo per quelli specifici, che generano voci nella traccia di controllo e che si desidera esportare.",
        "CHINESE": "针对所有或仅针对特定模块设置过滤器，这些模块会在审计跟踪中生成条目，而您希望导出这些条目。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Установите фильтр для всех или только определенных модулей, которые генерируют записи в журнале аудита и которые вы хотите экспортировать.",
        "FRENCH": "Définissez le filtre pour tous les modules ou seulement certains d'entre eux, qui génèrent des entrées dans l'audit trail et que vous souhaitez exporter.",
        "SPANISH": "Establezca el filtro para todos los módulos, o sólo para los específicos, que generan entradas en el registro de auditoría y que desea exportar.",
        "ITALIAN": "Impostare il filtro per tutti i moduli o solo per quelli specifici, che generano voci nella traccia di controllo e che si desidera esportare.",
        "CHINESE": "针对所有或仅针对特定模块设置过滤器，这些模块会在审计跟踪中生成条目，而您希望导出这些条目。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
