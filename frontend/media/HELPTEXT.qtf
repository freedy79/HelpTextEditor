    "NETWORK_WLAN_INSTRUCTION_1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "A Wi-Fi USB adapter (WLAN stick) can be connected to the MCA balance; several adapters of this type are not supported.",
        "GERMAN": "An die MCA Waage kann ein Wi-Fi USB Adapter (WLAN-Stick) angeschlossen werden, mehrere Adapter dieser Art werden nicht unterstützt.",
        "RUSSIAN": "К балансу MCA можно подключить USB-адаптер Wi-Fi (WLAN stick); несколько адаптеров этого типа не поддерживаются.",
        "FRENCH": "Un adaptateur USB Wi-Fi (clé WLAN) peut être connecté à la balance MCA ; plusieurs adaptateurs de ce type ne sont pas pris en charge.",
        "SPANISH": "Se puede conectar un adaptador USB Wi-Fi (WLAN stick) a la balanza MCA; varios adaptadores de este tipo no son compatibles.",
        "ITALIAN": "Un adattatore USB Wi-Fi (WLAN stick) può essere collegato alla bilancia MCA; diversi adattatori di questo tipo non sono supportati.",
        "CHINESE": "Wi-Fi USB 适配器（WLAN 棒）可连接至 MCA 天平；不支持几种此类适配器。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "К балансу MCA можно подключить USB-адаптер Wi-Fi (WLAN stick); несколько адаптеров этого типа не поддерживаются.",
        "FRENCH": "Un adaptateur USB Wi-Fi (clé WLAN) peut être connecté à la balance MCA ; plusieurs adaptateurs de ce type ne sont pas pris en charge.",
        "SPANISH": "Se puede conectar un adaptador USB Wi-Fi (WLAN stick) a la balanza MCA; varios adaptadores de este tipo no son compatibles.",
        "ITALIAN": "Un adattatore USB Wi-Fi (WLAN stick) può essere collegato alla bilancia MCA; diversi adattatori di questo tipo non sono supportati.",
        "CHINESE": "Wi-Fi USB 适配器（WLAN 棒）可连接至 MCA 天平；不支持几种此类适配器。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "NETWORK_WLAN_INSTRUCTION_2": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "In the overview of settings for Wi-Fi (WLAN), it is displayed via the status, whether a corresponding Wi-Fi USB adapter is attached and is connected to the network.",
        "GERMAN": "In der Übersicht der Einstellungen für Wi-Fi (WLAN) wird über den Status angezeigt, ob ein entsprechender Wi-Fi USB Adapter angeschlossen und mit dem Netzwerk verbunden ist.",
        "RUSSIAN": "В обзоре настроек для Wi-Fi (WLAN) отображается статус, подключен ли соответствующий USB-адаптер Wi-Fi и подключен ли он к сети.",
        "FRENCH": "Dans la vue d'ensemble des paramètres pour le Wi-Fi (WLAN), l'état indique si un adaptateur USB Wi-Fi correspondant est connecté et s'il est relié au réseau.",
        "SPANISH": "En la vista general de los ajustes para Wi-Fi (WLAN), se muestra a través del estado, si un adaptador USB Wi-Fi correspondiente está conectado y está conectado a la red.",
        "ITALIAN": "Nella panoramica delle impostazioni per il Wi-Fi (WLAN), viene visualizzato tramite lo stato, se un adattatore USB Wi-Fi corrispondente è collegato ed è connesso alla rete.",
        "CHINESE": "在 Wi-Fi (WLAN) 设置概览中，会通过状态显示是否已连接相应的 Wi-Fi USB 适配器并已与网络连接。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "В обзоре настроек для Wi-Fi (WLAN) отображается статус, подключен ли соответствующий USB-адаптер Wi-Fi и подключен ли он к сети.",
        "FRENCH": "Dans la vue d'ensemble des paramètres pour le Wi-Fi (WLAN), l'état indique si un adaptateur USB Wi-Fi correspondant est connecté et s'il est relié au réseau.",
        "SPANISH": "En la vista general de los ajustes para Wi-Fi (WLAN), se muestra a través del estado, si un adaptador USB Wi-Fi correspondiente está conectado y está conectado a la red.",
        "ITALIAN": "Nella panoramica delle impostazioni per il Wi-Fi (WLAN), viene visualizzato tramite lo stato, se un adattatore USB Wi-Fi corrispondente è collegato ed è connesso alla rete.",
        "CHINESE": "在 Wi-Fi (WLAN) 设置概览中，会通过状态显示是否已连接相应的 Wi-Fi USB 适配器并已与网络连接。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
