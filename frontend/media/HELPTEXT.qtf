      }
    },
    "LDAP_SERVER_SETTINGS_INSTRUCTION_10_1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The role to be used for automatically created users is set with this default setting.",
        "GERMAN": "Mit dieser Voreinstellung wird die Rolle festgelegt, die für automatisch erstellte Nutzer verwendet werden soll.",
        "RUSSIAN": "Роль, которая будет использоваться для автоматически созданных пользователей, устанавливается с помощью этого параметра по умолчанию.",
        "FRENCH": "Le rôle à utiliser pour les utilisateurs créés automatiquement est défini avec ce paramètre par défaut.",
        "SPANISH": "El rol que se utilizará para los usuarios creados automáticamente se establece con esta configuración por defecto.",
        "ITALIAN": "Il ruolo da utilizzare per gli utenti creati automaticamente è impostato con questa impostazione predefinita.",
        "CHINESE": "自动创建的用户所使用的角色通过此默认设置进行设置。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Роль, которая будет использоваться для автоматически созданных пользователей, устанавливается с помощью этого параметра по умолчанию.",
        "FRENCH": "Le rôle à utiliser pour les utilisateurs créés automatiquement est défini avec ce paramètre par défaut.",
        "SPANISH": "El rol que se utilizará para los usuarios creados automáticamente se establece con esta configuración por defecto.",
        "ITALIAN": "Il ruolo da utilizzare per gli utenti creati automaticamente è impostato con questa impostazione predefinita.",
        "CHINESE": "自动创建的用户所使用的角色通过此默认设置进行设置。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "LDAP_SERVER_SETTINGS_HEADLINE_12": {
      "group": "HELP_HEADLINE",
      "topic": "HELPTEXT",
