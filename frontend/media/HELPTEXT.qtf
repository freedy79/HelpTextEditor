    "EXAMPLE_CREATE_LOCAL_USER_APPL_INSTRUCTION": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "After selecting the new user e.g., [My local user], and the [User login] button, the entry of a password is demanded each time this user logs in.",
        "GERMAN": "Mit der Auswahl des neuen Benutzers z. B. [Mein lokaler Anwender] und der Schaltfläche [Benutzer anmelden] wird jetzt für jede Anmeldung von diesem Benutzer die Eingabe von einem Passwort verlangt.",
        "RUSSIAN": "После выбора нового пользователя, например, [Мой локальный пользователь], и нажатия кнопки [Вход пользователя], при каждом входе в систему требуется ввести пароль.",
        "FRENCH": "Après avoir sélectionné le nouvel utilisateur, par exemple [Mon utilisateur local], et le bouton [Connexion de l'utilisateur], la saisie d'un mot de passe est demandée à chaque fois que cet utilisateur se connecte.",
        "SPANISH": "Después de seleccionar el nuevo usuario, por ejemplo, [Mi usuario local], y el botón [Inicio de sesión del usuario], se exige la introducción de una contraseña cada vez que este usuario se conecta.",
        "ITALIAN": "Dopo aver selezionato il nuovo utente, ad esempio, [My local user], e il pulsante [User login], l'inserimento di una password è richiesto ogni volta che questo utente accede.",
        "CHINESE": "选择新用户（如[我的本地用户]）和[用户登录]按钮后，该用户每次登录时都需要输入密码。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "После выбора нового пользователя, например, [Мой локальный пользователь], и нажатия кнопки [Вход пользователя], при каждом входе в систему требуется ввести пароль.",
        "FRENCH": "Après avoir sélectionné le nouvel utilisateur, par exemple [Mon utilisateur local], et le bouton [Connexion de l'utilisateur], la saisie d'un mot de passe est demandée à chaque fois que cet utilisateur se connecte.",
        "SPANISH": "Después de seleccionar el nuevo usuario, por ejemplo, [Mi usuario local], y el botón [Inicio de sesión del usuario], se exige la introducción de una contraseña cada vez que este usuario se conecta.",
        "ITALIAN": "Dopo aver selezionato il nuovo utente, ad esempio, [My local user], e il pulsante [User login], l'inserimento di una password è richiesto ogni volta che questo utente accede.",
        "CHINESE": "选择新用户（如[我的本地用户]）和[用户登录]按钮后，该用户每次登录时都需要输入密码。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
