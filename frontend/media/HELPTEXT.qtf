    "NETWORK_XBPI_PROTOCOL_INSTRUCTION_1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "This binary protocol offers an extended scope of commands. It can be used to control numerous balance functions.",
        "GERMAN": "Dieses binäre Protokoll bietet einen erweiterten Befehlsumfang. Damit können zahlreiche Funktionen der Waage gesteuert werden.",
        "RUSSIAN": "Этот двоичный протокол предлагает расширенный набор команд. Он может использоваться для управления многочисленными функциями весов.",
        "FRENCH": "Ce protocole binaire offre une gamme étendue de commandes. Il peut être utilisé pour contrôler de nombreuses fonctions de la balance.",
        "SPANISH": "Este protocolo binario ofrece una amplia gama de comandos. Puede utilizarse para controlar numerosas funciones de la balanza.",
        "ITALIAN": "Questo protocollo binario offre una gamma estesa di comandi. Può essere usato per controllare numerose funzioni della bilancia.",
        "CHINESE": "这种二进制协议提供更多的命令。它可用于控制多种天平功能。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Этот двоичный протокол предлагает расширенный набор команд. Он может использоваться для управления многочисленными функциями весов.",
        "FRENCH": "Ce protocole binaire offre une gamme étendue de commandes. Il peut être utilisé pour contrôler de nombreuses fonctions de la balance.",
        "SPANISH": "Este protocolo binario ofrece una amplia gama de comandos. Puede utilizarse para controlar numerosas funciones de la balanza.",
        "ITALIAN": "Questo protocollo binario offre una gamma estesa di comandi. Può essere usato per controllare numerose funzioni della bilancia.",
        "CHINESE": "这种二进制协议提供更多的命令。它可用于控制多种天平功能。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
