      "TRANSLATIONS": {
        "ENGLISH": "Add a new timer controlled action \"Start task\"",
        "GERMAN": "Fügen Sie eine neue zeitgesteuerte Aktion \"Task starten\" hinzu",
        "CHINESE": "添加一个新的计时器控制动作 \"开始任务\"。",
        "FRENCH": "Ajoutez une nouvelle action programmée \"Démarrer une tâche\".",
        "SPANISH": "Añadir una nueva acción controlada por temporizador \"Iniciar tarea\".",
        "RUSSIAN": "Добавьте новое управляемое таймером действие \"Запуск задачи\".",
        "ITALIAN": "Aggiungere una nuova azione controllata dal timer \"Avvia attività\"."
      },
      "AUTOTRANSLATIONS": {
        "CHINESE": "添加一个新的计时器控制动作 \"开始任务\"。",
        "FRENCH": "Ajoutez une nouvelle action programmée \"Démarrer une tâche\".",
        "SPANISH": "Añadir una nueva acción controlada por temporizador \"Iniciar tarea\".",
        "RUSSIAN": "Добавьте новое управляемое таймером действие \"Запуск задачи\".",
        "ITALIAN": "Aggiungere una nuova azione controllata dal timer \"Avvia attività\"."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "CHINESE": false,
        "FRENCH": false,
        "SPANISH": false,
