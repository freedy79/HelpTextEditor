    "EXAMPLE_CHANGE_USER_SETTINGS_APPL_INSTRUCTION": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "For logging on to the balance e.g., after power-on or after a user change through logout, you must enter your password as user [Administrator].",
        "GERMAN": "Zur Anmeldung an der Waage, z. B. nach dem Einschalten oder nach einem Benutzerwechsel durch Abmelden, müssen Sie jetzt als Benutzer [Administrator] Ihr Passwort eingeben.",
        "RUSSIAN": "Для входа на весы, например, после включения питания или после смены пользователя через выход из системы, необходимо ввести пароль пользователя [Администратор].",
        "FRENCH": "Pour se connecter à la balance, par exemple après la mise sous tension ou après un changement d'utilisateur par déconnexion, vous devez entrer votre mot de passe en tant qu'utilisateur [Administrateur].",
        "SPANISH": "Para acceder a la balanza, por ejemplo, después de encenderla o tras un cambio de usuario por cierre de sesión, debe introducir su contraseña como usuario [Administrador].",
        "ITALIAN": "Per accedere alla bilancia, ad esempio, dopo l'accensione o dopo un cambio di utente tramite logout, dovete inserire la vostra password come utente [Administrator].",
        "CHINESE": "要登录天平，例如在开机后或通过注销更改用户后，必须输入用户 [Administrator] 的密码。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Для входа на весы, например, после включения питания или после смены пользователя через выход из системы, необходимо ввести пароль пользователя [Администратор].",
        "FRENCH": "Pour se connecter à la balance, par exemple après la mise sous tension ou après un changement d'utilisateur par déconnexion, vous devez entrer votre mot de passe en tant qu'utilisateur [Administrateur].",
        "SPANISH": "Para acceder a la balanza, por ejemplo, después de encenderla o tras un cambio de usuario por cierre de sesión, debe introducir su contraseña como usuario [Administrador].",
        "ITALIAN": "Per accedere alla bilancia, ad esempio, dopo l'accensione o dopo un cambio di utente tramite logout, dovete inserire la vostra password come utente [Administrator].",
        "CHINESE": "要登录天平，例如在开机后或通过注销更改用户后，必须输入用户 [Administrator] 的密码。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
