      "TRANSLATIONS": {
        "ENGLISH": "<b>Very fast: </b> Criterion even lower, the standstill comes very fast.",
        "GERMAN": "<b>Sehr schnell: </b> Kriterium noch niedriger, der Stillstand kommt sehr schnell.",
        "RUSSIAN": "<b>Очень быстро: </b> Критерий еще ниже, остановка наступает очень быстро.",
        "FRENCH": "<b>Très rapide : </b> Critère encore plus bas, l'arrêt arrive très vite.",
        "SPANISH": "<b>Muy rápido: </b> Criterio aún más bajo, la parada llega muy rápido.",
        "ITALIAN": "<b>Molto veloce: </b> Criterio ancora più basso, l'arresto arriva molto velocemente.",
        "CHINESE": "<b>非常快：</b>标准更低，停顿来得非常快。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "<b>Очень быстро: </b> Критерий еще ниже, остановка наступает очень быстро.",
        "FRENCH": "<b>Très rapide : </b> Critère encore plus bas, l'arrêt arrive très vite.",
        "SPANISH": "<b>Muy rápido: </b> Criterio aún más bajo, la parada llega muy rápido.",
        "ITALIAN": "<b>Molto veloce: </b> Criterio ancora più basso, l'arresto arriva molto velocemente.",
        "CHINESE": "<b>非常快：</b>标准更低，停顿来得非常快。"
      },
      "VERIFIED": {
