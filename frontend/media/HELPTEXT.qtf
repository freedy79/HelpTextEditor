      "TRANSLATIONS": {
        "ENGLISH": "Provides print services via a network.",
        "GERMAN": "Stellt Druckdienste über ein Netzwerk zur Verfügung.",
        "RUSSIAN": "Предоставляет услуги печати через сеть.",
        "FRENCH": "Fournit des services d'impression via un réseau.",
        "SPANISH": "Proporciona servicios de impresión a través de una red.",
        "ITALIAN": "Fornisce servizi di stampa tramite una rete.",
        "CHINESE": "通过网络提供打印服务。",
        "JAPANESE": "ネットワーク経由でプリントサービスを提供。",
        "KOREAN": "네트워크를 통해 인쇄 서비스를 제공합니다."
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Предоставляет услуги печати через сеть.",
        "FRENCH": "Fournit des services d'impression via un réseau.",
        "SPANISH": "Proporciona servicios de impresión a través de una red.",
        "ITALIAN": "Fornisce servizi di stampa tramite una rete.",
        "CHINESE": "通过网络提供打印服务。",
        "JAPANESE": "ネットワーク経由でプリントサービスを提供。",
        "KOREAN": "네트워크를 통해 인쇄 서비스를 제공합니다."
      },
