      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Open the selection of role rights and select [Task management] and [Access settings menu].",
        "GERMAN": "Öffnen Sie die Auswahl der Rollenrechte und wählen Sie [Task-Verwaltung] und [Zugriff Einstellungsmenü].",
        "RUSSIAN": "Откройте выбор ролевых прав и выберите [Управление задачами] и [Меню настроек доступа].",
        "FRENCH": "Ouvrez la sélection des droits de rôle et sélectionnez [Gestion des tâches] et [Menu des paramètres d'accès].",
        "SPANISH": "Abra la selección de derechos de rol y seleccione [Gestión de tareas] y [Menú de configuración de acceso].",
        "ITALIAN": "Aprire la selezione dei diritti di ruolo e selezionare [Task management] e [Access settings menu].",
        "CHINESE": "打开角色权限选择，选择 [任务管理] 和 [访问设置菜单]。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Откройте выбор ролевых прав и выберите [Управление задачами] и [Меню настроек доступа].",
        "FRENCH": "Ouvrez la sélection des droits de rôle et sélectionnez [Gestion des tâches] et [Menu des paramètres d'accès].",
        "SPANISH": "Abra la selección de derechos de rol y seleccione [Gestión de tareas] y [Menú de configuración de acceso].",
        "ITALIAN": "Aprire la selezione dei diritti di ruolo e selezionare [Task management] e [Access settings menu].",
        "CHINESE": "打开角色权限选择，选择 [任务管理] 和 [访问设置菜单]。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "EXAMPLE_CREATE_NEW_ROLE_CONF_STEP_2_G": {
      "group": "HELP_EXAMPLE",
