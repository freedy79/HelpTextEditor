    "ROLE_RIGHT_REDIRECT_FAILED_TRANSFERS": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "<b>Redirect failed data transfers:</b> Allows sending generated files with pending transfers to different connectors",
        "GERMAN": "<b>Fehlgeschlagene Dateiübertragungen umleiten:</b> Ermöglicht das Senden von Berichten mit ausstehenden Übertragungen an andere Konnektoren",
        "FRENCH": "<b>Rediriger transferts de fichiers échoués</b>",
        "ITALIAN": "<b>Reindirizzare trasferimenti file falliti:</b>",
        "SPANISH": "<b>Redirigir transferencias de datos fallidas:</b> Permite enviar archivos generados con transferencias pendientes a diferentes conectores.",
        "RUSSIAN": "<b>Перенаправление неудачных передач данных:</b> Позволяет отправлять сгенерированные файлы с ожидающими передачи данными на разные коннекторы",
        "CHINESE": "<b>重定向失败的数据传输：</b>允许将待传输的生成文件发送到不同的连接器"
      },
      "AUTOTRANSLATIONS": {
        "SPANISH": "<b>Redirigir transferencias de datos fallidas:</b> Permite enviar archivos generados con transferencias pendientes a diferentes conectores.",
        "RUSSIAN": "<b>Перенаправление неудачных передач данных:</b> Позволяет отправлять сгенерированные файлы с ожидающими передачи данными на разные коннекторы",
        "CHINESE": "<b>重定向失败的数据传输：</b>允许将待传输的生成文件发送到不同的连接器"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
        "ITALIAN": false,
        "SPANISH": false,
        "RUSSIAN": false,
        "CHINESE": false
      }
    },
