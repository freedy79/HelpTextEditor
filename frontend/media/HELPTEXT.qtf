    "NETWORK_CERTIFICATES_TYPES_INSTRUCTION_1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "GERMAN": "Für den sichere Verbindung zu Netzdiensten benötigt die Waage unterschiedliche Zertifikate, die auf die Waage geladen werden können. Es wird zwischen folgenden Zertifikaten unterschieden:",
        "ENGLISH": "For a secure connection to network services, the balance requires different certificates that can be loaded onto the balance. A distinction is made between the following certificates:",
        "FRENCH": "Pour une connexion sécurisée aux services de réseau, la balance a besoin de différents certificats qui peuvent être chargés sur la balance. Une distinction est faite entre les certificats suivants :",
        "CHINESE": "为确保与网络服务的安全连接，衡器需要可加载到衡器上的不同证书。以下证书是有区别的：",
        "SPANISH": "Para una conexión segura a los servicios de red, la balanza necesita diferentes certificados que se pueden cargar en la balanza. Se distingue entre los siguientes certificados:",
        "RUSSIAN": "Для безопасного подключения к сетевым службам весам требуются различные сертификаты, которые можно загрузить в весы. Различают следующие сертификаты:",
        "ITALIAN": "Per una connessione sicura ai servizi di rete, la bilancia richiede diversi certificati che possono essere caricati sulla bilancia. Si distingue tra i seguenti certificati:"
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Pour une connexion sécurisée aux services de réseau, la balance a besoin de différents certificats qui peuvent être chargés sur la balance. Une distinction est faite entre les certificats suivants :",
        "CHINESE": "为确保与网络服务的安全连接，衡器需要可加载到衡器上的不同证书。以下证书是有区别的：",
        "SPANISH": "Para una conexión segura a los servicios de red, la balanza necesita diferentes certificados que se pueden cargar en la balanza. Se distingue entre los siguientes certificados:",
        "RUSSIAN": "Для безопасного подключения к сетевым службам весам требуются различные сертификаты, которые можно загрузить в весы. Различают следующие сертификаты:",
        "ITALIAN": "Per una connessione sicura ai servizi di rete, la bilancia richiede diversi certificati che possono essere caricati sulla bilancia. Si distingue tra i seguenti certificati:"
      },
      "VERIFIED": {
        "GERMAN": false,
        "ENGLISH": false,
        "FRENCH": false,
        "CHINESE": false,
        "SPANISH": false,
        "RUSSIAN": false,
        "ITALIAN": false
      }
    },
