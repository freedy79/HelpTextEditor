      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Select the [Login method] menu item and set the selection to [Local password].",
        "GERMAN": "Wählen Sie den Punkt [Anmeldeverfahren] und stellen Sie die Auswahl auf [Lokales Passwort].",
        "RUSSIAN": "Выберите пункт меню [Метод входа] и установите выбор на [Локальный пароль].",
        "FRENCH": "Sélectionnez l'élément de menu [Méthode de connexion] et réglez la sélection sur [Mot de passe local].",
        "SPANISH": "Seleccione el elemento de menú [Método de inicio de sesión] y establezca la selección en [Contraseña local].",
        "ITALIAN": "Selezionare la voce di menu [Login method] e impostare la selezione su [Local password].",
        "CHINESE": "选择 [登录方法] 菜单项，并将选项设置为 [本地密码]。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Выберите пункт меню [Метод входа] и установите выбор на [Локальный пароль].",
        "FRENCH": "Sélectionnez l'élément de menu [Méthode de connexion] et réglez la sélection sur [Mot de passe local].",
        "SPANISH": "Seleccione el elemento de menú [Método de inicio de sesión] y establezca la selección en [Contraseña local].",
        "ITALIAN": "Selezionare la voce di menu [Login method] e impostare la selezione su [Local password].",
        "CHINESE": "选择 [登录方法] 菜单项，并将选项设置为 [本地密码]。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "EXAMPLE_CHANGE_USER_SET_CONF_STEP_1_F": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The [OK] button applies your settings and displays these as overview.",
        "GERMAN": "Mit der Schaltfläche [OK] werden Ihre Einstellungen übernommen und als Übersicht angezeigt.",
        "RUSSIAN": "Кнопка [OK] применяет ваши настройки и отображает их в виде обзора.",
        "FRENCH": "Le bouton [OK] applique vos paramètres et les affiche sous forme d'aperçu.",
        "SPANISH": "El botón [OK] aplica sus ajustes y los muestra como resumen.",
        "ITALIAN": "Il pulsante [OK] applica le vostre impostazioni e le visualizza come panoramica.",
        "CHINESE": "确定]按钮将应用您的设置并显示为概览。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Кнопка [OK] применяет ваши настройки и отображает их в виде обзора.",
        "FRENCH": "Le bouton [OK] applique vos paramètres et les affiche sous forme d'aperçu.",
        "SPANISH": "El botón [OK] aplica sus ajustes y los muestra como resumen.",
        "ITALIAN": "Il pulsante [OK] applica le vostre impostazioni e le visualizza come panoramica.",
        "CHINESE": "确定]按钮将应用您的设置并显示为概览。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "EXAMPLE_CHANGE_USER_SET_CONF_STEP_1_G": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Exit the menu and log out from the main menu by using the [User logout] button.",
        "GERMAN": "Verlassen Sie das Menü und melden Sie sich über die Schaltfläche [Benutzer abmelden] aus dem Hauptmenü ab.",
        "RUSSIAN": "Выйдите из меню и выйдите из главного меню с помощью кнопки [Выход пользователя].",
        "FRENCH": "Quittez le menu et déconnectez-vous du menu principal à l'aide du bouton [Déconnexion utilisateur].",
        "SPANISH": "Salga del menú y cierre la sesión en el menú principal utilizando el botón [User logout].",
        "ITALIAN": "Esci dal menu e fai il logout dal menu principale usando il pulsante [User logout].",
        "CHINESE": "使用 [用户注销] 按钮退出菜单并从主菜单注销。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Выйдите из меню и выйдите из главного меню с помощью кнопки [Выход пользователя].",
        "FRENCH": "Quittez le menu et déconnectez-vous du menu principal à l'aide du bouton [Déconnexion utilisateur].",
        "SPANISH": "Salga del menú y cierre la sesión en el menú principal utilizando el botón [User logout].",
        "ITALIAN": "Esci dal menu e fai il logout dal menu principale usando il pulsante [User logout].",
        "CHINESE": "使用 [用户注销] 按钮退出菜单并从主菜单注销。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "EXAMPLE_CHANGE_USER_SETTINGS_CONF_STEP_2": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "With the [Administrator] selection and the [User login] button, the system now asks for to enter a password for the login.",
        "GERMAN": "Mit der Auswahl [Administrator] und der Schaltfläche [Benutzer anmelden] wird jetzt für die Anmeldung die Eingabe eines neuen Passworts verlangt.",
        "RUSSIAN": "При выборе [Администратор] и нажатии кнопки [Вход пользователя] система теперь просит ввести пароль для входа.",
        "FRENCH": "Avec la sélection [Administrator] et le bouton [User login], le système demande maintenant d'entrer un mot de passe pour la connexion.",
        "SPANISH": "Con la selección [Administrador] y el botón [Inicio de sesión de usuario], el sistema pide ahora que se introduzca una contraseña para el inicio de sesión.",
        "ITALIAN": "Con la selezione [Administrator] e il pulsante [User login], il sistema chiede ora di inserire una password per il login.",
        "CHINESE": "选择 [Administrator] 和 [User login] 按钮后，系统会要求输入登录密码。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "При выборе [Администратор] и нажатии кнопки [Вход пользователя] система теперь просит ввести пароль для входа.",
        "FRENCH": "Avec la sélection [Administrator] et le bouton [User login], le système demande maintenant d'entrer un mot de passe pour la connexion.",
        "SPANISH": "Con la selección [Administrador] y el botón [Inicio de sesión de usuario], el sistema pide ahora que se introduzca una contraseña para el inicio de sesión.",
        "ITALIAN": "Con la selezione [Administrator] e il pulsante [User login], il sistema chiede ora di inserire una password per il login.",
        "CHINESE": "选择 [Administrator] 和 [User login] 按钮后，系统会要求输入登录密码。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "EXAMPLE_CHANGE_USER_SET_CONF_STEP_2_A": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Press the [New password] button and enter your desired password.",
        "GERMAN": "Drücken Sie die Schaltfläche [Neues Passwort] und geben Sie Ihr gewünschtes Passwort ein.",
        "RUSSIAN": "Нажмите кнопку [Новый пароль] и введите желаемый пароль.",
        "FRENCH": "Appuyez sur le bouton [Nouveau mot de passe] et saisissez le mot de passe de votre choix.",
        "SPANISH": "Pulse el botón [Nueva contraseña] e introduzca la contraseña que desee.",
        "ITALIAN": "Premere il pulsante [Nuova password] e inserire la password desiderata.",
        "CHINESE": "按下 [新密码] 按钮并输入所需的密码。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Нажмите кнопку [Новый пароль] и введите желаемый пароль.",
        "FRENCH": "Appuyez sur le bouton [Nouveau mot de passe] et saisissez le mot de passe de votre choix.",
        "SPANISH": "Pulse el botón [Nueva contraseña] e introduzca la contraseña que desee.",
        "ITALIAN": "Premere il pulsante [Nuova password] e inserire la password desiderata.",
        "CHINESE": "按下 [新密码] 按钮并输入所需的密码。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "EXAMPLE_CHANGE_USER_SET_CONF_STEP_2_B": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the control characters <BR>.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "After confirmation, your password must be entered again for security reasons. <BR>If the password entered both the times is identical, then you get the confirmation that your password has been changed successfully.",
        "GERMAN": "Nach der Bestätigung muss zur Sicherheit Ihr Passwort erneut eingegeben werden. <BR>Bei identischer Eingabe erhalten Sie die Bestätigung, dass Ihr Passwort erfolgreich geändert wurde.",
        "RUSSIAN": "После подтверждения в целях безопасности необходимо снова ввести пароль. <BR>Если пароль, введенный оба раза, идентичен, то вы получите подтверждение, что ваш пароль был успешно изменен.",
        "FRENCH": "Après confirmation, votre mot de passe doit être saisi à nouveau pour des raisons de sécurité. <BR>Si le mot de passe saisi les deux fois est identique, alors vous obtenez la confirmation que votre mot de passe a été modifié avec succès.",
        "SPANISH": "Después de la confirmación, su contraseña debe ser introducida de nuevo por razones de seguridad. <BR>Si la contraseña introducida las dos veces es idéntica, entonces obtendrá la confirmación de que su contraseña ha sido cambiada con éxito.",
        "ITALIAN": "Dopo la conferma, la tua password deve essere inserita di nuovo per ragioni di sicurezza. <BR>Se la password inserita entrambe le volte è identica, allora avrai la conferma che la tua password è stata cambiata con successo.",
        "CHINESE": "确认后，出于安全考虑，您必须再次输入密码。<BR>如果两次输入的密码相同，则确认密码已成功更改。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "После подтверждения в целях безопасности необходимо снова ввести пароль. <BR>Если пароль, введенный оба раза, идентичен, то вы получите подтверждение, что ваш пароль был успешно изменен.",
        "FRENCH": "Après confirmation, votre mot de passe doit être saisi à nouveau pour des raisons de sécurité. <BR>Si le mot de passe saisi les deux fois est identique, alors vous obtenez la confirmation que votre mot de passe a été modifié avec succès.",
        "SPANISH": "Después de la confirmación, su contraseña debe ser introducida de nuevo por razones de seguridad. <BR>Si la contraseña introducida las dos veces es idéntica, entonces obtendrá la confirmación de que su contraseña ha sido cambiada con éxito.",
        "ITALIAN": "Dopo la conferma, la tua password deve essere inserita di nuovo per ragioni di sicurezza. <BR>Se la password inserita entrambe le volte è identica, allora avrai la conferma che la tua password è stata cambiata con successo.",
        "CHINESE": "确认后，出于安全考虑，您必须再次输入密码。<BR>如果两次输入的密码相同，则确认密码已成功更改。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "EXAMPLE_CHANGE_USER_SETTINGS_CONF_NOTE": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Note: Keep your Administrator password safe; if lost, it can be deleted only through the Sartorius Service.",
        "GERMAN": "Anmerkung: Merken Sie sich Ihr Passwort für den Administrator, beim Verlust kann es nur durch den Sartorius Service gelöscht werden.",
        "RUSSIAN": "Примечание: Храните пароль администратора в надежном месте; в случае утери его можно удалить только через сервисную службу Sartorius.",
        "FRENCH": "Note : Conservez précieusement le mot de passe de l'administrateur. En cas de perte, il ne peut être effacé que par le service après-vente Sartorius.",
        "SPANISH": "Nota: Guarde su contraseña de administrador; si la pierde, sólo puede ser eliminada a través del Servicio de Sartorius.",
        "ITALIAN": "Nota: Tieni al sicuro la tua password di amministratore; se persa, può essere cancellata solo attraverso il Servizio Sartorius.",
        "CHINESE": "注意：请妥善保管您的管理员密码；如果丢失，只能通过赛多利斯服务删除。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Примечание: Храните пароль администратора в надежном месте; в случае утери его можно удалить только через сервисную службу Sartorius.",
        "FRENCH": "Note : Conservez précieusement le mot de passe de l'administrateur. En cas de perte, il ne peut être effacé que par le service après-vente Sartorius.",
        "SPANISH": "Nota: Guarde su contraseña de administrador; si la pierde, sólo puede ser eliminada a través del Servicio de Sartorius.",
        "ITALIAN": "Nota: Tieni al sicuro la tua password di amministratore; se persa, può essere cancellata solo attraverso il Servizio Sartorius.",
        "CHINESE": "注意：请妥善保管您的管理员密码；如果丢失，只能通过赛多利斯服务删除。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
