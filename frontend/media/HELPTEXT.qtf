      "TRANSLATIONS": {
        "ENGLISH": "Server name",
        "GERMAN": "Servername",
        "FRENCH": "Nom de serveur",
        "RUSSIAN": "Имя сервера",
        "SPANISH": "Nombre del servidor",
        "ITALIAN": "Nome del server",
        "CHINESE": "服务器名称"
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Nom de serveur",
        "RUSSIAN": "Имя сервера",
        "SPANISH": "Nombre del servidor",
        "ITALIAN": "Nome del server",
        "CHINESE": "服务器名称"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
        "RUSSIAN": false,
