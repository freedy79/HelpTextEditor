      "TRANSLATIONS": {
        "ENGLISH": "Solution strategies",
        "GERMAN": "Lösungsstrategien",
        "RUSSIAN": "Стратегии решения",
        "FRENCH": "Stratégies de solution",
        "SPANISH": "Estrategias de solución",
        "ITALIAN": "Strategie di soluzione",
        "CHINESE": "解决策略"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Стратегии решения",
        "FRENCH": "Stratégies de solution",
        "SPANISH": "Estrategias de solución",
        "ITALIAN": "Strategie di soluzione",
        "CHINESE": "解决策略"
      },
      "VERIFIED": {
        "ENGLISH": false,
