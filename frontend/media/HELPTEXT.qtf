      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Weighing with Individual GLP Print Using the YDP30 Printer on a Paper strip",
        "GERMAN": "Wägen mit individuellem GLP-Druck über Drucker YDP30 auf Streifenpapier",
        "FRENCH": "Pesée avec impression BPL individuelle à l'aide de l'imprimante YDP30 sur une bande de papier",
        "RUSSIAN": "Взвешивание с индивидуальной печатью GLP с помощью принтера YDP30 на бумажной ленте",
        "SPANISH": "Pesaje con impresión individual GLP utilizando la impresora YDP30 en una tira de papel",
        "ITALIAN": "Pesatura con stampa individuale GLP utilizzando la stampante YDP30 su una striscia di carta",
        "CHINESE": "通过 YDP30 打印机在条形纸上进行定制 GLP 打印称重",
        "JAPANESE": "YDP30プリンタを使用した個別GLP印刷による紙片計量",
        "KOREAN": "종이 스트립에 YDP30 프린터를 사용하여 개별 GLP 인쇄로 무게 측정하기"
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Pesée avec impression BPL individuelle à l'aide de l'imprimante YDP30 sur une bande de papier",
        "RUSSIAN": "Взвешивание с индивидуальной печатью GLP с помощью принтера YDP30 на бумажной ленте",
        "SPANISH": "Pesaje con impresión individual GLP utilizando la impresora YDP30 en una tira de papel",
        "ITALIAN": "Pesatura con stampa individuale GLP utilizzando la stampante YDP30 su una striscia di carta",
        "CHINESE": "通过 YDP30 打印机在条形纸上进行定制 GLP 打印称重",
        "JAPANESE": "YDP30プリンタを使用した個別GLP印刷による紙片計量",
        "KOREAN": "종이 스트립에 YDP30 프린터를 사용하여 개별 GLP 인쇄로 무게 측정하기"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
        "RUSSIAN": false,
        "SPANISH": false,
        "ITALIAN": false,
