      "TRANSLATIONS": {
        "GERMAN": "Navigieren Sie im Menü Verbindungen in das Untermenü Zertifikate",
        "ENGLISH": "In the Connections menu, navigate to the Certificates submenu",
        "FRENCH": "Dans le menu Connexions, naviguez jusqu'au sous-menu Certificats",
        "SPANISH": "En el menú Conexiones, vaya al submenú Certificados",
        "RUSSIAN": "В меню Подключения перейдите к подменю Сертификаты",
        "ITALIAN": "Nel menu Connessioni, passare al sottomenu Certificati.",
        "CHINESE": "在 \"连接 \"菜单中，导航至 \"证书 \"子菜单"
      },
      "AUTOTRANSLATIONS": {
        "ENGLISH": "In the Connections menu, navigate to the Certificates submenu",
        "FRENCH": "Dans le menu Connexions, naviguez jusqu'au sous-menu Certificats",
        "SPANISH": "En el menú Conexiones, vaya al submenú Certificados",
        "RUSSIAN": "В меню Подключения перейдите к подменю Сертификаты",
        "ITALIAN": "Nel menu Connessioni, passare al sottomenu Certificati.",
        "CHINESE": "在 \"连接 \"菜单中，导航至 \"证书 \"子菜单"
      },
      "VERIFIED": {
        "GERMAN": false,
