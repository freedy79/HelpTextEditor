      "TRANSLATIONS": {
        "ENGLISH": "Set up a connector to an FTP server e.g., [My FTP server for export].",
        "GERMAN": "Richten Sie einen Konnektor zu einem FTP Server ein, z. B. [Mein FTP Server für Export].",
        "RUSSIAN": "Настройте подключение к FTP-серверу, например, [Мой FTP-сервер для экспорта].",
        "FRENCH": "Configurez un connecteur vers un serveur FTP, par exemple, [Mon serveur FTP pour l'exportation].",
        "SPANISH": "Configure un conector a un servidor FTP, por ejemplo, [Mi servidor FTP para exportar].",
        "ITALIAN": "Imposta un connettore a un server FTP, ad esempio, [Il mio server FTP per l'esportazione].",
        "CHINESE": "设置连接 FTP 服务器的连接器，例如[我的 FTP 服务器用于导出]。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Настройте подключение к FTP-серверу, например, [Мой FTP-сервер для экспорта].",
        "FRENCH": "Configurez un connecteur vers un serveur FTP, par exemple, [Mon serveur FTP pour l'exportation].",
        "SPANISH": "Configure un conector a un servidor FTP, por ejemplo, [Mi servidor FTP para exportar].",
        "ITALIAN": "Imposta un connettore a un server FTP, ad esempio, [Il mio server FTP per l'esportazione].",
        "CHINESE": "设置连接 FTP 服务器的连接器，例如[我的 FTP 服务器用于导出]。"
      },
