      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Обновление QAPP Center",
        "FRENCH": "Mise à jour du centre QAPP",
        "SPANISH": "Actualización del Centro QAPP",
        "ITALIAN": "Aggiornamento del centro QAPP",
        "CHINESE": "更新 QAPP 中心"
      },
      "VERIFIED": {
        "ENGLISH": false,
