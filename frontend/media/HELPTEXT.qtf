      "TRANSLATIONS": {
        "ENGLISH": "DNS 1 and DNS 2",
        "GERMAN": "DNS 1 und DNS 2",
        "RUSSIAN": "DNS 1 и DNS 2",
        "FRENCH": "DNS 1 et DNS 2",
        "SPANISH": "DNS 1 y DNS 2",
        "ITALIAN": "DNS 1 e DNS 2",
        "CHINESE": "DNS 1 和 DNS 2"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "DNS 1 и DNS 2",
        "FRENCH": "DNS 1 et DNS 2",
        "SPANISH": "DNS 1 y DNS 2",
        "ITALIAN": "DNS 1 e DNS 2",
        "CHINESE": "DNS 1 和 DNS 2"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
