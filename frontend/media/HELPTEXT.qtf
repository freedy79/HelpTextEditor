      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "USB-A/C Interface",
        "GERMAN": "Schnittstelle USB-A/C",
        "FRENCH": "Interface USB-A/C",
        "RUSSIAN": "Интерфейс USB-A/C",
        "SPANISH": "Interfaz USB-A/C",
        "ITALIAN": "Interfaccia USB-A/C",
        "CHINESE": "USB-A/C 接口",
        "JAPANESE": "USB-A/Cインターフェース",
        "KOREAN": "USB-A/C 인터페이스"
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Interface USB-A/C",
        "RUSSIAN": "Интерфейс USB-A/C",
        "SPANISH": "Interfaz USB-A/C",
        "ITALIAN": "Interfaccia USB-A/C",
        "CHINESE": "USB-A/C 接口",
        "JAPANESE": "USB-A/Cインターフェース",
        "KOREAN": "USB-A/C 인터페이스"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
        "RUSSIAN": false,
        "SPANISH": false,
        "ITALIAN": false,
