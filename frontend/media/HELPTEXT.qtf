      "TRANSLATIONS": {
        "ENGLISH": "Rules for login and logout",
        "GERMAN": "Regeln für die An- und Abmeldung",
        "RUSSIAN": "Правила входа и выхода из системы",
        "FRENCH": "Règles de connexion et de déconnexion",
        "SPANISH": "Reglas de inicio y cierre de sesión",
        "ITALIAN": "Regole per il login e il logout",
        "CHINESE": "登录和注销规则"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Правила входа и выхода из системы",
        "FRENCH": "Règles de connexion et de déconnexion",
        "SPANISH": "Reglas de inicio y cierre de sesión",
        "ITALIAN": "Regole per il login e il logout",
        "CHINESE": "登录和注销规则"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
