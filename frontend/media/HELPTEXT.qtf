    "EXAMPLE_CHANGE_USER_SET_CONF_STEP_1_B": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Navigate to [Access Management] -> [User management] -> [Administrator], the current settings are displayed.",
        "GERMAN": "Zu [Zugriffsverwaltung] -> [Benutzerverwaltung] -> [Administrator] navigieren, es werden die aktuellen Einstellungen angezeigt.",
        "RUSSIAN": "Перейдите к [Управление пользователями] -> [Администратор], отобразятся текущие настройки.",
        "FRENCH": "Naviguez vers [User management] -> [Administrator], les paramètres actuels sont affichés.",
        "SPANISH": "Acceda a [Gestión de usuarios] -> [Administrador], se muestran los ajustes actuales.",
        "ITALIAN": "Passare a [Gestione utenti] -> [Amministratore], vengono visualizzate le impostazioni correnti.",
        "CHINESE": "导航至 [Access Management（访问管理）] -> [User management（用户管理）] -> [Administrator（管理员）]，显示当前设置。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Перейдите к [Управление пользователями] -> [Администратор], отобразятся текущие настройки.",
        "FRENCH": "Naviguez vers [User management] -> [Administrator], les paramètres actuels sont affichés.",
        "SPANISH": "Acceda a [Gestión de usuarios] -> [Administrador], se muestran los ajustes actuales.",
        "ITALIAN": "Passare a [Gestione utenti] -> [Amministratore], vengono visualizzate le impostazioni correnti.",
        "CHINESE": "导航至 [Access Management（访问管理）] -> [User management（用户管理）] -> [Administrator（管理员）]，显示当前设置。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "EXAMPLE_CHANGE_USER_SET_CONF_STEP_1_C": {
      "group": "HELP_EXAMPLE",
