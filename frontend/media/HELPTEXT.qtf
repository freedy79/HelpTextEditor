    "WEIGHING_STABILITY_INSTRUCTION_1_STEP_3": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "Do not translate HTML command <b> and </b>",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "<b>Medium accuracy:</b> Normal criterion for standstill (default setting).",
        "GERMAN": "<b>Mittlere Genauigkeit:</b> Normales Kriterium für den Stillstand (Voreinstellung).",
        "RUSSIAN": "<b>Средняя точность:</b> Нормальный критерий для состояния покоя (настройка по умолчанию).",
        "FRENCH": "<b>Précision moyenne:</b> Critère normal pour l'arrêt (réglage par défaut).",
        "SPANISH": "<b>Precisión media:</b> Criterio normal de parada (ajuste por defecto).",
        "ITALIAN": "<b>Precisione media:</b> Criterio normale per lo standstill (impostazione predefinita).",
        "CHINESE": "<b>中等精度：</b>静止时的正常标准（默认设置）。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "<b>Средняя точность:</b> Нормальный критерий для состояния покоя (настройка по умолчанию).",
        "FRENCH": "<b>Précision moyenne:</b> Critère normal pour l'arrêt (réglage par défaut).",
        "SPANISH": "<b>Precisión media:</b> Criterio normal de parada (ajuste por defecto).",
        "ITALIAN": "<b>Precisione media:</b> Criterio normale per lo standstill (impostazione predefinita).",
        "CHINESE": "<b>中等精度：</b>静止时的正常标准（默认设置）。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "WEIGHING_STABILITY_INSTRUCTION_1_STEP_4": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "Do not translate HTML command <b> and </b>",
      "locked": false,
      "obsolete": false,
