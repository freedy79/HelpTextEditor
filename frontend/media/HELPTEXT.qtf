    "EXAMPLE_CREATE_NEW_ROLE_CONF_STEP_2_E": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Enter a role name and, optionally, a role description e.g., [My role task and menu] and as description [Role with task and menu rights].",
        "GERMAN": "Geben Sie einen Rollennamen und optional eine Rollenbeschreibung ein, z. B. [Meine Rolle Task und Menü] und als Beschreibung [Rolle mit Task- und Menü-Rechten].",
        "RUSSIAN": "Введите имя роли и, по желанию, описание роли, например, [Моя роль - задачи и меню] и описание [Роль с правами на задачи и меню].",
        "FRENCH": "Saisissez un nom de rôle et, en option, une description de rôle, par exemple [Mon rôle, tâche et menu] et comme description [Rôle avec droits de tâche et de menu].",
        "SPANISH": "Introduzca un nombre de rol y, opcionalmente, una descripción de rol, por ejemplo, [Mi rol tarea y menú] y como descripción [Rol con derechos de tarea y menú].",
        "ITALIAN": "Inserisci un nome di ruolo e, opzionalmente, una descrizione del ruolo, ad esempio, [Il mio ruolo attività e menu] e come descrizione [Ruolo con diritti di attività e menu].",
        "CHINESE": "输入角色名称和可选的角色描述，例如[我的角色任务和菜单]和描述[具有任务和菜单权限的角色]。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Введите имя роли и, по желанию, описание роли, например, [Моя роль - задачи и меню] и описание [Роль с правами на задачи и меню].",
        "FRENCH": "Saisissez un nom de rôle et, en option, une description de rôle, par exemple [Mon rôle, tâche et menu] et comme description [Rôle avec droits de tâche et de menu].",
        "SPANISH": "Introduzca un nombre de rol y, opcionalmente, una descripción de rol, por ejemplo, [Mi rol tarea y menú] y como descripción [Rol con derechos de tarea y menú].",
        "ITALIAN": "Inserisci un nome di ruolo e, opzionalmente, una descrizione del ruolo, ad esempio, [Il mio ruolo attività e menu] e come descrizione [Ruolo con diritti di attività e menu].",
        "CHINESE": "输入角色名称和可选的角色描述，例如[我的角色任务和菜单]和描述[具有任务和菜单权限的角色]。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "EXAMPLE_CREATE_NEW_ROLE_CONF_STEP_2_F": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
