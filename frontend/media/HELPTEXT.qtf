      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Enter the first date and time [Execution date] as e.g., 2020-05-04 and 06:00:00 i.e., Monday 04.05.2020 at 6:00 a.m.",
        "GERMAN": "Geben Sie das erstmalige [Ausführungsdatum] mit Datum und Uhrzeit ein, z. B. 2020-05-04 und 06:00:00, das bedeutet Montag 04.05.2020 um 06:00 Uhr.",
        "RUSSIAN": "Введите первую дату и время [Дата исполнения], например, 2020-05-04 и 06:00:00, т.е. в понедельник 04.05.2020 в 6:00 утра.",
        "FRENCH": "Saisissez la première date et heure [Date d'exécution], par exemple 2020-05-04 et 06:00:00, c'est-à-dire le lundi 04.05.2020 à 6h00.",
        "SPANISH": "Introduzca la primera fecha y hora [Fecha de ejecución] como, por ejemplo, 2020-05-04 y 06:00:00, es decir, el lunes 04.05.2020 a las 6:00 horas.",
        "ITALIAN": "Inserire la prima data e ora [Data di esecuzione] come ad esempio, 2020-05-04 e 06:00:00 cioè, lunedì 04.05.2020 alle 6:00.",
        "CHINESE": "输入第一个日期和时间 [执行日期]，例如 2020-05-04 和 06:00:00，即 2020 年 5 月 4 日星期一上午 6 时。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Введите первую дату и время [Дата исполнения], например, 2020-05-04 и 06:00:00, т.е. в понедельник 04.05.2020 в 6:00 утра.",
        "FRENCH": "Saisissez la première date et heure [Date d'exécution], par exemple 2020-05-04 et 06:00:00, c'est-à-dire le lundi 04.05.2020 à 6h00.",
        "SPANISH": "Introduzca la primera fecha y hora [Fecha de ejecución] como, por ejemplo, 2020-05-04 y 06:00:00, es decir, el lunes 04.05.2020 a las 6:00 horas.",
        "ITALIAN": "Inserire la prima data e ora [Data di esecuzione] come ad esempio, 2020-05-04 e 06:00:00 cioè, lunedì 04.05.2020 alle 6:00.",
        "CHINESE": "输入第一个日期和时间 [执行日期]，例如 2020-05-04 和 06:00:00，即 2020 年 5 月 4 日星期一上午 6 时。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
