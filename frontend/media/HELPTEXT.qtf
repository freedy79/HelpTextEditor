    "PRINT_GLP_PDF_FTPS_CONF_STEP_5_D": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Adapt the specified settings for the formulation to your requirements, e.g. automatic takeover, number of components, number of lot and sample indicators, etc.",
        "GERMAN": "Passen Sie die vorgegebenen Einstellungen für die Rezeptur ihren Anforderungen an, z. B. Autom. Übernahme, Anzahl der Komponenten, Anzahl von Lot- und Probenbezeichnern, usw.",
        "RUSSIAN": "Адаптируйте заданные настройки рецептуры к вашим требованиям, например, автоматическое поглощение, количество компонентов, количество индикаторов партии и образца и т.д.",
        "FRENCH": "Adaptez les paramètres spécifiés pour la formulation à vos besoins, par exemple la reprise automatique, le nombre de composants, le nombre d'indicateurs de lot et d'échantillon, etc.",
        "SPANISH": "Adapte los ajustes especificados para la formulación a sus necesidades, por ejemplo, la toma de posesión automática, el número de componentes, el número de indicadores de lote y muestra, etc.",
        "ITALIAN": "Adattate le impostazioni specificate per la formulazione alle vostre esigenze, ad esempio la presa in carico automatica, il numero di componenti, il numero di indicatori di lotto e campione, ecc.",
        "CHINESE": "根据您的要求自定义配方的默认设置，如自动传输、成分数量、批次和样品标识符数量等。",
        "JAPANESE": "例えば、自動引取、成分数、ロット数、サンプルインジケータ数などです。",
        "KOREAN": "자동 인수, 구성 요소 수, 로트 및 샘플 표시기 수 등 요구 사항에 맞게 제형에 대한 지정된 설정을 조정합니다."
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Адаптируйте заданные настройки рецептуры к вашим требованиям, например, автоматическое поглощение, количество компонентов, количество индикаторов партии и образца и т.д.",
        "FRENCH": "Adaptez les paramètres spécifiés pour la formulation à vos besoins, par exemple la reprise automatique, le nombre de composants, le nombre d'indicateurs de lot et d'échantillon, etc.",
        "SPANISH": "Adapte los ajustes especificados para la formulación a sus necesidades, por ejemplo, la toma de posesión automática, el número de componentes, el número de indicadores de lote y muestra, etc.",
        "ITALIAN": "Adattate le impostazioni specificate per la formulazione alle vostre esigenze, ad esempio la presa in carico automatica, il numero di componenti, il numero di indicatori di lotto e campione, ecc.",
        "CHINESE": "根据您的要求自定义配方的默认设置，如自动传输、成分数量、批次和样品标识符数量等。",
        "JAPANESE": "例えば、自動引取、成分数、ロット数、サンプルインジケータ数などです。",
        "KOREAN": "자동 인수, 구성 요소 수, 로트 및 샘플 표시기 수 등 요구 사항에 맞게 제형에 대한 지정된 설정을 조정합니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_GLP_PDF_FTPS_CONF_STEP_5_E": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Choose a weighing profile, followed by the [My PDF print on FTPS server] print profile.",
        "GERMAN": "Wählen Sie ein Wägeprofil und dann das Druckprofil [Mein PDF-Druck auf FTPS-Server].",
        "RUSSIAN": "Выберите профиль взвешивания, а затем профиль печати [My PDF print on FTPS server].",
        "FRENCH": "Choisissez un profil de pesée, puis le profil d'impression [Mon PDF imprimé sur le serveur FTPS].",
        "SPANISH": "Elija un perfil de pesaje, seguido del perfil de impresión [Mi impresión PDF en el servidor FTPS].",
        "ITALIAN": "Scegli un profilo di pesatura, seguito dal profilo di stampa [My PDF print on FTPS server].",
        "CHINESE": "选择称重预案，然后选择打印预案 [我的 PDF 在 FTPS 服务器上打印]。",
        "JAPANESE": "計量プロファイルを選択し、続いて[My PDF print on FTPS server]プリントプロファイルを選択します。",
        "KOREAN": "계량 프로필을 선택한 다음 [FTPS 서버에서 내 PDF 인쇄] 인쇄 프로필을 선택합니다."
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Выберите профиль взвешивания, а затем профиль печати [My PDF print on FTPS server].",
        "FRENCH": "Choisissez un profil de pesée, puis le profil d'impression [Mon PDF imprimé sur le serveur FTPS].",
        "SPANISH": "Elija un perfil de pesaje, seguido del perfil de impresión [Mi impresión PDF en el servidor FTPS].",
        "ITALIAN": "Scegli un profilo di pesatura, seguito dal profilo di stampa [My PDF print on FTPS server].",
        "CHINESE": "选择称重预案，然后选择打印预案 [我的 PDF 在 FTPS 服务器上打印]。",
        "JAPANESE": "計量プロファイルを選択し、続いて[My PDF print on FTPS server]プリントプロファイルを選択します。",
        "KOREAN": "계량 프로필을 선택한 다음 [FTPS 서버에서 내 PDF 인쇄] 인쇄 프로필을 선택합니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
