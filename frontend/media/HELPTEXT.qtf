    "DEVICE_CLEANING_COVER_TITLE": {
      "group": "COVER_TITLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Device cleaning for the Cubis® MCA Balance",
        "GERMAN": "Gerätereinigung für die Cubis® MCA Balance",
        "FRENCH": "Nettoyage de l'appareil pour le Cubis® MCA Balance",
        "ITALIAN": "Pulizia del dispositivo per la bilancia Cubis® MCA",
        "RUSSIAN": "Очистка устройства для Cubis® MCA Balance",
