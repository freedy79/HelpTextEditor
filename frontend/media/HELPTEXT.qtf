      }
    },
    "PRINT_PROFILE_SBI_DIRECT_TITLE": {
      "group": "HELP_TITLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "SBI Direct Print Profile",
        "GERMAN": "Druckprofil SBI-Direkt",
        "FRENCH": "Profil d'impression directe SBI",
        "RUSSIAN": "Профиль прямой печати SBI",
        "SPANISH": "Perfil de SBI Direct Print",
        "ITALIAN": "Profilo di stampa diretta SBI",
        "CHINESE": "打印简介 SBI-Direct",
        "JAPANESE": "SBIダイレクトプリント・プロフィール",
        "KOREAN": "SBI 다이렉트 프린트 프로필"
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Profil d'impression directe SBI",
        "RUSSIAN": "Профиль прямой печати SBI",
        "SPANISH": "Perfil de SBI Direct Print",
        "ITALIAN": "Profilo di stampa diretta SBI",
        "CHINESE": "打印简介 SBI-Direct",
        "JAPANESE": "SBIダイレクトプリント・プロフィール",
        "KOREAN": "SBI 다이렉트 프린트 프로필"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
        "RUSSIAN": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_PROFILE_SBI_DIRECT_INSTRUCTION_1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "SBI direct is the printout on all or a selection of interfaces that are set to the SBI protocol.",
        "GERMAN": "SBI-Direkt ist die Druckausgabe auf alle oder eine Auswahl an Schnittstellen, die auf das SBI Protokoll eingestellt sind.",
        "FRENCH": "SBI direct est l'impression sur toutes ou une sélection d'interfaces qui sont réglées sur le protocole SBI.",
        "RUSSIAN": "SBI direct - это печать на всех или выбранных интерфейсах, настроенных на протокол SBI.",
        "SPANISH": "SBI direct es la impresión en todas las interfaces o en una selección de ellas que están configuradas con el protocolo SBI.",
        "ITALIAN": "SBI direct è la stampa su tutte o su una selezione di interfacce che sono impostate sul protocollo SBI.",
        "CHINESE": "SBI-Direct 是向设置为 SBI 协议的所有或部分接口的打印输出。",
        "JAPANESE": "SBIダイレクトは、SBIプロトコルに設定されているインターフェイスのすべて、または選択されたインターフェイスでの印刷です。",
        "KOREAN": "SBI 다이렉트는 SBI 프로토콜로 설정된 모든 인터페이스 또는 일부 인터페이스의 출력물입니다."
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "SBI direct est l'impression sur toutes ou une sélection d'interfaces qui sont réglées sur le protocole SBI.",
        "RUSSIAN": "SBI direct - это печать на всех или выбранных интерфейсах, настроенных на протокол SBI.",
        "SPANISH": "SBI direct es la impresión en todas las interfaces o en una selección de ellas que están configuradas con el protocolo SBI.",
        "ITALIAN": "SBI direct è la stampa su tutte o su una selezione di interfacce che sono impostate sul protocollo SBI.",
        "CHINESE": "SBI-Direct 是向设置为 SBI 协议的所有或部分接口的打印输出。",
        "JAPANESE": "SBIダイレクトは、SBIプロトコルに設定されているインターフェイスのすべて、または選択されたインターフェイスでの印刷です。",
        "KOREAN": "SBI 다이렉트는 SBI 프로토콜로 설정된 모든 인터페이스 또는 일부 인터페이스의 출력물입니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
        "RUSSIAN": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_PROFILE_SBI_DIRECT_INSTRUCTION_2": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "All interfaces are used for the print output if [Common SBI Protocol settings] has been selected as [SBI Output formatting]. Also the protocol of the desired interface must be set to SBI. For the printing process, the SBI formatting instructions selected in the menu [Connections] -> [SBI protocol] are used.",
        "GERMAN": "Alle Schnittstellen werden zur Druckausgabe genutzt, wenn [Allgemeine SBI Protokolleinstellungen] als [SBI Ausgabeformatierung] gewählt wurde. Außerdem muss das Protokoll der gewünschten Schnittstelle auf SBI eingestellt werden. Für den Druckvorgang werden SBI Formatierungsanweisungen umgesetzt, die im Menü [Verbindungen] -> [SBI Protokoll] gewählt sind.",
        "FRENCH": "Toutes les interfaces sont utilisées pour la sortie d'impression si [Impostazioni comuni del protocollo SBI] a été sélectionné comme [SBI Formatage de la sortie]. Le protocole de l'interface souhaitée doit également être réglé sur SBI. Pour le processus d'impression, les instructions de formatage SBI sélectionnées dans le menu [Connexions] -> [Protocole SBI] sont utilisées.",
        "RUSSIAN": "Для вывода на печать используются все интерфейсы, если в качестве параметра [Общие настройки протокола SBI] выбрано [Форматирование вывода SBI]. Также протокол нужного интерфейса должен быть установлен на SBI. Для процесса печати используются инструкции форматирования SBI, выбранные в меню [Соединения] -> [Протокол SBI].",
        "SPANISH": "Todas las interfaces se utilizan para la salida de impresión si se ha seleccionado [Configuración del protocolo SBI común] como [Formato de salida SBI]. Además, el protocolo de la interfaz deseada debe ajustarse a SBI. Para el proceso de impresión, se utilizan las instrucciones de formato SBI seleccionadas en el menú [Conexiones] -> [Protocolo SBI].",
        "ITALIAN": "Tutte le interfacce sono usate per l'uscita di stampa se [Impostazioni protocollo SBI comune] è stato selezionato come [SBI Formattazione dell'output]. Anche il protocollo dell'interfaccia desiderata deve essere impostato su SBI. Per il processo di stampa vengono utilizzate le istruzioni di formattazione SBI selezionate nel menu [Connessioni] -> [Protocollo SBI].",
        "CHINESE": "如果已将 [一般 SBI 协议设置] 选为 [SBI 输出格式]，则所有接口都用于打印输出。所需接口的协议也必须设置为 SBI。在 [连接] -> [SBI 协议] 菜单中选择的 SBI 格式化指令将在打印过程中执行。",
        "JAPANESE": "共通 SBI プロトコル設定]が[SBI 出力フォーマット]として選択されている場合、すべてのインター フェースが印刷出力に使用されます。また、希望するインターフェイスのプロトコルがSBIに設定されている必要があります。印刷処理には、メニュー[接続]->[SBIプロトコル]で選択したSBIフォーマット命令が使用されます。",
        "KOREAN": "공통 SBI 프로토콜 설정]을 [SBI 출력 형식]으로 선택한 경우 모든 인터페이스가 인쇄 출력에 사용됩니다. 또한 원하는 인터페이스의 프로토콜을 SBI로 설정해야 합니다. 인쇄 프로세스에는 [연결] -> [SBI 프로토콜] 메뉴에서 선택한 SBI 포맷 지침이 사용됩니다."
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Toutes les interfaces sont utilisées pour la sortie d'impression si [Impostazioni comuni del protocollo SBI] a été sélectionné comme [SBI Formatage de la sortie]. Le protocole de l'interface souhaitée doit également être réglé sur SBI. Pour le processus d'impression, les instructions de formatage SBI sélectionnées dans le menu [Connexions] -> [Protocole SBI] sont utilisées.",
        "RUSSIAN": "Для вывода на печать используются все интерфейсы, если в качестве параметра [Общие настройки протокола SBI] выбрано [Форматирование вывода SBI]. Также протокол нужного интерфейса должен быть установлен на SBI. Для процесса печати используются инструкции форматирования SBI, выбранные в меню [Соединения] -> [Протокол SBI].",
        "SPANISH": "Todas las interfaces se utilizan para la salida de impresión si se ha seleccionado [Configuración del protocolo SBI común] como [Formato de salida SBI]. Además, el protocolo de la interfaz deseada debe ajustarse a SBI. Para el proceso de impresión, se utilizan las instrucciones de formato SBI seleccionadas en el menú [Conexiones] -> [Protocolo SBI].",
        "ITALIAN": "Tutte le interfacce sono usate per l'uscita di stampa se [Impostazioni protocollo SBI comune] è stato selezionato come [SBI Formattazione dell'output]. Anche il protocollo dell'interfaccia desiderata deve essere impostato su SBI. Per il processo di stampa vengono utilizzate le istruzioni di formattazione SBI selezionate nel menu [Connessioni] -> [Protocollo SBI].",
        "CHINESE": "如果已将 [一般 SBI 协议设置] 选为 [SBI 输出格式]，则所有接口都用于打印输出。所需接口的协议也必须设置为 SBI。在 [连接] -> [SBI 协议] 菜单中选择的 SBI 格式化指令将在打印过程中执行。",
        "JAPANESE": "共通 SBI プロトコル設定]が[SBI 出力フォーマット]として選択されている場合、すべてのインター フェースが印刷出力に使用されます。また、希望するインターフェイスのプロトコルがSBIに設定されている必要があります。印刷処理には、メニュー[接続]->[SBIプロトコル]で選択したSBIフォーマット命令が使用されます。",
        "KOREAN": "공통 SBI 프로토콜 설정]을 [SBI 출력 형식]으로 선택한 경우 모든 인터페이스가 인쇄 출력에 사용됩니다. 또한 원하는 인터페이스의 프로토콜을 SBI로 설정해야 합니다. 인쇄 프로세스에는 [연결] -> [SBI 프로토콜] 메뉴에서 선택한 SBI 포맷 지침이 사용됩니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
        "RUSSIAN": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_PROFILE_SBI_DIRECT_INSTRUCTION_3": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Only the interfaces selected in the print profile are used for print output if [Costumized] has been selected as [SBI Output formatting]. Also the protocol of the selected interfaces must be set to SBI. For the printing process, the SBI formatting instructions selected in the print profile are used.",
        "GERMAN": "Nur die im Druckprofil selektierten Schnittstellen werden zur Druckausgabe genutzt, wenn [Angepasst] als SBI Ausgabeformatierung gewählt wurde. Außerdem muss das Protokoll der gewählten Schnittstellen auf SBI eingestellt werden. Für den Druckvorgang werden SBI Formatierungsanweisungen umgesetzt, die im Druckprofil gewählt wurden.",
        "FRENCH": "Seules les interfaces sélectionnées dans le profil d'impression sont utilisées pour l'impression si [Adapté] a été sélectionné comme [SBI Formatage de la sortie]. Le protocole des interfaces sélectionnées doit également être réglé sur SBI. Pour le processus d'impression, les instructions de formatage SBI sélectionnées dans le profil d'impression sont utilisées.",
        "RUSSIAN": "Для вывода на печать используются только интерфейсы, выбранные в профиле печати, если в качестве [Форматирование вывода SBI] выбрано [Адаптированный]. Также протокол выбранных интерфейсов должен быть установлен на SBI. Для процесса печати используются инструкции форматирования SBI, выбранные в профиле печати.",
        "SPANISH": "Sólo las interfaces seleccionadas en el perfil de impresión se utilizan para la salida de la impresión si se ha seleccionado [Adaptado] como [Formato de salida SBI]. Además, el protocolo de las interfaces seleccionadas debe ajustarse a SBI. Para el proceso de impresión se utilizan las instrucciones de formato SBI seleccionadas en el perfil de impresión.",
        "ITALIAN": "Solo le interfacce selezionate nel profilo di stampa sono usate per l'uscita di stampa se [Adattato] è stato selezionato come [SBI Formattazione dell'output]. Anche il protocollo delle interfacce selezionate deve essere impostato su SBI. Per il processo di stampa vengono utilizzate le istruzioni di formattazione SBI selezionate nel profilo di stampa.",
        "CHINESE": "如果已将 [自定义] 选为 SBI 输出格式，则打印输出只使用打印配置文件中选择的接口。所选接口的协议也必须设置为 SBI。在打印配置文件中选择的 SBI 格式化指令将在打印过程中执行。",
        "JAPANESE": "SBI出力フォーマット]として[Costumized]が選択されている場合、プリントプロフ ァイルで選択されているインターフェースのみがプリント出力に使用されます。また、選択されたインターフェイスのプロトコルは、SBI に設定されている必要があります。印刷処理には、印刷プロファイルで選択されたSBIフォーマット命令が使用されます。",
        "KOREAN": "인쇄 프로필에서 [의상화]를 [SBI 출력 포맷]으로 선택한 경우 인쇄 프로필에서 선택한 인터페이스만 인쇄 출력에 사용됩니다. 또한 선택한 인터페이스의 프로토콜이 SBI로 설정되어 있어야 합니다. 인쇄 프로세스에는 인쇄 프로필에서 선택한 SBI 서식 지정 지침이 사용됩니다."
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Seules les interfaces sélectionnées dans le profil d'impression sont utilisées pour l'impression si [Adapté] a été sélectionné comme [BI Formatage de la sortie]. Le protocole des interfaces sélectionnées doit également être réglé sur SBI. Pour le processus d'impression, les instructions de formatage SBI sélectionnées dans le profil d'impression sont utilisées.",
        "RUSSIAN": "Для вывода на печать используются только интерфейсы, выбранные в профиле печати, если в качестве [Форматирование вывода SBI] выбрано [Адаптированный]. Также протокол выбранных интерфейсов должен быть установлен на SBI. Для процесса печати используются инструкции форматирования SBI, выбранные в профиле печати.",
        "SPANISH": "Sólo las interfaces seleccionadas en el perfil de impresión se utilizan para la salida de la impresión si se ha seleccionado [Adaptado] como [Formato de salida SBI]. Además, el protocolo de las interfaces seleccionadas debe ajustarse a SBI. Para el proceso de impresión se utilizan las instrucciones de formato SBI seleccionadas en el perfil de impresión.",
        "ITALIAN": "Solo le interfacce selezionate nel profilo di stampa sono usate per l'uscita di stampa se [Adattato] è stato selezionato come [SBI Formattazione dell'output]. Anche il protocollo delle interfacce selezionate deve essere impostato su SBI. Per il processo di stampa vengono utilizzate le istruzioni di formattazione SBI selezionate nel profilo di stampa.",
        "CHINESE": "如果已将 [自定义] 选为 SBI 输出格式，则打印输出只使用打印配置文件中选择的接口。所选接口的协议也必须设置为 SBI。在打印配置文件中选择的 SBI 格式化指令将在打印过程中执行。",
        "JAPANESE": "SBI出力フォーマット]として[Costumized]が選択されている場合、プリントプロフ ァイルで選択されているインターフェースのみがプリント出力に使用されます。また、選択されたインターフェイスのプロトコルは、SBI に設定されている必要があります。印刷処理には、印刷プロファイルで選択されたSBIフォーマット命令が使用されます。",
        "KOREAN": "인쇄 프로필에서 [의상화]를 [SBI 출력 포맷]으로 선택한 경우 인쇄 프로필에서 선택한 인터페이스만 인쇄 출력에 사용됩니다. 또한 선택한 인터페이스의 프로토콜이 SBI로 설정되어 있어야 합니다. 인쇄 프로세스에는 인쇄 프로필에서 선택한 SBI 서식 지정 지침이 사용됩니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
        "RUSSIAN": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_PROFILE_SBI_DIRECT_INSTRUCTION_4": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "A print profile for the SBI print is already provided by the factory. New special SBI print profiles can be created according to the task requirements. The printout can be provided with a GLP header and footer, and the scope of the output values can be configured.",
        "GERMAN": "Ein Druckprofil für den SBI-Druck ist ab Werk schon angelegt. Entsprechend der Anforderung aus den Tasks können weitere spezielle SBI-Druckprofile angelegt werden. Der Ausdruck von Werten kann mit GLP-Kopf und -Fuß erfolgen, der Umfang der Ausgabewerte ist einstellbar.",
        "FRENCH": "Un profil d'impression pour l'impression SBI est déjà fourni par l'usine. De nouveaux profils d'impression SBI spéciaux peuvent être créés en fonction des exigences de la tâche. L'impression peut être dotée d'un en-tête et d'un pied de page BPL, et l'étendue des valeurs de sortie peut être configurée.",
        "RUSSIAN": "Профиль печати для SBI-печати уже предоставляется заводом-изготовителем. Новые специальные профили печати SBI могут быть созданы в соответствии с требованиями задачи. Распечатка может быть снабжена заголовком и колонтитулом GLP, а также может быть настроен объем выводимых значений.",
        "SPANISH": "Un perfil de impresión para la impresión SBI ya viene de fábrica. Se pueden crear nuevos perfiles de impresión SBI especiales según los requisitos de la tarea. La impresión puede estar provista de una cabecera y un pie de página GLP, y se puede configurar el alcance de los valores de salida.",
        "ITALIAN": "Un profilo di stampa per la stampa SBI è già fornito dalla fabbrica. Nuovi profili di stampa SBI speciali possono essere creati secondo i requisiti del compito. La stampa può essere fornita con un'intestazione e un piè di pagina GLP e l'ambito dei valori di uscita può essere configurato.",
        "CHINESE": "用于 SBI 打印的打印配置文件已经创建。还可根据任务要求创建其他特殊的 SBI 打印配置文件。打印的数值可以带有 GLP 页眉和页脚；可以设置输出值的范围。",
        "JAPANESE": "SBI プリント用のプリントプロファイルは、工場から既に提供されている。タスクの要求に応じて、新しい特別な SBI 印刷プロファイルを作成することができる。印刷物にはGLPヘッダーとフッターを付けることができ、出力値の範囲を設定することができる。",
        "KOREAN": "SBI 인쇄용 인쇄 프로필은 공장에서 이미 제공됩니다. 작업 요구 사항에 따라 새로운 특수 SBI 인쇄 프로필을 만들 수 있습니다. 인쇄물에는 GLP 머리글과 바닥글이 제공될 수 있으며 출력 값의 범위를 구성할 수 있습니다."
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Un profil d'impression pour l'impression SBI est déjà fourni par l'usine. De nouveaux profils d'impression SBI spéciaux peuvent être créés en fonction des exigences de la tâche. L'impression peut être dotée d'un en-tête et d'un pied de page BPL, et l'étendue des valeurs de sortie peut être configurée.",
        "RUSSIAN": "Профиль печати для SBI-печати уже предоставляется заводом-изготовителем. Новые специальные профили печати SBI могут быть созданы в соответствии с требованиями задачи. Распечатка может быть снабжена заголовком и колонтитулом GLP, а также может быть настроен объем выводимых значений.",
        "SPANISH": "Un perfil de impresión para la impresión SBI ya viene de fábrica. Se pueden crear nuevos perfiles de impresión SBI especiales según los requisitos de la tarea. La impresión puede estar provista de una cabecera y un pie de página GLP, y se puede configurar el alcance de los valores de salida.",
        "ITALIAN": "Un profilo di stampa per la stampa SBI è già fornito dalla fabbrica. Nuovi profili di stampa SBI speciali possono essere creati secondo i requisiti del compito. La stampa può essere fornita con un'intestazione e un piè di pagina GLP e l'ambito dei valori di uscita può essere configurato.",
        "CHINESE": "用于 SBI 打印的打印配置文件已经创建。还可根据任务要求创建其他特殊的 SBI 打印配置文件。打印的数值可以带有 GLP 页眉和页脚；可以设置输出值的范围。",
        "JAPANESE": "SBI プリント用のプリントプロファイルは、工場から既に提供されている。タスクの要求に応じて、新しい特別な SBI 印刷プロファイルを作成することができる。印刷物にはGLPヘッダーとフッターを付けることができ、出力値の範囲を設定することができる。",
        "KOREAN": "SBI 인쇄용 인쇄 프로필은 공장에서 이미 제공됩니다. 작업 요구 사항에 따라 새로운 특수 SBI 인쇄 프로필을 만들 수 있습니다. 인쇄물에는 GLP 머리글과 바닥글이 제공될 수 있으며 출력 값의 범위를 구성할 수 있습니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
        "RUSSIAN": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
