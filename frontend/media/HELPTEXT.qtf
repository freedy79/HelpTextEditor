      "TRANSLATIONS": {
        "ENGLISH": "Enter the username as configured in the network.",
        "GERMAN": "Geben Sie den Benutzernamen ein, wie im Netzwerk eingerichtet.",
        "RUSSIAN": "Введите имя пользователя, настроенное в сети.",
        "FRENCH": "Entrez le nom d'utilisateur tel que configuré dans le réseau.",
        "SPANISH": "Introduzca el nombre de usuario configurado en la red.",
        "ITALIAN": "Inserisci il nome utente come configurato nella rete.",
        "CHINESE": "输入在网络中配置的用户名。"
      },
      "AUTOTRANSLATIONS": {
