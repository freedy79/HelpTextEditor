    "DEVICE_MAINTENANCE_FIRMWARE_UPDATE_INSTRUCTION_4": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "To transfer the software update to the balance, follow the steps below.",
        "GERMAN": "Um die Softwareaktualisierung auf die Waage zu übertragen, befolgen Sie die nachfolgenden Schritte.",
        "RUSSIAN": "Чтобы перенести обновление программного обеспечения на весы, выполните следующие действия.",
        "FRENCH": "Pour transférer la mise à jour du logiciel sur la balance, suivez les étapes ci-dessous.",
        "SPANISH": "Para transferir la actualización del software a la balanza, siga los siguientes pasos.",
        "ITALIAN": "Per trasferire l'aggiornamento del software alla bilancia, segui i passi seguenti.",
        "CHINESE": "要将软件更新转移到余额，请按照以下步骤操作。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Чтобы перенести обновление программного обеспечения на весы, выполните следующие действия.",
        "FRENCH": "Pour transférer la mise à jour du logiciel sur la balance, suivez les étapes ci-dessous.",
        "SPANISH": "Para transferir la actualización del software a la balanza, siga los siguientes pasos.",
        "ITALIAN": "Per trasferire l'aggiornamento del software alla bilancia, segui i passi seguenti.",
        "CHINESE": "要将软件更新转移到余额，请按照以下步骤操作。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "DEVICE_MAINTENANCE_FIRMWARE_UPDATE_APPL_STEP_1": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "From the main menu, use the [Setup] button to open the menu for the settings of the balance.",
        "GERMAN": "Vom Hauptmenü aus öffnen Sie mit der Schaltfläche [Einstellungen] das Menü für die Einstellungen der Waage.",
        "RUSSIAN": "В главном меню с помощью кнопки [Setup] откройте меню настроек весов.",
        "FRENCH": "Dans le menu principal, utilisez le bouton [Setup] pour ouvrir le menu des réglages de la balance.",
        "SPANISH": "Desde el menú principal, utilice el botón [Setup] para abrir el menú para los ajustes de la balanza.",
        "ITALIAN": "Dal menu principale, usare il pulsante [Setup] per aprire il menu per le impostazioni del bilanciamento.",
        "CHINESE": "在主菜单中，使用 [设置] 按钮打开天平设置菜单。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "В главном меню с помощью кнопки [Setup] откройте меню настроек весов.",
        "FRENCH": "Dans le menu principal, utilisez le bouton [Setup] pour ouvrir le menu des réglages de la balance.",
        "SPANISH": "Desde el menú principal, utilice el botón [Setup] para abrir el menú para los ajustes de la balanza.",
        "ITALIAN": "Dal menu principale, usare il pulsante [Setup] per aprire il menu per le impostazioni del bilanciamento.",
        "CHINESE": "在主菜单中，使用 [设置] 按钮打开天平设置菜单。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "DEVICE_MAINTENANCE_FIRMWARE_UPDATE_APPL_STEP_2": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ]. The values references to the device menu captions.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Navigate to menu [Device maintenance] -> [Update firmware]",
        "GERMAN": "Navigieren Sie zum Menü [Gerätewartung] -> [Firmware aktualisieren]",
        "RUSSIAN": "Перейдите в меню [Обслуживание устройства] -> [Обновить прошивку].",
        "FRENCH": "Naviguez vers le menu [Maintenance de l'appareil] -> [Mise à jour du micrologiciel].",
        "SPANISH": "Acceda al menú [Mantenimiento del dispositivo] -> [Actualizar el firmware].",
        "ITALIAN": "Passare al menu [Manutenzione del dispositivo] -> [Aggiorna firmware]",
        "CHINESE": "导航至菜单 [设备维护] -> [更新固件］"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Перейдите в меню [Обслуживание устройства] -> [Обновить прошивку].",
        "FRENCH": "Naviguez vers le menu [Maintenance de l'appareil] -> [Mise à jour du micrologiciel].",
        "SPANISH": "Acceda al menú [Mantenimiento del dispositivo] -> [Actualizar el firmware].",
        "ITALIAN": "Passare al menu [Manutenzione del dispositivo] -> [Aggiorna firmware]",
        "CHINESE": "导航至菜单 [设备维护] -> [更新固件］"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "DEVICE_MAINTENANCE_FIRMWARE_UPDATE_APPL_STEP_3": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Select the connector  through which the previously provided file is reached.",
        "GERMAN": "Wählen Sie den Konnektor, über den Sie die zuvor bereitgestellte Datei erreichen.",
        "RUSSIAN": "Выберите коннектор, через который осуществляется доступ к ранее предоставленному файлу.",
        "FRENCH": "Sélectionnez le connecteur par lequel le fichier fourni précédemment est atteint.",
        "SPANISH": "Seleccione el conector a través del cual se llega al archivo previamente proporcionado.",
        "ITALIAN": "Seleziona il connettore attraverso il quale si raggiunge il file fornito in precedenza.",
        "CHINESE": "选择连接先前提供的文件的连接器。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Выберите коннектор, через который осуществляется доступ к ранее предоставленному файлу.",
        "FRENCH": "Sélectionnez le connecteur par lequel le fichier fourni précédemment est atteint.",
        "SPANISH": "Seleccione el conector a través del cual se llega al archivo previamente proporcionado.",
        "ITALIAN": "Seleziona il connettore attraverso il quale si raggiunge il file fornito in precedenza.",
        "CHINESE": "选择连接先前提供的文件的连接器。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "DEVICE_MAINTENANCE_FIRMWARE_UPDATE_APPL_STEP_4": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The device shows all files found in a valid file format via the connector. Select the desired update file.",
        "GERMAN": "Das Gerät zeigt alle Dateien, die in einem gültigen Dateiformat über den Konnektor gefunden werden. Selektieren Sie die gewünschte Aktualisierungsdatei.",
        "RUSSIAN": "Устройство показывает все файлы, найденные в допустимом формате через коннектор. Выберите нужный файл обновления.",
        "FRENCH": "L'appareil affiche tous les fichiers trouvés dans un format de fichier valide via le connecteur. Sélectionnez le fichier de mise à jour souhaité.",
        "SPANISH": "El dispositivo muestra todos los archivos encontrados en un formato de archivo válido a través del conector. Seleccione el archivo de actualización deseado.",
        "ITALIAN": "Il dispositivo mostra tutti i file trovati in un formato valido tramite il connettore. Selezionare il file di aggiornamento desiderato.",
        "CHINESE": "设备会显示通过连接器找到的所有有效文件格式的文件。选择所需的更新文件。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Устройство показывает все файлы, найденные в допустимом формате через коннектор. Выберите нужный файл обновления.",
        "FRENCH": "L'appareil affiche tous les fichiers trouvés dans un format de fichier valide via le connecteur. Sélectionnez le fichier de mise à jour souhaité.",
        "SPANISH": "El dispositivo muestra todos los archivos encontrados en un formato de archivo válido a través del conector. Seleccione el archivo de actualización deseado.",
        "ITALIAN": "Il dispositivo mostra tutti i file trovati in un formato valido tramite il connettore. Selezionare il file di aggiornamento desiderato.",
        "CHINESE": "设备会显示通过连接器找到的所有有效文件格式的文件。选择所需的更新文件。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "DEVICE_MAINTENANCE_FIRMWARE_UPDATE_APPL_STEP_5": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The device displays a confirmation prompt with the selected file. To update the device now, select the [Continue] button. If a qualification date is stored in the device, the note will be adjusted accordingly.",
        "GERMAN": "Das Gerät zeigt eine Sicherheitsabfrage mit der gewählten Datei. Um das Gerät nun zu aktualisieren, wählen Sie die Schaltfläche [Fortfahren]. Falls im Gerät ein Qualifizierungsdatum hinterlegt ist, wird der Hinweis entsprechend angepasst.",
        "RUSSIAN": "На устройстве отобразится запрос подтверждения с выбранным файлом. Чтобы обновить устройство сейчас, выберите кнопку [Продолжить].",
        "FRENCH": "L'appareil affiche une demande de confirmation avec le fichier sélectionné. Pour mettre à jour l'appareil maintenant, sélectionnez le bouton [Continuer].",
        "SPANISH": "El dispositivo muestra un aviso de confirmación con el archivo seleccionado. Para actualizar el dispositivo ahora, seleccione el botón [Continuar].",
        "ITALIAN": "Il dispositivo visualizza un messaggio di conferma con il file selezionato. Per aggiornare il dispositivo ora, seleziona il pulsante [Continua].",
        "CHINESE": "设备会显示确认提示，并显示所选文件。要立即更新设备，请选择 [Continue] 按钮。如果设备中存储了合格日期，则会相应调整备注。"
      },
      "AUTOTRANSLATIONS": {
        "ENGLISH": "The device displays a confirmation prompt with the selected file. To update the device now, select the [Continue] button. If a qualification date is stored in the device, the note will be adjusted accordingly.",
        "RUSSIAN": "На устройстве отобразится запрос подтверждения с выбранным файлом. Чтобы обновить устройство сейчас, выберите кнопку [Продолжить].",
        "FRENCH": "L'appareil affiche une demande de confirmation avec le fichier sélectionné. Pour mettre à jour l'appareil maintenant, sélectionnez le bouton [Continuer].",
        "SPANISH": "El dispositivo muestra un aviso de confirmación con el archivo seleccionado. Para actualizar el dispositivo ahora, seleccione el botón [Continuar].",
        "ITALIAN": "Il dispositivo visualizza un messaggio di conferma con il file selezionato. Per aggiornare il dispositivo ora, seleziona il pulsante [Continua].",
        "CHINESE": "设备会显示确认提示，并显示所选文件。要立即更新设备，请选择 [Continue] 按钮。如果设备中存储了合格日期，则会相应调整备注。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "DEVICE_MAINTENANCE_FIRMWARE_UPDATE_APPL_STEP_6": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The device will now automatically start the update process. The file is transferred to the device, a data backup is stored on the internal memory and any necessary data structures are updated after the restart. This process may take several minutes depending on the available data. <b>The balance must not be disconnected from the power supply during this time.</b>",
        "GERMAN": "Das Gerät startet nun automatisch den Aktualisierungsprozess. Dabei wird die Datei auf das Gerät übertragen, eine Datensicherung auf dem internen Speicher abgelegt und nach dem Neustart ggf. notwendige Datenstrukturen aktualisiert. Dieser Vorgang kann abhängig von den vorliegenden Daten mehrere Minuten dauern. <b>Die Waage darf in dieser Zeit nicht vom Strom getrennt werden.</b>",
        "RUSSIAN": "Теперь устройство автоматически запустит процесс обновления. Файл передается на устройство, резервная копия данных сохраняется во внутренней памяти, и все необходимые структуры данных обновляются после перезапуска. Этот процесс может занять несколько минут в зависимости от имеющихся данных. <b>В течение этого времени нельзя отключать весы от источника питания.</b>",
        "FRENCH": "L'appareil va alors lancer automatiquement le processus de mise à jour. Le fichier est transféré vers l'appareil, une sauvegarde des données est stockée dans la mémoire interne et toutes les structures de données nécessaires sont mises à jour après le redémarrage. Ce processus peut prendre plusieurs minutes en fonction des données disponibles. <b>La balance ne doit pas être déconnectée de l'alimentation électrique pendant ce temps.</b>",
        "SPANISH": "El dispositivo iniciará ahora automáticamente el proceso de actualización. El archivo se transfiere al dispositivo, se almacena una copia de seguridad de los datos en la memoria interna y se actualizan las estructuras de datos necesarias tras el reinicio. Este proceso puede durar varios minutos dependiendo de los datos disponibles. <b>La balanza no debe ser desconectada de la red eléctrica durante este tiempo.</b>",
        "ITALIAN": "Il dispositivo inizierà ora automaticamente il processo di aggiornamento. Il file viene trasferito al dispositivo, un backup dei dati viene memorizzato nella memoria interna e tutte le strutture dati necessarie vengono aggiornate dopo il riavvio. Questo processo può richiedere diversi minuti a seconda dei dati disponibili. <b>La bilancia non deve essere scollegata dall'alimentazione durante questo tempo.</b>",
        "CHINESE": "现在设备将自动启动更新过程。文件将传输到设备，数据备份将存储在内部存储器中，并在重新启动后更新任何必要的数据结构。此过程可能需要几分钟，具体取决于可用数据。<b>在此期间不得断开天平与电源的连接。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Теперь устройство автоматически запустит процесс обновления. Файл передается на устройство, резервная копия данных сохраняется во внутренней памяти, и все необходимые структуры данных обновляются после перезапуска. Этот процесс может занять несколько минут в зависимости от имеющихся данных. <b>В течение этого времени нельзя отключать весы от источника питания.</b>",
        "FRENCH": "L'appareil va alors lancer automatiquement le processus de mise à jour. Le fichier est transféré vers l'appareil, une sauvegarde des données est stockée dans la mémoire interne et toutes les structures de données nécessaires sont mises à jour après le redémarrage. Ce processus peut prendre plusieurs minutes en fonction des données disponibles. <b>La balance ne doit pas être déconnectée de l'alimentation électrique pendant ce temps.</b>",
        "SPANISH": "El dispositivo iniciará ahora automáticamente el proceso de actualización. El archivo se transfiere al dispositivo, se almacena una copia de seguridad de los datos en la memoria interna y se actualizan las estructuras de datos necesarias tras el reinicio. Este proceso puede durar varios minutos dependiendo de los datos disponibles. <b>La balanza no debe ser desconectada de la red eléctrica durante este tiempo.</b>",
        "ITALIAN": "Il dispositivo inizierà ora automaticamente il processo di aggiornamento. Il file viene trasferito al dispositivo, un backup dei dati viene memorizzato nella memoria interna e tutte le strutture dati necessarie vengono aggiornate dopo il riavvio. Questo processo può richiedere diversi minuti a seconda dei dati disponibili. <b>La bilancia non deve essere scollegata dall'alimentazione durante questo tempo.</b>",
        "CHINESE": "现在设备将自动启动更新过程。文件将传输到设备，数据备份将存储在内部存储器中，并在重新启动后更新任何必要的数据结构。此过程可能需要几分钟，具体取决于可用数据。<b>在此期间不得断开天平与电源的连接。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "DEVICE_MAINTENANCE_FIRMWARE_UPDATE_APPL_NOTE": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "After the automatic restart, the device is available with the updated firmware. The new software version can be checked in the status center.",
        "GERMAN": "Nach dem automatischen Neustart steht das Gerät mit der aktualisierten Firmware zur Verfügung. Die neue Software-Version kann im Status-Center überprüft werden.",
        "RUSSIAN": "После автоматического перезапуска устройство доступно с обновленной микропрограммой. Новую версию программного обеспечения можно проверить в центре состояния.",
        "FRENCH": "Après le redémarrage automatique, l'appareil est disponible avec le firmware mis à jour. La nouvelle version du logiciel peut être vérifiée dans le centre d'état.",
        "SPANISH": "Tras el reinicio automático, el dispositivo está disponible con el firmware actualizado. La nueva versión de software se puede comprobar en el centro de estado.",
        "ITALIAN": "Dopo il riavvio automatico, il dispositivo è disponibile con il firmware aggiornato. La nuova versione del software può essere controllata nel centro di stato.",
        "CHINESE": "自动重启后，设备可使用更新的固件。可在状态中心查看新的软件版本。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "После автоматического перезапуска устройство доступно с обновленной микропрограммой. Новую версию программного обеспечения можно проверить в центре состояния.",
        "FRENCH": "Après le redémarrage automatique, l'appareil est disponible avec le firmware mis à jour. La nouvelle version du logiciel peut être vérifiée dans le centre d'état.",
        "SPANISH": "Tras el reinicio automático, el dispositivo está disponible con el firmware actualizado. La nueva versión de software se puede comprobar en el centro de estado.",
        "ITALIAN": "Dopo il riavvio automatico, il dispositivo è disponibile con il firmware aggiornato. La nuova versione del software può essere controllata nel centro di stato.",
        "CHINESE": "自动重启后，设备可使用更新的固件。可在状态中心查看新的软件版本。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
