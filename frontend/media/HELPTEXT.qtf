      "TRANSLATIONS": {
        "ENGLISH": "The connection to the balance is displayed as [Unsecure] in the browser.",
        "GERMAN": "Die Verbindung zur Waage wird im Browser als [Unsicher] angezeigt.",
        "RUSSIAN": "В браузере соединение с весами отображается как [Unsecure].",
        "FRENCH": "La connexion à la balance est affichée comme [Unsecure] dans le navigateur.",
        "SPANISH": "La conexión a la balanza se muestra como [No segura] en el navegador.",
        "ITALIAN": "La connessione alla bilancia viene visualizzata come [Unsecure] nel browser.",
        "CHINESE": "与余额的连接在浏览器中显示为 [不安全]。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "В браузере соединение с весами отображается как [Unsecure].",
        "FRENCH": "La connexion à la balance est affichée comme [Unsecure] dans le navigateur.",
        "SPANISH": "La conexión a la balanza se muestra como [No segura] en el navegador.",
        "ITALIAN": "La connessione alla bilancia viene visualizzata come [Unsecure] nel browser.",
