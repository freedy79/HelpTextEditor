    "LOGIN_RULES_TITLE": {
      "group": "HELP_TITLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Rules for login",
        "GERMAN": "Regeln für die Anmeldung",
        "RUSSIAN": "Правила входа в систему",
        "FRENCH": "Règles de connexion",
        "SPANISH": "Normas de acceso",
        "ITALIAN": "Regole per il login",
        "CHINESE": "登录规则"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Правила входа в систему",
        "FRENCH": "Règles de connexion",
        "SPANISH": "Normas de acceso",
        "ITALIAN": "Regole per il login",
        "CHINESE": "登录规则"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "LOGIN_RULES_INSTRUCTION": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The user login can be set to require password entry or not. The password must consist of at least one character. No further rules are activated ex-factory.",
        "GERMAN": "Die Anmeldung des Benutzers kann so eingestellt werden, dass eine Passworteingabe erforderlich ist oder nicht. Das Passwort muss mindestens aus einem Zeichen bestehen. Ab Werk sind keine weiteren Regeln aktiviert.",
        "RUSSIAN": "Для входа пользователя в систему можно установить требование ввода пароля или нет. Пароль должен состоять как минимум из одного символа. Никакие другие правила не активируются на заводе.",
        "FRENCH": "La connexion de l'utilisateur peut être paramétrée pour exiger ou non la saisie d'un mot de passe. Le mot de passe doit être composé d'au moins un caractère. Aucune autre règle n'est activée en usine.",
        "SPANISH": "El inicio de sesión del usuario puede configurarse para que requiera la introducción de una contraseña o no. La contraseña debe constar de al menos un carácter. No se activan más reglas de fábrica.",
        "ITALIAN": "Il login utente può essere impostato per richiedere o meno l'inserimento di una password. La password deve consistere di almeno un carattere. Non ci sono altre regole attivate in fabbrica.",
        "CHINESE": "可以设置用户登录是否需要输入密码。密码必须至少包含一个字符。出厂时不激活其他规则。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Для входа пользователя в систему можно установить требование ввода пароля или нет. Пароль должен состоять как минимум из одного символа. Никакие другие правила не активируются на заводе.",
        "FRENCH": "La connexion de l'utilisateur peut être paramétrée pour exiger ou non la saisie d'un mot de passe. Le mot de passe doit être composé d'au moins un caractère. Aucune autre règle n'est activée en usine.",
        "SPANISH": "El inicio de sesión del usuario puede configurarse para que requiera la introducción de una contraseña o no. La contraseña debe constar de al menos un carácter. No se activan más reglas de fábrica.",
        "ITALIAN": "Il login utente può essere impostato per richiedere o meno l'inserimento di una password. La password deve consistere di almeno un carattere. Non ci sono altre regole attivate in fabbrica.",
        "CHINESE": "可以设置用户登录是否需要输入密码。密码必须至少包含一个字符。出厂时不激活其他规则。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "AUTOM_LOGIN_TITLE": {
      "group": "HELP_TITLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Automatic login",
        "GERMAN": "Automatische Anmeldung",
        "FRENCH": "Connexion automatique",
        "RUSSIAN": "Автоматический вход в систему",
        "SPANISH": "Inicio de sesión automático",
        "ITALIAN": "Accesso automatico",
        "CHINESE": "自动登录"
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Connexion automatique",
        "RUSSIAN": "Автоматический вход в систему",
        "SPANISH": "Inicio de sesión automático",
        "ITALIAN": "Accesso automatico",
        "CHINESE": "自动登录"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
        "RUSSIAN": false,
        "SPANISH": false,
        "ITALIAN": false,
