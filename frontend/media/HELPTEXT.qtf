    "EXAMPLE_WITH_DEFAULT_PROFILE_CONF_STEP_1_D": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "If necessary, specify the number of identifiers for the lot (batch) and the samples. Everything else is described in the application examples for printing.",
        "GERMAN": "Legen Sie ggf. die Anzahl der Bezeichner für Lot (Charge) und Proben fest. Alles weiter dazu ist in Anwendungsbeispielen für das Drucken beschrieben.",
        "RUSSIAN": "При необходимости укажите количество идентификаторов для партии (batch) и образцов. Все остальное описано в примерах приложений для печати.",
        "FRENCH": "Si nécessaire, spécifiez le nombre d'identifiants pour le lot (batch) et les échantillons. Tout le reste est décrit dans les exemples d'application pour l'impression.",
        "SPANISH": "Si es necesario, especifique el número de identificadores para el lote y las muestras. Todo lo demás se describe en los ejemplos de aplicación para la impresión.",
        "ITALIAN": "Se necessario, specificate il numero di identificatori per il lotto (batch) e i campioni. Tutto il resto è descritto negli esempi di applicazione per la stampa.",
        "CHINESE": "如有必要，请指定批次（批量）和样品的标识符数量。其他事项在打印应用示例中均有说明。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "При необходимости укажите количество идентификаторов для партии (batch) и образцов. Все остальное описано в примерах приложений для печати.",
        "FRENCH": "Si nécessaire, spécifiez le nombre d'identifiants pour le lot (batch) et les échantillons. Tout le reste est décrit dans les exemples d'application pour l'impression.",
        "SPANISH": "Si es necesario, especifique el número de identificadores para el lote y las muestras. Todo lo demás se describe en los ejemplos de aplicación para la impresión.",
        "ITALIAN": "Se necessario, specificate il numero di identificatori per il lotto (batch) e i campioni. Tutto il resto è descritto negli esempi di applicazione per la stampa.",
        "CHINESE": "如有必要，请指定批次（批量）和样品的标识符数量。其他事项在打印应用示例中均有说明。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "EXAMPLE_WITH_DEFAULT_PROFILE_CONF_STEP_1_E": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Select the [Weighing in safety cabinet] weighing profile and then select a suitable print profile for your application.",
        "GERMAN": "Wählen Sie das Wägeprofil [Wägen in Sicherheitswerkbank] und dann ein passendes Druckprofil für ihre Anwendung aus.",
        "RUSSIAN": "Выберите профиль взвешивания [Взвешивание в шкафу безопасности], а затем выберите подходящий профиль печати для вашего приложения.",
        "FRENCH": "Sélectionnez le profil de pesée [Pesée dans une enceinte de sécurité], puis sélectionnez un profil d'impression adapté à votre application.",
        "SPANISH": "Seleccione el perfil de pesaje [Pesaje en cabina de seguridad] y, a continuación, seleccione un perfil de impresión adecuado para su aplicación.",
        "ITALIAN": "Selezionare il profilo di pesatura [Weighing in safety cabinet] e poi selezionare un profilo di stampa adatto alla propria applicazione.",
        "CHINESE": "选择 [在安全柜中称重] 称重曲线，然后选择适合您应用的打印曲线。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Выберите профиль взвешивания [Взвешивание в шкафу безопасности], а затем выберите подходящий профиль печати для вашего приложения.",
        "FRENCH": "Sélectionnez le profil de pesée [Pesée dans une enceinte de sécurité], puis sélectionnez un profil d'impression adapté à votre application.",
        "SPANISH": "Seleccione el perfil de pesaje [Pesaje en cabina de seguridad] y, a continuación, seleccione un perfil de impresión adecuado para su aplicación.",
        "ITALIAN": "Selezionare il profilo di pesatura [Weighing in safety cabinet] e poi selezionare un profilo di stampa adatto alla propria applicazione.",
        "CHINESE": "选择 [在安全柜中称重] 称重曲线，然后选择适合您应用的打印曲线。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "EXAMPLE_WITH_DEFAULT_PROFILE_CONF_STEP_1_F": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Thereafter, enter the name and description of the task, select user roles and save the task.",
        "GERMAN": "Anschließend Name und Beschreibung der Task eingeben, Benutzerrollen auswählen und Task speichern.",
        "RUSSIAN": "После этого введите название и описание задачи, выберите роли пользователей и сохраните задачу.",
        "FRENCH": "Ensuite, saisissez le nom et la description de la tâche, sélectionnez les rôles des utilisateurs et enregistrez la tâche.",
        "SPANISH": "A continuación, introduzca el nombre y la descripción de la tarea, seleccione los roles de los usuarios y guarde la tarea.",
        "ITALIAN": "In seguito, inserite il nome e la descrizione del compito, selezionate i ruoli utente e salvate il compito.",
        "CHINESE": "然后，输入任务名称和说明，选择用户角色并保存任务。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "После этого введите название и описание задачи, выберите роли пользователей и сохраните задачу.",
        "FRENCH": "Ensuite, saisissez le nom et la description de la tâche, sélectionnez les rôles des utilisateurs et enregistrez la tâche.",
        "SPANISH": "A continuación, introduzca el nombre y la descripción de la tarea, seleccione los roles de los usuarios y guarde la tarea.",
        "ITALIAN": "In seguito, inserite il nome e la descrizione del compito, selezionate i ruoli utente e salvate il compito.",
        "CHINESE": "然后，输入任务名称和说明，选择用户角色并保存任务。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "EXAMPLE_WITH_DEFAULT_PROFILE_CONF_NOTE": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Note: In the same way, further weighing tasks can be created with the preset [Dosing] or [2nd tare memory] weighing profiles.",
        "GERMAN": "Anmerkung: Auf die gleiche Weise können mit den vorgegebenen Wägeprofilen [Dosieren] oder [2.Taraspeicher] weitere Task für das Wägen angelegt werden.",
        "RUSSIAN": "Примечание: Таким же образом можно создать дополнительные задачи взвешивания с помощью предустановленных профилей взвешивания [Дозирование] или [Память 2-й тары].",
        "FRENCH": "Note : De la même manière, d'autres tâches de pesage peuvent être créées avec les profils de pesage prédéfinis [Dosage] ou [2ème mémoire de tare].",
        "SPANISH": "Nota: Del mismo modo, se pueden crear otras tareas de pesaje con los perfiles de pesaje preestablecidos [Dosificación] o [2ª memoria de tara].",
        "ITALIAN": "Nota: Allo stesso modo, ulteriori compiti di pesatura possono essere creati con i profili di pesatura preimpostati [Dosing] o [2nd tare memory].",
        "CHINESE": "注：同样，也可以使用预设的 [配料] 或 [第二皮重存储器] 称重预案创建更多称重任务。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Примечание: Таким же образом можно создать дополнительные задачи взвешивания с помощью предустановленных профилей взвешивания [Дозирование] или [Память 2-й тары].",
        "FRENCH": "Note : De la même manière, d'autres tâches de pesage peuvent être créées avec les profils de pesage prédéfinis [Dosage] ou [2ème mémoire de tare].",
        "SPANISH": "Nota: Del mismo modo, se pueden crear otras tareas de pesaje con los perfiles de pesaje preestablecidos [Dosificación] o [2ª memoria de tara].",
        "ITALIAN": "Nota: Allo stesso modo, ulteriori compiti di pesatura possono essere creati con i profili di pesatura preimpostati [Dosing] o [2nd tare memory].",
        "CHINESE": "注：同样，也可以使用预设的 [配料] 或 [第二皮重存储器] 称重预案创建更多称重任务。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
