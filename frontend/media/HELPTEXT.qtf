    "NETWORK_CONNECTION_INSTRUCTION_5": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The Cubis® MCA balance can have an IPv4 and an IPv6 address each on Ethernet and Wi-Fi respectively i.e., up to 4 addresses.",
        "GERMAN": "Die Cubis® MCA-Waage kann auf Ethernet und Wi-Fi jeweils eine IPv4 und eine IPv6 Adresse haben, d. h. damit bis zu 4 Adressen.",
        "RUSSIAN": "весы Cubis® MCA может иметь по одному IPv4 и IPv6 адресу в сетях Ethernet и Wi-Fi соответственно, т.е. до 4 адресов.",
        "FRENCH": "La balance Cubis® MCA peut avoir une adresse IPv4 et une adresse IPv6 sur Ethernet et Wi-Fi respectivement, soit jusqu'à 4 adresses.",
        "SPANISH": "La balanza Cubis® MCA puede tener una dirección IPv4 y otra IPv6 en Ethernet y Wi-Fi respectivamente, es decir, hasta 4 direcciones.",
        "ITALIAN": "La bilancia Cubis® MCA può avere un indirizzo IPv4 e uno IPv6 ciascuno su Ethernet e Wi-Fi rispettivamente, cioè fino a 4 indirizzi.",
        "CHINESE": "Cubis® MCA 天平可在以太网和 Wi-Fi 上分别拥有一个 IPv4 和一个 IPv6 地址，即最多 4 个地址。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "весы Cubis® MCA может иметь по одному IPv4 и IPv6 адресу в сетях Ethernet и Wi-Fi соответственно, т.е. до 4 адресов.",
        "FRENCH": "La balance Cubis® MCA peut avoir une adresse IPv4 et une adresse IPv6 sur Ethernet et Wi-Fi respectivement, soit jusqu'à 4 adresses.",
        "SPANISH": "La balanza Cubis® MCA puede tener una dirección IPv4 y otra IPv6 en Ethernet y Wi-Fi respectivamente, es decir, hasta 4 direcciones.",
        "ITALIAN": "La bilancia Cubis® MCA può avere un indirizzo IPv4 e uno IPv6 ciascuno su Ethernet e Wi-Fi rispettivamente, cioè fino a 4 indirizzi.",
        "CHINESE": "Cubis® MCA 天平可在以太网和 Wi-Fi 上分别拥有一个 IPv4 和一个 IPv6 地址，即最多 4 个地址。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "NETWORK_CONNECTION_INSTRUCTION_6": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "Do not translate HTML link commands, e.g. <a href=\"#NETWORK_ETHERNET\"> and </a>.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Via the network connections <a href=\"#NETWORK_ETHERNET\">Ethernet (LAN)</a> and <a href=\"#NETWORK_WLAN\">Wi-Fi (WLAN)</a>, the Cubis® MCA balance simultaneously offers several <a href=\"#NETWORK_SERVICES\">network services</a>.",
        "GERMAN": "Über die Netzwerkverbindungen <a href=\"#NETWORK_ETHERNET\">Ethernet (LAN)</a> und <a href=\"#NETWORK_WLAN\">Wi-Fi (WLAN)</a> bietet die Cubis® MCA-Waage gleichzeitig mehrere <a href=\"#NETWORK_SERVICES\">Netzwerkdienste</a>.",
        "RUSSIAN": "Через сетевые соединения <a href=\"#NETWORK_ETHERNET\">Ethernet (LAN)</a> и <a href=\"#NETWORK_WLAN\">Wi-Fi (WLAN)</a> весы Cubis® MCA одновременно предлагает несколько <a href=\"#NETWORK_SERVICES\">сетевых услуг</a>.",
        "FRENCH": "Via les connexions réseau <a href=\"#NETWORK_ETHERNET\">Ethernet (LAN)</a> et <a href=\"#NETWORK_WLAN\">Wi-Fi (WLAN)</a>, la balance Cubis® MCA offre simultanément plusieurs <a href=\"#NETWORK_SERVICES\">services réseau</a>.",
        "SPANISH": "A través de las conexiones de red <a href=\"#NETWORK_ETHERNET\">Ethernet (LAN)</a> y <a href=\"#NETWORK_WLAN\">Wi-Fi (WLAN)</a>, la balanza Cubis® MCA ofrece simultáneamente varios <a href=\"#NETWORK_SERVICES\">servicios de red</a>.",
        "ITALIAN": "Attraverso le connessioni di rete <a href=\"#NETWORK_ETHERNET\">Ethernet (LAN)</a> e <a href=\"#NETWORK_WLAN\">Wi-Fi (WLAN)</a>, la bilancia Cubis® MCA offre contemporaneamente diversi <a href=\"#NETWORK_SERVICES\">servizi di rete</a>.",
        "CHINESE": "通过网络连接<a href=\"#NETWORK_ETHERNET\">以太网（LAN）</a>和<a href=\"#NETWORK_WLAN\">无线网络（WLAN）</a>，Cubis® MCA 天平可同时提供多种<a href=\"#NETWORK_SERVICES\">网络服务</a>。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Через сетевые соединения <a href=\"#NETWORK_ETHERNET\">Ethernet (LAN)</a> и <a href=\"#NETWORK_WLAN\">Wi-Fi (WLAN)</a> весы Cubis® MCA одновременно предлагает несколько <a href=\"#NETWORK_SERVICES\">сетевых услуг</a>.",
        "FRENCH": "Via les connexions réseau <a href=\"#NETWORK_ETHERNET\">Ethernet (LAN)</a> et <a href=\"#NETWORK_WLAN\">Wi-Fi (WLAN)</a>, la balance Cubis® MCA offre simultanément plusieurs <a href=\"#NETWORK_SERVICES\">services réseau</a>.",
        "SPANISH": "A través de las conexiones de red <a href=\"#NETWORK_ETHERNET\">Ethernet (LAN)</a> y <a href=\"#NETWORK_WLAN\">Wi-Fi (WLAN)</a>, la balanza Cubis® MCA ofrece simultáneamente varios <a href=\"#NETWORK_SERVICES\">servicios de red</a>.",
        "ITALIAN": "Attraverso le connessioni di rete <a href=\"#NETWORK_ETHERNET\">Ethernet (LAN)</a> e <a href=\"#NETWORK_WLAN\">Wi-Fi (WLAN)</a>, la bilancia Cubis® MCA offre contemporaneamente diversi <a href=\"#NETWORK_SERVICES\">servizi di rete</a>.",
        "CHINESE": "通过网络连接<a href=\"#NETWORK_ETHERNET\">以太网（LAN）</a>和<a href=\"#NETWORK_WLAN\">无线网络（WLAN）</a>，Cubis® MCA 天平可同时提供多种<a href=\"#NETWORK_SERVICES\">网络服务</a>。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
