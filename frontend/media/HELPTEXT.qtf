    "DEVICE_MAINTENANCE_IMPORTEXPORT_CONCEPT_1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "Do not translate HTML link commands, e.g. <a href=\"#....\"> and </a>.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The export and import functions are fundamentally based on the menu structure of the device. A distinction is made between two basic types:",
        "GERMAN": "Die Export- und Importfunktion orientiert sich grundsätzlich an der Menüstruktur des Geräts. Dabei werden zwei grundsätzliche Typen unterschieden:",
        "RUSSIAN": "Функции экспорта и импорта принципиально основаны на структуре меню устройства. Различают два основных типа:",
        "FRENCH": "Les fonctions d'exportation et d'importation sont fondamentalement basées sur la structure du menu de l'appareil. On distingue deux types de base :",
        "SPANISH": "Las funciones de exportación e importación se basan fundamentalmente en la estructura de menús del aparato. Se distinguen dos tipos básicos:",
        "ITALIAN": "Le funzioni di esportazione e importazione si basano fondamentalmente sulla struttura del menu dell'apparecchio. Si distingue tra due tipi di base:",
        "CHINESE": "导出和导入功能主要基于设备的菜单结构。有两种基本类型可供选择："
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Функции экспорта и импорта принципиально основаны на структуре меню устройства. Различают два основных типа:",
        "FRENCH": "Les fonctions d'exportation et d'importation sont fondamentalement basées sur la structure du menu de l'appareil. On distingue deux types de base :",
        "SPANISH": "Las funciones de exportación e importación se basan fundamentalmente en la estructura de menús del aparato. Se distinguen dos tipos básicos:",
        "ITALIAN": "Le funzioni di esportazione e importazione si basano fondamentalmente sulla struttura del menu dell'apparecchio. Si distingue tra due tipi di base:",
        "CHINESE": "导出和导入功能主要基于设备的菜单结构。有两种基本类型可供选择："
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
