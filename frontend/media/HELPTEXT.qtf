    },
    "EXAMPLE_CREATE_NETWORK_USER_CONF_STEP_2_A": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
