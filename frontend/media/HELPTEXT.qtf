    "EXAMPLE_CREATE_NETWORK_USER_CONF_STEP_1": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The following items are the prerequisite for configuring a network user.",
        "GERMAN": "Voraussetzungen für das Einrichten von einem Netzwerk-Benutzer sind diese Punkte.",
        "RUSSIAN": "Следующие элементы являются необходимым условием для настройки сетевого пользователя.",
        "FRENCH": "Les éléments suivants constituent la condition préalable à la configuration d'un utilisateur réseau.",
        "SPANISH": "Los siguientes elementos son el requisito previo para configurar un usuario de red.",
        "ITALIAN": "I seguenti elementi sono il prerequisito per la configurazione di un utente di rete.",
        "CHINESE": "以下项目是配置网络用户的前提条件。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Следующие элементы являются необходимым условием для настройки сетевого пользователя.",
        "FRENCH": "Les éléments suivants constituent la condition préalable à la configuration d'un utilisateur réseau.",
        "SPANISH": "Los siguientes elementos son el requisito previo para configurar un usuario de red.",
        "ITALIAN": "I seguenti elementi sono il prerequisito per la configurazione di un utente di rete.",
        "CHINESE": "以下项目是配置网络用户的前提条件。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "EXAMPLE_CREATE_NETWORK_USER_CONF_STEP_1_A": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ]. Do not translate QAPP and QAPP Center.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The [User management] QAPP extension is activated on the balance.",
        "GERMAN": "Die QAPP-Erweiterung [Benutzerverwaltung] ist auf der Waage aktiviert.",
        "RUSSIAN": "Расширение QAPP [Управление пользователями] активировано на весах.",
        "FRENCH": "L'extension QAPP [Gestion des utilisateurs] est activée sur la balance.",
        "SPANISH": "La extensión [Gestión de usuarios] QAPP se activa en la balanza.",
        "ITALIAN": "L'estensione QAPP [Gestione utenti] è attivata sulla bilancia.",
        "CHINESE": "用户管理] QAPP 扩展已在天平上激活。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Расширение QAPP [Управление пользователями] активировано на весах.",
        "FRENCH": "L'extension QAPP [Gestion des utilisateurs] est activée sur la balance.",
        "SPANISH": "La extensión [Gestión de usuarios] QAPP se activa en la balanza.",
        "ITALIAN": "L'estensione QAPP [Gestione utenti] è attivata sulla bilancia.",
        "CHINESE": "用户管理] QAPP 扩展已在天平上激活。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "EXAMPLE_CREATE_NETWORK_USER_CONF_STEP_1_B": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The balance is connected to the network and an LDAP server is present there.",
        "GERMAN": "Die Waage ist am Netzwerk angeschlossen und dort befindet sich ein LDAP Server.",
        "RUSSIAN": "весы подключены к сети, и в ней присутствует LDAP-сервер.",
        "FRENCH": "La balance est connectée au réseau et un serveur LDAP y est présent.",
        "SPANISH": "La balanza está conectada a la red y en ella hay un servidor LDAP.",
        "ITALIAN": "La bilancia è collegata alla rete e vi è presente un server LDAP.",
        "CHINESE": "余额已连接到网络，并且那里有一个 LDAP 服务器。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "весы подключены к сети, и в ней присутствует LDAP-сервер.",
        "FRENCH": "La balance est connectée au réseau et un serveur LDAP y est présent.",
        "SPANISH": "La balanza está conectada a la red y en ella hay un servidor LDAP.",
        "ITALIAN": "La bilancia è collegata alla rete e vi è presente un server LDAP.",
        "CHINESE": "余额已连接到网络，并且那里有一个 LDAP 服务器。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "EXAMPLE_CREATE_NETWORK_USER_CONF_STEP_1_C": {
