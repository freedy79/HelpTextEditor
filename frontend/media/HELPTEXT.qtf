      "TRANSLATIONS": {
        "ENGLISH": "Figure 1: Components of a task",
        "GERMAN": "Abbildung 1: Bestandteile einer Task",
        "FRENCH": "Figure 1 : Composants d'une tâche",
        "RUSSIAN": "Рисунок 1: Компоненты задачи",
        "SPANISH": "Figura 1: Componentes de una tarea",
        "ITALIAN": "Figura 1: Componenti di un compito",
        "CHINESE": "图 1：任务的组成部分",
        "JAPANESE": "図1：タスクの構成要素",
        "KOREAN": "그림 1: 작업의 구성 요소"
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Figure 1 : Composants d'une tâche",
        "RUSSIAN": "Рисунок 1: Компоненты задачи",
        "SPANISH": "Figura 1: Componentes de una tarea",
        "ITALIAN": "Figura 1: Componenti di un compito",
        "CHINESE": "图 1：任务的组成部分",
        "JAPANESE": "図1：タスクの構成要素",
        "KOREAN": "그림 1: 작업의 구성 요소"
      },
      "VERIFIED": {
        "ENGLISH": false,
