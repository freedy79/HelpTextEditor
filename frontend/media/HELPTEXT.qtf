    "DEVICE_CLEANING_DASHBOARD_INSTRUCTION_1": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "When cleaning support is enabled, a tile in the status center shows the current cleaning status. Furthermore, the last time of soiling and cleaning can be viewed there.",
        "GERMAN": "Wenn die Reinigungsunterstützung aktiviert ist, zeigt eine Kachel im Statuszentrum den aktuellen Reinigungszustand an. Weiterhin kann dort der letzte Zeitpunkt der Verschmutzung sowie der Reinigung eingesehen werden.",
        "CHINESE": "启用清洁支持后，状态中心的磁贴将显示当前的清洁状态。此外，还可以查看上次弄脏和清洁的时间。",
        "FRENCH": "Lorsque l'aide au nettoyage est activée, un carreau dans le centre d'état indique l'état actuel du nettoyage. En outre, il est possible d'y voir la dernière heure de salissure ainsi que le nettoyage.",
        "SPANISH": "Cuando el soporte de limpieza está activado, un azulejo en el centro de estado muestra el estado de limpieza actual. Además, allí se puede ver la última vez que se ensució y limpió.",
        "RUSSIAN": "Если поддержка очистки включена, в центре состояния появляется плитка, показывающая текущий статус очистки. Кроме того, там можно просмотреть время последнего загрязнения и уборки.",
        "ITALIAN": "Quando il supporto per la pulizia è abilitato, un riquadro nel centro di stato mostra lo stato attuale della pulizia. Inoltre, è possibile visualizzare l'ultimo periodo di sporcizia e pulizia."
      },
      "AUTOTRANSLATIONS": {
        "CHINESE": "启用清洁支持后，状态中心的磁贴将显示当前的清洁状态。此外，还可以查看上次弄脏和清洁的时间。",
        "FRENCH": "Lorsque l'aide au nettoyage est activée, un carreau dans le centre d'état indique l'état actuel du nettoyage. En outre, il est possible d'y voir la dernière heure de salissure ainsi que le nettoyage.",
        "SPANISH": "Cuando el soporte de limpieza está activado, un azulejo en el centro de estado muestra el estado de limpieza actual. Además, allí se puede ver la última vez que se ensució y limpió.",
        "RUSSIAN": "Если поддержка очистки включена, в центре состояния появляется плитка, показывающая текущий статус очистки. Кроме того, там можно просмотреть время последнего загрязнения и уборки.",
        "ITALIAN": "Quando il supporto per la pulizia è abilitato, un riquadro nel centro di stato mostra lo stato attuale della pulizia. Inoltre, è possibile visualizzare l'ultimo periodo di sporcizia e pulizia."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "CHINESE": false,
        "FRENCH": false,
        "SPANISH": false,
        "RUSSIAN": false,
        "ITALIAN": false
      }
    },
    "IMAGE_DASHBOARD_CLEANING_TILE": {
