      "TRANSLATIONS": {
        "ENGLISH": "Activate the editing of the settings using the [Edit] button.",
        "GERMAN": "Aktivieren Sie mit der Schaltfläche [Bearbeiten] das Ändern der Einstellungen.",
        "RUSSIAN": "Активируйте редактирование настроек с помощью кнопки [Edit].",
        "FRENCH": "Activez l'édition des paramètres à l'aide du bouton [Edit].",
        "SPANISH": "Active la edición de los ajustes mediante el botón [Editar].",
        "ITALIAN": "Attivare la modifica delle impostazioni con il pulsante [Modifica].",
        "CHINESE": "使用 [Edit] 按钮激活设置编辑。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Активируйте редактирование настроек с помощью кнопки [Edit].",
        "FRENCH": "Activez l'édition des paramètres à l'aide du bouton [Edit].",
        "SPANISH": "Active la edición de los ajustes mediante el botón [Editar].",
        "ITALIAN": "Attivare la modifica delle impostazioni con il pulsante [Modifica].",
        "CHINESE": "使用 [Edit] 按钮激活设置编辑。"
      },
      "VERIFIED": {
