      "TRANSLATIONS": {
        "ENGLISH": "Wake-up from standby",
        "GERMAN": "Aufwachen aus Standby",
        "RUSSIAN": "Пробуждение из режима ожидания",
        "FRENCH": "Réveil à partir de la veille",
        "SPANISH": "Despertar desde el modo de espera",
        "ITALIAN": "Risveglio dallo standby",
        "CHINESE": "从待机状态唤醒"
      },
      "AUTOTRANSLATIONS": {
