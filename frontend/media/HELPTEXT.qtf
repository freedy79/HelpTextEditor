      "TRANSLATIONS": {
        "ENGLISH": "Application Examples",
        "GERMAN": "Anwendungsbeispiele",
        "RUSSIAN": "Примеры применения",
        "FRENCH": "Exemples d'application",
        "SPANISH": "Ejemplos de aplicación",
        "ITALIAN": "Esempi di applicazioni",
        "CHINESE": "应用实例"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Примеры применения",
        "FRENCH": "Exemples d'application",
        "SPANISH": "Ejemplos de aplicación",
        "ITALIAN": "Esempi di applicazioni",
        "CHINESE": "应用实例"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
