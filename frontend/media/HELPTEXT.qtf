    "TCA_NAME_PROPERTIES_INSTRUCTION_1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The [Name] is the unique designation for the action, to distinguish it from other actions, the name should be entered to match the action. The special [Properties] of the action differ depending upon the action.",
        "GERMAN": "Der [Name] ist die eindeutige Bezeichnung für die Aktion, zur Unterscheidung gegenüber anderen Aktionen, sollte der Name zur Aktion passend eingegeben werden. Die speziellen [Eigenschaften] der Aktion sind je nach Aktion unterschiedlich.",
        "RUSSIAN": "Имя [Name] - это уникальное обозначение действия, чтобы отличить его от других действий, имя должно быть введено в соответствии с действием. Специальные [Свойства] действия различаются в зависимости от действия.",
        "FRENCH": "Le [Nom] est la désignation unique de l'action. Pour la distinguer des autres actions, le nom doit être saisi en fonction de l'action. Les [Propriétés] spéciales de l'action varient en fonction de l'action.",
        "SPANISH": "El [Nombre] es la designación única de la acción, para distinguirla de otras acciones, el nombre debe introducirse para que coincida con la acción. Las [Propiedades] especiales de la acción difieren según la acción.",
        "ITALIAN": "Il [Nome] è la designazione unica per l'azione, per distinguerla da altre azioni, il nome dovrebbe essere inserito per corrispondere all'azione. Le [Proprietà] speciali dell'azione differiscono a seconda dell'azione.",
        "CHINESE": "名称]是该操作的唯一名称，为将其与其他操作区分开来，应输入与该操作相匹配的名称。操作的特殊 [属性] 因操作而异。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Имя [Name] - это уникальное обозначение действия, чтобы отличить его от других действий, имя должно быть введено в соответствии с действием. Специальные [Свойства] действия различаются в зависимости от действия.",
        "FRENCH": "Le [Nom] est la désignation unique de l'action. Pour la distinguer des autres actions, le nom doit être saisi en fonction de l'action. Les [Propriétés] spéciales de l'action varient en fonction de l'action.",
        "SPANISH": "El [Nombre] es la designación única de la acción, para distinguirla de otras acciones, el nombre debe introducirse para que coincida con la acción. Las [Propiedades] especiales de la acción difieren según la acción.",
        "ITALIAN": "Il [Nome] è la designazione unica per l'azione, per distinguerla da altre azioni, il nome dovrebbe essere inserito per corrispondere all'azione. Le [Proprietà] speciali dell'azione differiscono a seconda dell'azione.",
        "CHINESE": "名称]是该操作的唯一名称，为将其与其他操作区分开来，应输入与该操作相匹配的名称。操作的特殊 [属性] 因操作而异。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
