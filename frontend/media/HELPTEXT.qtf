      }
    },
    "EXAMPLE_CHANGE_USER_SET_CONF_STEP_1_D": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Select the [User color profile] menu item and set the color, for instance, [Red] for the user field.",
        "GERMAN": "Wählen Sie den Punkt [Farbprofil Benutzer] und stellen Sie die Farbe z. B. [Rot] für das Benutzerfeld ein.",
        "RUSSIAN": "Выберите пункт меню [Цветовой профиль пользователя] и установите цвет, например, [Красный] для поля пользователя.",
        "FRENCH": "Sélectionnez l'élément de menu [User color profile] et définissez la couleur, par exemple, [Red] pour le champ utilisateur.",
        "SPANISH": "Seleccione la opción de menú [Perfil de color del usuario] y establezca el color, por ejemplo, [Rojo] para el campo del usuario.",
        "ITALIAN": "Selezionate la voce di menu [Profilo colore utente] e impostate il colore, per esempio, [Rosso] per il campo utente.",
        "CHINESE": "选择 [用户色彩配置文件] 菜单项并设置颜色，例如为用户字段设置 [红色]。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Выберите пункт меню [Цветовой профиль пользователя] и установите цвет, например, [Красный] для поля пользователя.",
        "FRENCH": "Sélectionnez l'élément de menu [User color profile] et définissez la couleur, par exemple, [Red] pour le champ utilisateur.",
        "SPANISH": "Seleccione la opción de menú [Perfil de color del usuario] y establezca el color, por ejemplo, [Rojo] para el campo del usuario.",
        "ITALIAN": "Selezionate la voce di menu [Profilo colore utente] e impostate il colore, per esempio, [Rosso] per il campo utente.",
        "CHINESE": "选择 [用户色彩配置文件] 菜单项并设置颜色，例如为用户字段设置 [红色]。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "EXAMPLE_CHANGE_USER_SET_CONF_STEP_1_E": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
