    "TCA_EXAMPLE_SHOW_MESSAGE_CONF_STEP_1": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Set up a timer-controlled action for displaying a message, such as [My daily cleaning and testing].",
        "GERMAN": "Richten Sie eine zeitgesteuerte Aktion für das Anzeigen einer Nachricht ein, z. B. [Meine tägliche Reinigung und Prüfung].",
        "RUSSIAN": "Настройте управляемое таймером действие для отображения сообщения, например [Моя ежедневная уборка и проверка].",
        "FRENCH": "Configurez une action commandée par minuterie pour afficher un message, tel que [Mon nettoyage et mes tests quotidiens].",
        "SPANISH": "Configure una acción controlada por un temporizador para mostrar un mensaje, como por ejemplo [Mi limpieza y comprobación diaria].",
        "ITALIAN": "Impostare un'azione controllata da un timer per la visualizzazione di un messaggio, come ad esempio [La mia pulizia quotidiana e il test].",
        "CHINESE": "为显示信息设置一个由计时器控制的操作，例如 [我的日常清洁和测试]。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Настройте управляемое таймером действие для отображения сообщения, например [Моя ежедневная уборка и проверка].",
        "FRENCH": "Configurez une action commandée par minuterie pour afficher un message, tel que [Mon nettoyage et mes tests quotidiens].",
        "SPANISH": "Configure una acción controlada por un temporizador para mostrar un mensaje, como por ejemplo [Mi limpieza y comprobación diaria].",
        "ITALIAN": "Impostare un'azione controllata da un timer per la visualizzazione di un messaggio, come ad esempio [La mia pulizia quotidiana e il test].",
        "CHINESE": "为显示信息设置一个由计时器控制的操作，例如 [我的日常清洁和测试]。"
      },
