      "TRANSLATIONS": {
        "ENGLISH": "Status center tile",
        "GERMAN": "Anzeige im Status-Center",
        "CHINESE": "状态中心磁砖",
        "FRENCH": "Affichage dans le centre d'état",
        "SPANISH": "Azulejo central de estado",
        "RUSSIAN": "Плитка центра состояния",
        "ITALIAN": "Piastrella centrale di stato"
      },
      "AUTOTRANSLATIONS": {
        "CHINESE": "状态中心磁砖",
        "FRENCH": "Affichage dans le centre d'état",
        "SPANISH": "Azulejo central de estado",
        "RUSSIAN": "Плитка центра состояния",
        "ITALIAN": "Piastrella centrale di stato"
      },
      "VERIFIED": {
        "ENGLISH": false,
