      "TRANSLATIONS": {
        "ENGLISH": "Enter the first date and time [Execution date] as e.g., 2020-05-01 and 18:00:00 i.e., Friday 01.05.2020 at 6:00 p.m.",
        "GERMAN": "Geben Sie das erstmalige [Ausführungsdatum] mit Datum und Uhrzeit ein, z. B. 2020-05-01 und 18:00:00, damit Freitag 01.05.2020 um 18:00 Uhr.",
        "RUSSIAN": "Введите первую дату и время [Дата исполнения], например, 2020-05-01 и 18:00:00, т.е. пятница 01.05.2020 в 18:00.",
        "FRENCH": "Saisissez la première date et heure [Date d'exécution], par exemple 2020-05-01 et 18:00:00, c'est-à-dire le vendredi 01.05.2020 à 18h00.",
        "SPANISH": "Introduzca la primera fecha y hora [Fecha de ejecución] como, por ejemplo, 2020-05-01 y 18:00:00, es decir, viernes 01.05.2020 a las 18:00.",
        "ITALIAN": "Inserisci la prima data e ora [Data di esecuzione] come ad esempio, 2020-05-01 e 18:00:00 cioè, venerdì 01.05.2020 alle 18:00.",
        "CHINESE": "输入第一个日期和时间 [执行日期]，例如 2020-05-01 和 18:00:00，即 2020 年 5 月 1 日星期五下午 6:00。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Введите первую дату и время [Дата исполнения], например, 2020-05-01 и 18:00:00, т.е. пятница 01.05.2020 в 18:00.",
        "FRENCH": "Saisissez la première date et heure [Date d'exécution], par exemple 2020-05-01 et 18:00:00, c'est-à-dire le vendredi 01.05.2020 à 18h00.",
        "SPANISH": "Introduzca la primera fecha y hora [Fecha de ejecución] como, por ejemplo, 2020-05-01 y 18:00:00, es decir, viernes 01.05.2020 a las 18:00.",
        "ITALIAN": "Inserisci la prima data e ora [Data di esecuzione] come ad esempio, 2020-05-01 e 18:00:00 cioè, venerdì 01.05.2020 alle 18:00.",
        "CHINESE": "输入第一个日期和时间 [执行日期]，例如 2020-05-01 和 18:00:00，即 2020 年 5 月 1 日星期五下午 6:00。"
      },
