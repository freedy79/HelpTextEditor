      "TRANSLATIONS": {
        "ENGLISH": "Navigate to [Connections] -> [Connectors] -> [Network printer].",
        "GERMAN": "Zu [Verbindungen] -> [Konnektoren] -> [Netzwerk-Drucker] navigieren.",
        "RUSSIAN": "Перейдите в [Подключения] -> [Коннекторы] -> [Сетевой принтер].",
        "FRENCH": "Naviguez jusqu'à [Connexions] -> [Connecteurs] -> [Imprimante réseau].",
        "SPANISH": "Vaya a [Conexiones] -> [Conectores] -> [Impresora de red].",
        "ITALIAN": "Vai a [Connections] -> [Connectors] -> [Network printer].",
        "CHINESE": "导航至 [连接] -> [连接器] -> [网络打印机]。",
        "JAPANESE": "接続]->[コネクタ]->[ネットワークプリンタ]に移動します。",
        "KOREAN": "연결] -> [커넥터] -> [네트워크 프린터]로 이동합니다."
      },
      "AUTOTRANSLATIONS": {
