    "DEVICE_MAINTENANCE_DIAGNOSTIC_FILE_INSTRUCTION_4": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The [extended diagnosis] contains all data of the normal diagnosis. In addition, it may contain data that allows Sartorius to reconstruct the specific cause of a fault, but without using customer data.",
        "GERMAN": "Die [erweiterte Diagnose] enthält alle Daten der normalen Diagnose. Darüber hinaus können Daten enthalten sein, die es Sartorius erlauben, den konkreten Hergang eines Fehlers zu rekonstruieren, ohne jedoch Kundendaten zu verwenden.",
        "RUSSIAN": "В [расширенной диагностике] содержатся все данные обычной диагностики. Кроме того, она может содержать данные, позволяющие Sartorius восстановить конкретную причину неисправности, но без использования данных клиента.",
        "FRENCH": "Le [diagnostic étendu] contient toutes les données du diagnostic normal. En outre, il peut contenir des données qui permettent à Sartorius de reconstituer la cause spécifique d'un défaut, mais sans utiliser les données du client.",
        "SPANISH": "El [diagnóstico ampliado] contiene todos los datos del diagnóstico normal. Además, puede contener datos que permiten a Sartorius reconstruir la causa específica de una avería, pero sin utilizar los datos del cliente.",
        "ITALIAN": "La [diagnosi estesa] contiene tutti i dati della diagnosi normale. Inoltre, può contenere dati che permettono alla Sartorius di ricostruire la causa specifica di un guasto, ma senza utilizzare i dati del cliente.",
        "CHINESE": "扩展诊断]包含正常诊断的所有数据。此外，它还可能包含允许赛多利斯重建故障具体原因的数据，但不使用客户数据。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "В [расширенной диагностике] содержатся все данные обычной диагностики. Кроме того, она может содержать данные, позволяющие Sartorius восстановить конкретную причину неисправности, но без использования данных клиента.",
        "FRENCH": "Le [diagnostic étendu] contient toutes les données du diagnostic normal. En outre, il peut contenir des données qui permettent à Sartorius de reconstituer la cause spécifique d'un défaut, mais sans utiliser les données du client.",
        "SPANISH": "El [diagnóstico ampliado] contiene todos los datos del diagnóstico normal. Además, puede contener datos que permiten a Sartorius reconstruir la causa específica de una avería, pero sin utilizar los datos del cliente.",
        "ITALIAN": "La [diagnosi estesa] contiene tutti i dati della diagnosi normale. Inoltre, può contenere dati che permettono alla Sartorius di ricostruire la causa specifica di un guasto, ma senza utilizzare i dati del cliente.",
        "CHINESE": "扩展诊断]包含正常诊断的所有数据。此外，它还可能包含允许赛多利斯重建故障具体原因的数据，但不使用客户数据。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "DEVICE_MAINTENANCE_DIAGNOSTIC_FILE_APPL_STEP_1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Navigate to the menu [Device settings] -> [Device maintenance] to the item [Create diagnostic file].",
        "GERMAN": "Navigieren Sie in das Menü [Geräteeinstellungen] -> [Gerätewartung] zu dem Punkt [Diagnosedatei erstellen]",
        "RUSSIAN": "Перейдите в меню [Настройки устройства] -> [Обслуживание устройства] к пункту [Создать файл диагностики].",
        "FRENCH": "Naviguez dans le menu [Paramètres du dispositif] -> [Maintenance du dispositif] jusqu'à l'élément [Créer un fichier de diagnostic].",
        "SPANISH": "Navegue por el menú [Ajustes del dispositivo] -> [Mantenimiento del dispositivo] hasta la opción [Crear archivo de diagnóstico].",
        "ITALIAN": "Passare al menu [Device settings] -> [Device maintenance] alla voce [Create diagnostic file].",
        "CHINESE": "导航至菜单 [Device settings] -> [Device maintenance] 至 [Create diagnostic file] 项。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Перейдите в меню [Настройки устройства] -> [Обслуживание устройства] к пункту [Создать файл диагностики].",
        "FRENCH": "Naviguez dans le menu [Paramètres du dispositif] -> [Maintenance du dispositif] jusqu'à l'élément [Créer un fichier de diagnostic].",
        "SPANISH": "Navegue por el menú [Ajustes del dispositivo] -> [Mantenimiento del dispositivo] hasta la opción [Crear archivo de diagnóstico].",
        "ITALIAN": "Passare al menu [Device settings] -> [Device maintenance] alla voce [Create diagnostic file].",
        "CHINESE": "导航至菜单 [Device settings] -> [Device maintenance] 至 [Create diagnostic file] 项。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "DEVICE_MAINTENANCE_DIAGNOSTIC_FILE_APPL_STEP_2": {
