    "VIEW_AUDIT_TRAIL_VIA_BROWSER_CONF_STEP_1": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ]. Do not translate QAPP and QAPP Center.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Activate the [Audit trail] QAPP extension, if not yet done.",
        "GERMAN": "Aktivieren Sie die QAPP-Erweiterung [Audit trail], falls noch nicht erfolgt.",
        "RUSSIAN": "Активируйте расширение [Audit trail] QAPP, если это еще не сделано.",
        "FRENCH": "Activez l'extension du QAPP [Audit trail], si ce n'est pas encore fait.",
        "SPANISH": "Active la extensión [Audit trail] QAPP, si aún no lo ha hecho.",
        "ITALIAN": "Attivare l'estensione QAPP [Audit trail], se non ancora fatto.",
        "CHINESE": "如果尚未激活[审计跟踪]QAPP 扩展，请激活。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Активируйте расширение [Audit trail] QAPP, если это еще не сделано.",
        "FRENCH": "Activez l'extension du QAPP [Audit trail], si ce n'est pas encore fait.",
        "SPANISH": "Active la extensión [Audit trail] QAPP, si aún no lo ha hecho.",
        "ITALIAN": "Attivare l'estensione QAPP [Audit trail], se non ancora fatto.",
        "CHINESE": "如果尚未激活[审计跟踪]QAPP 扩展，请激活。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
