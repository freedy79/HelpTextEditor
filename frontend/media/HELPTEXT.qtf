    "NETWORK_WLAN_INSTRUCTION_3_STEP_4": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Online - Connection established with the Wi-Fi network and the Internet.",
        "GERMAN": "Online - Verbindung mit dem Wi-Fi Netzwerk und zum Internet vorhanden.",
        "RUSSIAN": "Онлайн - Установлено соединение с сетью Wi-Fi и Интернетом.",
        "FRENCH": "En ligne - Connexion établie avec le réseau Wi-Fi et l'Internet.",
        "SPANISH": "En línea - Conexión establecida con la red Wi-Fi e Internet.",
        "ITALIAN": "Online - Connessione stabilita con la rete Wi-Fi e Internet.",
        "CHINESE": "在线 - 与 Wi-Fi 网络和互联网建立连接。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Онлайн - Установлено соединение с сетью Wi-Fi и Интернетом.",
        "FRENCH": "En ligne - Connexion établie avec le réseau Wi-Fi et l'Internet.",
        "SPANISH": "En línea - Conexión establecida con la red Wi-Fi e Internet.",
        "ITALIAN": "Online - Connessione stabilita con la rete Wi-Fi e Internet.",
        "CHINESE": "在线 - 与 Wi-Fi 网络和互联网建立连接。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
