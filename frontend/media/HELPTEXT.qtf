      "TRANSLATIONS": {
        "ENGLISH": "YDP30-NET Connector",
        "GERMAN": "Konnektor YDP30-NET",
        "FRENCH": "Connecteur YDP30-NET",
        "RUSSIAN": "Коннектор YDP30-NET",
        "SPANISH": "Conector YDP30-NET",
        "ITALIAN": "Connettore YDP30-NET",
        "CHINESE": "连接器 YDP30-NET",
        "JAPANESE": "YDP30-NETコネクタ",
        "KOREAN": "YDP30-NET 커넥터"
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Connecteur YDP30-NET",
        "RUSSIAN": "Коннектор YDP30-NET",
        "SPANISH": "Conector YDP30-NET",
        "ITALIAN": "Connettore YDP30-NET",
        "CHINESE": "连接器 YDP30-NET",
        "JAPANESE": "YDP30-NETコネクタ",
        "KOREAN": "YDP30-NET 커넥터"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
        "RUSSIAN": false,
        "SPANISH": false,
        "ITALIAN": false,
