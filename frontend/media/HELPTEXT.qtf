      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The function can also be started manually by using the flashing [isoCAL] button.",
        "GERMAN": "Über die blinkende Schaltfläche [isoCAL] kann die Funktion auch manuell gestartet werden.",
        "RUSSIAN": "Функцию также можно запустить вручную с помощью мигающей кнопки [isoCAL].",
        "FRENCH": "La fonction peut également être lancée manuellement en utilisant le bouton [isoCAL] clignotant.",
        "SPANISH": "La función también puede iniciarse manualmente utilizando el botón intermitente [isoCAL].",
        "ITALIAN": "La funzione può anche essere avviata manualmente usando il pulsante [isoCAL] lampeggiante.",
        "CHINESE": "也可以使用闪烁的 [isoCAL] 按钮手动启动该功能。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Функцию также можно запустить вручную с помощью мигающей кнопки [isoCAL].",
        "FRENCH": "La fonction peut également être lancée manuellement en utilisant le bouton [isoCAL] clignotant.",
        "SPANISH": "La función también puede iniciarse manualmente utilizando el botón intermitente [isoCAL].",
        "ITALIAN": "La funzione può anche essere avviata manualmente usando il pulsante [isoCAL] lampeggiante.",
        "CHINESE": "也可以使用闪烁的 [isoCAL] 按钮手动启动该功能。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "ISOCAL_EXEC_MODE_INSTRUCTION_6": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "Do not translate isoCAL.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The time intervals and temperature changes to the last adjustment, which lead to resolution of isoCAL, depend upon the model.",
        "GERMAN": "Die Zeitintervalle und Temperaturänderungen zur letzten Justierung, die zur Auslösung von isoCAL führen, sind abhängig vom Modell.",
        "RUSSIAN": "Интервалы времени и изменения температуры последней корректировки, которые приводят к исполнению isoCAL, зависят от модели.",
        "FRENCH": "Les intervalles de temps et les changements de température jusqu'au dernier ajustement, qui conduisent à la résolution d'isoCAL, dépendent du modèle.",
        "SPANISH": "Los intervalos de tiempo y los cambios de temperatura hasta el último ajuste, que conducen a la resolución de isoCAL, dependen del modelo.",
        "ITALIAN": "Gli intervalli di tempo e i cambiamenti di temperatura all'ultima regolazione, che portano alla risoluzione di isoCAL, dipendono dal modello.",
        "CHINESE": "最后一次调整的时间间隔和温度变化导致了 isoCAL 的分辨率，这取决于模型。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Интервалы времени и изменения температуры последней корректировки, которые приводят к исполнению isoCAL, зависят от модели.",
        "FRENCH": "Les intervalles de temps et les changements de température jusqu'au dernier ajustement, qui conduisent à la résolution d'isoCAL, dépendent du modèle.",
        "SPANISH": "Los intervalos de tiempo y los cambios de temperatura hasta el último ajuste, que conducen a la resolución de isoCAL, dependen del modelo.",
        "ITALIAN": "Gli intervalli di tempo e i cambiamenti di temperatura all'ultima regolazione, che portano alla risoluzione di isoCAL, dipendono dal modello.",
        "CHINESE": "最后一次调整的时间间隔和温度变化导致了 isoCAL 的分辨率，这取决于模型。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
