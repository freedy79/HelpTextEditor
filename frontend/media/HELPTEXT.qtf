    "DEVICE_MAINTENANCE_EXPORT_INSTRUCTION_1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "Do not translate HTML link commands, e.g. <a href=\"#....\"> and </a>.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The export consists of the following basic steps:",
        "GERMAN": "Der Export besteht aus folgenden grundsätzlichen Schritten:",
        "RUSSIAN": "Экспорт состоит из следующих основных этапов:",
        "FRENCH": "L'exportation comprend les étapes de base suivantes :",
        "SPANISH": "La exportación consta de los siguientes pasos básicos:",
        "ITALIAN": "L'esportazione consiste nei seguenti passi fondamentali:",
        "CHINESE": "导出包括以下基本步骤："
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Экспорт состоит из следующих основных этапов:",
        "FRENCH": "L'exportation comprend les étapes de base suivantes :",
