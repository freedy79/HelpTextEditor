    },
    "TASK_CONCEPT_PARAMETER_ENUM_1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "TRANSLATIONS": {
        "GERMAN": "<b>Name</b><br>Eindeutiger Bezeichner der Task, unter dem sie im System angezeigt und aufgerufen wird.",
        "ENGLISH": "",
        "FRENCH": "",
        "CHINESE": "",
        "RUSSIAN": "",
        "SPANISH": "",
        "ITALIAN": "",
        "JAPANESE": "",
        "KOREAN": ""
      },
      "AUTOTRANSLATIONS": {},
      "VERIFIED": {}
    },
    "TASK_CONCEPT_PARAMETER_ENUM_2": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "TRANSLATIONS": {
        "GERMAN": "<b>Beschreibung</b><br>Kurze textliche Erläuterung des Zwecks oder der spezifischen Konfiguration der Task. Dies erleichtert die Zuordnung, insbesondere wenn mehrere Tasks derselben Anwendung existieren.",
        "ENGLISH": "",
        "FRENCH": "",
        "CHINESE": "",
        "RUSSIAN": "",
        "SPANISH": "",
        "ITALIAN": "",
        "JAPANESE": "",
        "KOREAN": ""
      },
      "AUTOTRANSLATIONS": {},
      "VERIFIED": {}
    },
    "TASK_CONCEPT_PARAMETER_ENUM_3": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "TRANSLATIONS": {
        "GERMAN": "<b>Zugeordnetes Wägeprofil</b><br>Das Wägeprofil legt die grundlegenden Einstellungen und Eigenschaften der Waage für diesen Workflow fest (z. B. Stabilitätskriterien, Filtereinstellungen oder Startbedingungen). Die Task verwendet stets das ihr zugeordnete Profil.",
        "ENGLISH": "",
        "FRENCH": "",
        "CHINESE": "",
        "RUSSIAN": "",
        "SPANISH": "",
        "ITALIAN": "",
        "JAPANESE": "",
        "KOREAN": ""
      },
      "AUTOTRANSLATIONS": {},
      "VERIFIED": {}
    },
    "TASK_CONCEPT_PARAMETER_ENUM_4": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "TRANSLATIONS": {
        "GERMAN": "<b>Zugeordnete Druckprofile</b><br>In der Regel können einer Task bis zu zwei Druckprofile zugeordnet werden, um unterschiedliche Ausgabebedarfe abzudecken – beispielsweise ein GLP-konformer Report als PDF sowie eine schnelle Etikettenausgabe auf einen Drucker.",
        "ENGLISH": "",
        "FRENCH": "",
        "CHINESE": "",
        "RUSSIAN": "",
        "SPANISH": "",
        "ITALIAN": "",
        "JAPANESE": "",
        "KOREAN": ""
      },
      "AUTOTRANSLATIONS": {},
      "VERIFIED": {}
    },
    "TASK_CONCEPT_PARAMETER_ENUM_5": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "TRANSLATIONS": {
        "GERMAN": "<b>Rollen</b><br>Festlegung, welche Benutzerrollen eine Task anzeigen und ausführen dürfen. Eine Task ist nur für Benutzer sichtbar und startbar, die einer der zugeordneten Rollen angehören.",
        "ENGLISH": "",
        "FRENCH": "",
        "CHINESE": "",
        "RUSSIAN": "",
        "SPANISH": "",
        "ITALIAN": "",
        "JAPANESE": "",
        "KOREAN": ""
      },
      "AUTOTRANSLATIONS": {},
      "VERIFIED": {}
    },
