      "TRANSLATIONS": {
        "ENGLISH": "Figure 6: Network connectors",
        "GERMAN": "Abbildung 6: Netzwerk Konnektoren",
        "RUSSIAN": "Рисунок 6: Сетевые коннекторы",
        "FRENCH": "Figure 6 : connecteurs réseau",
