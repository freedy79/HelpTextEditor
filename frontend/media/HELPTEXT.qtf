    "PRINT_GLP_YDP30_ERROR_STEP_5": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "If this results in a [Transfer failure] message, you can retry the print job now, retry it later, redirect it, or delete it.",
        "GERMAN": "Falls es zu Fehlermeldung [Übertragungsfehler] kommt, dann können sie den Druckauftrag, wiederholen, später wiederholen, umleiten oder löschen.",
        "FRENCH": "Si le message [Échec du transfert] apparaît, vous pouvez relancer la tâche d'impression maintenant, la relancer plus tard, la rediriger ou la supprimer.",
        "RUSSIAN": "Если в результате появится сообщение [Transfer failure], вы можете повторить задание печати сейчас, повторить его позже, перенаправить его или удалить.",
        "SPANISH": "Si esto resulta en un mensaje de [Fallo de transferencia], puede reintentar el trabajo de impresión ahora, reintentarlo más tarde, redirigirlo o eliminarlo.",
        "ITALIAN": "Se questo risulta in un messaggio [Transfer failure], potete riprovare il lavoro di stampa ora, riprovare più tardi, reindirizzarlo o cancellarlo.",
        "CHINESE": "如果出现 [ 传输失败 ] 消息，您可以现在重试打印任务、稍后重试、重定向或删除。",
        "JAPANESE": "この結果[転送失敗]メッセージが表示された場合、印刷ジョブを今すぐ再試行するか、後で再試行するか、リダイレクトするか、削除することができます。",
        "KOREAN": "전송 실패] 메시지가 표시되면 지금 인쇄 작업을 다시 시도하거나, 나중에 다시 시도하거나, 리디렉션하거나, 삭제할 수 있습니다."
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Si le message [Échec du transfert] apparaît, vous pouvez relancer la tâche d'impression maintenant, la relancer plus tard, la rediriger ou la supprimer.",
        "RUSSIAN": "Если в результате появится сообщение [Transfer failure], вы можете повторить задание печати сейчас, повторить его позже, перенаправить его или удалить.",
        "SPANISH": "Si esto resulta en un mensaje de [Fallo de transferencia], puede reintentar el trabajo de impresión ahora, reintentarlo más tarde, redirigirlo o eliminarlo.",
        "ITALIAN": "Se questo risulta in un messaggio [Transfer failure], potete riprovare il lavoro di stampa ora, riprovare più tardi, reindirizzarlo o cancellarlo.",
        "CHINESE": "如果出现 [ 传输失败 ] 消息，您可以现在重试打印任务、稍后重试、重定向或删除。",
        "JAPANESE": "この結果[転送失敗]メッセージが表示された場合、印刷ジョブを今すぐ再試行するか、後で再試行するか、リダイレクトするか、削除することができます。",
        "KOREAN": "전송 실패] 메시지가 표시되면 지금 인쇄 작업을 다시 시도하거나, 나중에 다시 시도하거나, 리디렉션하거나, 삭제할 수 있습니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
        "RUSSIAN": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_GLP_YDP30_ERROR_STEP_5_A": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Retry: The print job will be resent to the YDP30 printer.",
        "GERMAN": "Wiederholen: Die Ausgabe vom Druckauftrag zum Drucker YDP30 erfolgt erneut.",
        "FRENCH": "Retenter : Le travail d'impression sera renvoyé à l'imprimante YDP30.",
        "RUSSIAN": "Повторная попытка: Задание печати будет повторно отправлено на принтер YDP30.",
        "SPANISH": "Reintentar: El trabajo de impresión se volverá a enviar a la impresora YDP30.",
        "ITALIAN": "Riprova: Il lavoro di stampa sarà inviato nuovamente alla stampante YDP30.",
        "CHINESE": "重试：打印任务将重新发送到 YDP30 打印机。",
        "JAPANESE": "再試行：印刷ジョブはYDP30プリンタに再送されます。",
        "KOREAN": "다시 시도합니다: 인쇄 작업이 YDP30 프린터로 다시 전송됩니다."
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Retenter : Le travail d'impression sera renvoyé à l'imprimante YDP30.",
        "RUSSIAN": "Повторная попытка: Задание печати будет повторно отправлено на принтер YDP30.",
        "SPANISH": "Reintentar: El trabajo de impresión se volverá a enviar a la impresora YDP30.",
        "ITALIAN": "Riprova: Il lavoro di stampa sarà inviato nuovamente alla stampante YDP30.",
        "CHINESE": "重试：打印任务将重新发送到 YDP30 打印机。",
        "JAPANESE": "再試行：印刷ジョブはYDP30プリンタに再送されます。",
        "KOREAN": "다시 시도합니다: 인쇄 작업이 YDP30 프린터로 다시 전송됩니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
        "RUSSIAN": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_GLP_YDP30_ERROR_STEP_5_B": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Retry later: The output of the print job will be automatically repeated. Outstanding transfers are displayed in the [Status center] under [Messages].",
        "GERMAN": "Später wiederholen: Die Ausgabe vom Druckauftrag wird automatisch wiederholt. Im [Status-Center] unter [Nachrichten] werden die ausstehenden Übertragungen angezeigt.",
        "FRENCH": "Réessayer plus tard : La sortie de la tâche d'impression sera automatiquement répétée. Les transferts en attente sont affichés dans le [Centre d'état] sous [Messages].",
        "RUSSIAN": "Повторить позже: Вывод задания печати будет автоматически повторен. Невыполненные передачи отображаются в [Центре состояния] в разделе [Сообщения].",
        "SPANISH": "Reintentar más tarde: La salida del trabajo de impresión se repetirá automáticamente. Las transferencias pendientes se muestran en el [Centro de estado] en [Mensajes].",
        "ITALIAN": "Riprova più tardi: L'uscita del lavoro di stampa viene automaticamente ripetuta. I trasferimenti in sospeso vengono visualizzati nel [Centro di stato] sotto [Messaggi].",
        "CHINESE": "稍后重试：打印任务将自动重复输出。未完成的传输会显示在 [信息] 下的 [状态中心]。",
        "JAPANESE": "後で再試行する：印刷ジョブの出力が自動的に繰り返されます。未処理の転送は、[ステータスセンター]の[メッセージ]に表示されます。",
        "KOREAN": "나중에 다시 시도합니다: 인쇄 작업의 출력이 자동으로 반복됩니다. 미처리 전송은 [메시지] 아래의 [상태 센터]에 표시됩니다."
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Réessayer plus tard : La sortie de la tâche d'impression sera automatiquement répétée. Les transferts en attente sont affichés dans le [Centre d'état] sous [Messages].",
        "RUSSIAN": "Повторить позже: Вывод задания печати будет автоматически повторен. Невыполненные передачи отображаются в [Центре состояния] в разделе [Сообщения].",
        "SPANISH": "Reintentar más tarde: La salida del trabajo de impresión se repetirá automáticamente. Las transferencias pendientes se muestran en el [Centro de estado] en [Mensajes].",
        "ITALIAN": "Riprova più tardi: L'uscita del lavoro di stampa viene automaticamente ripetuta. I trasferimenti in sospeso vengono visualizzati nel [Centro di stato] sotto [Messaggi].",
        "CHINESE": "稍后重试：打印任务将自动重复输出。未完成的传输会显示在 [信息] 下的 [状态中心]。",
        "JAPANESE": "後で再試行する：印刷ジョブの出力が自動的に繰り返されます。未処理の転送は、[ステータスセンター]の[メッセージ]に表示されます。",
        "KOREAN": "나중에 다시 시도합니다: 인쇄 작업의 출력이 자동으로 반복됩니다. 미처리 전송은 [메시지] 아래의 [상태 센터]에 표시됩니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
        "RUSSIAN": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
