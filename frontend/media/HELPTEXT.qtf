      "TRANSLATIONS": {
        "ENGLISH": "Cubis Job Management",
        "GERMAN": "Auftragsverwaltung der Cubis",
        "FRENCH": "Gestion des commandes de Cubis",
        "RUSSIAN": "Cubis Управление заказами",
        "SPANISH": "Gestión de pedidos Cubis",
        "ITALIAN": "Gestione ordini Cubis",
        "CHINESE": "Cubis 订单管理"
      },
      "AUTOTRANSLATIONS": {
        "CHINESE": "Cubis 订单管理"
      },
      "VERIFIED": {
        "ENGLISH": true,
        "GERMAN": false,
        "FRENCH": false,
