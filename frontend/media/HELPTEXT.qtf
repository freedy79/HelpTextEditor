    "TCA_EXPORT_AUDIT_TRAIL_INSTRUCTION_2_STEP_1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "Do not translate HTML command <b> and </b>",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "<b>Export to connector:</b> Defines the connector to which the export is to be done e.g., to a USB stick.",
        "GERMAN": "<b>Export auf Konnektor:</b> Legt den Konnektor fest, auf den der Export erfolgen soll, z. B. auf einen USB-Stick.",
        "RUSSIAN": "<b>Экспорт в коннектор:</b> Определяет коннектор, в который будет производиться экспорт, например, на USB-накопитель.",
        "FRENCH": "<b>Exportation vers le connecteur:</b> Définit le connecteur vers lequel l'exportation doit être faite, par exemple vers une clé USB.",
        "SPANISH": "<b>Exportar a conector:</b> Define el conector al que se va a exportar, por ejemplo, a una memoria USB.",
        "ITALIAN": "<b>Export to connector:</b> Definisce il connettore verso il quale deve essere fatta l'esportazione, per esempio verso una chiavetta USB.",
        "CHINESE": "<b>导出到连接器：</b> 定义要导出到的连接器，例如导出到 U 盘。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "<b>Экспорт в коннектор:</b> Определяет коннектор, в который будет производиться экспорт, например, на USB-накопитель.",
        "FRENCH": "<b>Exportation vers le connecteur:</b> Définit le connecteur vers lequel l'exportation doit être faite, par exemple vers une clé USB.",
        "SPANISH": "<b>Exportar a conector:</b> Define el conector al que se va a exportar, por ejemplo, a una memoria USB.",
        "ITALIAN": "<b>Export to connector:</b> Definisce il connettore verso il quale deve essere fatta l'esportazione, per esempio verso una chiavetta USB.",
        "CHINESE": "<b>导出到连接器：</b> 定义要导出到的连接器，例如导出到 U 盘。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "TCA_EXPORT_AUDIT_TRAIL_INSTRUCTION_2_STEP_2": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "Do not translate HTML command <b> and </b>",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "<b>Modules for export:</b> Selection of the modules with their entries which are to be exported e.g., menu settings, task management, user management, etc.",
        "GERMAN": "<b>Module für Export:</b> Auswahl der Module mit ihren Einträgen, die exportiert werden sollen, z. B. Menü Einstellungen, Task-Verwaltung, Benutzer-Verwaltung, usw.",
        "RUSSIAN": "<b>Модули для экспорта:</b> Выбор модулей с их записями, которые должны быть экспортированы, например, настройки меню, управление задачами, управление пользователями и т.д.",
        "FRENCH": "<b>Modules à exporter:</b> Sélection des modules avec leurs entrées qui doivent être exportés par exemple, les paramètres du menu, la gestion des tâches, la gestion des utilisateurs, etc.",
        "SPANISH": "<b>Módulos para exportar:</b> Selección de los módulos con sus entradas que se van a exportar, por ejemplo, configuración de menús, gestión de tareas, gestión de usuarios, etc.",
        "ITALIAN": "<b>Moduli per l'esportazione:</b> Selezione dei moduli con le loro voci che devono essere esportati, ad esempio, impostazioni di menu, gestione dei compiti, gestione degli utenti, ecc.",
        "CHINESE": "<b>导出模块：</b>选择要导出的模块及其条目，如菜单设置、任务管理、用户管理等。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "<b>Модули для экспорта:</b> Выбор модулей с их записями, которые должны быть экспортированы, например, настройки меню, управление задачами, управление пользователями и т.д.",
        "FRENCH": "<b>Modules à exporter:</b> Sélection des modules avec leurs entrées qui doivent être exportés par exemple, les paramètres du menu, la gestion des tâches, la gestion des utilisateurs, etc.",
        "SPANISH": "<b>Módulos para exportar:</b> Selección de los módulos con sus entradas que se van a exportar, por ejemplo, configuración de menús, gestión de tareas, gestión de usuarios, etc.",
        "ITALIAN": "<b>Moduli per l'esportazione:</b> Selezione dei moduli con le loro voci che devono essere esportati, ad esempio, impostazioni di menu, gestione dei compiti, gestione degli utenti, ecc.",
        "CHINESE": "<b>导出模块：</b>选择要导出的模块及其条目，如菜单设置、任务管理、用户管理等。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "TCA_EXPORT_AUDIT_TRAIL_INSTRUCTION_3": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ]. Do not translate QAPP and QAPP Center.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "With QAPP extensions, which can be activated in the QAPP Center under [Connectivity (QP4)], the export can also be done via connectors to certain file-based network servers.",
        "GERMAN": "Durch QAPP-Erweiterungen, die im QAPP Center unter [Connectivity (QP4)] aktivierbar sind, kann der Export über Konnektoren auch auf bestimmte dateibasierte Netzwerk Server erfolgen.",
        "RUSSIAN": "С помощью расширений QAPP, которые можно активировать в QAPP Center в разделе [Connectivity (QP4)], экспорт также может осуществляться через коннекторы на определенные файловые сетевые серверы.",
        "FRENCH": "Avec les extensions QAPP, qui peuvent être activées dans le QAPP Center sous [Connectivité (QP4)], l'exportation peut également se faire via des connecteurs vers certains serveurs de réseau basés sur des fichiers.",
        "SPANISH": "Con las extensiones de QAPP, que pueden activarse en el QAPP Center en [Conectividad (QP4)], la exportación también puede realizarse a través de conectores a determinados servidores de red basados en archivos.",
        "ITALIAN": "Con le estensioni QAPP, che possono essere attivate nel Centro QAPP sotto [Connettività (QP4)], l'esportazione può essere fatta anche tramite connettori a certi server di rete basati su file.",
        "CHINESE": "通过 QAPP 扩展（可在 QAPP 中心[连接性 (QP4)]下激活），也可通过连接到某些基于文件的网络服务器的连接器进行导出。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "С помощью расширений QAPP, которые можно активировать в QAPP Center в разделе [Connectivity (QP4)], экспорт также может осуществляться через коннекторы на определенные файловые сетевые серверы.",
        "FRENCH": "Avec les extensions QAPP, qui peuvent être activées dans le QAPP Center sous [Connectivité (QP4)], l'exportation peut également se faire via des connecteurs vers certains serveurs de réseau basés sur des fichiers.",
        "SPANISH": "Con las extensiones de QAPP, que pueden activarse en el QAPP Center en [Conectividad (QP4)], la exportación también puede realizarse a través de conectores a determinados servidores de red basados en archivos.",
        "ITALIAN": "Con le estensioni QAPP, che possono essere attivate nel Centro QAPP sotto [Connettività (QP4)], l'esportazione può essere fatta anche tramite connettori a certi server di rete basati su file.",
        "CHINESE": "通过 QAPP 扩展（可在 QAPP 中心[连接性 (QP4)]下激活），也可通过连接到某些基于文件的网络服务器的连接器进行导出。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "TCA_EXPORT_AUDIT_TRAIL_INSTRUCTION_4": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The description of the [Connectors] function extension can be found in the printing concept. The [Audit trail] function extension of the balance is described in a separate section.",
        "GERMAN": "Die Beschreibung zur Funktionserweiterung [Konnektoren] befindet sich im Druck-Konzept. Die Funktionserweiterung [Audit Trail] der Waage wird in einem separaten Teil beschrieben.",
        "RUSSIAN": "Описание расширения функции [Connectors] можно найти в концепции печати. Расширение функции [Audit trail] весов описано в отдельном разделе.",
        "FRENCH": "La description de l'extension de la fonction [Connecteurs] se trouve dans le concept d'impression. L'extension de la fonction [Audit trail] de la balance est décrite dans une section séparée.",
        "SPANISH": "La descripción de la ampliación de la función [Conectores] se encuentra en el concepto de impresión. La extensión de la función [Audit trail] de la balanza se describe en una sección aparte.",
        "ITALIAN": "La descrizione dell'estensione di funzione [Connettori] si trova nel concetto di stampa. L'estensione della funzione [Audit trail] della bilancia è descritta in una sezione separata.",
        "CHINESE": "连接器]功能扩展的说明可在打印概念中找到。余额的 [审计跟踪] 功能扩展将在另一节中介绍。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Описание расширения функции [Connectors] можно найти в концепции печати. Расширение функции [Audit trail] весов описано в отдельном разделе.",
        "FRENCH": "La description de l'extension de la fonction [Connecteurs] se trouve dans le concept d'impression. L'extension de la fonction [Audit trail] de la balance est décrite dans une section séparée.",
        "SPANISH": "La descripción de la ampliación de la función [Conectores] se encuentra en el concepto de impresión. La extensión de la función [Audit trail] de la balanza se describe en una sección aparte.",
        "ITALIAN": "La descrizione dell'estensione di funzione [Connettori] si trova nel concetto di stampa. L'estensione della funzione [Audit trail] della bilancia è descritta in una sezione separata.",
        "CHINESE": "连接器]功能扩展的说明可在打印概念中找到。余额的 [审计跟踪] 功能扩展将在另一节中介绍。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "TCA_EXPORT_AUDIT_TRAIL_INSTRUCTION_5": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ]. Do not translate QAPP and QAPP Center.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The complete scope of the audit trail can be used only after activating the [Audit trail] QAPP extension in the QAPP Center under [Pharma (QP1)].",
        "GERMAN": "Erst nach der Aktivierung der QAPP-Erweiterungen [Audit Trail] im QAPP Center unter [Pharma (QP1)] ist der volle Umfang vom Audit Trail nutzbar.",
        "RUSSIAN": "Полный объем аудиторского следа можно использовать только после активации расширения QAPP [Audit trail] в QAPP в разделе [Pharma (QP1)].",
        "FRENCH": "Le champ complet de la piste d'audit ne peut être utilisé qu'après avoir activé l'extension QAPP [piste d'audit] dans le QAPP Center sous [Pharma (QP1)].",
        "SPANISH": "El alcance completo de la pista de auditoría sólo se puede utilizar después de activar la extensión QAPP [Pista de auditoría] en el Centro QAPP bajo [Pharma (QP1)].",
        "ITALIAN": "L'ambito completo della pista di controllo può essere utilizzato solo dopo aver attivato l'estensione QAPP [pista di controllo] nel Centro QAPP sotto [Pharma (QP1)].",
        "CHINESE": "只有在 QAPP 中心[制药（QP1）]下激活[审计跟踪]QAPP 扩展后，才能使用审计跟踪的完整范围。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Полный объем аудиторского следа можно использовать только после активации расширения QAPP [Audit trail] в QAPP в разделе [Pharma (QP1)].",
        "FRENCH": "Le champ complet de la piste d'audit ne peut être utilisé qu'après avoir activé l'extension QAPP [piste d'audit] dans le QAPP Center sous [Pharma (QP1)].",
        "SPANISH": "El alcance completo de la pista de auditoría sólo se puede utilizar después de activar la extensión QAPP [Pista de auditoría] en el Centro QAPP bajo [Pharma (QP1)].",
        "ITALIAN": "L'ambito completo della pista di controllo può essere utilizzato solo dopo aver attivato l'estensione QAPP [pista di controllo] nel Centro QAPP sotto [Pharma (QP1)].",
        "CHINESE": "只有在 QAPP 中心[制药（QP1）]下激活[审计跟踪]QAPP 扩展后，才能使用审计跟踪的完整范围。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "TCA_EXPORT_AUDIT_TRAIL_INSTRUCTION_6": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "Do not translate HTML link commands, e.g. <a href=\"#TCA_EXAMPLE_EXPORT_AUDIT_TRAIL\"> and </a>.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "You will find an example for setup and use in chapter <a href=\"#TCA_EXAMPLE_EXPORT_AUDIT_TRAIL\">Action: Export audit trail</a>.",
        "GERMAN": "Ein Beispiel für das Einrichten und Anwender finden Sie im Kapitel <a href=\"#TCA_EXAMPLE_EXPORT_AUDIT_TRAIL\">Aktion: Export Audit Trail</a>.",
        "RUSSIAN": "Пример настройки и использования вы найдете в главе <a href=\"#TCA_EXAMPLE_EXPORT_AUDIT_TRAIL\">Действие: Экспортировать журнал аудита</a>.",
        "FRENCH": "Vous trouverez un exemple de configuration et d'utilisation dans le chapitre <a href=\"#TCA_EXAMPLE_EXPORT_AUDIT_TRAIL\">Action : Exporter la piste d'audit</a>.",
        "SPANISH": "Encontrará un ejemplo de configuración y uso en el capítulo <a href=\"#TCA_EXAMPLE_EXPORT_AUDIT_TRAIL\">Acción: Exportar pista de auditoría</a>.",
        "ITALIAN": "Troverete un esempio per la configurazione e l'uso nel capitolo <a href=\"#TCA_EXAMPLE_EXPORT_AUDIT_TRAIL\">Azione: Esportazione pista di controllo</a>.",
        "CHINESE": "您可以在<a href=\"#TCA_EXAMPLE_EXPORT_AUDIT_TRAIL\">操作一章中找到设置和使用示例：导出审计跟踪</a>。"
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Пример настройки и использования вы найдете в главе <a href=\"#TCA_EXAMPLE_EXPORT_AUDIT_TRAIL\">Действие: Экспортировать журнал аудита</a>.",
        "FRENCH": "Vous trouverez un exemple de configuration et d'utilisation dans le chapitre <a href=\"#TCA_EXAMPLE_EXPORT_AUDIT_TRAIL\">Action : Exporter la piste d'audit</a>.",
        "SPANISH": "Encontrará un ejemplo de configuración y uso en el capítulo <a href=\"#TCA_EXAMPLE_EXPORT_AUDIT_TRAIL\">Acción: Exportar pista de auditoría</a>.",
        "ITALIAN": "Troverete un esempio per la configurazione e l'uso nel capitolo <a href=\"#TCA_EXAMPLE_EXPORT_AUDIT_TRAIL\">Azione: Esportazione pista di controllo</a>.",
        "CHINESE": "您可以在<a href=\"#TCA_EXAMPLE_EXPORT_AUDIT_TRAIL\">操作一章中找到设置和使用示例：导出审计跟踪</a>。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
