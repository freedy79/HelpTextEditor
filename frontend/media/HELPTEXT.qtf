      "TRANSLATIONS": {
        "ENGLISH": "Set up a connector to an FTPS server, e.g. [My FTPS server].",
        "GERMAN": "Richten Sie einen Konnektor zu einem FTPS-Server ein, z. B. [Mein FTPS-Server].",
        "FRENCH": "Configurez un connecteur vers un serveur FTPS, par exemple [Mon serveur FTPS].",
        "RUSSIAN": "Установите соединение с сервером FTPS, например, [Мой сервер FTPS].",
        "SPANISH": "Configure un conector a un servidor FTPS, por ejemplo [Mi servidor FTPS].",
        "ITALIAN": "Impostare un connettore a un server FTPS, ad esempio [Il mio server FTPS].",
        "CHINESE": "设置 FTPS 服务器连接器，例如 [我的 FTPS 服务器]。",
        "JAPANESE": "マイFTPSサーバー]など、FTPSサーバーへのコネクターを設定します。",
        "KOREAN": "FTPS 서버에 대한 커넥터를 설정합니다(예: [내 FTPS 서버])."
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "Configurez un connecteur vers un serveur FTPS, par exemple [Mon serveur FTPS].",
        "RUSSIAN": "Установите соединение с сервером FTPS, например, [Мой сервер FTPS].",
        "SPANISH": "Configure un conector a un servidor FTPS, por ejemplo [Mi servidor FTPS].",
        "ITALIAN": "Impostare un connettore a un server FTPS, ad esempio [Il mio server FTPS].",
        "CHINESE": "设置 FTPS 服务器连接器，例如 [我的 FTPS 服务器]。",
        "JAPANESE": "マイFTPSサーバー]など、FTPSサーバーへのコネクターを設定します。",
        "KOREAN": "FTPS 서버에 대한 커넥터를 설정합니다(예: [내 FTPS 서버])."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
        "RUSSIAN": false,
        "SPANISH": false,
        "ITALIAN": false,
