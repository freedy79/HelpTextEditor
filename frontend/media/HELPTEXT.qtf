    "PRINT_GLP_PDF_FTPS_APPL_STEP_1": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the character [ ].",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Start the task, e.g. [My flexible formulation with PDF print on FTPS server] with the assigned print profile: [My PDF print on FTPS server].",
        "GERMAN": "Starten Sie die Task z. B. [Meine variable Rezeptur mit PDF-Druck auf FTPS-Server] mit dem darin zugewiesenen Druckprofil [Mein PDF-Druck auf FTPS-Server].",
        "RUSSIAN": "Запустите задание, например, [Моя гибкая формулировка с печатью PDF на сервере FTPS] с назначенным профилем печати: [Моя PDF-печать на FTPS-сервере].",
        "FRENCH": "Lancez la tâche, par exemple [Ma formulation flexible avec impression PDF sur serveur FTPS] avec le profil d'impression attribué : [Mon impression PDF sur le serveur FTPS].",
        "SPANISH": "Inicie la tarea, por ejemplo, [Mi formulación flexible con impresión de PDF en el servidor FTPS] con el perfil de impresión asignado: [Mi impresión PDF en el servidor FTPS].",
        "ITALIAN": "Avviare l'attività, ad esempio [La mia formulazione flessibile con stampa PDF su server FTPS] con il profilo di stampa assegnato: [La mia stampa PDF su server FTPS].",
        "CHINESE": "启动任务，例如[我的可变配方与 FTPS 服务器上的 PDF 打印]，并在其中指定打印配置文件[我的 FTPS 服务器上的 PDF 打印]。",
        "JAPANESE": "割り当てられた印刷プロファイルで、例えば[FTPSサーバー上のPDF印刷による私の柔軟な定式化]のようなタスクを開始します：[FTPSサーバー上の私のPDF印刷]。",
        "KOREAN": "할당된 인쇄 프로필을 사용하여 [FTPS 서버에서 PDF 인쇄로 내 유연한 제형] 작업을 시작합니다(예: [내 유연한 제형]): [FTPS 서버에서 내 PDF 인쇄]."
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Запустите задание, например, [Моя гибкая формулировка с печатью PDF на сервере FTPS] с назначенным профилем печати: [Моя PDF-печать на FTPS-сервере].",
        "FRENCH": "Lancez la tâche, par exemple [Ma formulation flexible avec impression PDF sur serveur FTPS] avec le profil d'impression attribué : [Mon impression PDF sur le serveur FTPS].",
        "SPANISH": "Inicie la tarea, por ejemplo, [Mi formulación flexible con impresión de PDF en el servidor FTPS] con el perfil de impresión asignado: [Mi impresión PDF en el servidor FTPS].",
        "ITALIAN": "Avviare l'attività, ad esempio [La mia formulazione flessibile con stampa PDF su server FTPS] con il profilo di stampa assegnato: [La mia stampa PDF su server FTPS].",
        "CHINESE": "启动任务，例如[我的可变配方与 FTPS 服务器上的 PDF 打印]，并在其中指定打印配置文件[我的 FTPS 服务器上的 PDF 打印]。",
        "JAPANESE": "割り当てられた印刷プロファイルで、例えば[FTPSサーバー上のPDF印刷による私の柔軟な定式化]のようなタスクを開始します：[FTPSサーバー上の私のPDF印刷]。",
        "KOREAN": "할당된 인쇄 프로필을 사용하여 [FTPS 서버에서 PDF 인쇄로 내 유연한 제형] 작업을 시작합니다(예: [내 유연한 제형]): [FTPS 서버에서 내 PDF 인쇄]."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_GLP_PDF_FTPS_APPL_STEP_2": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "The specified values for the [Flexible formulation] application are displayed in an overview. Where necessary, change the number of components.",
        "GERMAN": "Die vorgegebenen Werte für die Anwendung [Variable Rezeptur] werden in einer Übersicht angezeigt. Ändern Sie ggf. die Anzahl der Komponenten.",
        "RUSSIAN": "Заданные значения для приложения [Гибкая рецептура] отображаются в виде обзора. При необходимости измените количество компонентов.",
        "FRENCH": "Les valeurs spécifiées pour l'application [Formulation flexible] sont affichées dans une vue d'ensemble. Si nécessaire, modifiez le nombre de composants.",
        "SPANISH": "Los valores especificados para la aplicación [Formulación flexible] se muestran en un resumen. En caso necesario, modifique el número de componentes.",
        "ITALIAN": "I valori specificati per l'applicazione [Formulazione flessibile] vengono visualizzati in una panoramica. Se necessario, modificare il numero di componenti.",
        "CHINESE": "变量配方]应用程序的默认值显示在概览中。必要时更改组件数量。",
        "JAPANESE": "Flexible formulation]アプリケーションの指定値が概要に表示されます。必要に応じて成分数を変更してください。",
        "KOREAN": "유연한 공식] 적용에 대해 지정된 값이 개요에 표시됩니다. 필요한 경우 구성 요소 수를 변경합니다."
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Заданные значения для приложения [Гибкая рецептура] отображаются в виде обзора. При необходимости измените количество компонентов.",
        "FRENCH": "Les valeurs spécifiées pour l'application [Formulation flexible] sont affichées dans une vue d'ensemble. Si nécessaire, modifiez le nombre de composants.",
        "SPANISH": "Los valores especificados para la aplicación [Formulación flexible] se muestran en un resumen. En caso necesario, modifique el número de componentes.",
        "ITALIAN": "I valori specificati per l'applicazione [Formulazione flessibile] vengono visualizzati in una panoramica. Se necessario, modificare il numero di componenti.",
        "CHINESE": "变量配方]应用程序的默认值显示在概览中。必要时更改组件数量。",
        "JAPANESE": "Flexible formulation]アプリケーションの指定値が概要に表示されます。必要に応じて成分数を変更してください。",
        "KOREAN": "유연한 공식] 적용에 대해 지정된 값이 개요에 표시됩니다. 필요한 경우 구성 요소 수를 변경합니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_GLP_PDF_FTPS_APPL_STEP_3": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the control character <BR>.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Follow the instructions and symbols to guide you through the takeover of components. <BR>You can give each component an individual designation (ID). Repeat these steps for the specified number of components.",
        "GERMAN": "Folgen Sie den Anweisungstexten und Symbolen, Sie werden so durch die Übernahme der Komponenten geführt. <BR>Sie können jeder Komponente eine individuelle Bezeichnung (ID) geben. Wiederholen Sie diese Schritte für die vorgegebene Anzahl der Komponenten.",
        "RUSSIAN": "Следуйте инструкциям и символам, которые помогут вам в процессе поглощения компонентов. <BR>Вы можете присвоить каждому компоненту индивидуальное обозначение (ID). Повторите эти шаги для указанного количества компонентов.",
        "FRENCH": "Suivez les instructions et les symboles qui vous guideront dans la prise en charge des composants. <BR>Vous pouvez donner à chaque composant une désignation individuelle (ID). Répétez ces étapes pour le nombre spécifié de composants.",
        "SPANISH": "Siga las instrucciones y los símbolos que le guiarán en la adquisición de componentes. <BR> Puede dar a cada componente una designación individual (ID). Repita estos pasos para el número especificado de componentes.",
        "ITALIAN": "Segui le istruzioni e i simboli che ti guidano nell'acquisizione dei componenti. <BR>Puoi dare ad ogni componente una designazione individuale (ID). Ripetete questi passi per il numero di componenti specificato.",
        "CHINESE": "按照说明文字和符号的指引，完成组件的转移。<BR>您可以为每个组件命名（ID）。对指定数量的组件重复上述步骤。",
        "JAPANESE": "コンポーネントの引き継ぎは、指示と記号に従って行ってください。<BR>各コンポーネントに個別の指定（ID）を与えることができます。指定された数のコンポーネントについて、これらの手順を繰り返します。",
        "KOREAN": "지침과 기호를 따라 구성 요소 인계 과정을 안내하세요. <BR>각 컴포넌트에 개별 지정(ID)을 부여할 수 있습니다. 지정된 구성 요소 수에 대해 이 단계를 반복합니다."
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Следуйте инструкциям и символам, которые помогут вам в процессе поглощения компонентов. <BR>Вы можете присвоить каждому компоненту индивидуальное обозначение (ID). Повторите эти шаги для указанного количества компонентов.",
        "FRENCH": "Suivez les instructions et les symboles qui vous guideront dans la prise en charge des composants. <BR>Vous pouvez donner à chaque composant une désignation individuelle (ID). Répétez ces étapes pour le nombre spécifié de composants.",
        "SPANISH": "Siga las instrucciones y los símbolos que le guiarán en la adquisición de componentes. <BR> Puede dar a cada componente una designación individual (ID). Repita estos pasos para el número especificado de componentes.",
        "ITALIAN": "Segui le istruzioni e i simboli che ti guidano nell'acquisizione dei componenti. <BR>Puoi dare ad ogni componente una designazione individuale (ID). Ripetete questi passi per il numero di componenti specificato.",
        "CHINESE": "按照说明文字和符号的指引，完成组件的转移。<BR>您可以为每个组件命名（ID）。对指定数量的组件重复上述步骤。",
        "JAPANESE": "コンポーネントの引き継ぎは、指示と記号に従って行ってください。<BR>各コンポーネントに個別の指定（ID）を与えることができます。指定された数のコンポーネントについて、これらの手順を繰り返します。",
        "KOREAN": "지침과 기호를 따라 구성 요소 인계 과정을 안내하세요. <BR>각 컴포넌트에 개별 지정(ID)을 부여할 수 있습니다. 지정된 구성 요소 수에 대해 이 단계를 반복합니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_GLP_PDF_FTPS_APPL_STEP_4": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "You have the option to change to the print preview of the specified values at any time; this also takes place automatically once the specified number of components have been taken over.",
        "GERMAN": "Sie haben jederzeit die Möglichkeit in die Druckvorschau der übernommenen Werte zu wechseln, dies erfolgt auch automatisch nach Übernahme der vorgegebenen Anzahl von Komponenten.",
        "RUSSIAN": "У вас есть возможность в любой момент перейти к предварительному просмотру печати указанных значений; это также происходит автоматически после передачи указанного количества компонентов.",
        "FRENCH": "Vous avez la possibilité de passer à tout moment à l'aperçu avant impression des valeurs spécifiées ; cela se fait également automatiquement dès que le nombre spécifié de composants a été pris en charge.",
        "SPANISH": "Tiene la opción de cambiar a la vista previa de impresión de los valores especificados en cualquier momento; esto también tiene lugar automáticamente una vez que se ha tomado el número especificado de componentes.",
        "ITALIAN": "Avete la possibilità di passare all'anteprima di stampa dei valori specificati in qualsiasi momento; questo avviene anche automaticamente una volta che il numero specificato di componenti è stato rilevato.",
        "CHINESE": "您可以随时切换到传输值的打印预览；传输指定数量的组件后，打印预览也会自动完成。",
        "JAPANESE": "指定された値の印刷プレビューにいつでも変更できるオプションがあります。これは、指定された数のコンポーネントが引き継がれると自動的に行われます。",
        "KOREAN": "언제든지 지정된 값의 인쇄 미리 보기로 변경할 수 있으며, 지정된 수의 컴포넌트가 인계되면 이 작업도 자동으로 수행됩니다."
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "У вас есть возможность в любой момент перейти к предварительному просмотру печати указанных значений; это также происходит автоматически после передачи указанного количества компонентов.",
        "FRENCH": "Vous avez la possibilité de passer à tout moment à l'aperçu avant impression des valeurs spécifiées ; cela se fait également automatiquement dès que le nombre spécifié de composants a été pris en charge.",
        "SPANISH": "Tiene la opción de cambiar a la vista previa de impresión de los valores especificados en cualquier momento; esto también tiene lugar automáticamente una vez que se ha tomado el número especificado de componentes.",
        "ITALIAN": "Avete la possibilità di passare all'anteprima di stampa dei valori specificati in qualsiasi momento; questo avviene anche automaticamente una volta che il numero specificato di componenti è stato rilevato.",
        "CHINESE": "您可以随时切换到传输值的打印预览；传输指定数量的组件后，打印预览也会自动完成。",
        "JAPANESE": "指定された値の印刷プレビューにいつでも変更できるオプションがあります。これは、指定された数のコンポーネントが引き継がれると自動的に行われます。",
        "KOREAN": "언제든지 지정된 값의 인쇄 미리 보기로 변경할 수 있으며, 지정된 수의 컴포넌트가 인계되면 이 작업도 자동으로 수행됩니다."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_GLP_PDF_FTPS_APPL_STEP_5": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "Do not replace the control character <BR>. Do not translate HTML link commands, e.g. <a href=\"#OUTPUT_EXAMPLES_PDF_TO_FTPS\"> and </a>.",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "You can generate the print output as a PDF file on the FTPS server from the print preview. <BR>See here for an output example: <a href=\"#OUTPUT_EXAMPLES_PDF_TO_FTPS\">PDF Output to file on FTPS</a>.",
        "GERMAN": "Aus der Druckvorschau heraus können Sie die Druckausgabe als PDF-Datei auf den FTPC Server auslösen. <BR>Ein Ausgabebeispiel dazu hier: <a href=\"#OUTPUT_EXAMPLES_PDF_TO_FTPS\">PDF-Ausgabe in Datei auf FTPS</a>.",
        "RUSSIAN": "Вы можете создать вывод на печать в виде PDF-файла на сервере FTPS из предварительного просмотра печати. <BR>Пример вывода смотрите здесь: <a href=\"#OUTPUT_EXAMPLES_PDF_TO_FTPS\">Вывод PDF в файл на FTPS</a>.",
        "FRENCH": "Vous pouvez générer la sortie d'impression sous forme de fichier PDF sur le serveur FTPS à partir de l'aperçu avant impression. <BR>Voir ici pour un exemple de sortie : <a href=\"#OUTPUT_EXAMPLES_PDF_TO_FTPS\">Sortie PDF vers un fichier sur FTPS</a>.",
        "SPANISH": "Puede generar la salida de impresión como un archivo PDF en el servidor FTPS desde la vista previa de impresión. <BR>Vea aquí un ejemplo de salida: <a href=\"#OUTPUT_EXAMPLES_PDF_TO_FTPS\">Salida de PDF a archivo en FTPS</a>.",
        "ITALIAN": "È possibile generare l'output di stampa come file PDF sul server FTPS dall'anteprima di stampa. <BR>Vedi qui per un esempio di output: <a href=\"#OUTPUT_EXAMPLES_PDF_TO_FTPS\">PDF Output to file on FTPS</a>.",
        "CHINESE": "通过打印预览，您可以在 FTPC 服务器上触发 PDF 文件的打印输出。<BR>这里有一个输出示例：<a href=\"#OUTPUT_EXAMPLES_PDF_TO_FTPS\">在 FTPS 上输出 PDF 到文件</a>。",
        "JAPANESE": "印刷プレビューから、FTPSサーバー上にPDFファイルとして印刷出力を生成することができます。<BR>出力例はこちらをご覧ください：<a href=\"#OUTPUT_EXAMPLES_PDF_TO_FTPS\">FTPS上のファイルへのPDF出力</a>を参照してください。",
        "KOREAN": "인쇄 미리 보기에서 FTPS 서버에 PDF 파일로 인쇄 출력을 생성할 수 있습니다. <BR>출력 예는 여기를 참조하세요: <a href=\"#OUTPUT_EXAMPLES_PDF_TO_FTPS\">FTPS에서 파일로 PDF 출력</a>."
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Вы можете создать вывод на печать в виде PDF-файла на сервере FTPS из предварительного просмотра печати. <BR>Пример вывода смотрите здесь: <a href=\"#OUTPUT_EXAMPLES_PDF_TO_FTPS\">Вывод PDF в файл на FTPS</a>.",
        "FRENCH": "Vous pouvez générer la sortie d'impression sous forme de fichier PDF sur le serveur FTPS à partir de l'aperçu avant impression. <BR>Voir ici pour un exemple de sortie : <a href=\"#OUTPUT_EXAMPLES_PDF_TO_FTPS\">Sortie PDF vers un fichier sur FTPS</a>.",
        "SPANISH": "Puede generar la salida de impresión como un archivo PDF en el servidor FTPS desde la vista previa de impresión. <BR>Vea aquí un ejemplo de salida: <a href=\"#OUTPUT_EXAMPLES_PDF_TO_FTPS\">Salida de PDF a archivo en FTPS</a>.",
        "ITALIAN": "È possibile generare l'output di stampa come file PDF sul server FTPS dall'anteprima di stampa. <BR>Vedi qui per un esempio di output: <a href=\"#OUTPUT_EXAMPLES_PDF_TO_FTPS\">PDF Output to file on FTPS</a>.",
        "CHINESE": "通过打印预览，您可以在 FTPC 服务器上触发 PDF 文件的打印输出。<BR>这里有一个输出示例：<a href=\"#OUTPUT_EXAMPLES_PDF_TO_FTPS\">在 FTPS 上输出 PDF 到文件</a>。",
        "JAPANESE": "印刷プレビューから、FTPSサーバー上にPDFファイルとして印刷出力を生成することができます。<BR>出力例はこちらをご覧ください：<a href=\"#OUTPUT_EXAMPLES_PDF_TO_FTPS\">FTPS上のファイルへのPDF出力</a>を参照してください。",
        "KOREAN": "인쇄 미리 보기에서 FTPS 서버에 PDF 파일로 인쇄 출력을 생성할 수 있습니다. <BR>출력 예는 여기를 참조하세요: <a href=\"#OUTPUT_EXAMPLES_PDF_TO_FTPS\">FTPS에서 파일로 PDF 출력</a>."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
    "PRINT_GLP_PDF_FTPS_APPL_NOTE": {
      "group": "HELP_EXAMPLE",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "Note: If the print job cannot be completed, it will not be lost; see Troubleshooting.",
        "GERMAN": "Anmerkung: Falls der Druckauftrag nicht abgesetzt werden kann, geht dieser nicht verloren; siehe Fehlerbehandlung.",
        "RUSSIAN": "Примечание: Если задание печати не может быть выполнено, оно не будет потеряно; см. раздел Устранение неполадок.",
        "FRENCH": "Remarque : si le travail d'impression ne peut être achevé, il ne sera pas perdu ; voir la section Dépannage.",
        "SPANISH": "Nota: Si el trabajo de impresión no puede completarse, no se perderá; consulte la sección de resolución de problemas.",
        "ITALIAN": "Nota: Se il lavoro di stampa non può essere completato, non verrà perso; vedere Risoluzione dei problemi.",
        "CHINESE": "注意：如果打印任务无法发送，也不会丢失；请参阅错误处理。",
        "JAPANESE": "注：印刷ジョブを完了できなかった場合でも、ジョブは失われません。",
        "KOREAN": "참고: 인쇄 작업을 완료할 수 없는 경우에도 인쇄 작업은 손실되지 않습니다(문제 해결을 참조하세요)."
      },
      "AUTOTRANSLATIONS": {
        "RUSSIAN": "Примечание: Если задание печати не может быть выполнено, оно не будет потеряно; см. раздел Устранение неполадок.",
        "FRENCH": "Remarque : si le travail d'impression ne peut être achevé, il ne sera pas perdu ; voir la section Dépannage.",
        "SPANISH": "Nota: Si el trabajo de impresión no puede completarse, no se perderá; consulte la sección de resolución de problemas.",
        "ITALIAN": "Nota: Se il lavoro di stampa non può essere completato, non verrà perso; vedere Risoluzione dei problemi.",
        "CHINESE": "注意：如果打印任务无法发送，也不会丢失；请参阅错误处理。",
        "JAPANESE": "注：印刷ジョブを完了できなかった場合でも、ジョブは失われません。",
        "KOREAN": "참고: 인쇄 작업을 완료할 수 없는 경우에도 인쇄 작업은 손실되지 않습니다(문제 해결을 참조하세요)."
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "RUSSIAN": false,
        "FRENCH": false,
        "SPANISH": false,
        "ITALIAN": false,
        "CHINESE": false
      }
    },
