    "ROLE_RIGHT_ACCESS_DEVICE_MANAGEMENT": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "<b>Access device management:</b> Access to the device settings like time configuration, device ids, device cleaning and display settings. Needs also right to access settings menu.",
        "GERMAN": "<b>Zugriff Geräteeinstellungen:</b> Zugriff auf das Einstellungsmenü, Vorsaussetzung für den Zugriff auf Geräteeinstellungen und Untermenüs; zur Änderung und Verwaltung müssen weitere Rechte erteilt werden.",
        "FRENCH": "<b>Accès aux réglages de l’appareil:</b>",
        "ITALIAN": "<b>Accesso a impostazioni dell’apparecchio:</b>",
        "RUSSIAN": "<b>Доступ, настройки устройства:</b>",
        "SPANISH": "<b>Acceso a Ajustes del aparato:</b>",
        "CHINESE": "<b>访问设备设置：</b>访问设置菜单，这是访问设备设置和子菜单的先决条件；必须授予更多权限才能进行修改和管理。"
      },
      "AUTOTRANSLATIONS": {
        "CHINESE": "<b>访问设备设置：</b>访问设置菜单，这是访问设备设置和子菜单的先决条件；必须授予更多权限才能进行修改和管理。"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
        "ITALIAN": false,
        "RUSSIAN": false,
        "SPANISH": false,
        "CHINESE": false
      }
    },
    "ROLE_RIGHT_ROLE_MANAGEMENT": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "<b>Role management:</b> Access to the management for creating, modifying or deleting device roles. Needs also right to access settings menu.",
        "GERMAN": "<b>Rollenverwaltung:</b> Zugriff auf die Verwaltung zum Erstellen, Ändern oder Löschen von Rollen und Rechten",
        "FRENCH": "<b>Gestion des rôles:</b> Accès à la gestion pour la création, la modification ou la suppression des rôles des appareils. Nécessite également le droit d'accéder au menu des paramètres.",
        "ITALIAN": "<b>Gestione dei ruoli:</b> Accesso alla gestione per la creazione, la modifica o l'eliminazione dei ruoli del dispositivo. Richiede anche il diritto di accedere al menu delle impostazioni.",
        "RUSSIAN": "<b>Управление ролями:</b> Доступ к управлению созданием, изменением или удалением ролей устройств. Также необходимо право доступа к меню настроек.",
        "SPANISH": "<b>Gestión de roles:</b>",
        "CHINESE": "<b>角色管理：</b>创建、更改或删除角色和权限的管理访问权限"
      },
      "AUTOTRANSLATIONS": {
        "CHINESE": "<b>角色管理：</b>创建、更改或删除角色和权限的管理访问权限"
      },
      "VERIFIED": {
        "ENGLISH": false,
        "GERMAN": false,
        "FRENCH": false,
        "ITALIAN": false,
        "RUSSIAN": false,
        "SPANISH": false,
        "CHINESE": false
      }
    },
