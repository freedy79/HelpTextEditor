    "PRINT_PROFILE_WEBSERVICE_INSTRUCTION_1": {
      "group": "HELP_INSTRUCTION",
      "topic": "HELPTEXT",
      "comment": "",
      "locked": false,
      "obsolete": false,
      "ref_id": "",
      "ref_changed": false,
      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "GERMAN": "Das Durckprofil Webservice-Report wird verwendet, wenn Sie eine Verbindung mit der Software Ingenix® aufbauen möchten. Dabei verbleiben abgeschlossene Task mit ihren Daten auf dem Gerät, bis sie durch die Software abgeholt werden. ",
        "ENGLISH": "The Web service Report print profile is used if you want to establish a connection with the Ingenix® software. Completed tasks and their data remain on the device until they are retrieved by the software. ",
        "CHINESE": "如果要与 Ingenix® 软件建立连接，则使用网络服务报告打印配置文件。已完成的任务及其数据会保留在设备上，直到软件检索到它们。",
        "FRENCH": "Le profil Durck Webservice-Report est utilisé lorsque vous souhaitez établir une connexion avec le logiciel Ingenix®. Les tâches terminées et leurs données restent sur l'appareil jusqu'à ce qu'elles soient récupérées par le logiciel.",
        "SPANISH": "El perfil de impresión de informes del servicio Web se utiliza si desea establecer una conexión con el software Ingenix®. Las tareas completadas y sus datos permanecen en el dispositivo hasta que el software los recupera.",
        "RUSSIAN": "Профиль печати отчета веб-службы используется, если необходимо установить соединение с программным обеспечением Ingenix®. Выполненные задания и их данные остаются на устройстве до тех пор, пока они не будут извлечены программным обеспечением.",
        "ITALIAN": "Il profilo di stampa Web service Report viene utilizzato se si desidera stabilire una connessione con il software Ingenix® . I compiti completati e i relativi dati rimangono sul dispositivo finché non vengono recuperati dal software."
      },
      "AUTOTRANSLATIONS": {
        "CHINESE": "如果要与 Ingenix® 软件建立连接，则使用网络服务报告打印配置文件。已完成的任务及其数据会保留在设备上，直到软件检索到它们。",
        "FRENCH": "Le profil Durck Webservice-Report est utilisé lorsque vous souhaitez établir une connexion avec le logiciel Ingenix®. Les tâches terminées et leurs données restent sur l'appareil jusqu'à ce qu'elles soient récupérées par le logiciel.",
        "SPANISH": "El perfil de impresión de informes del servicio Web se utiliza si desea establecer una conexión con el software Ingenix®. Las tareas completadas y sus datos permanecen en el dispositivo hasta que el software los recupera.",
        "RUSSIAN": "Профиль печати отчета веб-службы используется, если необходимо установить соединение с программным обеспечением Ingenix®. Выполненные задания и их данные остаются на устройстве до тех пор, пока они не будут извлечены программным обеспечением.",
        "ITALIAN": "Il profilo di stampa Web service Report viene utilizzato se si desidera stabilire una connessione con il software Ingenix® . I compiti completati e i relativi dati rimangono sul dispositivo finché non vengono recuperati dal software."
      },
      "VERIFIED": {
        "GERMAN": false,
        "ENGLISH": false,
        "CHINESE": false,
        "FRENCH": false,
        "SPANISH": false,
        "RUSSIAN": false,
        "ITALIAN": false
      }
    },
