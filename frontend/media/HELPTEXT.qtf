      "int_ref_id": "",
      "used_in": [],
      "TRANSLATIONS": {
        "ENGLISH": "<b>Access profile management:</b>Access to weighing and print profiles",
        "GERMAN": "<b>Zugang Profilverwaltung:</b> Zugriff auf die Verwaltung von Wäge- und Berichtsprofilen in den Einstellungsmenüs \"Wägeprofile\" und \"Druckprofile\"",
        "FRENCH": "<b>Gestion des profils :</b> Accès aux profils de pesage et d'impression",
        "CHINESE": "<b>访问配置文件管理：</b>访问 \"称重配置文件 \"和 \"打印配置文件 \"设置菜单中的称重和报告配置文件管理",
        "SPANISH": "<b>Gestión de perfiles de acceso:</b>Acceso a perfiles de pesaje e impresión.",
        "RUSSIAN": "<b>Управление профилями доступа:</b> Доступ к профилям взвешивания и печати",
        "ITALIAN": "<b>Gestione dei profili di accesso:</b> Accesso ai profili di pesatura e stampa"
      },
      "AUTOTRANSLATIONS": {
        "FRENCH": "<b>Gestion des profils d'accès :</b> Accès aux profils de pesage et d'impression",
        "CHINESE": "<b>访问配置文件管理：</b>访问 \"称重配置文件 \"和 \"打印配置文件 \"设置菜单中的称重和报告配置文件管理",
        "SPANISH": "<b>Gestión de perfiles de acceso:</b>Acceso a perfiles de pesaje e impresión.",
        "RUSSIAN": "<b>Управление профилями доступа:</b> Доступ к профилям взвешивания и печати",
        "ITALIAN": "<b>Gestione dei profili di accesso:</b> Accesso ai profili di pesatura e stampa"
      },
      "VERIFIED": {
